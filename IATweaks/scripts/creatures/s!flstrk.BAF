IF
	Dead("FSDRAGON")
THEN
    RESPONSE #50
		DestroySelf()
END

IF
    Global("IaAncientDragonFight","AR3024",0)
    !GlobalTimerNotExpired("IaFireTimer0_0","AR3024")
THEN
    RESPONSE #50
