	    !StateCheck(ThirdNearest([PC]),STATE_NOT_TARGETABLE)
	    !StateCheck(FourthNearest([PC]),STATE_NOT_TARGETABLE)
THEN
	RESPONSE #200
		IncrementGlobal("Iachainsequencer","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDecRES("SPWIJ01D", Myself)
	RESPONSE #50
	    Continue()
END

IF
	Global("Iachainsequencer","LOCALS",0)
	Allegiance(Myself,ENEMY)
	CheckStatGT(Myself,0,MINORGLOBE)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	Range(FourthNearest([GOODCUTOFF]),15)
	OR(4)
	    CheckStatLT([GOODCUTOFF],90,RESISTFIRE)
	    CheckStatLT(SecondNearest([GOODCUTOFF]),90,RESISTFIRE)
	    CheckStatLT(ThirdNearest([GOODCUTOFF]),90,RESISTFIRE)
	    CheckStatLT(FourthNearest([GOODCUTOFF]),90,RESISTFIRE)
	OR(4)
	    CheckStatLT([GOODCUTOFF],50,RESISTMAGIC)
	    CheckStatLT(SecondNearest([GOODCUTOFF]),50,RESISTMAGIC)
	    CheckStatLT(ThirdNearest([GOODCUTOFF]),50,RESISTMAGIC)
	    CheckStatLT(FourthNearest([GOODCUTOFF]),50,RESISTMAGIC)
	OR(4)
	    !StateCheck([GOODCUTOFF],STATE_NOT_TARGETABLE)
	    !StateCheck(SecondNearest([GOODCUTOFF]),STATE_NOT_TARGETABLE)
	    !StateCheck(ThirdNearest([GOODCUTOFF]),STATE_NOT_TARGETABLE)
	    !StateCheck(FourthNearest([GOODCUTOFF]),STATE_NOT_TARGETABLE)
THEN
	RESPONSE #150
		IncrementGlobal("Iachainsequencer","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDecRES("SPWIJ01D", Myself)
	RESPONSE #50
	    Continue()
END

