	See(SecondNearest([0.0.MIND_FLAYER.0.0.0.0]))
	See(SecondNearest([PC]))
	!HasBounceEffects(LastSeenBy(Myself))
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	OR(2)
		!CheckSpellState(LastSeenBy(Myself),STUN_IMMUNITY)
		!CheckSpellState(LastSeenBy(Myself),CHARM_DOMINATION_IMMUNITY)
	CheckStatGT(LastSeenBy(Myself),-5,SAVEVSSPELL)
	OR(2)
	    CheckStatGT(LastSeenBy(Myself),-1,SAVEVSSPELL)
	    !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!CheckSpellState(LastSeenBy(Myself),PSIONICS_IMMUNITY)
THEN
	RESPONSE #100
		IncrementGlobal("IaMind02","LOCALS",1)
		IncrementGlobal("IaMind01","LOCALS",1)
		SetGlobalTimer("IaPsionicAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaSoftenMind","LOCALS",TWO_ROUNDS)
		ForceSpellRES("S!MFSOFT",LastSeenBy(Myself))
END

