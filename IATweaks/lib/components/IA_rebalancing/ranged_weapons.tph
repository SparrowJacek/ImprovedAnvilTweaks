END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~DEX_BETWEEN_13_15~
    stat                  = ~0x104~
    value                 = EVAL ~%dex_less_than_13%~
    relation              = EVAL ~%dex_greater_than_15%~
