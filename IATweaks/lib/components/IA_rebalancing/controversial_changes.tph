// Riskbreaker

ACTION_FOR_EACH weapon_immunity_spell IN ~SPIN686~ ~SPWI611~ ~SPWI907~ BEGIN
  COPY_EXISTING ~%weapon_immunity_spell%.spl~ ~override~ // Protection from Risk Decrement
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 120
        opcode = 206
        parameter1 = 0
        parameter2 = 0
      STR_VAR
        resource = ~SPINI34~
    END
END

COPY_EXISTING ~INAREANP.PRO~ ~override/S!RISKDE.PRO~ // Risk Decrement ability projectile
  WRITE_LONG 0x2c ~-2147483648~ // Affect caster once for each enemy for "original caster" targetting
  WRITE_SHORT 0x204 85 // Range = 5 feet
  WRITE_SHORT 0x206 85

ADD_PROJECTILE ~override/S!RISKDE.pro~

COPY_EXISTING ~SPINI34.spl~ ~override~ // Risk Decrement
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      projectile = %S!RISKDE%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      resist_dispel = 0
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 17
      target = 9 // original caster
      parameter1 = 10
      parameter2 = 0
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 215
    STR_VAR
      match_resource = ~SPSTRENH~
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 215
      target = 1
  END

COPY_EXISTING ~SPCLI06.spl~ ~override~ // AC bonus
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 0
      parameter1 = 8
      parameter2 = 16 // set AC
  END
  PATCH_FOR_EACH header_id IN 1 2 3 4 5 BEGIN
    LPF ~S!CLONE_SPELL_HEADER~
      INT_VAR
        level_req = (header_id + 1) * 6
    END
    LPF ~S!ALTER_EFFECT~
      INT_VAR
        header = header_id
        match_opcode = 0
        parameter1 = 9 - header_id
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        header = header_id
        match_opcode = 0
        parameter1 = 1
        parameter2 = 0
    END
  END


