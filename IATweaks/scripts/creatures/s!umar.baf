		SetGlobal("IaAttacking","LOCALS",1)
		AttackReevaluate(ThirdNearestEnemyOf(Myself),45)
END

IF
	Allegiance(Myself,ENEMY)
	ActionListEmpty()
	HasItem("ENEBLADE",Myself)
	See(SecondNearestEnemyOf(Myself))
    OR(2)
        CheckStatLT(SecondNearestEnemyOf(Myself),100,RESISTSLASHING)
        CheckStatLT(SecondNearestEnemyOf(Myself),100,RESISTELECTRICITY)
THEN
	RESPONSE #100
		SetGlobal("IaAttacking","LOCALS",1)
		AttackReevaluate(SecondNearestEnemyOf(Myself),45)
END

IF
	Allegiance(Myself,ENEMY)
	ActionListEmpty()
	HasItem("ENEBLADE",Myself)
	See(NearestEnemyOf(Myself))
    OR(2)
        CheckStatLT(NearestEnemyOf(Myself),100,RESISTSLASHING)
        CheckStatLT(NearestEnemyOf(Myself),100,RESISTELECTRICITY)
THEN
	RESPONSE #100
		SetGlobal("IaAttacking","LOCALS",1)
		AttackReevaluate(NearestEnemyOf(Myself),45)
END



IF
	!Detect([PC])
	!Detect([GOODCUTOFF])
	Global("partyfled","LOCALS",0)
	Allegiance(Myself,ENEMY)
	GlobalGT("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("chase","LOCALS",TEN_ROUNDS)
		SetGlobal("partyfled","LOCALS",1)
END

IF
	!Detect([PC])
	!Detect([GOODCUTOFF])
	Global("partyfled","LOCALS",1)
	GlobalTimerNotExpired("chase","LOCALS")
	InMyArea(Player1)
	Allegiance(Myself,ENEMY)
	GlobalGT("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

