
SILENT

INCLUDE "%MOD_FOLDER%/lib/components/IA_rebalancing/helper_functions.tph"

// Patch all shields to set shield_equipped state when worn

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
  READ_BYTE 0x18 flags_1st_byte
  READ_SHORT 0x1c item_category
  SET is_2h = flags_1st_byte BAND 0x02
  GET_OFFSET_ARRAY ab_array ITM_V10_HEADERS
  SET num_melee = 0
  SET num_ranged = 0
  SET num_launcher = 0
  PHP_EACH ab_array AS int => ab_off BEGIN
    READ_BYTE (ab_off + 0x00) attack_type
    PATCH_IF (attack_type = 1) BEGIN num_melee += 1 END
    PATCH_IF (attack_type = 2) BEGIN num_ranged += 1 END
    PATCH_IF (attack_type = 4) BEGIN num_launcher += 1 END
  END
  PATCH_IF (item_category = 12)
    THEN BEGIN
      LPF ~ADD_ITEM_EQEFFECT~
        INT_VAR
          opcode = 328
          target = 1
          parameter2 = %shield_equipped_state%
          timing = 2  
          special = 1  
      END
      LPF ~ADD_ITEM_EQEFFECT~
        INT_VAR
          opcode = 321
          target = 1
          timing = 0
        STR_VAR
          resource = ~S!+05APR~
      END
  END
  // Grant 0,5APR to 2h weapons if 3 points in 2h weapon style
  PATCH_IF((num_melee > 0) AND (num_ranged = 0) AND (num_launcher = 0) AND (is_2h > 0)) BEGIN
    LPF ~ADD_ITEM_EQEFFECT~
      INT_VAR
        insert_point = ~-1~
        opcode = 318
        target = 1
        parameter1 = 3
        parameter2 = two_handed_style
        timing = 10
        duration = 1
      STR_VAR
        resource = EVAL ~%SOURCE_RES%~
    END
    LPF ~ADD_ITEM_EQEFFECT~
      INT_VAR
        insert_point = ~-1~
        opcode = 177
        target = 1
        parameter1 = 0
        parameter2 = 2
        timing = 2
      STR_VAR
        resource = ~S!+05APR~
    END
  END
  // Grant 0,5APR to 1 weapons if 3 points in single weapon style
  PATCH_IF((num_melee > 0) AND (num_ranged = 0) AND (num_launcher = 0) AND (is_2h = 0)) BEGIN
    LPF ~ADD_ITEM_EQEFFECT~
      INT_VAR
        insert_point = ~-1~
        opcode = 177
        target = 1
        parameter1 = 0
        parameter2 = 2
        timing = 2
      STR_VAR
        resource = ~S!COUNTW~
    END
    LPF ~ADD_ITEM_EQEFFECT~
      INT_VAR
        insert_point = ~-1~
        opcode = 318
        target = 1
        parameter1 = 3
        parameter2 = single_weapon_style_less_than
        timing = 10
        duration = 2
      STR_VAR
        resource = EVAL ~%SOURCE_RES%~
    END
    LPF ~ADD_ITEM_EQEFFECT~
      INT_VAR
        insert_point = ~-1~
        opcode = 272
        target = 1
        parameter1 = 1
        parameter2 = 0
        timing = 2
      STR_VAR
        resource = ~S!SWPAPR~
    END
  END
  PATCH_IF((num_melee > 0) OR (num_ranged > 0) OR (num_launcher > 0)) BEGIN
    LPF ~ADD_ITEM_EQEFFECT~
      INT_VAR
        opcode = 321
        target = 1
        timing = 0
      STR_VAR
        resource = ~S!+05APR~
    END
  END
BUT_ONLY

// Regen turned into spells

COPY ~IATweaks\resources\spl\s!regen1.spl~ ~override~
ACTION_FOR_EACH regen_num IN ~2~ ~3~ ~4~ ~5~ ~6~ ~7~ ~8~ ~9~ BEGIN
  COPY_EXISTING ~s!regen1.spl~ ~override/s!regen%regen_num%.spl~
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 17
        parameter1 = %regen_num%
    END
END

COPY ~IATweaks\resources\eff\s!regen1.eff~ ~override~
ACTION_FOR_EACH regen_num IN ~2~ ~3~ ~4~ ~5~ ~6~ ~7~ ~8~ ~9~ BEGIN
  COPY_EXISTING ~s!regen1.eff~ ~override/s!regen%regen_num%.eff~
    WRITE_ASCIIE 0x30 ~S!REGEN%regen_num%~ #8
END

COPY_EXISTING_REGEXP GLOB ~.*\.SPL~ ~override~
  GET_OFFSET_ARRAY ab_array SPL_V10_HEADERS
  PHP_EACH ab_array AS int => ab_off BEGIN
    GET_OFFSET_ARRAY2 fx_array ab_off SPL_V10_HEAD_EFFECTS
    PHP_EACH fx_array AS int => fx_off BEGIN
      READ_SHORT (fx_off + 0x00) opcode
      READ_LONG (fx_off + 0x08) param2
      PATCH_IF ((opcode = 98) AND (param2 != 1) AND (param2 < 4)) BEGIN
        READ_LONG (fx_off + 0x04) param1
        WRITE_SHORT (fx_off + 0x00) 272
        PATCH_IF ((param2 = 0) OR (param2 = 3)) BEGIN
          WRITE_ASCII (fx_off + 0x14) ~S!REGEN1~ #8
        END
        PATCH_IF (param2 = 2) BEGIN
          WRITE_LONG (fx_off + 0x04) 1
          WRITE_ASCIIE (fx_off + 0x14) ~S!REGEN%param1%~ #8
        END
      END
    END
  END
BUT_ONLY

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
  GET_OFFSET_ARRAY ab_array ITM_V10_HEADERS
  PHP_EACH ab_array AS int => ab_off BEGIN
    GET_OFFSET_ARRAY2 fx_array ab_off ITM_V10_HEAD_EFFECTS
    PHP_EACH fx_array AS int => fx_off BEGIN
      READ_SHORT (fx_off + 0x00) opcode
      READ_LONG (fx_off + 0x08) param2
      PATCH_IF ((opcode = 98) AND (param2 != 1) AND (param2 < 4)) BEGIN
        READ_LONG (fx_off + 0x04) param1
        WRITE_SHORT (fx_off + 0x00) 272
        PATCH_IF ((param2 = 0) OR (param2 = 3)) BEGIN
          WRITE_ASCII (fx_off + 0x14) ~S!REGEN1~ #8
        END
        PATCH_IF (param2 = 2) BEGIN
          WRITE_LONG (fx_off + 0x04) 1
          WRITE_ASCIIE (fx_off + 0x14) ~S!REGEN%param1%~ #8
        END
      END
    END
  END
  GET_OFFSET_ARRAY ab_array2 ITM_V10_GEN_EFFECTS
  PHP_EACH ab_array2 AS int => fx_off BEGIN
    READ_SHORT (fx_off + 0x00) opcode
    READ_LONG (fx_off + 0x08) param2
    PATCH_IF ((opcode = 98) AND (param2 != 1) AND (param2 < 4)) BEGIN
      READ_LONG (fx_off + 0x04) param1
      WRITE_SHORT (fx_off + 0x00) 272
      PATCH_IF ((param2 = 0) OR (param2 = 3)) BEGIN
        WRITE_ASCII (fx_off + 0x14) ~S!REGEN1~ #8
      END
      PATCH_IF (param2 = 2) BEGIN
        WRITE_LONG (fx_off + 0x04) 1
        WRITE_ASCIIE (fx_off + 0x14) ~S!REGEN%param1%~ #8
      END
    END
  END
BUT_ONLY

COPY_EXISTING_REGEXP GLOB ~.+\.cre~ ~override~
  PATCH_IF NOT (~%SOURCE_RES%~ STR_EQ ~S!SMARCE~) BEGIN
    GET_OFFSET_ARRAY fx_array CRE_V10_EFFECTS
    PHP_EACH fx_array AS int => fx_off BEGIN
      READ_LONG (fx_off + 0x08) opcode
      READ_LONG (fx_off + 0x18) param2
      PATCH_IF ((opcode = 98) AND (param2 != 1) AND (param2 < 4)) BEGIN
        READ_LONG (fx_off + 0x14) param1
        WRITE_LONG (fx_off + 0x08) 272
        PATCH_IF ((param2 = 0) OR (param2 = 3)) BEGIN
          WRITE_ASCII (fx_off + 0x28) ~S!REGEN1~ #8
        END
        PATCH_IF (param2 = 2) BEGIN
          WRITE_LONG (fx_off + 0x14) 1
          WRITE_ASCIIE (fx_off + 0x28) ~S!REGEN%param1%~ #8
        END
      END
    END
  END
BUT_ONLY

// Change Armor type to proper 3 types

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
  READ_ASCII 0x22 equipped_appearance (2)
  PATCH_IF (~%equipped_appearance%~ STR_EQ ~2A~) BEGIN
    WRITE_SHORT 0x1c 60 // Leather Armor
  END
  PATCH_IF (~%equipped_appearance%~ STR_EQ ~3A~) BEGIN
    WRITE_SHORT 0x1c 62 // Chain Armor
  END
  PATCH_IF (~%equipped_appearance%~ STR_EQ ~4A~) BEGIN
    WRITE_SHORT 0x1c 64 // Plate Armor
  END
BUT_ONLY

// Grant immunity to Disease and Intoxication to all Golems and Undead

COPY_EXISTING_REGEXP GLOB ~.+\.cre~ ~override~
  READ_BYTE 0x271 general
  READ_BYTE 0x272 race
  PATCH_IF ((general = 4) OR 
            (race = 144)) BEGIN
    LPF ~ADD_CRE_EFFECT~ 
      INT_VAR
        opcode = 101
        timing = 9
        parameter2 = 94
    END
    LPF ~ADD_CRE_EFFECT~ 
      INT_VAR
        opcode = 101
        timing = 9
        parameter2 = 78
    END
  END
BUT_ONLY