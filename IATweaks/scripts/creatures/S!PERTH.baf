IF
	NumberOfTimesTalkedTo(0)
	Global("Iapcastts","GLOBAL",0)
	Detect([PC])
THEN
	RESPONSE #100
		StartDialogueNoSet([PC])
END

IF
	OR(2)
		InMyArea(Player1)
		Detect([PC])
	Global("Iaperth01","LOCALS",0)
	HasItem("POTN34",Myself)
THEN
	RESPONSE #100
		ReallyForceSpellRES("PTN34X",Myself)
		DestroyItem("POTN34")
		Continue()
END

IF
	OR(2)
		InMyArea(Player1)
		Detect([PC])
	Global("Iaperth01","LOCALS",0)
	HasItem("POTN33",Myself)  // Barbarian Essence
THEN
	RESPONSE #100
		ReallyForceSpellRES("PTN33X",Myself)  // No such index
		DestroyItem("POTN33")  // Barbarian Essence
		Continue()
END

IF
	OR(2)
		InMyArea(Player1)
		Detect([PC])
	Global("Iaperth01","LOCALS",0)
	HasItem("POTN33",Myself)  // Barbarian Essence
THEN
	RESPONSE #100
		ReallyForceSpellRES("PTN33X",Myself)  // No such index
		DestroyItem("POTN33")  // Barbarian Essence
		Continue()
END

IF
	OR(2)
		InMyArea(Player1)
		Detect([PC])
	Global("Iaperth01","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iaperth01","LOCALS",1)
		ReallyForceSpell(Myself,WIZARD_SHIELD)
		ReallyForceSpell(Myself,WIZARD_ARMOR)
		ReallyForceSpell(Myself,WIZARD_LUCK)
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Fire Shield (Red))
		ReallyForceSpellRES("SPWI522",Myself)
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_ABJURATION)  // SPWI590.SPL (Immunity: Abjuration)
		ReallyForceSpell(Myself,WIZARD_GLOBE_OF_INVULNERABILITY)  // SPWI602.SPL (Globe of Invulnerability)
		ReallyForceSpell(Myself,WIZARD_SPELL_TURNING)  // SPWI701.SPL (Spell Turning)
		ReallyForceSpellRES("SPWI725",Myself)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_ENERGY)  // SPWI803.SPL (Protection From Energy)
		ReallyForceSpellRES("SPWI807",Myself)
		ReallyForceSpellRES("SPWI815",Myself)
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Allegiance(Myself,ENEMY)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_STUNNED)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Global("Iapcastts","GLOBAL",0)
	HPPercentLT(Myself,75)
	See([PC])
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!CheckStatGT(LastSeenBy(Myself),49,RESISTELECTRICITY)
	!CheckStat(LastSeenBy(Myself),4,SCRIPTINGSTATE7)
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
	Global("Iaperth07","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iaperth07","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		DisplayString(Myself,39968)  // Spell Trigger—Fired
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAIN_LIGHTNING)  // SPWI615.SPL (Chain Lightning)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAIN_LIGHTNING)  // SPWI615.SPL (Chain Lightning)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAIN_LIGHTNING)  // SPWI615.SPL (Chain Lightning)
END

IF
	Allegiance(Myself,ENEMY)
	!HPLT(Myself,1)
	See(Player1)
	GlobalLT("Iasummons","LOCALS",3)
	!GlobalTimerNotExpired("Iagolem","LOCALS")
THEN
	RESPONSE #100
		IncrementGlobal("Iasummons","LOCALS",1)
		SetGlobalTimer("Iagolem","LOCALS",FIVE_ROUNDS)
		CreateCreatureObjectDoor("S!coin",Player1,0,0,0)  // Coin Golem
END

IF
	Allegiance(Myself,ENEMY)
	!HPLT(Myself,1)
	See([PC])
	GlobalLT("Iasummons","LOCALS",3)
	!GlobalTimerNotExpired("Iagolem","LOCALS")
THEN
	RESPONSE #100
		IncrementGlobal("Iasummons","LOCALS",1)
		SetGlobalTimer("Iagolem","LOCALS",FIVE_ROUNDS)
		CreateCreatureObjectDoor("S!coin",LastSeenBy(Myself),0,0,0)  // Coin Golem
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_STUNNED)
	Global("Iapcastts","GLOBAL",0)
	OR(2)
		!GlobalTimerNotExpired("absolute","LOCALS")
		CheckStat(Myself,0,SCRIPTINGSTATE6)
	HasItem("scrl9p",Myself)  // Absolute Immunity
	See(NearestEnemyOf(Myself))
	OR(3)
		Range(LastSeenBy(Myself),4)
		AttackedBy([GOODCUTOFF],MELEE)
		AttackedBy([GOODCUTOFF],RANGED)
	GlobalLT("Iaperth06","LOCALS",5)
THEN
	RESPONSE #100
		IncrementGlobal("Iaperth06","LOCALS",1)
		SetGlobalTimer("absolute","LOCALS",FOUR_ROUNDS)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46153)  // *uses a scroll*
		UseItem("scrl9p",Myself)  // Absolute Immunity
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	OR(4)
		CheckStatGT(Myself,0,SCRIPTINGSTATE9)
		StateCheck(Myself,STATE_HELPLESS)
		StateCheck(Myself,STATE_STUNNED)
		Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
END

