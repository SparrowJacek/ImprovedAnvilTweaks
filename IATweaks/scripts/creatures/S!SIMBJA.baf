IF
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
		Continue()
END

IF
	!StateCheck(NearestEnemyOf(Myself),STATE_INVISIBLE)
	Range(NearestEnemyOf(Myself),5)
	OR(2)
		HitBy([ANYONE],CRUSHING)
		HPPercentLT(Myself,75)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	HasItem("POTN10",Myself)  // Potion of Invisibility
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaRunAway","LOCALS",0)
		UseItem("POTN10",Myself)  // Potion of Invisibility
END

IF
	Range(NearestEnemyOf(Myself),5)
	!StateCheck(NearestEnemyOf(Myself),STATE_HARMLESS)
	!CheckStatGT(NearestEnemyOf(Myself),0,HELD)
	StateCheck(Myself,STATE_INVISIBLE)
	OR(2)
		StateCheck(Myself,STATE_HASTED)
		!CheckStat(Myself,0,IMPROVEDHASTE)
	!GlobalTimerNotExpired("IaRunAway","LOCALS")
	CanEquipRanged()
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRunAway","LOCALS",TWO_ROUNDS)
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),30)
		SetInterrupt(TRUE)
END

IF
	Range(NearestEnemyOf(Myself),5)
	StateCheck(Myself,STATE_INVISIBLE)
	!GlobalTimerNotExpired("IaRunAway","LOCALS")
	!StateCheck(Myself,STATE_HASTED)
	CheckStat(Myself,0,IMPROVEDHASTE)
	CanEquipRanged()
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRunAway","LOCALS",TWO_ROUNDS)
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),45)
		SetInterrupt(TRUE)
END

IF
	HaveSpellRES("SPCL121")  // Called Shot
	See([PC])
	OR(2)
		!Range(NearestEnemyOf(Myself),5)
		HPPercent(Myself,100)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!CheckSpellState(Myself,ARCHER_CALL_SHOT)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellRES("SPCL121",Myself)  // Called Shot
END

