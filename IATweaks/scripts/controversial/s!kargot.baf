	GlobalLT("Chapter","GLOBAL",8)
THEN
	RESPONSE #50
		SetGlobalTimer("Iafire","LOCALS",TWO_ROUNDS)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDec(LastSeenBy(Myself),WIZARD_METEOR_SWARM)  // SPWI911.SPL (Meteor Swarm)
	RESPONSE #50
		SetGlobalTimer("Iafire","LOCALS",TWO_ROUNDS)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDec(LastSeenBy(Myself),WIZARD_FIREBALL)  // SPWI304.SPL (Fireball)
END

