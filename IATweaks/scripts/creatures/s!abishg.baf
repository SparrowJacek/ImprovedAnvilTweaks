IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	See(SecondNearest([PC]))
	Range(LastSeenBy(Myself),5)
	CheckStatGT(LastSeenBy(Myself),0,RESISTACID)
	GlobalLT("IaLowerAcid","LOCALS",1)
THEN
	RESPONSE #100
		IncrementGlobal("IaLowerAcid","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!DRU12",LastSeenBy(Myself))  // Lower Acid Resistance
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	See([PC])
	Range(LastSeenBy(Myself),5)
	CheckStatGT(LastSeenBy(Myself),0,RESISTACID)
	GlobalLT("IaLowerAcid","LOCALS",1)
THEN
	RESPONSE #100
		IncrementGlobal("IaLowerAcid","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!DRU12",LastSeenBy(Myself))  // Lower Acid Resistance
END

IF
	Allegiance(Myself,ENEMY)
	HPPercentLT(Myself,90)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	CheckStatLT(Myself,71,RESISTCRUSHING)
	See(NearestEnemyOf(Myself))
	GlobalLT("Iahard","LOCALS",2)
THEN
	RESPONSE #100
		IncrementGlobal("Iahard","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ForceSpell(Myself,WARRIOR_HARDINESS)  // SPCL907.SPL (Hardiness)
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	See(SecondNearest([PC]))
	CheckStatLT(LastSeenBy(Myself),100,RESISTACID)
	CheckStatLT(LastSeenBy(Myself),90,RESISTMAGIC)
	!CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE7)
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
	!StateCheck(LastSeenBy(Myself),STATE_FEEBLEMINDED)
	GlobalLT("IaMelf","LOCALS",1)
	Global("IaLowerAcid","LOCALS",1)
THEN
	RESPONSE #100
		IncrementGlobal("IaMelf","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayString(Myself,39968)  // Spell Trigger—Fired
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_MELF_ACID_ARROW)  // SPWI211.SPL (Melf's Acid Arrow)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_MELF_ACID_ARROW)  // SPWI211.SPL (Melf's Acid Arrow)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_MELF_ACID_ARROW)  // SPWI211.SPL (Melf's Acid Arrow)
END

