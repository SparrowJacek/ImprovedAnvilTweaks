
IF
	Dead("Yaga01")  // Yaga-Shura
THEN
	RESPONSE #100
		DestroySelf()
END

IF
	OR(2)
		See(NearestEnemyOf(Myself))
		Detect([PC])
	Global("Iayagam02","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("Iayagamrest","GLOBAL",SEVEN_HOURS)
		SetGlobal("Iayagam02","LOCALS",1)
		ReallyForceSpellRES("SPWI807",Myself)  // Foreknowledge
		ReallyForceSpell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (Mirror Image)
		ReallyForceSpell(Myself,WIZARD_SPELL_TURNING)  // SPWI701.SPL (Spell Turning)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_ENERGY)  // SPWI606.SPL (Protection From Magic Energy)
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_ABJURATION)  // SPWI590.SPL (Immunity: Abjuration)
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_BLUE)  // SPWI403.SPL (Fire Shield (Blue))
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_FIRE)  // SPWI319.SPL (Protection From Fire)
		ReallyForceSpell(Myself,WIZARD_GLOBE_OF_INVULNERABILITY)  // SPWI602.SPL (Globe of Invulnerability)
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	GlobalTimerExpired("Iayagamrest","GLOBAL")
	Global("Iayagam02","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobalTimer("Iayagamrest","GLOBAL",SEVEN_HOURS)
		SetGlobal("Iayagam01","LOCALS",0)
		SetGlobal("Iayagam02","LOCALS",0)
		SetGlobal("Iayagam03","LOCALS",0)
		SetGlobal("Iayagam04","LOCALS",0)
		SetGlobal("Iayagam05","LOCALS",0)
		SetGlobal("Iayagam06","LOCALS",0)
		SetGlobal("Iayagam07","LOCALS",0)
		SetGlobal("Iayagam08","LOCALS",0)
		SetGlobal("Iayagam09","LOCALS",0)
		SetGlobal("Iayagam10","LOCALS",0)
		SetGlobal("Iayagam11","LOCALS",0)
		SetGlobal("Iayagam12","LOCALS",0)
		SetGlobal("Iayagam13","LOCALS",0)
		SetGlobal("Iayagam19","LOCALS",0)
		SetGlobal("Iayagam20","LOCALS",0)
		SetGlobal("Iayagam22","LOCALS",0)
		SetGlobal("Iayagam23","LOCALS",0)
		SetGlobal("Iayagam24","LOCALS",0)
		SetGlobal("Iareversal","LOCALS",0)
		SetGlobal("Iadispel","LOCALS",0)
		SetGlobal("RemoveMagic","LOCALS",0)
		SetGlobal("Iacritical","LOCALS",0)
		SetGlobal("Iadispelpot","LOCALS",0)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	ActionListEmpty()
	Allegiance(Myself,ENEMY)
	HPPercentLT(Myself,75)
	See([PC])
	CheckStatLT(LastSeenBy(Myself),75,MAGICDAMAGERESISTANCE)
	CheckStatLT(LastSeenBy(Myself),90,RESISTMAGIC)
	!CheckStat(LastSeenBy(Myself),5,SCRIPTINGSTATE7)
	Global("Iayagam12","LOCALS",0)
	!HPLT(Myself,1)
THEN
	RESPONSE #100
		SetGlobal("Iayagam12","LOCALS",1)
		DisplayString(Myself,26328)  // Chain Contingency
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_ABI_DALZIMS_HORRID_WILTING)  // SPWI812.SPL (Abi-Dalzim's Horrid Wilting)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_ABI_DALZIMS_HORRID_WILTING)  // SPWI812.SPL (Abi-Dalzim's Horrid Wilting)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_ABI_DALZIMS_HORRID_WILTING)  // SPWI812.SPL (Abi-Dalzim's Horrid Wilting)
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	OR(3)
		StateCheck(Myself,STATE_HELPLESS)
		StateCheck(Myself,STATE_STUNNED)
		Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
END

IF
	Allegiance(Myself,ENEMY)
	!CheckStatGT(Myself,0,SCRIPTINGSTATE9)
	CheckStatLT(Myself,1,STONESKINS)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	See(NearestEnemyOf(Myself))
	GlobalLT("Iayagam04","LOCALS",2)
THEN
	RESPONSE #100
		IncrementGlobal("Iayagam04","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SpellNoDec(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	See(NearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),5)
	OR(2)
		!GlobalTimerNotExpired("pfmw","LOCALS")
		CheckStat(Myself,0,SCRIPTINGSTATE6)
	GlobalLT("Iaprotection","LOCALS",3)
	HasItem("scrl7o",Myself)  // Protection From Magical Weapons
THEN
	RESPONSE #100
		SetGlobalTimer("pfmw","LOCALS",FOUR_ROUNDS)
		IncrementGlobal("Iaprotection","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46153)  // *uses a scroll*
		UseItem("scrl7o",Myself)  // Protection From Magical Weapons
END

IF
	Allegiance(Myself,ENEMY)
	!CheckStatGT(Myself,0,SCRIPTINGSTATE9)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	CheckStatLT(Myself,65,RESISTCRUSHING)
	CheckStat(Myself,0,SCRIPTINGSTATE6)
	HPPercentLT(Myself,100)
	See(NearestEnemyOf(Myself))
	GlobalLT("Iahard","LOCALS",3)
THEN
	RESPONSE #100
		IncrementGlobal("Iahard","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ForceSpell(Myself,WARRIOR_HARDINESS)  // SPCL907.SPL (Hardiness)
END

IF
	HPPercentLT(Myself,50)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	HasItem("POTN55",Myself)  // Potion of Superior Healing
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46150)  // *quaffs a potion*
		UseItem("POTN55",Myself)  // Potion of Superior Healing
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	CheckStatGT(Myself,0,SCRIPTINGSTATE9)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	See([PC])
	OR(3)
		StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
		StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
		StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
	!GlobalTimerNotExpired("truesight","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("truesight","LOCALS",TEN_ROUNDS)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SpellNoDec(Myself,WIZARD_TRUE_SIGHT)  // SPWI609.SPL (True Sight)
END

