END

COPY ~IATweaks\resources\eff\s!-thcxb.eff~ ~override~
COPY ~IATweaks\resources\spl\s!-thcxb.spl~ ~override~
COPY ~IATweaks\resources\eff\s!rngthc.eff~ ~override~
COPY ~IATweaks\resources\eff\s!rngdmg.eff~ ~override~
COPY ~IATweaks\resources\spl\s!dmgrn1.spl~ ~override~
  FOR (i=2;i<=5;++i) BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 321
        multi_match = 1
      STR_VAR
        resource = EVAL ~S!DMGRN%i%~
    END
  END
OUTER_FOR (i=2;i<=5;++i) BEGIN
  COPY_EXISTING ~s!dmgrn1.spl~ ~override/s!dmgrn%i%.spl~
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 286
        parameter1 = i
    END
END

COPY ~IATweaks\resources\spl\ranged_damage_stat_bonus_template.spl~ ~override/s!dexdmg.spl~
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 326
      parameter2 = dex_between_13_15
  END
  LPF ~CLONE_EFFECT~
    INT_VAR
      match_opcode = 326
      multi_match  = 1
      parameter2   = dex_between_16_18
    STR_VAR
      insert   = ~last~
      resource = EVAL ~S!DMGRN2~
  END

  LPF ~CLONE_EFFECT~
    INT_VAR
      match_opcode = 326
      multi_match  = 1
      parameter2   = dex_between_19_21
    STR_VAR
      insert   = ~last~
      resource = EVAL ~S!DMGRN3~
  END

  LPF ~CLONE_EFFECT~
    INT_VAR
      match_opcode = 326
      multi_match  = 1
      parameter2   = dex_between_22_24
    STR_VAR
      insert   = ~last~
      resource = EVAL ~S!DMGRN4~
  END

  LPF ~CLONE_EFFECT~
    INT_VAR
      match_opcode = 326
      multi_match = 1
      parameter1 = 25
      parameter2 = 122
    STR_VAR
      insert = ~last~
      resource = EVAL ~S!DMGRN5~
  END

COPY ~IATweaks\resources\spl\ranged_damage_stat_bonus_template.spl~ ~override/s!strdmg.spl~
