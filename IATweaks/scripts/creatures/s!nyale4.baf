
IF
	Allegiance(Myself,ENEMY)
	Global("IaPhase4","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaPhase4","LOCALS",1)
		ReallyForceSpellRES("S!CASTI3",Myself)
		ReallyForceSpell(Myself,CLERIC_CURE_CRITICAL_WOUNDS)
		ReallyForceSpell(Myself,CLERIC_IRONSKIN)
		DestroyItem("minhp1")  // No such index
		SetGlobalTimer("IaNyaleeCryTimer","LOCALS",2)
END

IF
	Allegiance(Myself,ENEMY)
	GlobalTimerExpired("IaNyaleeCryTimer","LOCALS")
	Global("IaNyaleeCry","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaNyaleeCry","LOCALS",1)
		DisplayStringHead(Myself,@5178)
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobalTimer("Ianyaleerest","GLOBAL",SEVEN_HOURS)
		ReallyForceSpell(Myself,CLERIC_ARMOR_OF_FAITH)  // SPPR111.SPL (Armor of Faith)
		ReallyForceSpell(Myself,CLERIC_IRONSKIN)  // SPPR506.SPL (Iron Skins)
		ReallyForceSpell(Myself,CLERIC_AURA_OF_FLAMING_DEATH)  // SPPR730.SPL (Aura of Flaming Death)
		ReallyForceSpell(Myself,CLERIC_PHYSICAL_MIRROR)  // SPPR613.SPL (Protection From Missiles)
		ReallyForceSpell(Myself,CLERIC_ACID_SHIELD)  // SPPR418.SPL (Acid Shield)
		ReallyForceSpellRES("SPPR406F",Myself) //  Defensive Harmony
		ReallyForceSpell(Myself,CLERIC_GLOBE_OF_BLADES)
		SetGlobalTimer("IaDefensiveHarmony","LOCALS",SIX_ROUNDS)
		SetGlobalTimer("IaGlobeOfBlades","LOCALS",60)
		SetGlobalTimer("IaAuraOfFlame","LOCALS",90)
END


IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
		Continue()
END

IF
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		NoAction()
END


IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	GlobalTimerExpired("Ianyaleerest","GLOBAL")
	Global("IaPrep","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobalTimer("Ianyaleerest","GLOBAL",SEVEN_HOURS)
		SetGlobal("IaPrep","LOCALS",0)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
     Allegiance(Myself,ENEMY)
     CheckStat(Myself,0,AURACLEANSING)
THEN
	RESPONSE #100
		ForceSpellRES("SPPRI16",Myself)  // Aura Cleansing
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
END


IF
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
    !GlobalTimerNotExpired("IaNatureBeauty","LOCALS")
	CheckStat(Myself,0,SCRIPTINGSTATE6)
	OR(3)
	    See(ThirdNearestEnemyOf(Myself))
	    See(SecondNearestEnemyOf(Myself))
	    See(NearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),10)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		ForceSpell(Myself,CLERIC_NATURE_BEAUTY)
		SetGlobalTimer("IaNatureBeauty","LOCALS",ONE_TURN)
		SetInterrupt(TRUE)
	RESPONSE #0
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
    !GlobalTimerNotExpired("IaCallLightning","LOCALS")
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	CheckStatLT(Player6,60,RESISTELECTRICITY)
	CheckStatLT(Player6,30,RESISTMAGIC)
	!CheckSpellState(Player6,WIZARD_SPELL_TURNING)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaAction","LOCALS",14)
		SetGlobalTimer("IaCallLightning","LOCALS",TWO_ROUNDS)
		ForceSpell(Player6,CLERIC_CALL_LIGHTNING)
		SetInterrupt(TRUE)
	RESPONSE #300
	    Continue()
END

