IF
	Global("IaPrep","LOCALS",1)
	!See(Player1)
	InMyArea(Player1)
	HPLT(Player1,1)
	WeaponEffectiveVs(Player1,MAINHAND)
	WeaponCanDamage(Player1,MAINHAND)
	OR(2)
		!See(NearestEnemyOf(Myself))
		Range(NearestEnemyOf(Myself),10)
	ActionListEmpty()
THEN
	RESPONSE #100
		MoveToObject(Player1)
END


