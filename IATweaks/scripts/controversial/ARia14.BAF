IF
	!Dead("S!dracol")  // Dracolich
THEN
	RESPONSE #100
		Wait(5)
		MoveGlobalObject("S!DRACOL",Player1)  // Dracolich
END

IF
	Global("Iadracoldead","GLOBAL",0)
	Global("Iaghostfled","GLOBAL",0)
	Dead("S!dracol")  // Dracolich
THEN
	RESPONSE #100
		SetGlobal("Iadracoldead","GLOBAL",1)
		SetGlobalTimer("Iacghost","Aria14",ONE_ROUND)
END

IF
	Global("Iadracoldead","GLOBAL",0)
	Global("Iaghostfled","GLOBAL",1)
	Global("Iaexit","ARia14",1)
	Dead("S!dracol")  // Dracolich
THEN
	RESPONSE #100
		SetGlobal("Iadracoldead","GLOBAL",1)
		TriggerActivation("Trania17",TRUE)
END

IF
	Global("Iadracoldead","GLOBAL",1)
	GlobalTimerExpired("Iacghost","Aria14")
	InMyArea(Player1)
	Global("Iacghost2","ARia14",0)
	Global("Iaghostfled","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Iacghost2","ARia14",1)
		CreateCreatureObject("S!cghos2",Player1,0,0,0)  // Cursed Ghost
END

IF
	Global("Iadracoldead","GLOBAL",1)
	Global("Iaghostfled","GLOBAL",0)
	Global("ghostwent","ARIA14",1)
	Global("Iaexit","ARia14",1)
THEN
	RESPONSE #100
		SetGlobal("Iaexit","ARia14",2)
		TriggerActivation("Trania17",TRUE)
END

IF
	InMyArea(Player1)
	Global("Iafog","ARia14",1)
	OR(7)
		SpellCastPriest(Player1,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
		SpellCastPriest(Player2,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
		SpellCastPriest(Player3,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
		SpellCastPriest(Player4,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
		SpellCastPriest(Player5,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
		SpellCastPriest(Player6,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
		GlobalTimerExpired("FogTimer","ARia14")
THEN
	RESPONSE #100
		SetGlobal("Iafog","ARia14",0)
END

IF
	InMyArea(Player1)
	Global("Iap1highxp","ARia14",0)
	XPGT(Player1,3399999)
THEN
	RESPONSE #100
		SetGlobal("Iap1highxp","ARia14",1)
END

IF
	Global("Iareaction","ARia14",0)
	InMyArea(Player1)
	OR(24)
		SpellCast(Player1,0)
		SpellCastPriest(Player1,0)
		SpellCastInnate(Player1,0)
		SpellCastInnate(Player1,ROGUE_SET_TIME_TRAP)  // SPCL912.SPL (Resist Magic)
		SpellCast(Player2,0)
		SpellCastPriest(Player2,0)
		SpellCastInnate(Player2,0)
		SpellCastInnate(Player2,ROGUE_SET_TIME_TRAP)  // SPCL912.SPL (Resist Magic)
		SpellCast(Player3,0)
		SpellCastPriest(Player3,0)
		SpellCastInnate(Player3,0)
		SpellCastInnate(Player3,ROGUE_SET_TIME_TRAP)  // SPCL912.SPL (Resist Magic)
		SpellCast(Player4,0)
		SpellCastPriest(Player4,0)
		SpellCastInnate(Player4,0)
		SpellCastInnate(Player4,ROGUE_SET_TIME_TRAP)  // SPCL912.SPL (Resist Magic)
		SpellCast(Player5,0)
		SpellCastPriest(Player5,0)
		SpellCastInnate(Player5,0)
		SpellCastInnate(Player5,ROGUE_SET_TIME_TRAP)  // SPCL912.SPL (Resist Magic)
		SpellCast(Player6,0)
		SpellCastPriest(Player6,0)
		SpellCastInnate(Player6,0)
		SpellCastInnate(Player6,ROGUE_SET_TIME_TRAP)  // SPCL912.SPL (Resist Magic)
THEN
	RESPONSE #100
		SetGlobal("Iareaction","ARia14",1)
END

IF
	InMyArea(Player1)
	StateCheck(Player1,STATE_SILENCED)
	OR(3)
		Class(Player1,MAGE_ALL)
		Class(Player1,BARD_ALL)
		CheckStat(Player1,1,SCRIPTINGSTATE16)
	Global("Iadisabled1","ARia14",0)
THEN
	RESPONSE #100
		SetGlobal("Iadisabled1","ARia14",1)
		ActionOverride(Player1,ReallyForceSpellRES("spwii44",Myself))  // No such index
END

