        target = 1
        parameter1 = %race_val%
        parameter2 = 4
        resist_dispel = 3
        duration = 90
    END
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        opcode = 179
        target = 1
        parameter1 = %race_val%
        parameter2 = 4
        resist_dispel = 3
        duration = 90
    END
  END

