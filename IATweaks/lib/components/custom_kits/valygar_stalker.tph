/// Custom kits: makes Valygar into a Stalker ///

SILENT

COPY_EXISTING ~VALYG8.cre~ ~override~
  WRITE_BYTE  0x23d  18 // constitution
  WRITE_SHORT 0x246 0x4008 // kit

  SPRINT ~opcode_to_delete~ ~233~
  LAUNCH_PATCH_MACRO ~DELETE_CRE_EFFECT~

  // katana
  LPF ~ADD_CRE_EFFECT~ INT_VAR
    opcode = 233
    timing = 9
    parameter1 = 2
    parameter2 = 94
  END

  // dagger
  LPF ~ADD_CRE_EFFECT~ INT_VAR
    opcode = 233
    timing = 9
    parameter1 = 1
    parameter2 = 96
  END

  // single weapon style
  LPF ~ADD_CRE_EFFECT~ INT_VAR
    opcode = 233
    timing = 9
    parameter1 = 2
    parameter2 = 113
  END

  // club
  LPF ~ADD_CRE_EFFECT~ INT_VAR
    opcode = 233
    timing = 9
    parameter1 = 1
    parameter2 = 115
  END

  // dual-wielding
  LPF ~ADD_CRE_EFFECT~ INT_VAR
    opcode = 233
    timing = 9
    parameter1 = 2
    parameter2 = 114
  END

COPY_EXISTING ~VALYG14.cre~ ~override~
  WRITE_BYTE  0x23d  18 // constitution
  WRITE_SHORT 0x246 0x4008 // kit

  SPRINT ~opcode_to_delete~ ~233~
  LAUNCH_PATCH_MACRO ~DELETE_CRE_EFFECT~

  // katana
  LPF ~ADD_CRE_EFFECT~ INT_VAR
    opcode = 233
    timing = 9
    parameter1 = 2
    parameter2 = 94
  END

  // dagger
  LPF ~ADD_CRE_EFFECT~ INT_VAR
    opcode = 233
    timing = 9
    parameter1 = 1
    parameter2 = 96
  END

  // single weapon style
  LPF ~ADD_CRE_EFFECT~ INT_VAR
    opcode = 233
    timing = 9
    parameter1 = 3
    parameter2 = 113
  END

  // club
  LPF ~ADD_CRE_EFFECT~ INT_VAR
    opcode = 233
    timing = 9
    parameter1 = 2
    parameter2 = 115
  END

  // dual-wielding
  LPF ~ADD_CRE_EFFECT~ INT_VAR
    opcode = 233
    timing = 9
    parameter1 = 2
    parameter2 = 114
  END

COPY_EXISTING ~valyg8.cre~ ~Override/valyg9.cre~

COPY_EXISTING ~valyg8.cre~ ~Override/valyg11.cre~

COPY_EXISTING ~valyg8.cre~ ~Override/valyg12.cre~
