IF
    HaveSpell(CLERIC_ZONE_OF_SWEET_AIR)
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_STUNNED)
	!CheckStatGT(Myself,50,SPELLFAILUREPRIEST)
	InMyArea(Player1)
	Global("Iapccloud","MYAREA",1)
THEN
	RESPONSE #100
		SetGlobal("Iapccloud","MYAREA",0)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		RemoveSpell(CLERIC_ZONE_OF_SWEET_AIR)
		ForceSpell(Myself,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
END

IF
	HaveSpell(CLERIC_SUMMON_FALLEN_DEVA)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	See(NearestEnemyOf(Myself))
	!Range(LastSeenBy(Myself),3)
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(Myself,CLERIC_SUMMON_FALLEN_DEVA)  // SPPR727.SPL (Summon Fallen Deva)
END

IF
	HaveSpell(CLERIC_CURE_DISEASE)
	OR(2)
	    CheckSpellState(Myself,DEAFENED)
	    StateCheck(Myself,STATE_BLIND)
	!GlobalTimerNotExpired("IaAction","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",ONE_MINUTE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpell(Myself,CLERIC_CURE_DISEASE)  // SPPR317.SPL (Cure Disease)
END

IF
    HaveSpellRES("SPPRI02")
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaRemoveMagicWait","LOCALS")
	Allegiance(Myself,ENEMY)
	See(SixthNearest([PC]))
    CheckStatGT(SixthNearest([PC]),15,DISPELLABLEBUFFSPOWER)
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	TriggerOverride(SixthNearest([PC]), Range([PC], 15))
	TriggerOverride(SixthNearest([PC]), CheckStatGT([PC],5,DISPELLABLEBUFFSPOWER))
	!TriggerOverride(SixthNearest([PC]), CheckStat([PC],1,SCRIPTINGSTATE7))
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaRemoveMagicWait","LOCALS",12)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		SpellRES("SPPRI02",LastSeenBy(Myself))  // Dispel Magic
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #0
	    Continue()
END
