COPY_EXISTING ~SPPR615.spl~ ~override~
  SAY UNIDENTIFIED_DESC @6265

// Make all spells that have casting time of 0, have -10 casting time to prevent them not firing immediately, when silenced

COPY_EXISTING_REGEXP GLOB ~.*\.SPL~ ~override~
  LPF ~S!ALTER_SPELL_HEADER~
    INT_VAR 
      match_speed = 0
      speed = ~-10~
  END

// Rework Grave Silence

COPY_EXISTING ~SPINI39.spl~ ~override~
  LPF ~S!ALTER_EFFECT~
    INT_VAR
      savingthrow = 1
      savebonus = ~-10~
  END
  LPF ~ALTER_SPELL_EFFECT~
    INT_VAR
      duration_high = 30
  END

// Rework Sense of Limbo

LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~CLERIC_SENSE_OF_LIMBO~ RET sense_of_limbo_spell_res = spell_res END

COPY_EXISTING ~%sense_of_limbo_spell_res%.spl~ ~override~
  SAY UNIDENTIFIED_DESC @6266
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      target = 1
      speed = 7
  END
  LPF ~ALTER_SPELL_EFFECT~
    INT_VAR
      target = 2
      duration_high = 30
    END
  PATCH_FOR_EACH silence_spell IN ~SPIN692~ ~SPIN998~ ~SPINI39~ ~SPINI78~ ~SPPR211~ ~SPPR988~ ~SPWI052~ ~SPWI612~ ~SPWISH35~ BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 321
      STR_VAR
        insert = ~below~
        resource = EVAL ~%silence_spell%~
    END
  END
  LPF ~CLONE_EFFECT~
    INT_VAR
      multi_match = 1
      match_opcode = 240
      parameter2 = 105
  END
  LPF ~S!CLONE_EFFECT~
    INT_VAR
      multi_match = 1
      match_opcode = 240
      opcode = 337
      parameter1 = ~-1~
      parameter2 = 60
  END
  LPF ~CLONE_EFFECT~
    INT_VAR
      multi_match = 1
      match_opcode = 169
      parameter2 = 105
  END

// Firkraag

COPY_EXISTING ~FIRKRA02.cre~ ~override~

  REMOVE_MEMORIZED_SPELLS

  ADD_MEMORIZED_SPELL "SPWI302" #2 "wizard" ( 3 ) // Remove Magic
  ADD_MEMORIZED_SPELL "SPWI513" #4 "wizard" ( 5 ) // Breach
  ADD_MEMORIZED_SPELL "SPWI514" #4 "wizard" ( 3 ) // Lower Resistance
  ADD_MEMORIZED_SPELL "SPWI605" #5 "wizard" ( 2 ) // Death Spell
  ADD_MEMORIZED_SPELL "SPWI704" #6 "wizard" ( 5 ) // Ruby Ray of Reversal
  ADD_MEMORIZED_SPELL "SPWI812" #7 "wizard" ( 1 ) // Abi-Dalzim's Horrid Wilting
  ADD_MEMORIZED_SPELL "SPWII40" #0 "innate" ( 3 ) // Improved Fireball

  ADD_MEMORIZED_SPELL ~SPIN692~ #0 ~innate~ ( 4 ) // Greater Silence

COMPILE ~IATweaks\scripts\controversial\DRAGRED.BAF~

// Black Dragon fom Sulda

COPY_EXISTING ~DRAGBLAC.cre~ ~override~

  REMOVE_MEMORIZED_SPELLS

  ADD_MEMORIZED_SPELL "SPWI302" #2 "wizard" ( 3 ) // Remove Magic
  ADD_MEMORIZED_SPELL "SPWI513" #4 "wizard" ( 5 ) // Breach
  ADD_MEMORIZED_SPELL "SPWI514" #4 "wizard" ( 3 ) // Lower Resistance
  ADD_MEMORIZED_SPELL "SPWI605" #5 "wizard" ( 3 ) // Death Spell
  ADD_MEMORIZED_SPELL "SPWI704" #6 "wizard" ( 5 ) // Ruby Ray of Reversal
  
  ADD_MEMORIZED_SPELL ~SPIN692~ #0 ~innate~ ( 5 ) // Greater Silence

COMPILE ~IATweaks\scripts\controversial\DRAGBLAC.BAF~