        CheckStatGT(FifthNearest([PC]),3,SCRIPTINGSTATE6)
	OR(2)
        !CheckStatGT(FifthNearest([PC]),2,SCRIPTINGSTATE6)
	    !CheckSpellState(FifthNearest([PC]),PROTECTION_FROM_NORMAL_WEAPONS)
THEN
	RESPONSE #100
		MoveToObject(LastSeenBy(Myself))
END

