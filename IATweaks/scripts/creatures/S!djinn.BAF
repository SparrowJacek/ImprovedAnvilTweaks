IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	ActionListEmpty()
	!StateCheck(Myself,STATE_SILENCED)
	!CheckStatGT(Myself,0,SCRIPTINGSTATE9)
	HaveSpell(WIZARD_SLOW)  // SPWI312.SPL (Slow)
	See(NearestEnemyOf(Myself))
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!StateCheck(LastSeenBy(Myself),STATE_SLOWED)
	CheckStatLT(LastSeenBy(Myself),80,RESISTMAGIC)
	!CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE3)
	!CheckSpellState(LastSeenBy(Myself),SLOW_IMMUNITY)
	!Race(LastSeenBy(Myself),GOLEM)
	!Race(LastSeenBy(Myself),DEMILICH)
	!Race(LastSeenBy(Myself),LICH)
	!Race(LastSeenBy(Myself),RAKSHASA)
	!HasItem("dragring",LastSeenBy(Myself))  // Ring
	!HasItem("S!rngdmn",LastSeenBy(Myself))  // No such index
	!HasItem("S!ring08",LastSeenBy(Myself))  // Edventar's Gift
	!HasItem("s!lich",LastSeenBy(Myself))  // Ring
	!HasItem("S!orcus",LastSeenBy(Myself))  // Skull
	!HasItem("S!gorgit",LastSeenBy(Myself))  // Ring
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		Spell(LastSeenBy(Myself),WIZARD_SLOW)  // SPWI312.SPL (Slow)
END

