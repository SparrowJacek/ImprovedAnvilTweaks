IF
	HaveSpell(CLERIC_CREEPING_DOOM)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	CheckStatLT(Myself,60,SPELLFAILUREPRIEST)
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_POISONED)
	CheckStatLT([PC.0.0.MAGE_ALL],100,RESISTPIERCING)
	CheckStatLT([PC.0.0.MAGE_ALL],30,RESISTMAGIC)
	!CheckSpellState([PC.0.0.MAGE_ALL],SI_CONJURATION)
	TriggerOverride([PC.0.0.MAGE_ALL], Range([PC], 15))
	TriggerOverride([PC.0.0.MAGE_ALL], CheckStatLT([PC],100,RESISTPIERCING))
	TriggerOverride([PC.0.0.MAGE_ALL], CheckStatLT([PC],60,RESISTMAGIC))
	!TriggerOverride([PC.0.0.MAGE_ALL], CheckSpellState([PC],SI_CONJURATION))
	See([PC.0.0.MAGE_ALL])
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE) 
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),CLERIC_CREEPING_DOOM)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #0
	    Continue()
END

