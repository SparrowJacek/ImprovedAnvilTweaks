COPY_EXISTING_REGEXP GLOB ~LU.*\.2da~ ~override~
  COUNT_2DA_COLS ~colcount~
  COUNT_2DA_ROWS ~colcount~ ~rowcount~
  FOR (i = 0; i < ~rowcount~; ++i) BEGIN
    READ_2DA_ENTRY i 1 %colcount% current_val
    PATCH_IF (~%current_val%~ STR_EQ ~AP_SPCLI27~) BEGIN
      SET_2DA_ENTRY i 6 ~colcount~ 3
    END
  END
  BUT_ONLY

// Rework Assassination

COPY_EXISTING ~SPCL916.spl~ ~override~
  SAY UNIDENTIFIED_DESC @6185
  LPF ~ALTER_SPELL_EFFECT~
    INT_VAR
      duration_high = 30
  END
  FOR (i = 1; i <= 15; ++i) BEGIN
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        insert_point = ~-1~
        opcode = 321
        target = 1
        duration = 30
        timing = 3
      STR_VAR
        resource = EVAL ~S!ASSA%i%~
    END
  END
  FOR (i = 15; i >= 1; --i) BEGIN
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        insert_point = 0
        opcode = 321
        target = 1
        timing = 0
      STR_VAR
        resource = EVAL ~S!ASSA%i%~
    END
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      insert_point = ~-1~
      opcode = 326
      parameter1 = 16394 // Assassin
      parameter2 = kit_equals_row
      target = 1
      resist_dispel = 0
      duration = 30
      timing = 0
    STR_VAR
      resource = ~S!ASSA15~
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      insert_point = ~-1~
      opcode = 318
      parameter1 = 16394 // Assassin
      parameter2 = kit_equals_row
      target = 1
      resist_dispel = 0
      timing = 0
    STR_VAR
      resource = ~SPCL916~
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      insert_point = ~-1~
      opcode = 146
      parameter2 = 1
      target = 1
      resist_dispel = 0
      duration = 30
      timing = 0
    STR_VAR
      resource = ~S!ASSA10~
  END

