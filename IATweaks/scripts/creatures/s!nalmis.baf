IF
	See([PC])
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!GlobalTimerNotExpired("IaCharm","LOCALS")
	!CheckSpellState(LastSeenBy(Myself),CHARM_DOMINATION_IMMUNITY)
THEN
	RESPONSE #100
		SetGlobalTimer("IaCharm","LOCALS",TWO_MINUTES)
		SpellNoDec(LastSeenBy(Myself),NALMISSRA_CHARM)  // SPIN553.SPL (Charm Person)
	RESPONSE #100
	    Continue()
END

