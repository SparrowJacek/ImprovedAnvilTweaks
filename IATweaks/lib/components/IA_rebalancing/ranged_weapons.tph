COPY ~IATweaks\resources\eff\s!strdmg.eff~ ~override~

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
// Patch all bows to use (short)bow proficiency
  READ_LONG 0x08 unidentified_name
  READ_SHORT 0x1c item_category
  READ_BYTE 0x31 proficiency_type
  PATCH_IF (proficiency_type = 104) BEGIN WRITE_BYTE 0x31 105 END

  SET num_patched = 0
  GET_OFFSET_ARRAY headers ITM_V10_HEADERS
  PHP_EACH headers AS header_id => head_off BEGIN
    READ_BYTE head_off header_type
    READ_BYTE head_off + 0x10 launcher_required

    PATCH_IF (((header_type = 2 AND launcher_required = 0) OR header_type = 4) AND num_patched = 0) BEGIN
      SET num_patched = num_patched + 1
      LPF ~ADD_ITEM_EQEFFECT~
        INT_VAR
          opcode = 321
          target = 1
          timing = 0
        STR_VAR
          resource = ~S!-THCXB~
      END
      // Remove any bonuses to strength
      
      WRITE_BYTE head_off + 0x26 (THIS BAND 0b11111010) // CHECK PROPER OFFSET!!!!!!!!!!!!!!!!!!
      // Grant Ranged Weapon Style bonuses
      FOR (i=0;i<4;++i) BEGIN
        LPF ~ADD_ITEM_EQEFFECT~ 
          INT_VAR
            insert_point = ~-1~
            opcode = 318
            target = 1
            parameter1 = i * 8
            parameter2 = %ranged_style_equal_row%
            timing = 2
          STR_VAR
            resource = "S!RNGBON"
        END
      END
      LPF ~ADD_ITEM_EQEFFECT~ 
        INT_VAR
          insert_point = ~-1~
          opcode = 177
          target = 1
          parameter2 = 2
          timing = 2
        STR_VAR
          resource = "S!RNGTHC"
      END
      LPF ~ADD_ITEM_EQEFFECT~ 
        INT_VAR
          insert_point = ~-1~
          opcode = 318
          target = 1
          parameter1 = 3
          parameter2 = %ranged_style_bit_nand%
          timing = 2
        STR_VAR
          resource = "S!RNGBON"
      END
      LPF ~ADD_ITEM_EQEFFECT~ 
        INT_VAR
          insert_point = ~-1~
          opcode = 177
          target = 1
          parameter2 = 2
          timing = 2
        STR_VAR
          resource = "S!RNGDMG"
      END
      // Bonus Dmg from stats
      PATCH_IF (proficiency_type = 103 OR proficiency_type = 104 OR proficiency_type = 105 OR proficiency_type = 106) BEGIN
        LPF ~ADD_ITEM_EQEFFECT~ 
          INT_VAR
            insert_point = ~-1~
            opcode = 146
            target = 1
            parameter2 = 1
            duration = 0
          STR_VAR
            resource = "S!DEXDMG"
        END
        LPF ~ADD_ITEM_EQEFFECT~ 
          INT_VAR
            insert_point = ~-1~
            opcode = 272
            target = 1
            parameter1 = 1
            parameter2 = 2
            timing = 2
          STR_VAR
            resource = "S!DEXDMG"
        END
      END
      // Str for all else
      ELSE BEGIN
        LPF ~ADD_ITEM_EQEFFECT~ 
          INT_VAR
            insert_point = ~-1~
            opcode = 146
            target = 1
            parameter2 = 1
            duration = 0
          STR_VAR
            resource = "S!STRDMG"
        END
        LPF ~ADD_ITEM_EQEFFECT~ 
          INT_VAR
            insert_point = ~-1~
            opcode = 272
            target = 1
            parameter1 = 1
            parameter2 = 2
            timing = 2
          STR_VAR
            resource = "S!STRDMG"
        END
      END
      PATCH_IF (unidentified_name = 6881 AND item_category = 27) BEGIN // light crossbow
        LPF ~ADD_ITEM_EQEFFECT~ // AC penalty
          INT_VAR
            insert_point = ~-1~
            opcode = 0
            target = 1
            parameter1 = 1
            timing = 2
        END
        LPF ~S!ALTER_EFFECT~ // AC penalty
          INT_VAR
            match_opcode = 0
            match_target = 1
            match_parameter1 = 1
            match_timing = 2
            parameter1 = ~-1~
        END
      END
      PATCH_IF (unidentified_name = 6873 AND item_category = 27) BEGIN // heavy crossbow
        LPF ~ADD_ITEM_EQEFFECT~ // - lack of thac0 bonuses from dexterity
          INT_VAR
            insert_point = ~-1~
            opcode = 146
            target = 1
            parameter2 = 1
            duration = 0
          STR_VAR
            resource = "S!-THCXB"
        END
        LPF ~ADD_ITEM_EQEFFECT~ 
          INT_VAR
            insert_point = ~-1~
            opcode = 272
            target = 1
            parameter1 = 1
            parameter2 = 2
            timing = 2
          STR_VAR
            resource = "S!-THCXB"
        END
        LPF ~ADD_ITEM_EQEFFECT~ // AC penalty
          INT_VAR
            insert_point = ~-1~
            opcode = 0
            target = 1
            parameter1 = 1
            timing = 2
        END
        LPF ~S!ALTER_EFFECT~ // AC penalty
          INT_VAR
            match_opcode = 0
            match_target = 1
            match_parameter1 = 1
            match_timing = 2
            parameter1 = ~-2~
        END
        LPF ~ADD_ITEM_EQEFFECT~ // critical hit bonus
          INT_VAR
            insert_point = ~-1~
            opcode = 301
            target = 1
            parameter1 = 2
            parameter2 = 1
            timing = 2
        END
      END
    END
  END

