		Enemy()
END

IF
	Allegiance(Myself,ENEMY)
	Global("partyfled","LOCALS",0)
	InMyArea(Player1)
	!Detect([PC])
	!Detect([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",1)
END

IF
	Allegiance(Myself,ENEMY)
	Global("partyfled","LOCALS",1)
	InMyArea(Player1)
	!Detect([PC])
	!Detect([GOODCUTOFF])
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

