IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("IaPrep","LOCALS",1)
		ReallyForceSpell(Myself,WARRIOR_HARDINESS)
		ReallyForceSpellRES("SPPR101",Myself)  // Bless
		ReallyForceSpellRES("SPPR108",Myself)  // Remove Fear
		ReallyForceSpellRES("SPPR111",Myself)  // Armor of Faith
		ReallyForceSpellRES("SPPR202",Myself) //  Barkskin
		ReallyForceSpellRES("SPPR206",Myself)  // Flame Blade
		ReallyForceSpellRES("SPPR306",Myself)
		ReallyForceSpellRES("SPPR403",Myself)  // Free Action
		ReallyForceSpellRES("SPPR407",Myself)  // Protection From Lightning
		ReallyForceSpellRES("SPPR409",Myself)  // Death Ward
		ReallyForceSpellRES("SPPR418",Myself)
		ReallyForceSpellRES("SPPR505",Myself) //  True Seeing
		ReallyForceSpellRES("SPPR506",Myself)  // Iron Skins
		ReallyForceSpellRES("SPPR508",Myself)  // Chaotic Commands
		ReallyForceSpellRES("SPPR509",Myself)  // Magic Resistance
		ReallyForceSpellRES("SPPR613",Myself)  // Protection From Missiles
		ReallyForceSpellRES("SPPR701",Myself)  // Shield of the Archons
		RemoveSpellRES("SPPR101")  // Bless
		RemoveSpellRES("SPPR108")  // Remove Fear
		RemoveSpellRES("SPPR111")  // Armor of Faith
		RemoveSpellRES("SPPR202")
		RemoveSpellRES("SPPR206")  // Flame Blade
		RemoveSpellRES("SPPR306")
		RemoveSpellRES("SPPR403")  // Free Action
		RemoveSpellRES("SPPR407")  // Protection From Lightning
		RemoveSpellRES("SPPR409")  // Death Ward
		RemoveSpellRES("SPPR418")
		RemoveSpellRES("SPPR505")
		RemoveSpellRES("SPPR506")  // Iron Skins
		RemoveSpellRES("SPPR508")  // Chaotic Commands
		RemoveSpellRES("SPPR509")  // Magic Resistance
		RemoveSpellRES("SPPR613")  // Protection From Missiles
		RemoveSpellRES("SPPR701")  // Shield of the Archons
		SetInterrupt(TRUE)
END

