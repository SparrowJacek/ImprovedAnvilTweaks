IF
	HaveSpellRES("SPCL321")
	!CheckSpellState(Myself,BERSERKER_RAGE_FATIGUE) 
	!CheckSpellState(Myself,BERSERKER_RAGE) 
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaBreakCharge","LOCALS")
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SpellRES("SPCL321",Myself)  // Enrage
	RESPONSE #0
	    Continue()
END

IF
	!GlobalTimerNotExpired("IaBreakCharge","LOCALS")
	See(FarthestEnemyOf(Myself))
	!Range(LastSeenBy(Myself),10)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaNextCharge","LOCALS")
	CheckStatLT(LastSeenBy(Myself),100,RESISTCRUSHING)
THEN
	RESPONSE #100
		SetGlobal("IaCharge","LOCALS",1)
		SetGlobalTimer("IaBreakCharge","LOCALS",3)
		SetGlobalTimerRandom("IaNextCharge","LOCALS",8,13)
		ReallyForceSpellRES("S!CHARG4",LastSeenBy(Myself))
		ReallyForceSpellRES("S!CHARG1",Myself)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SpellNoDecRES("S!CHARG3",LastSeenBy(Myself))
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!CHARG6",Myself)
		ReallyForceSpellRES("S!CHARG5",LastSeenBy(Myself))
		SetGlobalTimer("IaBreakCharge","LOCALS",0)
	RESPONSE #0
	    Continue()
END

