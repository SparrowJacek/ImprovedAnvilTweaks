IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		ReallyForceSpellRES("SPPR418",Myself) //  Acid Shield
		Continue()
END


IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
END


IF
	!See(NearestEnemyOf(Myself))
	Heard([EVILCUTOFF],151)
	InMyArea(Player1)
THEN
	RESPONSE #100
		SetGlobal("Iashoutonce","LOCALS",1)
		MoveToObject(LastHeardBy(Myself))
END

IF
	Global("Iashoutonce","LOCALS",0)
	Global("Iapcastts","GLOBAL",0)
	See([GOODCUTOFF])
	Allegiance(Myself,ENEMY)
	ActionListEmpty()
THEN
	RESPONSE #100
		SetGlobal("Iashoutonce","LOCALS",1)
		GlobalShout(151)
END


IF
	HaveSpellRES("SPCL922")
	See(NearestEnemyOf(Myself))
	HPPercentLT(Myself,80)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaContactWithNature","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaContactWithNature","LOCALS",ONE_TURN)
		ForceSpellRES("SPCL922",Myself)
		RemoveSpellRES("SPCL922")
	RESPONSE #0
		Continue()
END


IF
	!GlobalTimerNotExpired("IaRunAway","LOCALS")
	Range(NearestEnemyOf(Myself),5)
	!CheckSpellState(Myself,HIDE_IN_SHADOWS_SUCCESS)
	!CheckSpellState(Myself,HIDE_IN_SHADOWS_FAIL)
	!StateCheck(Myself,STATE_INVISIBLE)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	OR(2)
		HitBy([ANYONE],CRUSHING)
		HPPercentLT(Myself,75)
THEN
	RESPONSE #100
		ForceSpellRES("S!HISBAS",Myself)  // No such index
END

IF
	Range(NearestEnemyOf(Myself),5)
	CanEquipRanged()
	!CheckSpellState(Myself,HIDE_IN_SHADOWS_SUCCESS)
	!CheckSpellState(Myself,HIDE_IN_SHADOWS_FAIL)
	!StateCheck(Myself,STATE_INVISIBLE)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	OR(2)
		HitBy([ANYONE],CRUSHING)
		HPPercentLT(Myself,40)
THEN
	RESPONSE #100
		SetGlobalTimer("IaRunAway","LOCALS",0)
		ForceSpellRES("S!HISBAS",Myself)  // No such index
END


IF
	!StateCheck(NearestEnemyOf(Myself),STATE_INVISIBLE)
	Range(NearestEnemyOf(Myself),5)
	OR(2)
		HitBy([ANYONE],CRUSHING)
		HPPercentLT(Myself,75)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	HasItem("POTN10",Myself)  // Potion of Invisibility
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaRunAway","LOCALS",0)
		UseItem("POTN10",Myself)  // Potion of Invisibility
END


IF
	Allegiance(Myself,ENEMY)
	HaveSpell(WARRIOR_HARDINESS)
	!CheckSpellState(Myself,HARDINESS)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	OR(3)
	    See(ThirdNearestEnemyOf(Myself))
	    See(SecondNearestEnemyOf(Myself))
	    See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ForceSpell(Myself,WARRIOR_HARDINESS)  // SPCL907.SPL (Hardiness)
		RemoveSpell(WARRIOR_HARDINESS)
END


IF
	Range(NearestEnemyOf(Myself),5)
	!StateCheck(NearestEnemyOf(Myself),STATE_HARMLESS)
	!CheckStatGT(NearestEnemyOf(Myself),0,HELD)
	StateCheck(Myself,STATE_INVISIBLE)
	OR(2)
		StateCheck(Myself,STATE_HASTED)
		!CheckStat(Myself,0,IMPROVEDHASTE)
	!GlobalTimerNotExpired("IaRunAway","LOCALS")
	CanEquipRanged()
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRunAway","LOCALS",10)
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),60)
		SetInterrupt(TRUE)
END

