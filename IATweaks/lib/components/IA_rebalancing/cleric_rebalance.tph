LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~PRST_SPELL_DURATION<n~
    stat                  = ~54~
    value                 = ~-1~
    relation              = ~2~
  RET
    prst_spell_duration_less_than = new_line_number
END

COPY ~IATweaks\resources\spl\s!lifeli.spl~ ~override~
  SAY NAME1 @6121
  SAY UNIDENTIFIED_DESC @6122
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 142
      parameter2 = %life_link_icon_id%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 328
      parameter2 = %life_link_state%
  END
  FOR (i = 29; i > 0; --i) BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 146
        match_duration = 0
        timing = 3
        duration = i * 2
      STR_VAR
        insert = ~below~
    END
  END
  LPF ~ADD_SPELL_EFFECT~ 
    INT_VAR
      insert_point = ~-1~
      opcode = 318
      target = 1
      parameter1 = 120
      parameter2 = prst_spell_duration_less_than
      resist_dispel = 0
      timing = 0
      duration = 0
      power = 6
    STR_VAR
      resource = ~S!LIFELI~
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 139
      parameter1 = RESOLVE_STR_REF (@6208)
  END
  FOR (i = 30; i < 36; ++i) BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 146
        match_duration = 0
        timing = 3
        duration = i * 2
      STR_VAR
        insert = ~last~
    END
  END
  LPF ~ADD_SPELL_EFFECT~ 
    INT_VAR
      insert_point = ~-1~
      opcode = 318
      target = 1
      parameter1 = 150
      parameter2 = prst_spell_duration_less_than
      resist_dispel = 0
      timing = 0
      duration = 0
      power = 6
    STR_VAR
      resource = ~S!LIFELI~
  END
  FOR (i = 36; i < 45; ++i) BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 146
        match_duration = 0
        timing = 3
        duration = i * 2
      STR_VAR
        insert = ~last~
    END
  END

