////////// Reworked Improved Haste and Whirlwind Attack ////////////

ACTION_FOR_EACH improved_haste_spell IN ~SPINI33~ ~SPINI88~ ~SPWI613~ ~S!CHMPMZ~ ~SPWISH36~ ~SPWISH37~ ~SPWISH40~ BEGIN
  COPY_EXISTING ~%improved_haste_spell%.spl~ ~override~
    LPF ~S!SPELL_USES_OPCODE~
      INT_VAR
        match_opcode = 16
      RET
        opcode_target
    END
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 16
        parameter2 = 0
        silent = 1
    END
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 317
        parameter2 = 0
        silent = 1
    END
    LPF ~CLONE_EFFECT~ 
      INT_VAR
        match_opcode = 16
        opcode = 1
        parameter1 = 1
        parameter2 = 0
        silent = 1
    END
    LPF ~CLONE_EFFECT~ 
      INT_VAR
        match_opcode = 317
        opcode = 1
        parameter1 = 1
        parameter2 = 0
        silent = 1
    END
    PATCH_FOR_EACH improved_haste_spell_to_delete IN ~SPINI33~ ~SPINI88~ ~SPWI613~ ~S!CHMPMZ~ ~SPWISH36~ ~SPWISH37~ ~SPWISH40~ BEGIN
      LPF ~ADD_SPELL_EFFECT~ 
        INT_VAR
          opcode = 321
          insert_point = 0
          target = EVAL ~%opcode_target%~
          resist_dispel = 0
        STR_VAR
          resource = EVAL ~%improved_haste_spell_to_delete%~
      END
    END
  BUT_ONLY
  IF_EXISTS
END

