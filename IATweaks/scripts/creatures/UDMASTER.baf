IF
	See([PC])
	Global("doOnce","LOCALS",0)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("doOnce","LOCALS",1)
		SetInterrupt(FALSE)
		DisplayStringHead(Myself,62033)  // The reek of chemicals and fermented brain overwhelms you as you step into sight of the famed elder brain of the illithids. An instant later, the brain lashes out at you with a psionic whip...
		Wait(1)
		ReallyForceSpell(LastSeenBy(Myself),PSIONIC_EGOWHIP)  // SPIN909.SPL (Ego Whip)
		SetInterrupt(TRUE)
END

IF
	Global("Iacreature","AR2400",0)  // Mind Flayers in Underdark
	Global("Iasummon","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iacreature","AR2400",1)  // Mind Flayers in Underdark
END

IF
	See([PC])
	Global("firstspawn","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("firstspawn","LOCALS",1)
		CreateCreature("MINDUL01",[655.690],E)
		CreateCreature("MINDFL01",[388.964],E)
		CreateVisualEffect("SPROTECT",[728.711])
		CreateCreature("udgolem",[728.711],E)  // Brain Golem
		CreateVisualEffect("SPROTECT",[501.905])
		CreateCreature("udgolem",[501.905],E)  // Brain Golem
		CreateVisualEffect("SPROTECT",[661.813])
		CreateCreature("udgolem",[661.813],E)  // Brain Golem
END

IF
	See([PC])
	!See(ThirdNearest([ENEMY.0.GOLEM]))
	Global("firstspawn","LOCALS",1)
	GlobalLT("IaBrainGolems","LOCALS",5)
THEN
	RESPONSE #100
		IncrementGlobal("IaBrainGolems","LOCALS",1)
		CreateVisualEffect("SPROTECT",[728.711])
		CreateCreature("udgolem",[728.711],E)  // Brain Golem
	RESPONSE #100
		IncrementGlobal("IaBrainGolems","LOCALS",1)
		CreateVisualEffect("SPROTECT",[501.905])
		CreateCreature("udgolem",[501.905],E)  // Brain Golem
	RESPONSE #100
		IncrementGlobal("IaBrainGolems","LOCALS",1)
		CreateVisualEffect("SPROTECT",[661.813])
		CreateCreature("udgolem",[661.813],E)  // Brain Golem
END

IF
	Allegiance(Myself,ENEMY)
	GlobalGT("IaBrainGolems","LOCALS",4)
	HasItem("surehp1",Myself)  // No such index
THEN
	RESPONSE #100
		DestroyItem("surehp1")  // No such index
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!GlobalTimerNotExpired("Iapurge","LOCALS")
	!HPLT(Myself,1)
	See([PC])
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	CheckStatGT(LastSeenBy(Myself),3,DISPELLABLEBUFFSPOWER)
THEN
	RESPONSE #100
		SetGlobalTimer("Iapurge","LOCALS",SIX_ROUNDS)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("SPINI29",LastSeenBy(Myself))  // Purge Magic
END

