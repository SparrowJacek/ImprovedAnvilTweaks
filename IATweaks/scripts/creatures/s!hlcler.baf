IF
    HaveSpellRES("SPPRI02")
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaRemoveMagicWait","LOCALS")
	Allegiance(Myself,ENEMY)
	See(SixthNearest([PC]))
    CheckStatGT(SixthNearest([PC]),15,DISPELLABLEBUFFSPOWER)
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	TriggerOverride(SixthNearest([PC]), Range([PC], 15))
	TriggerOverride(SixthNearest([PC]), CheckStatGT([PC],5,DISPELLABLEBUFFSPOWER))
	!TriggerOverride(SixthNearest([PC]), CheckStat([PC],1,SCRIPTINGSTATE7))
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaRemoveMagicWait","LOCALS",12)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		SpellRES("SPPRI02",LastSeenBy(Myself))  // Dispel Magic
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #0
	    Continue()
END
