IF
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
    !GlobalTimerNotExpired("IaAcidCircle","LOCALS")
	Range(ThirdNearest([PC]),15)
	OR(2)
	    CheckStatLT([PC],50,RESISTACID)
	    CheckStatLT(SecondNearest([PC]),50,RESISTACID)
	OR(2)
	    CheckStatLT([PC],50,RESISTACID)
	    CheckStatLT(ThirdNearest([PC]),50,RESISTACID)
	OR(2)
	    CheckStatLT(SecondNearest([PC]),50,RESISTACID)
	    CheckStatLT(ThirdNearest([PC]),50,RESISTACID)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaAcidCircle","LOCALS",12)
		SpellRES("S!ACIDCI", Myself)
END
IF
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
    !GlobalTimerNotExpired("IaPoison","LOCALS")
	!StateCheck(Player1,STATE_POISONED)
    CheckStatGT(Player1,4,SAVEVSDEATH)
	OR(2)
	    CheckStatGT(Player1,8,SAVEVSDEATH)
	    !StateCheck(Player1,STATE_IMPROVEDINVISIBILITY)
	!CheckSpellState(Player1,POISON_EFFECT_IMMUNITY)
	!CheckStat(Player1,5,SCRIPTINGSTATE7)
	!ImmuneToSpellLevel(Player1,4)
    !CheckSpellState(Player1,WIZARD_SPELL_TURNING)
	!StateCheck(Player1,STATE_MIRRORIMAGE)
	!StateCheck(Player1,STATE_HARMLESS)
	CheckStatLT(Player1,60,RESISTPOISON)
	CheckStatLT(Player1,20,RESISTMAGIC)
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaPoison","LOCALS",13)
		ForceSpell(Player1,CLERIC_POISON)  // SPPR411.SPL (Poison)
	RESPONSE #150
	    Continue()
END
