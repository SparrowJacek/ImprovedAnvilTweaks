    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 59
        target = 1
        parameter1 = 40
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~S!40SS~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 275
        target = 1
        parameter1 = 40
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~S!40HIS~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 144
        target = 1
        timing = 9
      STR_VAR
        effsource = ~S!DISSTE~
    END
END

