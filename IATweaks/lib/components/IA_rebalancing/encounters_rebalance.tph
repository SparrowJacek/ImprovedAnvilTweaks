  READ_LONG 0x64 headers_offset
  WRITE_BYTE (headers_offset + 0x18) (THIS - 1)
  WRITE_BYTE (headers_offset + 0x1a) (THIS + 1)
  PATCH_FOR_EACH spl_to_dispel IN ~SPPR413~ ~SPIN738~ ~SPPR403~ BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 221
        opcode = 321
        parameter1 = 0
        parameter2 = 0
      STR_VAR
        insert = ~above~
        resource = EVAL ~%spl_to_dispel%~
    END
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 221
      match_parameter2 = 2
  END
  LPF ~ADD_ITEM_EFFECT~
    INT_VAR
      type = 1
      opcode = 12
      insert_point = 0
      target = 2
      timing = 9
      dicenumber = 1
      dicesize = 8
      special = 1 // Drain HP
  END

