	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRemoveMagicWait","LOCALS",24)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		RemoveSpell(WIZARD_REMOVE_MAGIC)
		ForceSpell(LastSeenBy(Myself),WIZARD_REMOVE_MAGIC)  // SPWI302.SPL (Remove Magic)
		SetInterrupt(TRUE)
	RESPONSE #100
	    Continue()
END

