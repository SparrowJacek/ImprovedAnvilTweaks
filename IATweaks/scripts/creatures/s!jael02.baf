	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	See([PC])
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	!StateCheck(LastSeenBy(Myself),STATE_IMMOBILE)
	CheckStatLT(LastSeenBy(Myself),60,RESISTMAGIC)
	CheckStatGT([PC],1,SAVEVSSPELL)
	!CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE5)
	!CheckSpellState(LastSeenBy(Myself),SI_CONJURATION)
	!CheckSpellState(LastSeenBy(Myself),PARALYZE_IMMUNITY)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE3)
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ForceSpellRES("S!SEEAOE",Myself)
		SpellRES("SPDR201",LastSeenBy(Myself))  // Web
	RESPONSE #100
	    Continue()
END
