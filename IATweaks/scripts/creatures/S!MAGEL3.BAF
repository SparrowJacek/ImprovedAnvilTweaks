IF
	AreaCheck("AR1100")  // Umar Hills
	GlobalGT("Iaswanmejob","GLOBAL",6)
	Global("Iasuicide","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iasuicide","LOCALS",1)
		DestroySelf()
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	Detect([PC])
	Global("Iatimer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobal("Iatimer","LOCALS",1)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("Iafissureplayer1","LOCALS",0)
		SetGlobal("Iafissureplayer2","LOCALS",0)
		SetGlobal("Iafissureplayer3","LOCALS",0)
		SetGlobal("Iafissureplayer4","LOCALS",0)
		SetGlobal("Iafissureplayer5","LOCALS",0)
		SetGlobal("Iafissureplayer6","LOCALS",0)
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!HPLT(Myself,1)
	See(Player1)
	CheckStatLT(Player1,90,RESISTFIRE)
	CheckStatLT(Player2,90,RESISTFIRE)
	TriggerOverride(Player1, Range(Player2, 10))
THEN
	RESPONSE #100
		IncrementGlobal("Iafissureplayer1","LOCALS",1)
		Continue()
END

