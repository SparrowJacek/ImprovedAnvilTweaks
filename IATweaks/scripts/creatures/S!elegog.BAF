IF
	AreaCheck("AR4500")  // Pocket Plane
	GlobalGT("Iaepicbattle","AR4500",2)  // Pocket Plane
	Global("Iasuicide","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iasuicide","LOCALS",1)
		DestroySelf()
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	AreaCheck("AR4500")  // Pocket Plane
	GlobalGT("Iapasha","AR4500",0)  // Pocket Plane
	Exists("S!pasha2")  // Pasha Mahmoud
	!Dead("S!pasha2")  // Pasha Mahmoud
	OR(2)
		See("S!pasha2")  // Pasha Mahmoud
		See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Detect([PC])
	Global("EnemySeen","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("EnemySeen","LOCALS",1)
END

IF
	Detect([PC])
	Global("Iatimer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("golemcall","LOCALS",THREE_ROUNDS)
		SetGlobal("Iatimer","LOCALS",1)
END

IF
	Global("IaSpawnElementals1","LOCALS",0)
	HPPercentLT(Myself,75)
THEN
	RESPONSE #25
		ReallyForceSpellRES("S!ELEINF",Myself)
		CreateCreatureObject("S!ICEELG",Myself,0,0,0)
		SetGlobal("IaSpawnElementals1","LOCALS",1)
		ReallyForceSpellRES("S!COLD-5",Myself)
		ReallyForceSpellRES("S!ELEC-5",Myself)
	RESPONSE #25
		ReallyForceSpellRES("S!ELEINF",Myself)
		CreateCreatureObject("S!MAGELG",Myself,0,0,0)
		SetGlobal("IaSpawnElementals1","LOCALS",1)
		ReallyForceSpellRES("S!FIRE-5",Myself)
		ReallyForceSpellRES("S!ACID-5",Myself)
	RESPONSE #25
		ReallyForceSpellRES("S!ELEINF",Myself)
		CreateCreatureObject("S!OOZELG",Myself,0,0,0)
		SetGlobal("IaSpawnElementals1","LOCALS",1)
		ReallyForceSpellRES("S!COLD-5",Myself)
		ReallyForceSpellRES("S!ACID-5",Myself)
	RESPONSE #25
		ReallyForceSpellRES("S!ELEINF",Myself)
		CreateCreatureObject("S!SMOELG",Myself,0,0,0)
		SetGlobal("IaSpawnElementals1","LOCALS",1)
		ReallyForceSpellRES("S!ELEC-5",Myself)
		ReallyForceSpellRES("S!FIRE-5",Myself)
END

