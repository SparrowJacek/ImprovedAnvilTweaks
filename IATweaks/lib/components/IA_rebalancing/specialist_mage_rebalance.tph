    STR_VAR
      match_opcode = 189 // Casting Speed
      parameter1 = 3
  END

  LPF ~ADD_CRE_EFFECT~ // Add ENEMY_GROUP spellstate
    INT_VAR
      target = 1
      opcode = 328
      parameter1 = 0
      parameter2 = enemy_group_state
      resist_dispel = 0
      timing = 9
      special = 1
  END
  
  LPF ~ADD_CRE_EFFECT~ // Set persistent AI
    INT_VAR
      target = 1
      opcode = 293
      parameter2 = 1
      resist_dispel = 0
      timing = 9
  END

  LPF ~DELETE_CRE_ITEM~
    STR_VAR
      item_to_delete = ~S!IMMUNE~
  END

COMPILE ~IATweaks\scripts\creatures\S!KAOL1.BAF~

