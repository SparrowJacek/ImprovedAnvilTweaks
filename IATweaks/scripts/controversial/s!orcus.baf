
IF
	Detect(NearestEnemyOf(Myself))
	Global("Iacutscene","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iacutscene","LOCALS",1)
		ClearAllActions()
		StartCutSceneMode()
		StartCutScene("S!cutor")
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
	    SetGlobal("IaPrep","LOCALS",1)
	    SetGlobal("IaSilenc","LOCALS",2)
	    ReallyForceSpellRES("S!CNT03A",Myself)
	    ReallyForceSpellRES("S!ORCU1A",Myself)
	    ReallyForceSpellRES("S!ORCU2A",Myself)
	    ReallyForceSpellRES("S!ORCU3A",Myself)
		ReallyForceSpell(Myself,PROTECTION_MAGIC_WEAPON_NOEFF)  // SPIN686.SPL (Protection From Magical Weapons)
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Iamintimeset","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iamintimeset","LOCALS",1)
		SetGlobalTimer("IaRemainingGrandlords","LOCALS",TWO_ROUNDS)
		SetGlobalTimer("Iaminions","LOCALS",THREE_ROUNDS)
END

IF
	Allegiance(Myself,ENEMY)
	!HasItem("S!minhp1",Myself)  // No such index
	See(NearestEnemyOf(Myself))
	Global("IaPrepCanBeKilled","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaPrepCanBeKilled","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("SPWII03",Myself)  // Spell Turning
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iaskelos","AR0802",2)  // Netherscroll, Korgan's Book, Edwin
	HasItem("S!minhp1",Myself)  // No such index
THEN
	RESPONSE #100
		DestroyItem("S!minhp1")  // No such index
END


IF
    ActionListEmpty()
	See(Player1)
THEN
	RESPONSE #100
		SetGlobalTimer("IaChar1SeenTimer","LOCALS",TWO_TURNS)
		SetGlobal("IaChar1Seen","LOCALS",1)
		Continue()
END

