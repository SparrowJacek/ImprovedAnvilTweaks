		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaPoison","LOCALS",13)
		ForceSpell(Player2,CLERIC_POISON)  // SPPR411.SPL (Poison)
	RESPONSE #400
	    Continue()
END

