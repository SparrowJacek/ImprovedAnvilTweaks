	!HasItemEquiped("S!sw11",LastSeenBy(Myself))  // Warlord's blade +5
	Range(LastSeenBy(Myself),4)
	Global("Iaborina02","LOCALS",0)
	!GlobalTimerNotExpired("Iainnate","LOCALS")
THEN
