	Range(NearestEnemyOf(Myself),5)
	GlobalTimerNotExpired("IaAction","LOCALS")
	!StateCheck(NearestEnemyOf(Myself),STATE_HARMLESS)
	!CheckStatGT(NearestEnemyOf(Myself),0,HELD)
	!GlobalTimerNotExpired("IaRunAway","LOCALS")
	CheckStatLT(Myself,5,STONESKINS)
	!CheckStatGT(Myself,0,SCRIPTINGSTATE6)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRunAway","LOCALS",TWO_ROUNDS)
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),40)
		SetInterrupt(TRUE)
END

