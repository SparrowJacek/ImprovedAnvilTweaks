IF
	AreaCheck("AR4500")  // Pocket Plane
	GlobalGT("Iapasha","AR4500",0)  // Pocket Plane
	See([PC])
	Exists("S!pasha2")  // Pasha Mahmoud
	!Dead("S!pasha2")  // Pasha Mahmoud
	See("S!pasha2")  // Pasha Mahmoud
	Range("S!pasha2",2)  // Pasha Mahmoud
	RandomNumLT(6,2)
THEN
	RESPONSE #100
		AttackOneRound("S!pasha2")  // Pasha Mahmoud
		AttackOneRound("S!pasha2")  // Pasha Mahmoud
END

IF
	AreaCheck("AR4500")  // Pocket Plane
	GlobalGT("Iapasha","AR4500",0)  // Pocket Plane
	!See([PC])
	Exists("S!pasha2")  // Pasha Mahmoud
	!Dead("S!pasha2")  // Pasha Mahmoud
	See("S!pasha2")  // Pasha Mahmoud
	RandomNumGT(6,5)
THEN
	RESPONSE #100
		AttackOneRound("S!pasha2")  // Pasha Mahmoud
		AttackOneRound("S!pasha2")  // Pasha Mahmoud
END

IF
	Allegiance(Myself,ENEMY)
	See(SecondNearestEnemyOf(Myself))
	CheckStatLT(LastSeenBy(Myself),90,RESISTCRUSHING)
	!CheckStatGT(LastSeenBy(Myself),2,SCRIPTINGSTATE6)
	RandomNumGT(6,4)
	Range(LastSeenBy(Myself),3)
THEN
	RESPONSE #100
		AttackOneRound(LastSeenBy(Myself))
		AttackOneRound(LastSeenBy(Myself))
END

IF
	AreaCheck("AR4500")  // Pocket Plane
	GlobalGT("Iapasha","AR4500",0)  // Pocket Plane
	!Detect([PC])
	!Detect([GOODCUTOFF])
	Exists("S!pasha2")  // Pasha Mahmoud
	!Dead("S!pasha2")  // Pasha Mahmoud
	!See("S!pasha2")  // Pasha Mahmoud
	Global("partyfled","LOCALS",0)
	Global("EnemySeen","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobalTimer("chase","LOCALS",EIGHTEEN_MINUTES)
		SetGlobal("partyfled","LOCALS",1)
END

IF
	AreaCheck("AR4500")  // Pocket Plane
	GlobalGT("Iapasha","AR4500",0)  // Pocket Plane
	!Detect([PC])
	!Detect([GOODCUTOFF])
	Exists("S!pasha2")  // Pasha Mahmoud
	!Dead("S!pasha2")  // Pasha Mahmoud
	!See("S!pasha2")  // Pasha Mahmoud
	Global("partyfled","LOCALS",1)
	GlobalTimerNotExpired("chase","LOCALS")
	InMyArea(Player1)
	Global("EnemySeen","LOCALS",1)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

