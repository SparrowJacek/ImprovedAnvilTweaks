IF
	Allegiance(Myself,ENEMY)
	Detect([PC])
	Global("Iasummon","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iasummon","LOCALS",1)
		CreateCreatureObject("S!spidwd",Myself,0,0,0)
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	OR(2)
		StateCheck(Myself,STATE_POISONED)
		StateCheck(Myself,STATE_DISEASED)
	GlobalTimerNotExpired("IaContinualCure","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",1)
END

IF
    HaveSpell(CLERIC_ZONE_OF_SWEET_AIR)
	Allegiance(Myself,ENEMY)
	!CheckStatGT(Myself,25,SPELLFAILUREPRIEST)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	InMyArea(Player1)
	Global("Iapccloud","AR2209",1)  // Jae'llat's House
	Global("Iawhosweet","AR2209",1)  // Jae'llat's House
THEN
	RESPONSE #100
		SetGlobal("Iapccloud","AR2209",0)  // Jae'llat's House
		SetGlobal("Iawhosweet","AR2209",0)  // Jae'llat's House
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		Spell(Myself,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
		MoveToObject(Player1)
END

IF
    HaveSpell(CLERIC_SANCTUARY)
	!CheckSpellState(Myself,SANCTUARY)
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	HPPercentLT(Myself,50)
	OR(6)
		GlobalTimerNotExpired("IaRegen","LOCALS")
		GlobalTimerNotExpired("IaContinualCure","LOCALS")
		HaveSpell(CLERIC_HEAL)
		HaveSpell(CLERIC_CURE_CRITICAL_WOUNDS)
		HaveSpell(CLERIC_CURE_SERIOUS_WOUNDS)
		HaveSpell(CLERIC_RESTORATION)
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaSanctuary","LOCALS",ONE_ROUND)
		Spell(Myself,CLERIC_SANCTUARY)  // SPPR109.SPL (Sanctuary)
	RESPONSE #0
	    Continue()
END

IF
    HaveSpell(CLERIC_HEAL)
	Allegiance(Myself,ENEMY)
	!CheckStatGT(Myself,25,SPELLFAILUREPRIEST)
	Global("Iapcastts","GLOBAL",0)
	CheckSpellState(Myself,SANCTUARY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
