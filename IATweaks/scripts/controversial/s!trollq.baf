IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Iabattle","AR1904",0)  // Troll Hill
THEN
	RESPONSE #100
		SetGlobal("Iabattle","AR1904",1)  // Troll Hill
END

IF
	See(NearestEnemyOf(Myself))
	Global("Prep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Prep","LOCALS",1)
		SetGlobalTimer("bladetimer","LOCALS",ONE_TURN)
		SetGlobalTimer("camouflagetimer","LOCALS",TWO_TURNS)
		SetGlobalTimer("harmonytimer","LOCALS",SIX_ROUNDS)
		ReallyForceSpell(Myself,CLERIC_ARMOR_OF_FAITH)  // SPPR111.SPL (Armor of Faith)
		ReallyForceSpellRES("SPPRI07",Myself)  // Mirror Image
		ReallyForceSpell(Myself,CLERIC_BLESS)  // SPPR101.SPL (Bless)
		ReallyForceSpell(Myself,CLERIC_BARKSKIN)  // SPPR202.SPL (Barkskin)
		ReallyForceSpell(Myself,CLERIC_DEATH_WARD)  // SPPR409.SPL (Death Ward)
		ReallyForceSpell(Myself,CLERIC_IRONSKIN)  // SPPR506.SPL (Iron Skins)
		ReallyForceSpell(Myself,1420)
		ReallyForceSpell(Myself,CLERIC_PROTECTION_FROM_FIRE)  // SPPR306.SPL (Protection From Fire)
		ReallyForceSpell(Myself,CLERIC_PROTECTION_FROM_LIGHTNING)  // SPPR407.SPL (Protection From Lightning)
		ReallyForceSpellRES("SPPRI12",Myself)  // Protection From Acid
		ReallyForceSpell(Myself,CLERIC_CLOAK_OF_FEAR)  // SPPR416.SPL (Cloak of Fear)
		ReallyForceSpell(Myself,CLERIC_BLADE_BARRIER)  // SPPR603.SPL (Blade Barrier)
		ReallyForceSpell(Myself,CLERIC_GLOBE_OF_BLADES)  // SPPR725.SPL (Globe of Blades)
		ReallyForceSpell(Myself,CLERIC_DEFENSIVE_HARMONY)  // SPPR406.SPL (Defensive Harmony)
		ReallyForceSpell(Myself,CLERIC_ACID_SHIELD)  // SPPR418.SPL (Acid Shield)
		ReallyForceSpell(Myself,CLERIC_SHIELD_OF_THE_ARCHONS)  // SPPR701.SPL (Shield of the Archons)
		ReallyForceSpell(Myself,CLERIC_AURA_OF_FLAMING_DEATH)  // SPPR730.SPL (Aura of Flaming Death)
		ReallyForceSpellRES("SPPRI17",Myself)  // Perfect Camouflage
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Allegiance(Myself,ENEMY)
	See([PC])
	Global("Iantrolls","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iantrolls","LOCALS",1)
		CreateCreatureObjectOffScreen("S!ntrol2",Myself,0,0,0)
		CreateCreatureObjectOffScreen("S!ntrol2",Myself,0,0,0)
		CreateCreatureObjectOffScreen("S!ntrol2",Myself,0,0,0)
		CreateCreatureObjectOffScreen("S!ntrol2",Myself,0,0,0)
		SetGlobal("MyAura","LOCALS",1)
		SetGlobalTimer("alacritytimer","LOCALS",THREE_ROUNDS)
		ForceSpellRES("SPPRI16",Myself)
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	HasItem("POTN10",Myself)  // Potion of Invisibility
	See([PC])
	HPPercentLT(Myself,80)
	Global("vanish","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("vanish","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46150)  // *quaffs a potion*
		UseItem("POTN10",Myself)  // Potion of Invisibility
END

IF
	Allegiance(Myself,ENEMY)
	Global("FLEE","LOCALS",0)
	Global("vanish","LOCALS",0)
	HPPercentLT(Myself,50)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("FLEE","LOCALS",1)
		ApplySpellRES("s!retrea",Myself)
		RunAwayFrom(LastAttackerOf(Myself),100)
		SetInterrupt(TRUE)
END

IF
	Allegiance(Myself,ENEMY)
	Global("Prep","LOCALS",1)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	Global("vanish","LOCALS",1)
	Global("lastalacrity","LOCALS",0)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("lastalacrity","LOCALS",1)
		SetGlobal("vanish","LOCALS",2)
		SetGlobalTimer("alacritytimer2","LOCALS",TWO_MINUTES)
		SetGlobalTimer("alacrityactive","LOCALS",TWO_ROUNDS)
		SpellNoDecRES("sppri16",Myself)
END

IF
	Allegiance(Myself,ENEMY)
	Global("Prep","LOCALS",1)
	GlobalTimerExpired("alacritytimer2","LOCALS")
	CheckStatGT(Myself,0,AURACLEANSING)
	Global("Iapcastts","GLOBAL",0)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("lastalacrity","LOCALS",1)
	Global("lastalacrity2","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("lastalacrity2","GLOBAL",1)
		SetGlobalTimer("alacritytimer","LOCALS",FOUR_ROUNDS)
		SetGlobalTimer("alacrityactive","LOCALS",TWO_ROUNDS)
		SpellNoDecRES("sppri16",Myself)
END

IF
	Allegiance(Myself,ENEMY)
	Global("Prep","LOCALS",1)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("alacritytimer","LOCALS")
	!GlobalTimerNotExpired("alacrityactive","LOCALS")
	Global("MyAura","LOCALS",0)
	Global("Iapcastts","GLOBAL",0)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("MyAura","LOCALS",1)
		SetGlobalTimer("alacritytimer","LOCALS",FOUR_ROUNDS)
		SetGlobalTimer("alacrityactive","LOCALS",TWO_ROUNDS)
