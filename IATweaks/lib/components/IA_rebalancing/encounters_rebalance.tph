/////// Suna Seni encounter ///////

COPY_EXISTING ~RESUNA.cre~ ~override~
  WRITE_SHORT 0x24 99 // HP
  WRITE_SHORT 0x26 99 // HP

COPY_EXISTING ~REELDAR.cre~ ~override~
  WRITE_SHORT 0x24 96 // HP
  WRITE_SHORT 0x26 96 // HP
    
  LPF ~ALTER_EFFECT~ // ** in Sword and Shield
    INT_VAR
      match_opcode = 233
      match_parameter2 = 112
      parameter1 = 2
  END

COPY_EXISTING ~REMAGE01.cre~ ~override~
  WRITE_SHORT 0x24 40 // HP
  WRITE_SHORT 0x26 40 // HP
  WRITE_SHORT 0x46 10 // AC
  WRITE_SHORT 0x48 10 // AC

COPY_EXISTING ~RETHUG02.cre~ ~override~
  WRITE_SHORT 0x24 40 // HP
  WRITE_SHORT 0x26 40 // HP
  WRITE_SHORT 0x46 10 // AC
  WRITE_SHORT 0x48 10 // AC

COPY_EXISTING ~REFIGH01.cre~ ~override~
  WRITE_BYTE 0x54 8  // Saves
  WRITE_BYTE 0x55 10 // Saves
  WRITE_BYTE 0x56 9  // Saves
  WRITE_BYTE 0x57 9  // Saves
  WRITE_BYTE 0x58 11 // Saves
    
  LPF ~ALTER_EFFECT~ // ***** in 2h Sword
    INT_VAR
      match_opcode = 233
      match_parameter2 = 93
      parameter1 = 5
  END

// Postpone Suna Seni till PC has 250000 exp

ACTION_FOR_EACH suna_seni_area_script IN ~AR0041.BCS~ ~AR0045.BCS~ ~AR0046.BCS~ BEGIN
  COPY_EXISTING ~%suna_seni_area_script%~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      REPLACE_EVALUATE
        ~\([ %TAB%]+\)\(Global("RandomEncounters","GLOBAL",0)\)\([ %TAB%%LNL%%MNL%%WNL%]+\)~
      BEGIN
      END
      ~%MATCH1%%MATCH2%%MATCH3%%MATCH1%XPGT(Player1,249999)%MATCH3%~
    END
END

/////////// Rework Vampires ///////////

ACTION_FOR_EACH vampire_weapon IN ~VAMP~ ~VAMP1~ ~VAMP2~ ~VAMP3~ ~S!VLORD~ ~S!BODHI~ BEGIN
  COPY_EXISTING ~%vampire_weapon%.itm~ ~override~
    READ_LONG 0x64 headers_offset
    WRITE_BYTE (headers_offset + 0x18) (THIS - 1)
    WRITE_BYTE (headers_offset + 0x1a) (THIS + 1)
    PATCH_FOR_EACH spl_to_dispel IN ~SPPR413~ ~SPIN738~ ~SPPR508~ ~SPWI725E~ BEGIN
      LPF ~CLONE_EFFECT~
        INT_VAR
          match_opcode = 221
          opcode = 321
          parameter1 = 0
          parameter2 = 0
        STR_VAR
          insert = ~above~
          resource = EVAL ~%spl_to_dispel%~
      END
    END
    LPF ~DELETE_EFFECT~
      INT_VAR
        match_opcode = 221
        match_parameter2 = 2
    END
    LPF ~ADD_ITEM_EFFECT~
      INT_VAR
        type = 1
        opcode = 12
        insert_point = 0
        target = 2
        timing = 9
        dicenumber = 1
        dicesize = 6
        special = 1 // Drain HP
    END
END

// Vampiric Mist

COPY_EXISTING ~MISTVA.itm~ ~override~
  READ_LONG 0x64 headers_offset
  WRITE_BYTE (headers_offset + 0x18) (THIS - 1)
  WRITE_BYTE (headers_offset + 0x1a) (THIS + 1)
  PATCH_FOR_EACH spl_to_dispel IN ~SPPR413~ ~SPIN738~ ~SPPR403~ BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 221
        opcode = 321
        parameter1 = 0
        parameter2 = 0
      STR_VAR
        insert = ~above~
        resource = EVAL ~%spl_to_dispel%~
    END
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 221
      match_parameter2 = 2
  END
  LPF ~ADD_ITEM_EFFECT~
    INT_VAR
      type = 1
      opcode = 12
      insert_point = 0
      target = 2
      timing = 9
      dicenumber = 1
      dicesize = 8
      special = 1 // Drain HP
  END

// Eminent Vampires //

ACTION_FOR_EACH eminent_vamp_cre IN ~s!vamemi~ ~s!vamemr~ ~VAMEMI01~ ~VAMPAT01~ ~VAMPIF01~ ~VAMPIM01~ BEGIN
  COPY_EXISTING ~%eminent_vamp_cre%.cre~ ~override~
    WRITE_BYTE 0x59 25  // Fire Resistance
    WRITE_BYTE 0x5c 25  // Acid Resistance
    WRITE_BYTE 0x5e 25  // Magic Fire Resistance
END

/////////// Rayic (Cowled Wizard that Edwin orders us to kill) ////////////

COPY_EXISTING ~DCOWL1.CRE~ ~override~
  WRITE_SHORT 0x24 43 // HP
  WRITE_SHORT 0x26 43 // HP
  WRITE_BYTE  0x23d 16 // Constitution
  REMOVE_MEMORIZED_SPELL ~spwi609~ ~spwi899~ ~spwi601~
  REMOVE_KNOWN_SPELL ~spwi609~

COPY_EXISTING ~rayic.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    REPLACE_EVALUATE
      ~\([ %TAB%]+\)\(ReallyForceSpellRES("SPWII41",Myself)\)\([ %TAB%%LNL%%MNL%%WNL%]+\)~
    BEGIN
    END
    ~%MATCH1%%MATCH2%%MATCH3%%MATCH1%ReallyForceSpellRES("SPWI618",Myself)%MATCH3%~
  END

