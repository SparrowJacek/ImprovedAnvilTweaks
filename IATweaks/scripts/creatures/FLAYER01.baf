IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Allegiance(Myself,ENEMY)
	See(FourthNearestAllyOf(Myself))
	TriggerOverride(FourthNearestAllyOf(Myself),Race(Myself,MIND_FLAYER))
THEN
	RESPONSE #100
		IncrementGlobal("IaMindAlliesNearby","LOCALS",1)
