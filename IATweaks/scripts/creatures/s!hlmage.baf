IF
	Allegiance(Myself,ENEMY)
	AreaCheck("AR0711")  // Illithid Hideout in the Sewers (The Hidden Plot)
	Detect([PC])
	Global("Iaskelgs","LOCALS",0)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("Iaskelgs","LOCALS",1)
		ReallyForceSpellPointRES("SPINI61",[2066.1045])  // No such index
		ReallyForceSpellPointRES("SPINI61",[1987.1010])  // No such index
		SetInterrupt(TRUE)
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	AreaCheck("AR0711")  // Illithid Hideout in the Sewers (The Hidden Plot)
	Detect([PC])
	Global("Iatreasure","LOCALS",0)
	Global("Iavecnaplace","GLOBAL",3)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Iavecnaplace","GLOBAL",5)
		SetGlobal("Iatreasure","LOCALS",1)
		GiveItemCreate("wa2robe",Myself,0,0,0)  // Robe of Vecna
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	See([PC])
	OR(3)
		StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
		StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
		StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
	!GlobalTimerNotExpired("truesight","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("truesight","LOCALS",TEN_ROUNDS)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDec(Myself,WIZARD_TRUE_SIGHT)  // SPWI609.SPL (True Sight)
END

