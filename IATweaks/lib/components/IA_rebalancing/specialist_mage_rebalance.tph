//////// Abjurer /////////

// Abjuration Mastery

// 2DA lists of Abjuration spells
COPY ~IATweaks\resources\2da\abjurmasttempl.2da~ ~override\s!abjur4.2da~
COPY_EXISTING_REGEXP GLOB ~SPWI[1-4][0-5][0-9].SPL~ ~override~
  READ_BYTE 0x25 spell_school
  INNER_ACTION BEGIN
    ACTION_IF %spell_school% = 1 AND NOT ~%SOURCE_RES%~ STR_EQ ~SPWI222~ THEN BEGIN // Abjurer, No Chaos Shield
      APPEND ~s!abjur4.2da~ ~%SOURCE_RES% %SOURCE_RES% 4~
    END
  END
  BUT_ONLY

ACTION_FOR_EACH spl_level IN 5 6 7 8 9 BEGIN
  OUTER_SET lower_level = %spl_level% - 1
  COPY_EXISTING ~s!abjur%lower_level%.2da~ ~override\s!abjur%spl_level%.2da~
  COPY_EXISTING_REGEXP GLOB ~SPWI%spl_level%[0-5][0-9].SPL~ ~override~
    READ_BYTE 0x25 spell_school
    INNER_ACTION BEGIN
      ACTION_IF %spell_school% = 1 AND NOT ~%SOURCE_RES%~ STR_EQ ~SPWI723~ THEN BEGIN // Abjurer, No Improved Chaos Shield
        APPEND ~s!abjur%spl_level%.2da~ ~%SOURCE_RES% %SOURCE_RES% 4~
      END
    END
    BUT_ONLY
END

