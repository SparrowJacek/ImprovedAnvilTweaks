	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	CheckStatLT(Myself,60,SPELLFAILUREPRIEST)
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_POISONED)
	CheckStatLT(FifthNearest([PC.0.0.MAGE_ALL]),100,RESISTPIERCING)
	CheckStatLT(FifthNearest([PC.0.0.MAGE_ALL]),25,RESISTMAGIC)
	!CheckSpellState(FifthNearest([PC.0.0.MAGE_ALL]),SI_CONJURATION)
	TriggerOverride(FifthNearest([PC.0.0.MAGE_ALL]), Range(FourthNearestAllyOf(Myself), 15))
	TriggerOverride(FifthNearest([PC.0.0.MAGE_ALL]), CheckStatLT(FourthNearestAllyOf(Myself),100,RESISTPIERCING))
	TriggerOverride(FifthNearest([PC.0.0.MAGE_ALL]), CheckStatLT(FourthNearestAllyOf(Myself),75,RESISTMAGIC))
	!TriggerOverride(FifthNearest([PC.0.0.MAGE_ALL]), CheckSpellState(FourthNearestAllyOf(Myself),SI_CONJURATION))
	See(FifthNearest([PC.0.0.MAGE_ALL]))
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE) 
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),CLERIC_CREEPING_DOOM)
		ForceSpellRES("S!SEEREM",Myself)
	RESPONSE #0
