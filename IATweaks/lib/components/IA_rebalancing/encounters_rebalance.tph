// Postpone Suna Seni till PC has 250000 exp

ACTION_FOR_EACH suna_seni_area_script IN ~AR0041.BCS~ ~AR0045.BCS~ ~AR0046.BCS~ BEGIN
  COPY_EXISTING ~%suna_seni_area_script%~ ~override~
    DECOMPILE_AND_PATCH BEGIN
      REPLACE_EVALUATE
        ~\([ %TAB%]+\)\(Global("RandomEncounters","GLOBAL",0)\)\([ %TAB%%LNL%%MNL%%WNL%]+\)~
      BEGIN
      END
      ~%MATCH1%%MATCH2%%MATCH3%%MATCH1%XPGT(Player1,249999)%MATCH3%~
    END
END

/////////// Rework Vampires ///////////

ACTION_FOR_EACH vampire_weapon IN ~VAMP~ ~VAMP1~ ~VAMP2~ ~VAMP3~ ~S!VLORD~ ~S!BODHI~ BEGIN
  COPY_EXISTING ~%vampire_weapon%.itm~ ~override~
    READ_LONG 0x64 headers_offset
    WRITE_BYTE (headers_offset + 0x18) (THIS - 1)
    WRITE_BYTE (headers_offset + 0x1a) (THIS + 2)
    PATCH_FOR_EACH spl_to_dispel IN ~SPPR413~ ~SPIN738~ ~SPPR508~ ~SPWI725E~ BEGIN
      LPF ~CLONE_EFFECT~
        INT_VAR
          match_opcode = 221
          opcode = 321
          parameter1 = 0
          parameter2 = 0
        STR_VAR
          insert = ~above~
          resource = EVAL ~%spl_to_dispel%~
      END
    END
    LPF ~DELETE_EFFECT~
      INT_VAR
        match_opcode = 221
        match_parameter2 = 2
    END
    LPF ~ADD_ITEM_EFFECT~
      INT_VAR
        type = 1
        opcode = 12
        insert_point = 0
        target = 2
        timing = 9
        dicenumber = 1
        dicesize = 8
        special = 1 // Drain HP
    END
END

// 41495 - One level drained
ACTION_FOR_EACH vampire_weapon IN ~VAMP~ ~VAMP1~ BEGIN
  COPY_EXISTING ~%vampire_weapon%.itm~ ~override~
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 216
        parameter1 = 1
    END
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 139
        parameter1 = 41495
    END
  END

ACTION_FOR_EACH vampire_weapon IN ~VAMP2~ ~VAMP3~ BEGIN
  COPY_EXISTING ~%vampire_weapon%.itm~ ~override~
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 216
        parameter1 = 2
    END
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 139
        parameter1 = 40968
    END
  END

ACTION_FOR_EACH vampire_weapon IN ~S!VLORD~ ~S!BODHI~ BEGIN
  COPY_EXISTING ~%vampire_weapon%.itm~ ~override~
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 216
        parameter1 = 3
    END
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 139
        parameter1 = 40969
    END
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 12
        match_parameter2 = 0
        dicenumber = 2
    END
  END

// Vampiric Mist

