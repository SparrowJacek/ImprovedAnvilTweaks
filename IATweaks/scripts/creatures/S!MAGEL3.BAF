	RESPONSE #100
		
		SetGlobalTimer("Iaspell","LOCALS",THREE_ROUNDS)
		ForceSpell(LastSeenBy(Myself),CLERIC_IMPLOSION)  // SPPR728.SPL (Implosion)
		
END

