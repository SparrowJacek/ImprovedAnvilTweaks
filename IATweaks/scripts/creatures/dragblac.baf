IF
	NumberOfTimesTalkedTo(0)
	Global("Iapcastts","GLOBAL",0)
	Detect([PC])
THEN
	RESPONSE #100
		StartDialogueNoSet([PC])
END

IF
	InMyArea(Player1)
	!Allegiance(Myself,ENEMY)
	CheckStatLT(Myself,1,STONESKINS)
THEN
	RESPONSE #100
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		AddAreaFlag(NOSAVE)
		AddAreaFlag(NOREST)
		Continue()
END

IF
	Die()
THEN
	RESPONSE #100
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		RemoveAreaFlag(NOSAVE)
		RemoveAreaFlag(NOREST)
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iacantexit","AR2807",0)  // Black Dragon's Hideout
THEN
	RESPONSE #100
		SetGlobal("Iacantexit","AR2807",1)  // Black Dragon's Hideout
		Continue()
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Iabldra01","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iabldra01","LOCALS",1)
		SetGlobalTimer("IaNextMeleePhase","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("SPWII03",Myself)  // Spell Turning
		ReallyForceSpellRES("SPWII01",Myself)  // Spell Shield
END

IF
	!GlobalTimerNotExpired("IaNextMeleePhase","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaNextMeleePhase","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("S!NOAURA",Myself)
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	Allegiance(Myself,ENEMY)
	HasItem("minhp1",Myself)  // No such index
	Global("IaDendroidsSlain","AR2807",3)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
		DestroyItem("minhp1")  // No such index
		SetInterrupt(TRUE)
		Continue()
END

IF
	HPPercentLT(Myself,50)
	!HPLT(Myself,1)
	!HasItem("minhp1",Myself)  // No such index
	InMyArea(Player1)
	Allegiance(Myself,ENEMY)
	Global("Iabldra01","LOCALS",1)
	Global("Iaheal","LOCALS",1)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Iaheal","LOCALS",2)
		ForceSpellRES("SPPRI10",Myself)  // Heal
END

IF
	HPPercentLT(Myself,30)
	!HPLT(Myself,1)
