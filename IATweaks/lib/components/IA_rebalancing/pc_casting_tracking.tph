PRINT @5102

SILENT

INCLUDE "%MOD_FOLDER%/lib/components/IA_rebalancing/helper_functions.tph"

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~CASTING_SPEED~
    stat                  = ~77~
    value                 = ~-1~
    relation              = ~1~
  RET
    casting_speed_equals = new_line_number
END

COPY ~IATweaks\resources\spl\s!casttx.spl~ ~override~
COPY ~IATweaks\resources\eff\s!casttx.eff~ ~override~
COPY ~IATweaks\resources\spl\s!castt1.spl~ ~override~
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 318
      parameter2 = casting_speed_equals
  END
COPY_EXISTING ~s!castt1.spl~ ~override/s!castt2.spl~
  LPF ~ALTER_EFFECT~
    STR_VAR
      match_resource = ~S!CASTT1~
      resource = ~S!CASTT2~
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 233
      parameter2 = 65669 // EXTRAPROFICIENCY19 increment
  END

ACTION_FOR_EACH powerful_spell IN ~sppr717~ ~spwi812~ ~sppri27~ ~spcli24~ ~spcli23~ ~sppr711~ ~sppr722~ ~sppr705~ ~sppr607~ ~sppr705~ ~spwi807~ ~spini13~ BEGIN
  COPY_EXISTING ~%powerful_spell%.spl~ ~override~
    READ_LONG 0x64 first_header_offset
    READ_SHORT first_header_offset + 0x12 casting_speed
    LPF ~ADD_SPELL_CFEFFECT~ 
      INT_VAR
        opcode = 146
        target = 1
        parameter1 = casting_speed
        parameter2 = 2
        resist_dispel = 2
      STR_VAR
        resource = ~S!CASTT1~
    END
END

ACTION_FOR_EACH powerful_spell_scroll IN ~scrl9g~ ~s!scrl06~ BEGIN
  COPY_EXISTING ~%powerful_spell_scroll%.itm~ ~override~
    LPF ~CLONE_EFFECT~ 
      INT_VAR
        multi_match = 1
        match_opcode = 318
        parameter1 = 0
        parameter2 = 0
      STR_VAR
        resource = ~S!CASTT1~
        insert = ~below~
    END
END

ACTION_FOR_EACH priority_spell IN ~spwi302~ ~spwi326~ ~sppr303~ ~spwi510~ ~spwi513~ ~spwi602~ ~sppri18~ ~spwi704~ ~spwi805~ ~spwi701~ ~spwi919~ ~sppri16~ ~spwi921~ BEGIN
  COPY_EXISTING ~%priority_spell%.spl~ ~override~
    READ_LONG 0x64 first_header_offset
    READ_SHORT first_header_offset + 0x12 casting_speed
    LPF ~ADD_SPELL_CFEFFECT~ 
      INT_VAR
        opcode = 146
        target = 1
        parameter1 = casting_speed
        parameter2 = 2
        resist_dispel = 2
      STR_VAR
        resource = ~S!CASTT2~
    END
END

ACTION_FOR_EACH priority_spell_scroll IN ~scrla7~ ~scrlb4~ ~scrl8d~ ~scrl9a~ ~scrl8g~ ~scrl8i~ ~scrl7f~ ~scrl6u~ ~scrl6s~ ~scrl1e~ ~scrl6g~ BEGIN
  COPY_EXISTING ~%priority_spell_scroll%.itm~ ~override~
    LPF ~CLONE_EFFECT~ 
      INT_VAR
        multi_match = 1
        match_opcode = 318
        parameter1 = 0
        parameter2 = 0
      STR_VAR
        resource = ~S!CASTT2~
        insert = ~below~
    END
END

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~stats.ids~
    col_with_names = 1
  RET_ARRAY
    stats_rows = 2da_rows_to_ids_mapping
END