IF
	!Detect([PC])
	!Detect([GOODCUTOFF])
	Global("EnemySeen","LOCALS",0)
	Global("EnemySeen","AR0405",1)  // Slaver's Ship Building
	InMyArea(Player1)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

IF
	See(NearestEnemyOf(Myself))
	Global("Iaexit2","AR0405",1)  // Slaver's Ship Building
	!GlobalTimerNotExpired("Iasummon","LOCALS")
	Detect([PC])
	Global("EnemySeen","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobalTimer("Iasummon","LOCALS",FIVE_ROUNDS)
		CreateCreatureObject("S!slassa",LastSeenBy(Myself),0,0,0)  // Assassin - Assassin
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),10)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!CheckStatGT(Myself,0,SCRIPTINGSTATE9)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_STUNNED)
	!StateCheck(Myself,STATE_SILENCED)
	!HasItem("SERIOUS",Myself)  // Cause Serious Wounds
	GlobalLT("s!causeserious","LOCALS",2)
THEN
	RESPONSE #100
		IncrementGlobal("s!causeserious","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDec(Myself,CLERIC_CAUSE_SERIOUS_WOUNDS)  // SPPR414.SPL (Cause Serious Wounds)
END

