IF
	HPPercentLT(Myself,35)
	!GlobalTimerNotExpired("AuruHealTimer","LOCALS")
	!GlobalLT("AuruHeal","LOCALS",3)
THEN
	RESPONSE #100
		SetGlobalTimer("AuruHealTimer","LOCALS",THREE_ROUNDS)
		IncrementGlobal("AuruHeal","LOCALS",1)
		ForceSpell(Myself,CLERIC_HEAL)  // SPPR607.SPL (Heal)
END

IF
	!StateCheck(Myself,STATE_MIRRORIMAGE)
	!GlobalTimerNotExpired("AuruMirror","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("AuruMirror","LOCALS",24)
		ForceSpell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (Mirror Image)
END


IF
	HaveSpellRES("SPCL321")
	!CheckSpellState(Myself,BERSERKER_RAGE_FATIGUE) 
	!CheckSpellState(Myself,BERSERKER_RAGE) 
	!GlobalTimerNotExpired("IaAction","LOCALS")
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SpellRES("SPCL321",Myself)  // Enrage
	RESPONSE #0
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
    !GlobalTimerNotExpired("IaDeathSpellWait","LOCALS")
	See(NearestEnemyOfType([GOODCUTOFF.0.0.0.0.SUMMONED]))
	OR(3)
		CheckStat(LastSeenBy(Myself),20,RESISTSLASHING)
		CheckStat(LastSeenBy(Myself),95,RESISTPIERCING)
		CheckStat(LastSeenBy(Myself),89,RESISTMAGIC)
	TriggerOverride(LastSeenBy(Myself), Range([GOODCUTOFF.0.0.0.0.SUMMONED], 15))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaDeathSpellWait","LOCALS",10)
		ForceSpell(LastSeenBy(Myself),WIZARD_DEATH_SPELL)  // SPWI605.SPL (Death Spell)
		SetInterrupt(TRUE)
	RESPONSE #50
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
    !GlobalTimerNotExpired("IaPrismaticWait","LOCALS")
	See([PC])
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE7)
	CheckStatLT(LastSeenBy(Myself),80,MAGICDAMAGERESISTANCE)
	CheckStatLT(LastSeenBy(Myself),60,RESISTMAGIC)
	Range(LastSeenBy(Myself),14)
	!Range(LastSeenBy(Myself),2)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaPrismaticWait","LOCALS",15)
		ForceSpell(LastSeenBy(Myself),WIZARD_PRISMATIC_SPRAY)  // SPWI714.SPL (Prismatic Spray)
		SetInterrupt(TRUE)
	RESPONSE #0
	    Continue()
END

