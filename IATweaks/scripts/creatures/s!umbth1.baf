IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("IaBreakCharge","LOCALS")
	ActionListEmpty()
	See([PC])
	OR(2)
		CheckStatLT([PC],75,RESISTPIERCING)
		CheckStatLT([PC],75,RESISTCRUSHING)
	!CheckStatGT([PC],2,SCRIPTINGSTATE6)
	Range([PC],3)
THEN
	RESPONSE #100
		ReallyForceSpellRES("S!CHARG6",Myself)
		AttackOneRound([PC])
	RESPONSE #100
	    Continue()
END

