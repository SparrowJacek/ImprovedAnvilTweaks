IF
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		NoAction()
END

IF
	Allegiance(Myself,ENEMY)
	Global("SamiaBattle","AR1202",0)  // Firkraag's Maze
THEN
	RESPONSE #100
		SetGlobal("SamiaBattle","AR1202",1)  // Firkraag's Maze
		Continue()
END

IF
	!Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	Global("SamiaBattle","AR1202",1)  // Firkraag's Maze
THEN
	RESPONSE #100
		Enemy()
		MoveToObject(Player1)
END


IF
    HaveSpellRES("SPPR508")
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
	!Dead("DESHAR")
	InMyArea("DESHAR")
THEN
	RESPONSE #100
		ReallyForceSpellRES("SPPR508","DESHAR") //  Chaotic Commands
		RemoveSpellRES("SPPR508")
		Continue()
END


