// Avenger

// Weaken Clan Hunters

OUTER_SET str_bonus = 25
ACTION_FOR_EACH clan_hunter_cre IN ~S!clhun1~ ~S!clhun2~ ~S!clhun3~ ~S!clhun4~ BEGIN
  COPY_EXISTING ~%clan_hunter_cre%.cre~ ~override~
    WRITE_BYTE 0x53 1 // APR
    READ_BYTE 0x59 fire_res
    READ_BYTE 0x235 druid_level
    SET real_HP = 90 + 2 * (druid_level - 9)
    WRITE_SHORT 0x24 real_HP // HP
    WRITE_SHORT 0x26 real_HP // HP
    WRITE_SHORT 0x46 10 // AC
    WRITE_SHORT 0x48 10 // AC
    WRITE_BYTE 0x238 18 // Strength
    WRITE_BYTE 0x239 str_bonus // Exceptional Strength
    SET str_bonus = str_bonus + 25

    PATCH_IF (druid_level < 15) BEGIN
      LPF ~DELETE_EFFECT~
        INT_VAR
          match_opcode = 173 // Poison Resistance
      END
      LPF ~DELETE_EFFECT~
        INT_VAR
          match_opcode = 101
          match_parameter2 = 25 // Immunity to Poison opcode
      END
    END
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 31 // Magic damage resistance
        parameter1 = fire_res
    END
  BUT_ONLY
END

// Prevent Regeneration from lvl7 divine and RVE from stacking

ACTION_FOR_EACH regen_spell_file IN ~SPWII55~ ~SPINI65~ ~SPINI57~ ~SPPR711~ BEGIN
  COPY_EXISTING ~%regen_spell_file%.spl~ ~override~
    PATCH_FOR_EACH regen_spell IN ~SPWII55~ ~SPINI65~ ~SPINI57~ ~SPPR711~ BEGIN
      LPF ~CLONE_EFFECT~
        INT_VAR
          multi_match = 1
          match_opcode = 98
          opcode = 321
          parameter1 = 0
          parameter2 = 0
          duration = 0
        STR_VAR
          insert = ~first~
          resource = EVAL ~%regen_spell%~
      END
    END
END

