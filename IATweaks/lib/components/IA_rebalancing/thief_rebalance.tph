      parameter2 = 0
      timing = 9
  END
  
  LPF ~ADD_CRE_EFFECT~ // Set persistent AI
    INT_VAR
      target = 1
      opcode = 293
      parameter2 = 1
      resist_dispel = 0
      timing = 9
  END

  LPF ~ADD_CRE_EFFECT~ // All saving throws
    INT_VAR
      opcode = 325
      target = 1
      parameter1 = 5
      parameter2 = 0
      timing = 9
  END

  PATCH_FOR_EACH poison_weapon_eff IN ~SPCL422~ ~SPCL422A~ ~SPCL422B~ BEGIN
    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        target = 1
        opcode = 248
        parameter2 = 1
        resist_dispel = 0
        timing = 9
      STR_VAR
        resource = EVAL ~%poison_weapon_eff%~
    END
    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        target = 1
        opcode = 249
        parameter2 = 1
        resist_dispel = 0
        timing = 9
      STR_VAR
        resource = EVAL ~%poison_weapon_eff%~
    END
  END

  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 73
      target = 1
      parameter1 = 1
      parameter2 = 0
      timing = 9
    STR_VAR
      effsource = ~SPCL421~
  END

