// HLA

// Check if Beastmaster has his own HLA table, if not add it

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~luabbr.2da~
  RET_ARRAY
    hla_mapping_rows = 2da_rows_to_ids_mapping
END

COPY_EXISTING ~luabbr.2da~ ~override~
  COUNT_2DA_COLS ~colcount~
  READ_2DA_ENTRY $hla_mapping_rows("BEASTMASTER") 1 %colcount% beastmaster_hla_suffix
  PATCH_IF ~%beastmaster_hla_suffix%~ STR_EQ ~Ra0~ BEGIN
    INNER_ACTION BEGIN
      COPY_EXISTING ~LURA0.2DA~ ~override/LURA4.2DA~
    END
    SET_2DA_ENTRY $hla_mapping_rows("BEASTMASTER") 1 %colcount% ~Ra4~
    SPRINT beastmaster_hla_suffix ~Ra4~
  END

// Add Smilodon HLA

LAF ~S!ADD_HLA_ROW~
  STR_VAR
    filename = ~LU%beastmaster_hla_suffix%.2DA~
    row_desc = ~SMILODON~
    ability = ~GA_SPCLI12~
    num_allowed = ~1~
END

