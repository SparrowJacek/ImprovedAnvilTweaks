		SetGlobal("IaAttacking","LOCALS",1)
		EquipRanged()
		SelectWeaponAbility(SLOT_AMMO1,0) //SLOT_AMMOX
		AttackReevaluate(FifthNearest([PC]),15)
END

IF
	Allegiance(Myself,ENEMY)
	ActionListEmpty()
	CanEquipRanged()
	HasItem("AROW11",Myself)
	See(SixthNearest([PC]))
	HPLT(SixthNearest([PC]),400)
	CheckStatGT(SixthNearest([PC]),-20,ARMORCLASS)
	CheckStatLT(SixthNearest([PC]),75,RESISTMISSILE)
    CheckStat(SixthNearest([PC]),0,SCRIPTINGSTATE6)
	!CheckSpellState(SixthNearest([PC]),MISSILE_IMMUNITY)
	!Range(SixthNearest([PC]),5)
THEN
