COPY ~IATweaks\resources\spl\s!aura-4.spl~ ~override~

LAF ~S!ADD_CLAB_ROW~
  STR_VAR
    filename = ~AMDK.2da~
    row_desc = ~STAT_PENALTY~
    level1 = ~AP_S!AURA-4~
END

ACTION_FOR_EACH cernd_file IN ~CERND10~ ~CERND12~ ~CERND13~ ~CERND13B~ ~CERND14~ BEGIN
  COPY_EXISTING ~%cernd_file%.cre~ ~override~
  WRITE_BYTE 0x238 THIS + 4 // Strength
  WRITE_BYTE 0x23d THIS + 4 // constitution
  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 44
      target = 1
      parameter1 = ~-4~
      timing = 9
      resist_dispel = 0
    STR_VAR
      resource = ~S!AURA-4~
  END
  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 10
      target = 1
      parameter1 = ~-4~
      timing = 9
      resist_dispel = 0
    STR_VAR
      resource = ~S!AURA-4~
  END
END

// Make Golems immune to Insects

ACTION_FOR_EACH insects_spell IN ~sppr319~ ~sppr517~ ~sppr717~ BEGIN
  COPY_EXISTING ~%insects_spell%.spl~ ~override~
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 272
        opcode = 324
        parameter1 = 0
        parameter2 = 27
        duration = 1
      STR_VAR
        insert = ~above~
        resource = EVAL ~%SOURCE_RES%~
    END
END

