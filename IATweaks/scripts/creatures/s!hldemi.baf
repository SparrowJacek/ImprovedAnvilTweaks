	!Range(NearestAllyOf(Myself), 15)
	Range(SecondNearest([PC]), 15)
	CheckStatLT(SecondNearest([PC]),30,RESISTFIRE)
	OR(2)
	    NumInPartyAlive(1)
	    Range(ThirdNearest([PC]), 15)
	OR(2)
	    NumInPartyAlive(1)
	    CheckStatLT(ThirdNearest([PC]),50,RESISTFIRE)
	See(SecondNearest([PC]))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaSunFireInfinite","LOCALS",15)
		ForceSpell(Myself,WIZARD_SUN_FIRE)
		SetInterrupt(TRUE)
	RESPONSE #150
	    Continue()
END

