	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	HaveSpell(CLERIC_UNHOLY_BLIGHT)  // SPPR314.SPL (Unholy Blight)
	!TriggerOverride(SixthNearest([PC]),Range([ENEMY.0.0.0.0.0.MASK_GENEUTRAL],16))
	!TriggerOverride(SixthNearest([PC]),Range([ENEMY.0.0.0.0.0.MASK_GOOD],16))
    !Alignment(SixthNearest([PC]),MASK_EVIL)
	CheckStatLT(Myself,60,SPELLFAILUREPRIEST)
	!StateCheck(SixthNearest([PC]),STATE_INVISIBLE)
	!CheckStatGT(SixthNearest([PC]),0,SANCTUARY)
	!CheckStatGT(SixthNearest([PC]),30,RESISTMAGIC)
	!CheckStatGT(SixthNearest([PC]),50,MAGICDAMAGERESISTANCE)
	!CheckStat(SixthNearest([PC]),5,SCRIPTINGSTATE7)
	CheckStat(SixthNearest([PC]),0,MINORGLOBE)
	See(SixthNearest([PC]))
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself), CLERIC_UNHOLY_BLIGHT)
		ForceSpellRES("S!SEEREM",Myself)
	RESPONSE #50
	    Continue()
END
