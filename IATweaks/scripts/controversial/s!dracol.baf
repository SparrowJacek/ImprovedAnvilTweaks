IF
	Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	See(NearestEnemyOf(Myself))
	!Global("Chapter","GLOBAL",5)
	Global("IAchaptercheck","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IAchaptercheck","LOCALS",1)
		DestroyGold(5000)
		DestroyItem("S!scrl02")
		DestroyItem("S!scrl03")
		DestroyItem("potn33")  // Barbarian Essence
		DestroyItem("S!scrl09")
		DestroyItem("scrla4")  // Limited Wish
		Continue()
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	CheckStatLT(Myself,1,STONESKINS)
	CheckStat(Myself,0,SCRIPTINGSTATE6)
	HPPercentLT(Myself,100)
	Global("IaSpellTrigger","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaSpellTrigger","LOCALS",1)
		SetGlobalTimer("pfmw","LOCALS",FIVE_MINUTES)
		DisplayString(Myself,39968)  // Spell Trigger—Fired
		DisplayString(Myself,@6267)
		CreateCreatureObjectEffect("s!skelre","SPRAISED","S!DRACOL") 
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		ReallyForceSpellRES("SPWII01",Myself)  // Spell Shield
END


IF
	HaveSpellRES("SPIN692")
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
    !GlobalTimerNotExpired("IaGreaterSilence","LOCALS")
    !GlobalTimerNotExpired("IaSilencePlayer1","LOCALS")
	Allegiance(Myself,ENEMY)
	See(Player1)
	OR(6)
		Class(LastSeenBy(Myself),BARD_ALL)
		Class(LastSeenBy(Myself),SORCERER)
		Class(LastSeenBy(Myself),CLERIC_ALL)
		Class(LastSeenBy(Myself),DRUID_ALL)
		Class(LastSeenBy(Myself),SHAMAN)
		Class(LastSeenBy(Myself),MAGE_ALL)
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!HasItemEquiped("S!amul05",LastSeenBy(Myself))  // Amulet of Hades
	!HasItemEquiped("S!amul06",LastSeenBy(Myself))  // Lord of the Underworld
	!Kit(LastSeenBy(Myself),AURAMASTER)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE7)
	!CheckStat(LastSeenBy(Myself),3,SCRIPTINGSTATE4)
	!StateCheck(LastSeenBy(Myself),STATE_SILENCED)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaGreaterSilence","LOCALS", TWO_ROUNDS)
		SetGlobalTimer("IaSilencePlayer1","LOCALS", ONE_TURN)
		RemoveSpellRES("SPIN692")
		ForceSpellRES("SPIN692", LastSeenBy(Myself))
	RESPONSE #50
	    Continue()
END

