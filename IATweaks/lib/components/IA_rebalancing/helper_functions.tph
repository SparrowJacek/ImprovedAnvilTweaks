DEFINE_PATCH_FUNCTION ~S!ITMSPL_USES_OPCODE~
  INT_VAR
    check_globals  = 1      // check global effects: 0 for no, 1 for yes
    check_headers  = 1      // check effects on headers; 0 for no, 1 for yes
    match_opcode   = 177    // opcode at 0x00 to match, use -1 for all
    match_dispel   = ~-999~ // dispel_resistance, use -999 for all
    match_param1   = ~-999~ // param1, use -999 for all
    match_param2   = ~-999~ // param2, use -999 for all
    min_duration   = 0      // duration
    header_length = 0x38    // 0x38 for item, 0x28 for spell
  RET
    is_found
    opcode_resource
    opcode_target
    opcode_param1
BEGIN
  SPRINT is_found "FALSE"
  SPRINT opcode_resource ""
  SPRINT opcode_target "0"
  SPRINT opcode_param1 "0"
  READ_LONG 0x6a fx_off
  PATCH_IF (check_globals = 1) BEGIN
    READ_SHORT 0x70 fx_num
    FOR (index = 0 ; index < fx_num ; ++index) BEGIN
      READ_SHORT (fx_off +        (index * 0x30)) opcode_file
      READ_BYTE  (fx_off + 0x02 + (index * 0x30)) opcode_target
      READ_LONG  (fx_off + 0x04 + (index * 0x30)) param1
      READ_LONG  (fx_off + 0x04 + (index * 0x30)) opcode_param1
      READ_LONG  (fx_off + 0x08 + (index * 0x30)) param2
      READ_BYTE  (fx_off + 0x0d + (index * 0x30)) dispel
      READ_LONG  (fx_off + 0x0e + (index * 0x30)) duration
      READ_ASCII (fx_off + 0x14 + (index * 0x30)) res_name
      PATCH_IF (match_opcode = opcode_file AND (match_param1 = ~-999~ OR match_param1 = param1) AND (match_param2 = ~-999~ OR match_param2 = param2) AND (match_dispel = ~-999~ OR match_dispel = dispel) AND (min_duration <= duration)) BEGIN
        ///PATCH_PRINT ~File uses opcode %match_opcode% with res %res_name% in global effects~///
        SPRINT is_found "TRUE"
        SPRINT opcode_resource "%res_name%"
      END
    END
  END
  PATCH_IF (check_headers = 1) BEGIN
    READ_LONG   0x64 "abil_off"
    READ_SHORT  0x68 "abil_num"
    SET loop_start = 0
    SET loop_end = abil_num
    FOR (index2 = loop_start ; index2 < loop_end ; ++index2) BEGIN // looks through headers
      READ_BYTE (abil_off +        (index2 * header_length)) abil_type
      READ_SHORT (abil_off + 0x1e + (index2 * header_length)) abil_fx_num
      READ_SHORT (abil_off + 0x20 + (index2 * header_length)) abil_fx_idx
      FOR (index = 0 ; index < abil_fx_num ; index = index + 1) BEGIN
        READ_SHORT (fx_off +        ((abil_fx_idx + index) * 0x30)) opcode_file
        READ_BYTE  (fx_off + 0x02 + ((abil_fx_idx + index) * 0x30)) opcode_target
        READ_LONG  (fx_off + 0x04 + ((abil_fx_idx + index) * 0x30)) param1
        READ_LONG  (fx_off + 0x04 + ((abil_fx_idx + index) * 0x30)) opcode_param1
        READ_LONG  (fx_off + 0x08 + ((abil_fx_idx + index) * 0x30)) param2
        READ_BYTE  (fx_off + 0x0d + ((abil_fx_idx + index) * 0x30)) dispel
        READ_LONG  (fx_off + 0x0e + ((abil_fx_idx + index) * 0x30)) duration
        READ_ASCII (fx_off + 0x14 + ((abil_fx_idx + index) * 0x30)) res_name
        PATCH_IF (match_opcode = opcode_file AND (match_param1 = ~-999~ OR match_param1 = param1) AND (match_param2 = ~-999~ OR match_param2 = param2) AND (match_dispel = ~-999~ OR match_dispel = dispel) AND (min_duration <= duration)) BEGIN
          SPRINT is_found "TRUE"
          SPRINT opcode_resource "%res_name%"
          index=abil_fx_num
        END
      END
    END
  END
END

DEFINE_PATCH_FUNCTION ~S!SPELL_USES_OPCODE~
  INT_VAR
    check_globals  = 1      // check global effects: 0 for no, 1 for yes
    check_headers  = 1      // check effects on headers; 0 for no, 1 for yes
    match_opcode   = 177    // opcode at 0x00 to match, use -1 for all
    match_dispel   = ~-999~ // dispel_resistance, use -999 for all
    match_param1   = ~-999~ // param1, use -999 for all
    match_param2   = ~-999~ // param2, use -999 for all
    min_duration   = 0      // duration
  RET
    is_found
    opcode_resource
    opcode_target
    opcode_param1
BEGIN
  LPF ~S!ITMSPL_USES_OPCODE~
    INT_VAR
      check_globals  = 1
      check_headers  = 1
      match_opcode   = %match_opcode%
      match_dispel   = %match_dispel%
      match_param1   = %match_param1%
      match_param2   = %match_param2%
      header_length = 0x28
    RET is_found opcode_resource opcode_target opcode_param1
  END
END

