	CheckStatLT(LastSeenBy(Myself),60,RESISTPOISON)
	!CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE20)
	Range(FifthNearest([PC.0.0.BARD_ALL]),20)
THEN
	RESPONSE #100
		XEquipItem("SW1H07",Myself,SLOT_WEAPON3,EQUIP)
		AttackOneRound(LastSeenBy(Myself))
END

