IF
    HaveSpell(WIZARD_BREACH)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaProtRemovalWait","LOCALS")
	See([PC])
	!CheckSpellState(LastSeenBy(Myself),REMOVE_SPECIFIC_PROTS_IMMUNITY)
	CheckSpellState(LastSeenBy(Myself),DISPELLABLE_INCREASED_MAGIC_DAMAGE_RESISTANCE)
	OR(2)
        CheckStatGT(LastSeenBy(Myself),5,BREACHABLECOMBATBUFFSPOWER)
        CheckStatGT(LastSeenBy(Myself),10,BREACHABLESPECIFICBUFFSPOWER)
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaProtRemovalWait","LOCALS",2)
		RemoveSpell(WIZARD_BREACH)
		ForceSpell(LastSeenBy(Myself),WIZARD_BREACH)
	RESPONSE #50
	    Continue()
END

