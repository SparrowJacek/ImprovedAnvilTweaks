IF
	!GlobalTimerNotExpired("IaSwapPlaces","LOCALS")
	!Range(SecondNearestEnemyOf(Myself),4)
	!Dead("S!BAROCK")
	!Range("S!BAROCK",4)
	TriggerOverride("S!BAROCK",Range(SecondNearestEnemyOf(Myself),5))
	See("S!BAROCK")
THEN
	RESPONSE #100
		SetGlobalTimer("IaSwapPlaces","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("S!SWAPMI",LastSeenBy(Myself))
	RESPONSE #50
	    Continue()
END

IF
	!GlobalTimerNotExpired("IaSwapPlaces","LOCALS")
	!Dead("ROCK")
	!Range("ROCK",4)
	TriggerOverride("ROCK",GlobalTimerExpired("IaNextCharge","LOCALS"))
	!Range(FarthestEnemyOf(Myself),10)
	TriggerOverride("ROCK",Range(FarthestEnemyOf(Myself),10))
	See("ROCK")
THEN
	RESPONSE #100
		SetGlobalTimer("IaSwapPlaces","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("S!SWAPMI",LastSeenBy(Myself))
	RESPONSE #250
	    Continue()
END

IF
	!GlobalTimerNotExpired("IaSwapPlaces","LOCALS")
	!Dead("ROCK")
	!Range("ROCK",4)
	GlobalTimerExpired("IaWhrwndTimer","LOCALS")
	!Range(SecondNearestEnemyOf(Myself),7)
	TriggerOverride("ROCK",Range(SecondNearestEnemyOf(Myself),7))
	See("ROCK")
THEN
	RESPONSE #100
		SetGlobalTimer("IaSwapPlaces","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("S!SWAPMI",LastSeenBy(Myself))
	RESPONSE #450
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	HPPercentLT(Myself,60)
	HasItem("potn55",Myself)  // Potion of Superior Healing
	!GlobalTimerNotExpired("IaAction","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46150)  // *quaffs a potion*
		UseItem("potn55",Myself)  // Potion of Superior Healing
END

IF
	HaveSpellRES("SPCL152")
	!CheckSpellState(Myself,STATE_ENRAGED)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SpellRES("SPCL152",Myself)  // Barbarian Rage
	RESPONSE #0
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	HaveSpell(WARRIOR_CRITICAL_STRIKE)
	!CheckStatGT(Myself,5,CRITICALHITBONUS)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	See(NearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),5)
	!CheckStatGT(LastSeenBy(Myself),1,SCRIPTINGSTATE6)
	CheckStatLT(LastSeenBy(Myself),1,STONESKINS)
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ForceSpell(Myself,WARRIOR_CRITICAL_STRIKE)  // SPCL905.SPL (Critical Strike)
		RemoveSpell(WARRIOR_CRITICAL_STRIKE)
END

