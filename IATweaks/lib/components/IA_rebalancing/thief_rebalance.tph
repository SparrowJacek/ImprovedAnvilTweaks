    2da_table_name = ~kitlist.2da~
  RET_ARRAY
    kitlist_cols = 2da_columns_to_ids_mapping
END

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  INT_VAR
    col_with_names = 1
  STR_VAR
    2da_table_name = ~kitlist.2da~
  RET_ARRAY
    kitlist_rows = 2da_rows_to_ids_mapping
END

COPY_EXISTING ~kitlist.2da~ ~override/kitlist.2da~
  COUNT_2DA_COLS ~colcount~
  SET description_col = $kitlist_cols("HELP")
  PATCH_IF VARIABLE_IS_SET $kitlist_rows("ASSASSIN") BEGIN
    SET_2DA_ENTRY_LATER ~s!thief_desc~ $kitlist_rows("ASSASSIN") description_col RESOLVE_STR_REF (@5025)
  END
  PATCH_IF VARIABLE_IS_SET $kitlist_rows("ASSASIN") BEGIN
    SET_2DA_ENTRY_LATER ~s!thief_desc~ $kitlist_rows("ASSASIN") description_col RESOLVE_STR_REF (@5025)
  END
  SET_2DA_ENTRY_LATER ~s!thief_desc~ $kitlist_rows("BOUNTY_HUNTER") description_col RESOLVE_STR_REF (@5026)
  SET_2DA_ENTRY_LATER ~s!thief_desc~ $kitlist_rows("SWASHBUCKLER") description_col RESOLVE_STR_REF (@5027)
  SET_2DA_ENTRY_LATER ~s!thief_desc~ $kitlist_rows("SHADOWDANCER") description_col RESOLVE_STR_REF (@5028)
  SET_2DA_ENTRIES_NOW ~s!thief_desc~ ~colcount~
  PRETTY_PRINT_2DA

