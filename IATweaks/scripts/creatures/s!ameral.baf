IF
	Allegiance(Myself,ENEMY)
	GlobalTimerNotExpired("IaFiveSeconds","LOCALS")
	!GlobalTimerNotExpired("IaBlightPurify","LOCALS")
	HaveSpell(CLERIC_UNHOLY_BLIGHT)  // SPPR314.SPL (Unholy Blight)
	CheckStatLT(Myself,60,SPELLFAILUREPRIEST)
    !TriggerOverride(SixthNearest([PC]),Range([ENEMY.0.0.0.0.0.MASK_GENEUTRAL],16))
    !TriggerOverride(SixthNearest([PC]),Range([ENEMY.0.0.0.0.0.MASK_GOOD],16))
    !Alignment(SixthNearest([PC]),MASK_EVIL)
	!StateCheck(SixthNearest([PC]),STATE_INVISIBLE)
	!CheckStatGT(SixthNearest([PC]),0,SANCTUARY)
	!CheckStatGT(SixthNearest([PC]),30,RESISTMAGIC)
	!CheckStatGT(SixthNearest([PC]),50,MAGICDAMAGERESISTANCE)
	!CheckStat(SixthNearest([PC]),5,SCRIPTINGSTATE7)
	CheckStat(SixthNearest([PC]),0,MINORGLOBE)
	TriggerOverride(SixthNearest([PC]),Range(NearestAllyOf(Myself),15))
    !TriggerOverride(SixthNearest([PC]),Alignment(NearestAllyOf(Myself),MASK_EVIL))
	TriggerOverride(SixthNearest([PC]),CheckStat(NearestAllyOf(Myself),0,SANCTUARY))
	TriggerOverride(SixthNearest([PC]),CheckStatLT(NearestAllyOf(Myself),60,RESISTMAGIC))
	TriggerOverride(SixthNearest([PC]),CheckStatLT(NearestAllyOf(Myself),80,MAGICDAMAGERESISTANCE))
	TriggerOverride(SixthNearest([PC]),CheckStatLT(NearestAllyOf(Myself),5,SCRIPTINGSTATE7))
	TriggerOverride(SixthNearest([PC]),CheckStat(NearestAllyOf(Myself),0,MINORGLOBE))
	See(SixthNearest([PC]))
THEN
	RESPONSE #100
	    SetInterrupt(FALSE)
		SetGlobalTimer("IaBlightPurify","LOCALS",6)
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		ReallyForceSpellRES("SPCL943",Myself)  // Purify Aura
		RemoveSpellRES("SPCL943")
		Spell(LastSeenBy(Myself), CLERIC_UNHOLY_BLIGHT)
		ReallyForceSpellRES("S!SEEREM",Myself)
	    SetInterrupt(TRUE)
	RESPONSE #25
	    Continue()
END

