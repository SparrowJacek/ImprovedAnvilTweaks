IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Detect([PC])
	Global("Iatimer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobal("Iatimer","LOCALS",1)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("Iaacidcircle","LOCALS",0)
		Continue()
END
IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Range(Player1, 12)
	CheckStatLT(Player1,100,RESISTACID)
THEN
	RESPONSE #100
		IncrementGlobal("Iaacidcircle","LOCALS",1)
		Continue()
END

