IF
	Global("toggle","AR1513",0)  // Bodhi's Hunt Level 2
	Clicked([ANYONE])
	GlobalLT("page","AR1513",11)  // Bodhi's Hunt Level 2
THEN
	RESPONSE #100
		SetGlobal("toggle","AR1513",1)  // Bodhi's Hunt Level 2
		DisplayString(Myself,48319)  // Click again to turn the yellowed pages of this ancient tome.
END

IF
	Global("toggle","AR1513",0)  // Bodhi's Hunt Level 2
	Clicked([ANYONE])
	Global("page","AR1513",11)  // Bodhi's Hunt Level 2
	GlobalTimerExpired("Iatoggle","AR1513")  // Bodhi's Hunt Level 2
	CombatCounter(0)
THEN
	RESPONSE #100
		SetGlobal("toggle","AR1513",1)  // Bodhi's Hunt Level 2
		DisplayString(Myself,48319)  // Click again to turn the yellowed pages of this ancient tome.
END

IF
	Clicked([ANYONE])
	Global("toggle","AR1513",1)  // Bodhi's Hunt Level 2
	Global("page","AR1513",0)  // Bodhi's Hunt Level 2
THEN
	RESPONSE #100
		DisplayString(Myself,50657)  // You turn a page in the ancient tome, and a magic portal suddenly opens, spawning a bloodthirsty monster!
		SetGlobal("toggle","AR1513",0)  // Bodhi's Hunt Level 2
		SetGlobalTimer("Ianorest","AR1513",TWO_HOURS)  // Bodhi's Hunt Level 2
		IncrementGlobal("page","AR1513",1)  // Bodhi's Hunt Level 2
		CreateVisualEffect("SPPLANAR",[2196.634])
		Wait(2)
		CreateCreature("kobcap01",[2196.634],NE)  // Kobold Captain
END

