  COUNT_2DA_COLS ~colcount~
  SET description_col = $kitlist_cols("HELP")
  SET_2DA_ENTRY_LATER ~s!paladin_desc~ $kitlist_rows("CAVALIER") description_col RESOLVE_STR_REF (@5133)
  SET_2DA_ENTRY_LATER ~s!paladin_desc~ $kitlist_rows("INQUISITOR") description_col RESOLVE_STR_REF (@5132)
  SET_2DA_ENTRY_LATER ~s!paladin_desc~ $kitlist_rows("UNDEAD_HUNTER") description_col RESOLVE_STR_REF (@5135)
  SET_2DA_ENTRY_LATER ~s!paladin_desc~ $kitlist_rows("Blackguard") description_col RESOLVE_STR_REF (@5136)
