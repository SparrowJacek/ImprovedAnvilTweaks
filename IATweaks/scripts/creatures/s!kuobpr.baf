	!GlobalTimerNotExpired("IaRemoveMagicWait","LOCALS")
	Allegiance(Myself,ENEMY)
	See([PC])
    CheckStatGT([PC],15,DISPELLABLEBUFFSPOWER)
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	TriggerOverride([PC], Range([PC], 15))
	TriggerOverride([PC], CheckStatGT([PC],5,DISPELLABLEBUFFSPOWER))
	!TriggerOverride([PC], CheckStat([PC],1,SCRIPTINGSTATE7))
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
