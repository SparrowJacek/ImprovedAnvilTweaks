
IF
	!See([PC])
	InMyArea(Player1)
	NumberOfTimesTalkedTo(0)
	Global("Iapcastts","GLOBAL",0)
	Global("IaInitialWait","LOCALS",0)
THEN
	RESPONSE #100
	    SetInterrupt(FALSE)
	    SetGlobal("IaInitialWait","LOCALS",1)
	    Wait(5)
	    SetInterrupt(TRUE)
END

IF
	!See([PC])
	InMyArea(Player1)
	NumberOfTimesTalkedTo(0)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

IF
	See([PC])
	NumberOfTimesTalkedTo(0)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
	    AddAreaFlag(NOREST)
		StartDialogueNoSet([PC])
END

IF
	Die()
THEN
	RESPONSE #100
	    RemoveAreaFlag(NOREST)
END

IF
	GlobalGT("IaUndeadWaves","GLOBAL",0)
	GlobalLT("IaUndeadWaves","GLOBAL",4)
THEN
	RESPONSE #100
		NoAction()
END

IF
	Global("IaUndeadWaves","GLOBAL",4)
	Global("IaTeleportBack","LOCALS",0)
THEN
	RESPONSE #100
	    SetGlobal("IaTeleportBack","LOCALS",1)
		JumpToPoint([1885.1736])
		SetGlobal("IaPrep","LOCALS",0)
		SetGlobal("Iaonewing","LOCALS",0)
		Rest()
END

IF
	InMyArea(Player1)
	XPLT(Player1,3000000)
	Global("IaToneDown","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaToneDown","LOCALS",2)
		SetGlobal("Iamywail","LOCALS",5)
		RemoveSpellRES("SPIN692")
		RemoveSpellRES("SPIN692")
END

IF
	InMyArea(Player1)
	XPLT(Player1,3400000)
	Global("IaToneDown","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaToneDown","LOCALS",1)
		SetGlobal("Iamywail","LOCALS",4)
		RemoveSpellRES("SPIN692")
END

IF
	InMyArea(Player1)
	OR(2)
		NumberOfTimesTalkedTo(0)
		Global("IaPrep","LOCALS",0)
	Global("Iareaction","ARia14",0)
	OR(5)
		AttackedBy([GOODCUTOFF],DEFAULT)
		AttackedBy([PC],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		SpellCastOnMe([PC],0)
		TookDamage()
THEN
	RESPONSE #100
		SetGlobal("Iareaction","ARia14",1)
END

IF
	Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	OR(2)
		See(NearestEnemyOf(Myself))
		Global("Iareaction","ARia14",1)
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
		ReallyForceSpellRES("SPWII03",Myself)  // Spell Turning
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		SetGlobal("Iaattack","LOCALS",2)
END

IF
	Allegiance(Myself,ENEMY)
	Detect([PC])
	Global("Iatreasure","LOCALS",0)
	Global("Iaaxeplace","GLOBAL",2)
THEN
	RESPONSE #100
		SetGlobal("Iaaxeplace","GLOBAL",4)
		SetGlobal("Iatreasure","LOCALS",1)
		GiveItemCreate("ax1h10",Myself,0,0,0)  // Azuredge +3
		Continue()
END

