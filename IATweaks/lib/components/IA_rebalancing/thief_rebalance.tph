// Add this ability to every class and kit that can use detect illusions at lvl 1

ACTION_FOR_EACH class_kit_which_can_detect_illusions IN ~CLABTH01.2da~ ~CLABTH02.2da~ ~CLABTH03.2da~ ~CLABTH04.2da~ ~CLABTH05.2da~ ~CLABMO02~ ~CLABSH01~ BEGIN
  LAF ~S!ADD_CLAB_ROW~
    STR_VAR
      filename = ~%class_kit_which_can_detect_illusions%~
      row_desc = ~PASSIVE_DETECT_ILLUSIONS~
      level1 = ~AP_S!DIBASE~
  END
END

//////// Thieving for various creatures /////////

// Add repeating effects for Pickpocket and Detect Illusions to all creatures that have proper class/kit

COPY_EXISTING_REGEXP GLOB ~.+\.cre~ ~override~
  READ_LONG 0x244 cre_kit
  READ_BYTE 0x273 cre_class
  // Pickpocket
  PATCH_IF %cre_class% == 4 OR %cre_class% == 5 OR %cre_class% == 9 OR %cre_class% == 10 OR %cre_class% == 13 OR %cre_class% == 15 BEGIN
    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 146
        target = 1
        parameter2 = 1
        timing = 9
        resist_dispel = 0
      STR_VAR
        resource = ~S!PPBASE~
        effsource = ~S!PPBASE~
    END
  END
  // Detect Illusionsx
  PATCH_IF %cre_class% == 4 OR %cre_class% == 9 OR %cre_class% == 10 OR %cre_class% == 13 OR %cre_class% == 15 OR %cre_class% == 21 OR %cre_kit% == 1076101120 BEGIN
    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 146
        target = 1
        parameter2 = 1
        timing = 9
        resist_dispel = 0
      STR_VAR
        resource = ~S!DIBASE~
        effsource = ~S!DIBASE~
    END
  END
  BUT_ONLY

