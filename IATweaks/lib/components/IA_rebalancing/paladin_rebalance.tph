// update class description for Paladins
COPY_EXISTING ~clastext.2da~ ~override/clastext.2da~
  COUNT_2DA_COLS ~colcount~
  SET description_col = $clastext_cols("DESCSTR")
  SET_2DA_ENTRY_LATER ~s!paladin_desc~ $clastext_rows("PALADIN") description_col RESOLVE_STR_REF (@5131)
  SET_2DA_ENTRY_LATER ~s!paladin_desc~ $clastext_rows("CAVALIER") description_col RESOLVE_STR_REF (@5133)
  SET_2DA_ENTRY_LATER ~s!paladin_desc~ $clastext_rows("INQUISITOR") description_col RESOLVE_STR_REF (@5132)
  SET_2DA_ENTRY_LATER ~s!paladin_desc~ $clastext_rows("UNDEAD_HUNTER") description_col RESOLVE_STR_REF (@5135)
  SET_2DA_ENTRY_LATER ~s!paladin_desc~ $clastext_rows("BLACKGUARD") description_col RESOLVE_STR_REF (@5136)
  SET_2DA_ENTRIES_NOW ~s!paladin_desc~ ~colcount~
  PRETTY_PRINT_2DA

