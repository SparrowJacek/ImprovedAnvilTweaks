IF
	!GlobalTimerNotExpired("IaSwapPlaces","LOCALS")
	!Range(SecondNearestEnemyOf(Myself),4)
	!Dead("S!BAROCK")
	!Range("S!BAROCK",4)
	TriggerOverride("S!BAROCK",Range(SecondNearestEnemyOf(Myself),5))
	See("S!BAROCK")
THEN
	RESPONSE #100
		SetGlobalTimer("IaSwapPlaces","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("S!SWAPMI",LastSeenBy(Myself))
	RESPONSE #100
	    Continue()
END

IF
	!GlobalTimerNotExpired("IaSwapPlaces","LOCALS")
	Range(SecondNearestEnemyOf(Myself),4)
	!Dead("GAROCK")
	!Range("GAROCK",4)
	!TriggerOverride("GAROCK",Range(SecondNearestEnemyOf(Myself),5))
	TriggerOverride("GAROCK",Global("IaWhrwnd","LOCALS",1))
	See("GAROCK")
THEN
	RESPONSE #100
		SetGlobalTimer("IaSwapPlaces","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("S!SWAPMI",LastSeenBy(Myself))
	RESPONSE #50
	    Continue()
END

IF
	!GlobalTimerNotExpired("IaSwapPlaces","LOCALS")
	!GlobalTimerNotExpired("IaNextCharge","LOCALS")
	Range(SecondNearestEnemyOf(Myself),4)
	!Dead("GAROCK")
	!Range("GAROCK",4)
	Range(FarthestEnemyOf(Myself),10)
	!TriggerOverride("GAROCK",Range(FarthestEnemyOf(Myself),10))
	See("GAROCK")
THEN
	RESPONSE #100
		SetGlobalTimer("IaSwapPlaces","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("S!SWAPMI",LastSeenBy(Myself))
	RESPONSE #250
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	HaveSpellRES("SPINI51")
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaChainBreakerStance","LOCALS")
	OR(3)
	    See(ThirdNearestEnemyOf(Myself))
	    See(SecondNearestEnemyOf(Myself))
	    See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaChainBreakerStance","LOCALS",FIVE_ROUNDS)
		ForceSpellRES("SPINI51",Myself)
		RemoveSpellRES("SPINI51")
END

IF
	Allegiance(Myself,ENEMY)
	HaveSpellRES("SPINI34")
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	Range(ThirdNearestEnemyOf(Myself),5)
    !CheckStatGT(NearestEnemyOf(Myself),2,SCRIPTINGSTATE6)
	CheckStatLT(NearestEnemyOf(Myself),1,STONESKINS)
    !CheckStatGT(SecondNearestEnemyOf(Myself),2,SCRIPTINGSTATE6)
	CheckStatLT(SecondNearestEnemyOf(Myself),1,STONESKINS)
    !CheckStatGT(ThirdNearestEnemyOf(Myself),2,SCRIPTINGSTATE6)
	CheckStatLT(ThirdNearestEnemyOf(Myself),1,STONESKINS)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ForceSpellRES("SPINI34",Myself)
		RemoveSpellRES("SPINI34")
	RESPONSE #0
	    Continue()
END

