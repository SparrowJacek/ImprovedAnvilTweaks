	!CheckSpellState(Myself,HIDE_IN_SHADOWS_SUCCESS)
	!CheckSpellState(Myself,HIDE_IN_SHADOWS_FAIL)
	!StateCheck(Myself,STATE_INVISIBLE)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	OR(3)
	    See(NearestEnemyOf(Myself))
	    See(SecondNearestEnemyOf(Myself))
	    See(ThirdNearestEnemyOf(Myself))
THEN
	RESPONSE #100
		ForceSpellRES("S!HISBAS",Myself)  // No such index
END


IF
	Allegiance(Myself,ENEMY)
	GlobalTimerNotExpired("PoisonWeapon","LOCALS")
	OR(2)
        StateCheck(Myself,STATE_INVISIBLE)
        CheckStatGT(Myself,0,ASSASSINATE)
	See([PC.0.0.MAGE_ALL])
	HPLT([PC.0.0.MAGE_ALL],100)
	CheckStatLT([PC.0.0.MAGE_ALL],75,RESISTPIERCING) // PIERCING/CRUSHING/SLASHING
    !CheckStatGT([PC.0.0.MAGE_ALL],1,SCRIPTINGSTATE6)
	!CheckStatGT([PC.0.0.MAGE_ALL],0,STONESKINS)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_MIRRORIMAGE)
	!StateCheck(LastSeenBy(Myself),STATE_POISONED)
	!CheckSpellState([PC.0.0.MAGE_ALL],POISON_EFFECT_IMMUNITY)
	CheckStatLT(LastSeenBy(Myself),60,RESISTPOISON)
	CheckStat(LastSeenBy(Myself),0,IMMUNITY_TO_BACKSTAB)
	Range([PC.0.0.MAGE_ALL],5)
THEN
	RESPONSE #100
		EquipMostDamagingMelee()
		AttackOneRound(LastSeenBy(Myself))
END

