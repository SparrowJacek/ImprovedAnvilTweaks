    !GlobalTimerNotExpired("Iaspell","LOCALS")
	See(FourthNearest([PC])) 
	TriggerOverride(FourthNearest([PC]), Range([PC], 10))
	TriggerOverride(FourthNearest([PC]), Range(SecondNearest([PC]), 10))
	CheckStatLT(FourthNearest([PC]),50,RESISTFIRE)
	CheckStatLT([PC],75,RESISTFIRE)
	CheckStatLT(SecondNearest([PC]),90,RESISTFIRE)
THEN
	RESPONSE #200
		SetGlobalTimer("Iaspell","LOCALS",THREE_ROUNDS)
		SpellNoDecRES("S!FISSUR", FourthNearest([PC]))
	RESPONSE #50
	    Continue()
END

