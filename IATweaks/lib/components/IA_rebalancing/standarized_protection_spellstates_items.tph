// Dispellable protection from fire
  LPF ~S!ITEM_USES_OPCODE~
  INT_VAR
    check_globals  = 1
    check_headers  = 1
    match_dispel   = 3
    match_opcode   = 30
    min_duration   = 12
  RET
    is_found
  END
  PATCH_IF ~%is_found%~ STR_EQ ~TRUE~ BEGIN
    LPF ~S!ITEM_USES_OPCODE~
    INT_VAR
      check_globals  = 1
      check_headers  = 1
      match_opcode   = 328
      match_param2   = dispellable_increased_fire_resistance
    RET
        is_found
    END
    PATCH_IF ~%is_found%~ STR_EQ ~FALSE~ BEGIN
      LPF ~S!CLONE_EFFECT_ADD_VALUE~
        INT_VAR
          match_opcode      = 30
          opcode            = 328
          parameter2        = dispellable_increased_fire_resistance
          special           = 1
          duration_add      = ~-3~
      END
    END
  END
