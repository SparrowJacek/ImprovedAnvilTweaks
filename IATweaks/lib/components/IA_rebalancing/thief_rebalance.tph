      opcode = 59
      target = 1
      parameter1 = 40
      parameter2 = 0
      timing = 9
    STR_VAR
      effsource = ~S!40SS~
  END

  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 275
      target = 1
      parameter1 = 40
      parameter2 = 0
      timing = 9
    STR_VAR
      effsource = ~S!40HIS~
  END

  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 144
      target = 1
      timing = 9
    STR_VAR
      effsource = ~S!DISSTE~
  END

  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 16
      parameter2 = 1
  END

  LPF ~DELETE_CRE_ITEM~
    STR_VAR
      item_to_delete = ~SW1H75~
  END

  ADD_CRE_ITEM ~S!ILLASE~ #0 #0 #0 ~UNSTEALABLE&UNDROPPABLE~ ~WEAPON1~ EQUIP
  ADD_CRE_ITEM ~SW1H43~ #0 #0 #0 ~UNSTEALABLE~ ~WEAPON3~
