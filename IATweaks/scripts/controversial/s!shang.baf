IF
	HaveSpellRES("SPINI39")
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
    !GlobalTimerNotExpired("IaGraveSilence","LOCALS")
    !GlobalTimerNotExpired("IaSilence[PC]","LOCALS")
	Allegiance(Myself,ENEMY)
	See([PC])
	OR(6)
		Class(LastSeenBy(Myself),BARD_ALL)
		Class(LastSeenBy(Myself),SORCERER)
		Class(LastSeenBy(Myself),CLERIC_ALL)
		Class(LastSeenBy(Myself),DRUID_ALL)
		Class(LastSeenBy(Myself),SHAMAN)
		Class(LastSeenBy(Myself),MAGE_ALL)
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!HasItemEquiped("S!amul05",LastSeenBy(Myself))  // Amulet of Hades
	!HasItemEquiped("S!amul06",LastSeenBy(Myself))  // Lord of the Underworld
	!Kit(LastSeenBy(Myself),AURAMASTER)
	CheckStatGT(LastSeenBy(Myself),0,SAVEVSSPELL)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE7)
	!CheckStat(LastSeenBy(Myself),3,SCRIPTINGSTATE4)
	!StateCheck(LastSeenBy(Myself),STATE_SILENCED)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaGraveSilence","LOCALS", 18)
		SetGlobalTimer("IaSilence[PC]","LOCALS", ONE_TURN)
		RemoveSpellRES("SPINI39")
		ForceSpellRES("SPINI39", LastSeenBy(Myself))
	RESPONSE #25
	    Continue()
END

