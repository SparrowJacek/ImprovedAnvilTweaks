IF
	Allegiance(Myself,ENEMY)
	ActionListEmpty()
	CanEquipRanged()
	See([PC])
	CheckStatLT([PC],95,RESISTMISSILE)
    CheckStat([PC],0,SCRIPTINGSTATE6)
	!CheckSpellState([PC],MISSILE_IMMUNITY)
	!CheckStatGT([PC],0,STONESKINS)
	!StateCheck([PC],STATE_MIRRORIMAGE)
	!Range(NearestEnemyOf(Myself),5)
THEN
	RESPONSE #100
		SetGlobal("IaAttacking","LOCALS",1)
		EquipRanged()
		AttackReevaluate([PC],45)
END
