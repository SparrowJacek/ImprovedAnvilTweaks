IF
    HaveSpellRES("SPWII40")
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("IaImpFireballTimer","LOCALS")
	See(SixthNearest([PC]))
	CheckStatGT(LastSeenBy(Myself),0,RESISTFIRE)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!CheckStat(LastSeenBy(Myself),4,SCRIPTINGSTATE7)
	TriggerOverride(SixthNearest([PC]), Range([PC], 14))
	!TriggerOverride(SixthNearest([PC]), CheckStat([PC],4,SCRIPTINGSTATE7))
THEN
	RESPONSE #100
		SetGlobalTimer("IaImpFireballTimer","LOCALS",30)
		SetInterrupt(FALSE)
		ForceSpell(LastSeenBy(Myself),DRAGON_LOWER_FIRE)  // SPIN682.SPL (Lower Fire Resistance)
		Wait(1)
		RemoveSpellRES("SPWII40")
		ForceSpellRES("SPWII40",LastSeenBy(Myself))  // Improved FireBall
		DisplayString(Myself,19054)  // Your life ends here.
		SetInterrupt(TRUE)
END

