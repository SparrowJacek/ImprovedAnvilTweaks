
IF
	Global("Iaheal","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iaheal","LOCALS",1)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	InMyArea("ABAZIGAL")
	!Dead("ABAZIGAL")
	Global("IaLifeLink","LOCALS",0)
THEN
	RESPONSE #100
	    SetGlobal("IaLifeLink","LOCALS",1)
		ReallyForceSpellRES("S!lifeld","ABAZIGAL")  // No such index
END

IF
	See(NearestEnemyOf(Myself))
	Global("Prepare2","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Prepare2","LOCALS",1)
		SetGlobalTimer("Iagdoom","LOCALS",5)
		ReallyForceSpellRES("jwglobe",Myself)  // Globe of Invulnerability
		ReallyForceSpellRES("SPWII02",Myself)  // Protection From Magic Energy
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		ReallyForceSpellRES("SPWII03",Myself)  // Spell Turning
END

IF
	HPPercentLT(Myself,70)
	InMyArea(Player1)
	Allegiance(Myself,ENEMY)
	Global("Iacure","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iacure","LOCALS",1)
		ForceSpell(Myself,CLERIC_CURE_CRITICAL_WOUNDS)  // SPPR502.SPL (Cure Critical Wounds)
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	OR(2)
		Global("Iapcastts","GLOBAL",1)
		Global("Iadebuff","AR6005",0)  // Abazigal's Hideout
THEN
	RESPONSE #100
		NoAction()
END

IF
	!GlobalTimerNotExpired("IaNextMeleePhase","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaNextMeleePhase","LOCALS",15)
		ReallyForceSpellRES("S!NOAURA",Myself)
END

IF
	HPPercentLT(Myself,100)
	See(NearestEnemyOf(Myself))
	OR(2)
		!GlobalTimerNotExpired("pfmw","LOCALS")
		CheckStat(Myself,0,SCRIPTINGSTATE6)
	GlobalLT("Iaprotection","LOCALS",2)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		IncrementGlobal("Iaprotection","LOCALS",1)
		SetGlobalTimer("pfmw","LOCALS",FIVE_MINUTES)
		ForceSpell(Myself,PROTECTION_MAGIC_WEAPON_NOEFF)  // SPIN686.SPL (Protection From Magical Weapons)
END


IF
	HaveSpellRES("SPIN692")
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
    !GlobalTimerNotExpired("IaGreaterSilence","LOCALS")
    !GlobalTimerNotExpired("IaSilencePlayer1","LOCALS")
	Allegiance(Myself,ENEMY)
	See(Player1)
	OR(6)
		Class(LastSeenBy(Myself),BARD_ALL)
		Class(LastSeenBy(Myself),SORCERER)
		Class(LastSeenBy(Myself),CLERIC_ALL)
		Class(LastSeenBy(Myself),DRUID_ALL)
		Class(LastSeenBy(Myself),SHAMAN)
		Class(LastSeenBy(Myself),MAGE_ALL)
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!HasItemEquiped("S!amul05",LastSeenBy(Myself))  // Amulet of Hades
	!HasItemEquiped("S!amul06",LastSeenBy(Myself))  // Lord of the Underworld
	!Kit(LastSeenBy(Myself),AURAMASTER)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE7)
	!CheckStat(LastSeenBy(Myself),3,SCRIPTINGSTATE4)
	!StateCheck(LastSeenBy(Myself),STATE_SILENCED)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaGreaterSilence","LOCALS", TWO_ROUNDS)
		SetGlobalTimer("IaSilencePlayer1","LOCALS", ONE_TURN)
		RemoveSpellRES("SPIN692")
		ForceSpellRES("SPIN692", LastSeenBy(Myself))
	RESPONSE #50
	    Continue()
END

