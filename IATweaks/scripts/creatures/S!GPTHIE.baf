	Allegiance(Myself,ENEMY)
	GlobalTimerNotExpired("PoisonWeapon","LOCALS")
	OR(2)
        StateCheck(Myself,STATE_INVISIBLE)
        CheckStatGT(Myself,0,ASSASSINATE)
	See(ThirdNearest([PC.0.0.CLERIC_ALL]))
	HPLT(ThirdNearest([PC.0.0.CLERIC_ALL]),100)
	OR(2)
	    CheckStatGT(ThirdNearest([PC.0.0.CLERIC_ALL]),-20,ARMORCLASS)
	    CheckStatGT(Myself,5,CRITICALHITBONUS)
	CheckStatLT(ThirdNearest([PC.0.0.CLERIC_ALL]),50,RESISTPIERCING) // PIERCING/CRUSHING/SLASHING
    !CheckStatGT(ThirdNearest([PC.0.0.CLERIC_ALL]),0,SCRIPTINGSTATE6)
	!CheckStatGT(ThirdNearest([PC.0.0.CLERIC_ALL]),0,STONESKINS)
	!StateCheck(ThirdNearest([PC.0.0.CLERIC_ALL]),STATE_MIRRORIMAGE)
	!CheckSpellState(ThirdNearest([PC.0.0.CLERIC_ALL]),POISON_EFFECT_IMMUNITY)
	CheckStatLT(LastSeenBy(Myself),60,RESISTPOISON)
	!CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE20)
	Range(ThirdNearest([PC.0.0.CLERIC_ALL]),10)
THEN
	RESPONSE #100
		EquipMostDamagingMelee()
		AttackOneRound(LastSeenBy(Myself))
END

