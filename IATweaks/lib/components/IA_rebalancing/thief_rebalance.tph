/////////// Items ////////////

COPY_EXISTING ~potn36.itm~ ~override~
  LPF ~ADD_ITEM_EFFECT~
    INT_VAR
      opcode = 321
      insert_point = 0
      target = 1
      power = 4
    STR_VAR
      resource = "POTN36"
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      opcode = ~-1~
      resist_dispel = 3
  END

ACTION_FOR_EACH perception_potion_item IN ~POTN39.itm~ ~s!potn09.itm~ BEGIN
  COPY_EXISTING ~%perception_potion_item%~ ~override~
    SAY IDENTIFIED_DESC @7001
    LPF ~ADD_ITEM_EFFECT~
      INT_VAR
        opcode = 321
        insert_point = 0
        target = 1
        power = 4
      STR_VAR
        resource = "POTN39"
    END
    LPF ~ADD_ITEM_EFFECT~
      INT_VAR
        opcode = 321
        insert_point = 0
        target = 1
        power = 4
      STR_VAR
        resource = "S!POTN09"
    END
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 59
        parameter1 = 10
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 92
        opcode = 276
    END
    LPF ~ALTER_EFFECT~
      INT_VAR
        opcode = ~-1~
        resist_dispel = 3
    END
END

