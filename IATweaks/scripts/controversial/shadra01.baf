	!HPLT(Myself,1)
	Global("Iapcastts","GLOBAL",0)
	See(NearestEnemyOf(Myself))
	CheckStatLT(Myself,1,STONESKINS)
	CheckStat(Myself,0,SCRIPTINGSTATE6)
	HPPercentLT(Myself,100)
	Global("Iashadra10","LOCALS",0)
	!GlobalTimerNotExpired("pfmw","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("Iashadra10","LOCALS",1)
		SetGlobalTimer("pfmw","LOCALS",FOUR_ROUNDS)
		DisplayString(Myself,39968)  // Spell Trigger—Fired
		ReallyForceSpell(Myself,PROTECTION_MAGIC_WEAPON_NOEFF)  // SPIN686.SPL (Protection From Magical Weapons)
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		ReallyForceSpellRES("SPWII02",Myself)  // Protection From Magic Energy
END

IF
	Allegiance(Myself,ENEMY)
	CheckStatLT(Myself,1,STONESKINS)
	See(NearestEnemyOf(Myself))
	Global("Iashadra10","LOCALS",1)
	OR(2)
		!GlobalTimerNotExpired("pfmw","LOCALS")
		CheckStat(Myself,0,SCRIPTINGSTATE6)
	GlobalLT("Iashadra09","LOCALS",3)
THEN
	RESPONSE #100
		IncrementGlobal("Iashadra09","LOCALS",1)
		SetGlobalTimer("pfmw","LOCALS",FIVE_MINUTES)
		ForceSpell(Myself,PROTECTION_MAGIC_WEAPON_NOEFF)  // SPIN686.SPL (Protection From Magical Weapons)
END

