IF
	AreaCheck("AR4500")  // Pocket Plane
	GlobalGT("Iaepicbattle","AR4500",2)  // Pocket Plane
	Global("Iasuicide","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iasuicide","LOCALS",1)
		DestroySelf()
END

IF
	See(NearestEnemyOf(Myself))
	Global("EnemySeen","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("EnemySeen","LOCALS",1)
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	AreaCheck("AR4500")  // Pocket Plane
	GlobalGT("Iapasha","AR4500",0)  // Pocket Plane
	Exists("S!pasha2")  // Pasha Mahmoud
	!Dead("S!pasha2")  // Pasha Mahmoud
	OR(2)
		See("S!pasha2")  // Pasha Mahmoud
		See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Detect([PC])
	Global("Iatimer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobal("Iatimer","LOCALS",1)
		SetGlobal("Iawhirlwind","LOCALS",0)
END

IF
	GlobalGT("Iawhirlwind","LOCALS",0)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("Iawhirlwind","LOCALS",0)
		Continue()
END
IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Range(Player1, 7)
	OR(2)
	    CheckStatLT(Player1,100,RESISTELECTRICITY)
	    CheckStatLT(Player1,100,RESISTSLASHING)
THEN
	RESPONSE #100
		IncrementGlobal("Iawhirlwind","LOCALS",1)
		Continue()
END

