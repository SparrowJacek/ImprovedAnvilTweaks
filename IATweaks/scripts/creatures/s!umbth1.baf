IF
	!GlobalTimerNotExpired("IaNextCharge","LOCALS")
	!GlobalTimerNotExpired("IaRunToCharge","LOCALS")
	See(FarthestEnemyOf(Myself))
	Range(LastSeenBy(Myself),10)
	!Range(LastSeenBy(Myself),7)
	!Range(ThirdNearest([ANYONE]),4)
	!GlobalTimerNotExpired("IaAction","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaRunToCharge","LOCALS",10)
	    RunAwayFromNoInterrupt(LastSeenBy(Myself),20)
END

IF
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaBreakCharge","LOCALS")
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	See([PC])
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!CheckSpellState(LastSeenBy(Myself),CONFUSION_IMMUNITY)
	CheckStatLT(LastSeenBy(Myself),25,RESISTMAGIC)
    CheckStatGT(LastSeenBy(Myself),1,SAVEVSSPELL)
    OR(2)
        CheckStatGT(LastSeenBy(Myself),5,SAVEVSSPELL)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!CheckStat(LastSeenBy(Myself),3,SCRIPTINGSTATE7)
	!CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
THEN
	RESPONSE #100
		ReallyForceSpellRES("S!CHARG6",Myself)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ForceSpell(LastSeenBy(Myself),HULK_CONFUSION)  // SPIN839.SPL (Confusion)
END

