// Make Heal, Mend Body and Natural Restoral dispel casting speed penalties

ACTION_FOR_EACH heal_spell IN ~SPIN734~ ~DEVAHEAL~ ~SPPR615~ ~SPPR607~ ~SPWISH28~ ~SPWISH39~ ~SPWM168~ ~SPCLI15~ BEGIN
  COPY_EXISTING ~%heal_spell%.spl~ ~override~
    PATCH_FOR_EACH silence_cast_penalty IN ~S!-CAST5~ ~S!-CAST4~ ~S!-CAST3~ ~S!-CAST2~ ~S!-CAST1~ BEGIN
      LPF ~CLONE_EFFECT~
        INT_VAR
          match_opcode = 17
          opcode = 321
          parameter1 = 0
          parameter2 = 0
          timing = 0
          dicenumber = 0
          dicesize = 0
        STR_VAR
          resource = EVAL ~%silence_cast_penalty%~
      END
    END
END

