	OR(2)
		CheckStatLT(FourthNearest([PC]),80,RESISTCOLD)
		CheckStatLT(FourthNearest([PC]),75,RESISTPIERCING)
	OR(2)
		CheckStatLT(FifthNearest([PC]),80,RESISTCOLD)
		CheckStatLT(FifthNearest([PC]),75,RESISTPIERCING)
	Range(FifthNearest([PC]),18)
	Range(FourthNearest([PC]),18)
	TriggerOverride(FourthNearest([PC]),Range(FifthNearest([PC]),3))
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",THREE_ROUNDS)
		ForceSpellRES("S!SPIKE", FourthNearest([PC]))
END

