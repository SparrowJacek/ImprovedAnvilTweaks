	!GlobalTimerNotExpired("IaWeaponUnusable","LOCALS")
	OR(2)
        !WeaponEffectiveVs(NearestEnemyOf(Myself),MAINHAND)
        !WeaponCanDamage(NearestEnemyOf(Myself),MAINHAND)
THEN
	RESPONSE #100
	    SetGlobalTimer("IaWeaponUnusable","LOCALS",ONE_ROUND)
		ClearActions(Myself)
END


IF
	Allegiance(Myself,ENEMY)
	AreaCheck("AR0530")  // Storehouse
	InMyArea(Player1)
	!See([PC])
	!See([GOODCUTOFF])
	!HasItem("bolt03",Myself)  // Bolt of Lightning
	Global("Iadoonce","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iadoonce","LOCALS",1)
		ForceSpell(Myself,GAROCK_TELEPORT)  // SPIN565.SPL (Dimension Door)
		JumpToPoint([297.576])
END


