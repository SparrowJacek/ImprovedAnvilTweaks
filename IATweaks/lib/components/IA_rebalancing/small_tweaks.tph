// Add new spellstate and immunities to items protecting from psionics

ACTION_FOR_EACH psionic_item IN ~MISC9Y~ ~SW2H21~ ~S!SW22~ BEGIN
  COPY_EXISTING ~%psionic_item%.itm~ ~override~
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 206
        multi_match = 1
      STR_VAR
        resource = ~S!MFSOFT~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 206
        multi_match = 1
      STR_VAR
        resource = ~S!MFSOFT~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 206
        multi_match = 1
      STR_VAR
        resource = ~S!MFSOF1~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 206
        multi_match = 1
      STR_VAR
        resource = ~S!MFBLST~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 206
        multi_match = 1
      STR_VAR
        resource = ~S!MFBLS1~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 206
        multi_match = 1
      STR_VAR
        resource = ~S!MFBLS2~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 206
        multi_match = 1
        opcode = 328
        parameter2 = psionics_immunity_splstate
        special = 1
    END
END

