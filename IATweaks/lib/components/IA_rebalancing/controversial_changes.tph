///////////// Make elemental damage from weapons not bypass magic resistances //////////////

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
  GET_OFFSET_ARRAY headers ITM_V10_HEADERS
  READ_SHORT 0x1c category
  PATCH_IF ((category != 0) AND (category != 28)) BEGIN // claws, 1-hit attacks etc
    READ_LONG 0x6a effects_offset
    PHP_EACH headers AS int => header_off BEGIN
      // READ_ASCII cont_off + 0x78 key // key item
      READ_BYTE header_off + 0x2 location
      READ_SHORT header_off + 0x1e num_effects
      READ_SHORT header_off + 0x20 effect_index
      PATCH_IF (location = 1) BEGIN // 1 == weapon
        FOR (current_eff_index = effect_index; current_eff_index < effect_index + num_effects; ++current_eff_index) BEGIN
          SET current_effect_offset = (effects_offset + current_eff_index * 0x30)
          READ_SHORT current_effect_offset opcode
          PATCH_IF (opcode = 12) BEGIN // damage
            READ_SHORT (current_effect_offset + 0x0a) damage_type
            READ_SHORT (current_effect_offset + 0x12) probab_1
            READ_SHORT (current_effect_offset + 0x13) probab_2
            PATCH_IF (((damage_type BAND 0b11001001111) > 0) AND (probab_1 < 100 OR probab_2 > 0)) BEGIN // Any form of elemental non-poison damage
              WRITE_BYTE (current_effect_offset + 0x0d) 1 // Does not break through resistances
            END
          END
        END
      END
    END
  END

  BUT_ONLY

