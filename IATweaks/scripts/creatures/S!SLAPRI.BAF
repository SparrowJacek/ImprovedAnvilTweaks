IF
	Global("EnemySeen","LOCALS",0)
	Global("Iadoonce","LOCALS",0)
	HPPercentLT(Myself,100)
	InMyArea(Player1)
	!Detect([PC])
	!Detect([GOODCUTOFF])
THEN
	RESPONSE #100
		SetGlobal("Iadoonce","LOCALS",1)
		Shout(ALERT)
		MoveToObject(Player1)
END

IF
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("Iashout","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iashout","LOCALS",1)
		Shout(ALERT)
		CreateCreatureObject("S!slassa",Myself,0,0,0)  // Assassin - Assassin
		CreateCreatureObject("slguard1",Myself,0,0,0)  // Slaver Guard
		CreateCreatureObject("slguard2",Myself,0,0,0)  // Slaver Guard
END

IF
	Allegiance(Myself,ENEMY)
	XPGT(Player1,799999)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("Iaapri01","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iaapri01","LOCALS",1)
		SetGlobalTimer("truesight","LOCALS",TEN_ROUNDS)
		ReallyForceSpell(Myself,CLERIC_REMOVE_FEAR)  // SPPR108.SPL (Remove Fear)
		ReallyForceSpell(Myself,CLERIC_ARMOR_OF_FAITH)  // SPPR111.SPL (Armor of Faith)
		ReallyForceSpell(Myself,CLERIC_AID)  // SPPR201.SPL (Aid)
		ReallyForceSpell(Myself,CLERIC_CHANT)  // SPPR203.SPL (Chant)
		ReallyForceSpell(Myself,CLERIC_DRAW_UPON_HOLY_MIGHT)  // SPPR214.SPL (Draw Upon Holy Might)
		ReallyForceSpell(Myself,CLERIC_PROTECTION_FROM_FIRE)  // SPPR306.SPL (Protection From Fire)
		ReallyForceSpell(Myself,CLERIC_STRENGTH_OF_ONE)  // SPPR312.SPL (Strength of One)
		ReallyForceSpell(Myself,CLERIC_FREE_ACTION)  // SPPR403.SPL (Free Action)
		ReallyForceSpell(Myself,CLERIC_PROTECTION_FROM_LIGHTNING)  // SPPR407.SPL (Protection From Lightning)
		ReallyForceSpell(Myself,CLERIC_DEATH_WARD)  // SPPR409.SPL (Death Ward)
		ReallyForceSpell(Myself,CLERIC_HOLY_POWER)  // SPPR412.SPL (Holy Power)
		ReallyForceSpell(Myself,CLERIC_CAUSE_SERIOUS_WOUNDS)  // SPPR414.SPL (Cause Serious Wounds)
		ReallyForceSpell(Myself,CLERIC_TRUE_SIGHT)  // SPPR505.SPL (True Seeing)
		ReallyForceSpell(Myself,CLERIC_CHAOTIC_COMMANDS)  // SPPR508.SPL (Chaotic Commands)
		ReallyForceSpell(Myself,CLERIC_SLAY_LIVING)  // SPPR511.SPL (Slay Living)
		ReallyForceSpell(Myself,CLERIC_RIGHTEOUS_MAGIC)  // SPPR513.SPL (Righteous Magic)
		ReallyForceSpell(Myself,CLERIC_PHYSICAL_MIRROR)  // SPPR613.SPL (Protection From Missiles)
		ReallyForceSpell(Myself,CLERIC_CHAMPIONS_STRENGTH)  // sppr618.spl (Champion's Might)
		ReallyForceSpellRES("SPPR698",Myself)  // Blade Barrier
		ReallyForceSpell(Myself,CLERIC_SHIELD_OF_THE_ARCHONS)  // SPPR701.SPL (Shield of the Archons)
		EquipItem("SERIOUS")  // Cause Serious Wounds
END

