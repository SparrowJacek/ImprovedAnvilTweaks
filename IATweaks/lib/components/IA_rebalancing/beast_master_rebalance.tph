SILENT

INCLUDE "%MOD_FOLDER%/lib/components/IA_rebalancing/helper_functions.tph"

// Remove Dualclassing possibility from Beastmaster kit

COPY_EXISTING ~DUALCLAS.2da~ ~override~
  REPLACE_EVALUATE
    ~BEASTMASTER.*~
    BEGIN
    END
    ~BEASTMASTER 0 0 0 0 0 0~
  PRETTY_PRINT_2DA

// Make Beast Masters able to put *** points into all weapons they can use

LAF ~S!MAP_COLUMN_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~weapprof.2da~
  RET_ARRAY
    weapprof_cols = 2da_columns_to_ids_mapping
END

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~weapprof.2da~
  RET_ARRAY
    weapprof_rows = 2da_rows_to_ids_mapping
END

COPY_EXISTING ~weapprof.2da~  ~override/weapprof.2da~
  COUNT_2DA_COLS ~colcount~
  SET BM_column = $weapprof_cols("BEASTMASTER")
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ $weapprof_rows("CLUB") %BM_column% ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ $weapprof_rows("SPEAR") %BM_column% ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ $weapprof_rows("MACE") %BM_column% ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ $weapprof_rows("QUARTERSTAFF") %BM_column% ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ $weapprof_rows("CROSSBOW") %BM_column% ~0~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ $weapprof_rows("LONGBOW") %BM_column% ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ $weapprof_rows("SHORTBOW") %BM_column% ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ $weapprof_rows("DART") %BM_column% ~0~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ $weapprof_rows("SLING") %BM_column% ~3~
  SET_2DA_ENTRIES_NOW ~_#_#_#weapprof~ ~colcount~
  PRETTY_PRINT_2DA

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
  READ_SHORT 0x1c item_category
  // Make all spears and maces usable by Beast Masters
  PATCH_IF (item_category = 29 OR item_category = 17)
    THEN BEGIN  
      READ_BYTE 0x2b usability_flags_2
      WRITE_BYTE 0x2b (%usability_flags_2% BAND 0b11111101)
  END
  // Make all crossbows, bolts and darts unusable by Beast Masters
  PATCH_IF (item_category = 27 OR item_category = 31 OR item_category = 24)
    THEN BEGIN  
      READ_BYTE 0x2b usability_flags_2
      WRITE_BYTE 0x2b (%usability_flags_2% BOR 0b00000010)
  END
  BUT_ONLY

// Remove old abilities

COPY_EXISTING ~CLABRN04.2da~ ~override~
  REPLACE_EVALUATE
    ~AP_SPCL341~
    BEGIN
    END
    ~****~
  REPLACE_EVALUATE
    ~GA_SPCL342~
    BEGIN
    END
    ~****~
  REPLACE_EVALUATE
    ~GA_SPRA30[4-6]~
    BEGIN
    END
    ~****~
  PRETTY_PRINT_2DA

