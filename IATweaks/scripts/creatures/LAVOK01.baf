IF
	NumberOfTimesTalkedTo(0)
	Detect([PC])
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		StartDialogueNoSet([PC])
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([GOODCUTOFF])
		Detect([PC])
	Global("partyfled","LOCALS",1)
	Global("Ialavok21","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	OR(2)
		Detect([GOODCUTOFF])
		Detect([PC])
	Global("Ialavok02","LOCALS",0)
	Global("Ialavok21","LOCALS",0)
THEN
	RESPONSE #100
		Enemy()
		SetGlobal("Ialavok02","LOCALS",1)
		SetGlobalTimer("Iatpt","LOCALS",66)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_ENERGY)  // SPWI606.SPL (Protection From Magic Energy)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_THE_ELEMENTS)  // SPWI702.SPL (Protection From The Elements)
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_BLUE)  // SPWI403.SPL (Fire Shield (Blue))
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Fire Shield (Red))
		ReallyForceSpell(Myself,WIZARD_GLOBE_OF_INVULNERABILITY)  // SPWI602.SPL (Globe of Invulnerability)
		ReallyForceSpell(Myself,WIZARD_SPELL_TURNING)  // SPWI701.SPL (Spell Turning)
		ReallyForceSpellRES("SPWI804",Myself)  // Tenser's Partial Transformation
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_ABJURATION)  // SPWI590.SPL (Immunity: Abjuration)
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iasummon","LOCALS",0)
	Global("Ialavok21","LOCALS",0)
	OR(2)
		Global("Iahardmode","GLOBAL",1)
		XPGT(Player1,1699999)
	See([PC])
THEN
	RESPONSE #100
		SetGlobal("Iasummon","LOCALS",1)
		CreateCreatureObject("S!geml",LastSeenBy(Myself),0,0,0)  // Gem Golem
		CreateCreatureObject("S!geml",LastSeenBy(Myself),0,0,0)  // Gem Golem
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iasummon","LOCALS",0)
	Global("Ialavok21","LOCALS",0)
	XPLT(Player1,1700000)
	See([PC])
THEN
	RESPONSE #100
		SetGlobal("Iasummon","LOCALS",1)
		CreateCreatureObject("S!geml",LastSeenBy(Myself),0,0,0)  // Gem Golem
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iacells","AR0410",0)  // Sphere: Navigator's room -- Lavok's Hideout
	Global("Ialavok21","LOCALS",0)
	OR(2)
		See([PC])
		Global("Iasummon","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iacells","AR0410",1)  // Sphere: Navigator's room -- Lavok's Hideout
		SetGlobalTimer("Iacellskels","LOCALS",TWO_ROUNDS)
END

