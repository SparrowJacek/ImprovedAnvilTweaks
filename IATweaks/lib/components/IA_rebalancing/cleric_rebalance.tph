// Divine Favor

COPY_EXISTING ~OHTYR2.spl~ ~override/OHTYR2.spl~
  SAY UNIDENTIFIED_DESC @6049  
  
  // Extend duration to 36s
  LPF ALTER_SPELL_EFFECT INT_VAR
    check_headers = 1
    duration = 36
  END

  // Remove previous instance of this spell to prevent stacking
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      opcode = 321
      target = 1
      insert_point = 0
      resist_dispel = 0
    STR_VAR
      resource = ~OHTYR2~
  END
  BUT_ONLY

// Tyr Righteous Magic

COPY_EXISTING ~SPPR513.spl~ ~override/SPPR513D.spl~
  WRITE_LONG  0x08      ~-1~ // spell name
  WRITE_BYTE  0x27      0 // secondary type 

  // Remove spell state BUFF_ENHANCEMENT to avoid AI problems
  LPF ~DELETE_SPELL_EFFECT~
    INT_VAR
      opcode_to_delete = 328
      match_parameter2 = 68
  END

  // Remove self for stacking reasons
  LPF ~CLONE_EFFECT~
    INT_VAR
      match_opcode = 321
      multi_match = 1
    STR_VAR
      resource = ~SPPR513D~
  END

  // Make undispellable
  LPF ~ALTER_SPELL_EFFECT~
    INT_VAR
      match_opcode = ~-1~
      resist_dispel = 0
  END

  // Extend duration by 50%
  GET_OFFSET_ARRAY ab_array SPL_V10_HEADERS
  PHP_EACH ab_array AS int => ab_off BEGIN
    GET_OFFSET_ARRAY2 fx_array ab_off SPL_V10_HEAD_EFFECTS
    PHP_EACH fx_array AS int => fx_off BEGIN
      READ_LONG (fx_off + 0x0e) duration
      PATCH_IF duration > 0 BEGIN
        WRITE_LONG (fx_off + 0x0e) duration + (duration / 2)
      END
    END
  END
BUT_ONLY
