IF
	Allegiance(Myself,ENEMY)
	GlobalGT("Iaonewing","LOCALS",0)
	Global("Iafog","ARia14",0)
	!GlobalTimerNotExpired("MyTimer","LOCALS")
	See([PC])
THEN
	RESPONSE #100
		SetGlobal("Iafog","ARia14",1)
		SetGlobalTimer("FogTimer","ARia14",FIVE_ROUNDS)
		SetGlobalTimer("MyTimer","LOCALS",TWO_ROUNDS)
		ForceSpell(LastSeenBy(Myself),WIZARD_DEATH_FOG)  // SPWI614.SPL (Death Fog)
END

IF
	Allegiance(Myself,ENEMY)
	See([PC])
	OR(3)
		StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
		StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
		StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
	!GlobalTimerNotExpired("truesight","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("truesight","LOCALS",TEN_ROUNDS)
		SetInterrupt(FALSE)
		ForceSpell(Myself,WIZARD_TRUE_SIGHT)  // SPWI609.SPL (True Sight)
		Wait(1)
		SetInterrupt(TRUE)
END

