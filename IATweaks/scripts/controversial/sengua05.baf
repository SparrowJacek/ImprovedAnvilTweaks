IF
	Allegiance(Myself,ENEMY)
	See([PC])
	!CheckStatGT(LastSeenBy(Myself),1,SCRIPTINGSTATE6)
	!CheckSpellState(LastSeenBy(Myself),MISSILE_IMMUNITY)
THEN
	RESPONSE #100
		EquipRanged()
		AttackOneRound(NearestEnemyOf(Myself))
END

