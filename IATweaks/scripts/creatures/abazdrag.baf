
IF
	Global("Iaheal","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iaheal","LOCALS",1)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	InMyArea("S!abazwife")
	!Dead("S!abazwife")
	Global("IaLifeLink","LOCALS",0)
THEN
	RESPONSE #100
	    SetGlobal("IaLifeLink","LOCALS",1)
		ReallyForceSpellRES("S!lifeld","S!abazwife")  // No such index
		JumpToObject("S!abazwife")
END


IF
	Allegiance(Myself,ENEMY)
    !GlobalTimerNotExpired("IaFlyAttackTimerMax","LOCALS")
	InMyArea(Player1)
	!HPLT(Player1,1)
	!IsActive(Myself)
THEN
	RESPONSE #100
		Activate(Myself)
		SetInterrupt(FALSE)
		SmallWait(2)
		JumpToObject(Player1)
		ForceSpellRES("S!DRGFLY",Myself)
		SetInterrupt(TRUE)
	RESPONSE #100
	    Continue()
END


IF
	HPLT(Myself,15)
	Global("Death","LOCALS",0)
	Global("Iaheal","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Death","LOCALS",1)
		SetGlobal("Iasalam","AR6005",6)  // Abazigal's Hideout
		SetGlobal("Iasummondie","AR6005",1)  // Abazigal's Hideout
		StartDialogueNoSet(Player1)
END

IF
	HPLT(Myself,15)
THEN
	RESPONSE #100
		NoAction()
END

IF
	See(NearestEnemyOf(Myself))
	Global("Prepare2","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Prepare2","LOCALS",1)
		SetGlobalTimer("ElectrifiedFloorTimer","AR6005",ONE_ROUND)  // Abazigal's Hideout
		SetGlobalTimer("TailSlap","AR6005",TWO_ROUNDS)  // Abazigal's Hideout
		ReallyForceSpellRES("jwglobe",Myself)  // Globe of Invulnerability
		ReallyForceSpellRES("SPWII02",Myself)  // Protection From Magic Energy
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		ReallyForceSpellRES("SPWII03",Myself)  // Spell Turning
END


IF
	Allegiance(Myself,ENEMY)
    !GlobalTimerNotExpired("IaFlyDragonTimer","LOCALS")
    !Dead("s!abazwife")
    OR(2)
        !See("s!abazwife")
        !Range("s!abazwife",20)
    OR(2)
        HPPercentLT("s!abazwife",70)
        !See("s!abazwife")
	IsActive(Myself)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaFlyDragonTimer","LOCALS",19)
		SetGlobalTimer("IaFlyAttackTimerMin","LOCALS",2)
		SetGlobalTimer("IaFlyAttackTimerMax","LOCALS",3)
		ForceSpellRES("S!DRGFLY",Myself)
		SmallWait(5)
		DisplayStringHead(Myself,@5187)
		Deactivate(Myself)
		SetInterrupt(TRUE)
	RESPONSE #100
	    Continue()
END

