	See(FourthNearestEnemyOfType([PC]))
	CheckStatLT(LastSeenBy(Myself),1,SCRIPTINGSTATE6)
THEN
	RESPONSE #100
		AttackOneRound(FourthNearestEnemyOfType([PC]))
END

IF
	Allegiance(Myself,ENEMY)
	See(FifthNearestEnemyOfType([PC]))
	CheckStatLT(LastSeenBy(Myself),1,SCRIPTINGSTATE6)
THEN
	RESPONSE #100
		AttackOneRound(FifthNearestEnemyOfType([PC]))
END

IF
	Allegiance(Myself,ENEMY)
	See(SixthNearestEnemyOfType([PC]))
	CheckStatLT(LastSeenBy(Myself),1,SCRIPTINGSTATE6)
THEN
	RESPONSE #100
		AttackOneRound(SixthNearestEnemyOfType([PC]))
END

IF
	Allegiance(Myself,ENEMY)
	!See([PC])
	!See([GOODCUTOFF])
	Global("EnemySeen","LOCALS",0)
	Global("anticheese","LOCALS",0)
	OR(2)
		AttackedBy([GOODCUTOFF],DEFAULT)
		HPPercentLT(Myself,100)
	InMyArea(Player1)
THEN
	RESPONSE #100
		SetGlobal("anticheese","LOCALS",1)
		SetGlobalTimer("chase2","LOCALS",THREE_ROUNDS)
		Shout(89)
END

IF
	Allegiance(Myself,ENEMY)
	GlobalTimerNotExpired("chase2","LOCALS")
	Global("anticheese","LOCALS",1)
	Global("EnemySeen","LOCALS",0)
	!See([PC])
	!See([GOODCUTOFF])
	InMyArea(Player1)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

IF
	Allegiance(Myself,ENEMY)
	GlobalTimerExpired("chase2","LOCALS")
	Global("anticheese","LOCALS",1)
	Global("EnemySeen","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("anticheese","LOCALS",0)
		SetGlobal("Iacontin","LOCALS",0)
		SetGlobal("IaSpellTrigger","LOCALS",0)
		SetGlobal("IaSpellSequencer","LOCALS",0)
		SetGlobal("IaMinorSequencer","LOCALS",0)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	Global("EnemySeen","LOCALS",0)
	Heard([EVILCUTOFF],89)
	!See([GOODCUTOFF])
	InMyArea(Player1)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

IF
	Global("EnemySeen","LOCALS",0)
	Heard([EVILCUTOFF],89)
	!See(NearestEnemyOf(Myself))
	See(LastHeardBy(Myself))
THEN
	RESPONSE #100
		MoveToObject(LastHeardBy(Myself))
END
