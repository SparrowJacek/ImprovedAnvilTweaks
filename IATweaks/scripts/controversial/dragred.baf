	See(SixthNearest([PC]))
	CheckStatLT(SixthNearest([PC]),50,MAGICDAMAGERESISTANCE)
	CheckStatLT(SixthNearest([PC]),50,RESISTMAGIC)
	!CheckStat(SixthNearest([PC]),5,SCRIPTINGSTATE7)
	!HasItemEquiped("S!halb02",LastSeenBy(Myself))  // Poseidon's Wrath +5
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		RemoveSpell(WIZARD_ABI_DALZIMS_HORRID_WILTING)
		ForceSpell(LastSeenBy(Myself),WIZARD_ABI_DALZIMS_HORRID_WILTING)  // SPWI812.SPL (Abi-Dalzim's Horrid Wilting)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #50
