IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Detect([PC])
	Global("Iatimer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobal("Iatimer","LOCALS",1)
END

IF
	Allegiance(Myself,ENEMY)
    !GlobalTimerNotExpired("Iaspell","LOCALS")
	Range(FourthNearest([PC]),15)
	OR(2)
	    CheckStatLT([PC],50,RESISTACID)
	    CheckStatLT(SecondNearest([PC]),50,RESISTACID)
	OR(2)
	    CheckStatLT([PC],50,RESISTACID)
	    CheckStatLT(ThirdNearest([PC]),50,RESISTACID)
	OR(2)
	    CheckStatLT([PC],50,RESISTACID)
	    CheckStatLT(FourthNearest([PC]),50,RESISTACID)
	OR(2)
	    CheckStatLT(SecondNearest([PC]),50,RESISTACID)
	    CheckStatLT(ThirdNearest([PC]),50,RESISTACID)
	OR(2)
	    CheckStatLT(SecondNearest([PC]),50,RESISTACID)
	    CheckStatLT(FourthNearest([PC]),50,RESISTACID)
	OR(2)
	    CheckStatLT(ThirdNearest([PC]),50,RESISTACID)
	    CheckStatLT(FourthNearest([PC]),50,RESISTACID)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",THREE_ROUNDS)
		ForceSpellRES("S!ACIDCI", Myself)
END

