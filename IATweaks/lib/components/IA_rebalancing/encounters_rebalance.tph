///////// Haegan ///////////

COPY_EXISTING ~HAEGAN.cre~ ~override~
  WRITE_SHORT 0x24 111 // HP
  WRITE_SHORT 0x26 111 // HP
  WRITE_BYTE 0x60 0 // Resist Slashing
  WRITE_BYTE 0x61 0 // Resist Crushing
  WRITE_BYTE 0x62 0 // Resist Piercing
  WRITE_BYTE 0x63 0 // Resist Missile
  WRITE_BYTE 0x23d 19 // Constitution
  WRITE_LONG 0x244 0x40010000 // Kit = Berserker

  LPF ~DELETE_CRE_ITEM~
    STR_VAR
      item_to_delete = ~S!IMMUNE~
  END

  PATCH_IF(FILE_EXISTS_IN_GAME ~POTN11.spl~) BEGIN
    ADD_CRE_ITEM ~POTN11~ #0 #0 #0 ~UNSTEALABLE&UNDROPPABLE~ ~INV15~
  END

  PATCH_IF(FILE_EXISTS_IN_GAME ~POTN56.spl~) BEGIN
    ADD_CRE_ITEM ~POTN56~ #0 #0 #0 ~UNSTEALABLE&UNDROPPABLE~ ~INV14~
  END

COPY_EXISTING ~s!haegan.itm~ ~override~
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 101
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 106
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 267
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 233
      match_parameter2 = 92
      parameter1 = 2
  END

COMPILE ~IATweaks\scripts\creatures\HAEGAN.BAF~

