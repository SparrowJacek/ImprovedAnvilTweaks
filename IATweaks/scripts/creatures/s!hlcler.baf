	!StateCheck(Myself,STATE_SILENCED)
	!Race(FourthNearest([PC]),ELF)
	!Race(FourthNearest([PC]),HALF_ELF)
	!StateCheck(FourthNearest([PC]),STATE_HELPLESS)
	!StateCheck(FourthNearest([PC]),STATE_CONFUSED)
	!StateCheck(FourthNearest([PC]),STATE_PANIC)
	!CheckStat(FourthNearest([PC]),2,SCRIPTINGSTATE3)
	!CheckStat(FourthNearest([PC]),1,SCRIPTINGSTATE4)
	!CheckStatGT(FourthNearest([PC]),0,SCRIPTINGSTATE8)
	!CheckSpellState(FourthNearest([PC]),SI_ENCHANTMENT)
	!CheckStatGT(FourthNearest([PC]),0,MINORGLOBE)
    !CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	CheckStatLT(FourthNearest([PC]),50,RESISTMAGIC)
    CheckStatGT(FourthNearest([PC]),5,SAVEVSSPELL)
	OR(2)
	    CheckStatGT(FourthNearest([PC]),9,SAVEVSSPELL)
	    !StateCheck(FourthNearest([PC]),STATE_IMPROVEDINVISIBILITY)
	See(FourthNearest([PC]))
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",ONE_MINUTE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(LastSeenBy(Myself),CLERIC_COMMAND)  // SPPR102.SPL (Command)
	RESPONSE #200
	    Continue()
END

