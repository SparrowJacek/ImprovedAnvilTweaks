    INT_VAR
      target = 1
      opcode = 188
      parameter1 = 0
      parameter2 = 1
      resist_dispel = 0
      timing = 9
  END

  LPF ~ADD_CRE_EFFECT~ // *** in Single Weapon Style
    INT_VAR
      target = 1
      opcode = 233
      parameter1 = 3
      parameter2 = 113
      resist_dispel = 0
      timing = 9
  END

  LPF ~ADD_CRE_EFFECT~ // +15 movement speed
    INT_VAR
      opcode = 126
      target = 1
