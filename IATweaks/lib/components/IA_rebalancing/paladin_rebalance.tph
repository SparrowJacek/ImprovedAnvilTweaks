PRINT @5107

SILENT

INCLUDE "%MOD_FOLDER%/lib/components/IA_rebalancing/helper_functions.tph"

// Improve Keldorn

ACTION_FOR_EACH keldorn_SoA_file IN ~KELDOR8~ ~KELDOR9~ ~KELDOR10~ ~KELDOR12~ BEGIN
  COPY_EXISTING ~%keldorn_SoA_file%.cre~ ~override~  
    WRITE_SHORT 0x24 79 // HP
    WRITE_SHORT 0x26 79 // HP
    WRITE_BYTE  0x23c 17 // dexterity
END

// Remove Smite, Deathblow and Greater Deathblow from Paladin HLAs

  COPY_EXISTING ~LUPA0.2da~ ~override~
    COUNT_2DA_COLS ~colcount~
    COUNT_2DA_ROWS ~colcount~ ~rowcount~
    SET smite_row = (0 - 1)
    SET deathblow_row = (0 - 1)
    SET greater_deathblow_row = (0 - 1)
    FOR (i = 0; i < ~rowcount~; ++i) BEGIN
      READ_2DA_ENTRY i 1 %colcount% current_val
      PATCH_IF (~%current_val%~ STR_EQ ~GA_SPCL903~) BEGIN
        SET greater_deathblow_row = i
      END
    END
    PATCH_IF (greater_deathblow_row != (0 - 1)) BEGIN
      REMOVE_2DA_ROW greater_deathblow_row ~colcount~
    END
    BUT_ONLY

  COPY_EXISTING ~LUPA0.2da~ ~override~
    COUNT_2DA_COLS ~colcount~
    COUNT_2DA_ROWS ~colcount~ ~rowcount~
    SET smite_row = (0 - 1)
    SET deathblow_row = (0 - 1)
    SET greater_deathblow_row = (0 - 1)
    FOR (i = 0; i < ~rowcount~; ++i) BEGIN
      READ_2DA_ENTRY i 1 %colcount% current_val
      PATCH_IF (~%current_val%~ STR_EQ ~GA_SPCL909~) BEGIN
        SET smite_row = i
      END
    END
    PATCH_IF (smite_row != (0 - 1)) BEGIN
      REMOVE_2DA_ROW smite_row ~colcount~
    END
    BUT_ONLY

  COPY_EXISTING ~LUPA0.2da~ ~override~
    COUNT_2DA_COLS ~colcount~
    COUNT_2DA_ROWS ~colcount~ ~rowcount~
    SET smite_row = (0 - 1)
    SET deathblow_row = (0 - 1)
    SET greater_deathblow_row = (0 - 1)
    FOR (i = 0; i < ~rowcount~; ++i) BEGIN
      READ_2DA_ENTRY i 1 %colcount% current_val
      PATCH_IF (~%current_val%~ STR_EQ ~GA_SPCL902~) BEGIN
        SET deathblow_row = i
      END
    END
    PATCH_IF (deathblow_row != (0 - 1)) BEGIN
      REMOVE_2DA_ROW deathblow_row ~colcount~
    END
    BUT_ONLY
  
// Remove Protection from Evil from all Paladins

ACTION_FOR_EACH paladin_kit_clab IN ~CLABPA01.2da~ ~CLABPA02.2da~ ~CLABPA03.2da~ ~CLABPA04.2da~ BEGIN
  COPY_EXISTING ~%paladin_kit_clab%~ ~override~
    REPLACE_EVALUATE
      ~GA_SPCL213~
      BEGIN
      END
      ~****~
    PRETTY_PRINT_2DA
END

// Rework current Protection from Evil to an AoE version

COPY_EXISTING ~SPPR408.spl~ ~override/SPCL213.spl~
  SAY UNIDENTIFIED_DESC @6283
  WRITE_SHORT 0x1c 4
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      speed = 2
      location = 4
  END

// Grant this new Prot from Evil for evey 10 levels

ACTION_FOR_EACH paladin_kit_clab IN ~CLABPA01.2da~ ~CLABPA02.2da~ ~CLABPA03.2da~ ~CLABPA04.2da~ BEGIN
  LAF ~S!ADD_CLAB_ROW~
    STR_VAR
      filename = ~%paladin_kit_clab%~
      row_desc = ~PROT_FROM_EVIL~
      level5 = ~GA_SPCL213~
      level15 = ~GA_SPCL213~
      level25 = ~GA_SPCL213~
      level35 = ~GA_SPCL213~
  END
END

// Remove all instantces of of Remove Fear from Cavalier

COPY_EXISTING ~CLABPA02.2da~ ~override~
  REPLACE_EVALUATE
    ~GA_SPCL222~
    BEGIN
    END
    ~****~
  PRETTY_PRINT_2DA

// Enable *** in Sword and Shield for Paladins

LAF ~S!MAP_COLUMN_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~weapprof.2da~
  RET_ARRAY
    weapprof_cols = 2da_columns_to_ids_mapping
END

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~weapprof.2da~
  RET_ARRAY
    weapprof_rows = 2da_rows_to_ids_mapping
END

COPY_EXISTING ~weapprof.2da~  ~override/weapprof.2da~
  COUNT_2DA_COLS ~colcount~
  SET sw_and_sh_row = $weapprof_rows("SWORDANDSHIELD")
  SET 2h_row = $weapprof_rows("2HANDED")
  SET single_weap_row = $weapprof_rows("SINGLEWEAPON")
  SET 2_weap_row = $weapprof_rows("2WEAPON")
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("PALADIN") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("CAVALIER") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("INQUISITOR") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("UNDEAD_HUNTER") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("BLACKGUARD") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2h_row $weapprof_cols("PALADIN") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2h_row $weapprof_cols("CAVALIER") ~1~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2h_row $weapprof_cols("INQUISITOR") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2h_row $weapprof_cols("UNDEAD_HUNTER") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2h_row $weapprof_cols("BLACKGUARD") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ single_weap_row $weapprof_cols("PALADIN") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ single_weap_row $weapprof_cols("CAVALIER") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ single_weap_row $weapprof_cols("INQUISITOR") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ single_weap_row $weapprof_cols("UNDEAD_HUNTER") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ single_weap_row $weapprof_cols("BLACKGUARD") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2_weap_row $weapprof_cols("PALADIN") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2_weap_row $weapprof_cols("CAVALIER") ~1~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2_weap_row $weapprof_cols("INQUISITOR") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2_weap_row $weapprof_cols("UNDEAD_HUNTER") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2_weap_row $weapprof_cols("BLACKGUARD") ~2~
  SET_2DA_ENTRIES_NOW ~_#_#_#weapprof~ ~colcount~
  PRETTY_PRINT_2DA

// Improve Lay on Hands progression

COPY_EXISTING ~spcl211.spl~ ~override~
  SAY UNIDENTIFIED_DESC @6229
  GET_OFFSET_ARRAY ab_array SPL_V10_HEADERS
  PHP_EACH ab_array AS int => ab_off BEGIN
    GET_OFFSET_ARRAY2 fx_array ab_off SPL_V10_HEAD_EFFECTS
    PHP_EACH fx_array AS int => fx_off BEGIN
      READ_SHORT (fx_off + 0x00) opcode
      PATCH_IF opcode = 17 BEGIN
        WRITE_LONG (fx_off + 0x04) THIS * 5  / 2
      END
    END
  END
BUT_ONLY

COPY ~IATweaks\resources\2da\layhands.2da~ ~override~

// Grant additional uses of Lay on Hands to Paladin

LAF ~S!ADD_CLAB_ROW~
  STR_VAR
    filename = ~CLABPA01.2da~
    row_desc = ~LAY_ON_HANDS~
    level15 = ~GA_SPCL211~
    level30 = ~GA_SPCL211~
END

