	!CheckSpellState(LastSeenBy(Myself),CONFUSION_IMMUNITY)
	!CheckStat(LastSeenBy(Myself),3,SCRIPTINGSTATE7)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE3)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	TriggerOverride(SixthNearest([PC]), Range([PC], 15))
	TriggerOverride(SixthNearest([PC]), CheckStatLT([PC],50,RESISTMAGIC))
	!TriggerOverride(SixthNearest([PC]), CheckSpellState([PC],CONFUSION_IMMUNITY))
	!TriggerOverride(SixthNearest([PC]), CheckStat([PC],3,SCRIPTINGSTATE7))
	!TriggerOverride(SixthNearest([PC]), CheckStat([PC],2,SCRIPTINGSTATE3))
	!TriggerOverride(SixthNearest([PC]), StateCheck([PC],STATE_CONFUSED))
	!TriggerOverride(SixthNearest([PC]), StateCheck([PC],STATE_HELPLESS))
	Global("IaSpellTrigger","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaSpellTrigger","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayString(Myself,39968)  // Spell Trigger—Fired
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_GREATER_MALISON)  // SPWI412.SPL (Greater Malison)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAOS)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAOS)
	RESPONSE #50
	    Continue()
END

