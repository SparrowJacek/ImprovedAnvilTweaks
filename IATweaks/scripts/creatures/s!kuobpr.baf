IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	OR(2)
		StateCheck(Myself,STATE_POISONED)
		StateCheck(Myself,STATE_DISEASED)
	GlobalTimerNotExpired("IaContinualCure","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",1)
END


IF
    HaveSpell(CLERIC_NATURE_BEAUTY)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
    !GlobalTimerNotExpired("IaNatureBeauty","LOCALS")
	CheckStat(Myself,0,SCRIPTINGSTATE6)
	OR(3)
	    See(ThirdNearestEnemyOf(Myself))
	    See(SecondNearestEnemyOf(Myself))
	    See(NearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),10)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaNatureBeauty","LOCALS",ONE_TURN)
		Spell(Myself,CLERIC_NATURE_BEAUTY)
	RESPONSE #0
	    Continue()
END
IF
	Allegiance(Myself,ENEMY)
	HaveSpell(WARRIOR_HARDINESS)
	!CheckSpellState(Myself,HARDINESS)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	!GlobalTimerNotExpired("DrankPotionTimer","LOCALS")
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	OR(3)
	    See(ThirdNearestEnemyOf(Myself))
	    See(SecondNearestEnemyOf(Myself))
	    See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ForceSpell(Myself,WARRIOR_HARDINESS)  // SPCL907.SPL (Hardiness)
		RemoveSpell(WARRIOR_HARDINESS)
END

IF
	Allegiance(Myself,ENEMY)
	HaveSpell(WARRIOR_HARDINESS)
    HaveSpellRES("spcl943")
	!CheckSpellState(Myself,HARDINESS)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
    GlobalTimerNotExpired("IaFiveSeconds","LOCALS")
	OR(3)
	    See(ThirdNearestEnemyOf(Myself))
	    See(SecondNearestEnemyOf(Myself))
	    See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
	    SetInterrupt(FALSE)
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ForceSpellRES("spcl943",Myself)
		RemoveSpellRES("spcl943")
		ForceSpell(Myself,WARRIOR_HARDINESS)  // SPCL907.SPL (Hardiness)
		RemoveSpell(WARRIOR_HARDINESS)
	    SetInterrupt(TRUE)
END

IF
	HaveSpell(CLERIC_CURE_DISEASE)
	OR(2)
	    CheckSpellState(Myself,DEAFENED)
	    StateCheck(Myself,STATE_BLIND)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",ONE_MINUTE)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ReallyForceSpell(Myself,CLERIC_CURE_DISEASE)  // SPPR317.SPL (Cure Disease)
END
IF
    HaveSpell(CLERIC_SANCTUARY)
	!CheckSpellState(Myself,SANCTUARY)
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	HPPercentLT(Myself,50)
	OR(7)
		GlobalTimerNotExpired("IaRegen","LOCALS")
		GlobalTimerNotExpired("IaContinualCure","LOCALS")
		HaveSpell(CLERIC_HEAL)
		HaveSpell(CLERIC_CURE_CRITICAL_WOUNDS)
		HaveSpell(CLERIC_CURE_SERIOUS_WOUNDS)
		HaveSpell(CLERIC_RESTORATION)
		HaveSpellRES("SPCLI15")
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaSanctuary","LOCALS",ONE_ROUND)
		Spell(Myself,CLERIC_SANCTUARY)  // SPPR109.SPL (Sanctuary)
	RESPONSE #0
	    Continue()
END

IF
    HaveSpellRES("SPCLI15")
	Allegiance(Myself,ENEMY)
