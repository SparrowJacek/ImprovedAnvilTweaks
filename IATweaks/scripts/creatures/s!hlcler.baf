	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	OR(2)
	    CheckStatLT(LastSeenBy(Myself),76,RESISTELECTRICITY)
	    CheckStatLT(LastSeenBy(Myself),76,RESISTACID)
	OR(2)
	    CheckStatLT(LastSeenBy(Myself),76,RESISTFIRE)
	    CheckStatLT(LastSeenBy(Myself),76,RESISTACID)
	OR(2)
	    CheckStatLT(LastSeenBy(Myself),76,RESISTELECTRICITY)
	    CheckStatLT(LastSeenBy(Myself),76,RESISTFIRE)
	TriggerOverride(LastSeenBy(Myself),Range(SecondNearestAllyOf(Myself),14))
	OR(2)
	    TriggerOverride(LastSeenBy(Myself),CheckStatLT(NearestAllyOf(Myself),76,RESISTELECTRICITY))
	    TriggerOverride(LastSeenBy(Myself),CheckStatLT(SecondNearestAllyOf(Myself),76,RESISTELECTRICITY))
	OR(2)
	    TriggerOverride(LastSeenBy(Myself),CheckStatLT(NearestAllyOf(Myself),76,RESISTACID))
	    TriggerOverride(LastSeenBy(Myself),CheckStatLT(SecondNearestAllyOf(Myself),76,RESISTACID))
	OR(2)
	    TriggerOverride(LastSeenBy(Myself),CheckStatLT(NearestAllyOf(Myself),76,RESISTFIRE))
	    TriggerOverride(LastSeenBy(Myself),CheckStatLT(SecondNearestAllyOf(Myself),76,RESISTFIRE))
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaStormDelay","LOCALS",THREE_ROUNDS)
		Spell(LastSeenBy(Myself),CLERIC_STORM_OF_VENGEANCE)  // SPPR722.SPL (Storm of Vengeance)
END

