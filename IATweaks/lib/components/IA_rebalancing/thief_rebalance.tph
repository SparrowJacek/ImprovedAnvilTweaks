//////// Thieving for various creatures /////////

// Add repeating effects for Pickpocket and Detect Illusions to all creatures that have proper class/kit

COPY_EXISTING_REGEXP GLOB ~.+\.cre~ ~override~
  READ_LONG 0x244 cre_kit
  READ_BYTE 0x273 cre_class
  // Pickpocket
  PATCH_IF %cre_class% == 4 OR %cre_class% == 5 OR %cre_class% == 9 OR %cre_class% == 10 OR %cre_class% == 13 OR %cre_class% == 15 BEGIN
    PATCH_FOR_EACH pickpocket_subspell IN ~S!PPTHAC~ ~S!PPCRIT~ ~S!PPACLI~ ~S!PPACHE~ BEGIN
      LPF ~ADD_CRE_EFFECT~
        INT_VAR
          opcode = 177
          target = 1
          parameter2 = 2
          timing = 9
        STR_VAR
          resource = EVAL ~%pickpocket_subspell%~
          effsource = ~S!PPBASE~
      END
    END
  END
  // Detect Illusionsx
  PATCH_IF %cre_class% == 4 OR %cre_class% == 9 OR %cre_class% == 10 OR %cre_class% == 13 OR %cre_class% == 15 OR %cre_class% == 21 OR %cre_kit% == 1076101120 BEGIN
    PATCH_FOR_EACH detect_illusion_subspell IN ~S!DINORM~ ~S!DISAVT~ ~S!DIMRES~ BEGIN
      LPF ~ADD_CRE_EFFECT~
        INT_VAR
          opcode = 177
          target = 1
          parameter2 = 2
          timing = 9
        STR_VAR
          resource = EVAL ~%detect_illusion_subspell%~
          effsource = ~S!DIBASE~
      END
    END
  END
  BUT_ONLY

