IF
	GlobalLT("IaMind02","LOCALS",2)
	GlobalLT("IaMind01","LOCALS",6)
	See(SecondNearest([0.0.MIND_FLAYER.0.0.0.0]))
	!GlobalTimerNotExpired("IaSoftenMind","LOCALS")
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOfType([PC]))
	!HasBounceEffects(LastSeenBy(Myself))
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	CheckStatLT(LastSeenBy(Myself),1,SCRIPTINGSTATE8)
	!CheckStat(LastSeenBy(Myself),3,SCRIPTINGSTATE7)
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE5)
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE4)
	!HasItemEquiped("S!sw02",LastSeenBy(Myself))  // True Sword of Arvoreen +5
	CheckStatGT(LastSeenBy(Myself),2,SAVEVSSPELL)
	!CheckSpellState(LastSeenBy(Myself),PSIONICS_IMMUNITY)
THEN
	RESPONSE #100
		IncrementGlobal("IaMind1","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaSoftenMind","LOCALS",TWO_ROUNDS)
		ForceSpellRES("S!MFSOFT",LastSeenBy(Myself))
	RESPONSE #300
	    Continue()
END

