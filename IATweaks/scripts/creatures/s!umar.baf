	HaveSpell(WIZARD_PRISMATIC_SPRAY)
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	See(SixthNearest([PC]))
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE7)
	CheckStatLT(LastSeenBy(Myself),30,MAGICDAMAGERESISTANCE)
	CheckStatLT(LastSeenBy(Myself),20,RESISTMAGIC)
	Range(LastSeenBy(Myself),14)
	!Range(LastSeenBy(Myself),2)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),WIZARD_PRISMATIC_SPRAY)  // SPWI714.SPL (Prismatic Spray)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #200
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	See(SixthNearest([PC]))
	CheckStatLT(LastSeenBy(Myself),50,RESISTMAGIC)
	!CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	TriggerOverride(SixthNearest([PC]), Range([PC], 15))
	!CheckStat(LastSeenBy(Myself),3,SCRIPTINGSTATE7)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE3)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	Global("IaSpellSequencer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaSpellSequencer","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayString(Myself,39969)  // Spell Sequencer—Fired
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_GREATER_MALISON)  // SPWI412.SPL (Greater Malison)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_EMOTION_HOPELESSNESS)  // SPWI411.SPL (Emotion: Hopelessness)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_SLOW)  // SPWI312.SPL (Slow)
	RESPONSE #25
	    Continue()
END

