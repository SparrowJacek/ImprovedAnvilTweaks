IF
	Allegiance(Myself,ENEMY)
	HPLT(Myself,10)
	Global("Iagrestore","AR0530",0)  // Storehouse
THEN
	RESPONSE #100
		SetGlobal("Iagrestore","AR0530",1)  // Storehouse
		Continue()
END

IF
	Global("Iagrestore","AR0530",2)  // Storehouse
	Global("Iapcastts","GLOBAL",0)
	HasItem("bhaalhp1",Myself)  // No such index
THEN
	RESPONSE #100
		DestroyItem("bhaalhp1")  // No such index
		Continue()
END


IF
	Allegiance(Myself,ENEMY)
	GlobalTimerExpired("IaRestTimer","LOCALS")
	Global("partyfled","LOCALS",1)
	Global("IaPrep","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",0)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
		Continue()
END

IF
	!See([PC])
	!See([GOODCUTOFF])
	Global("partyfled","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Global("IaPrep","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobalTimer("IaRestTimer","LOCALS",SEVEN_HOURS)
		SetGlobal("partyfled","LOCALS",1)
END



IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
		Continue()
END

IF
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		NoAction()
END



