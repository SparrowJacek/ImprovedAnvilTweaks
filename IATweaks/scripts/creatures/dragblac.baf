THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("Iaonewing","LOCALS",1)
		ForceSpell(LastSeenBy(Myself),DRAGON_WING_BUFFET)  // SPIN695.SPL (Wing Buffet)
		Wait(1)
		CreateCreatureObject("S!dendr1",Myself,0,0,0)
		CreateCreatureObject("S!dendr1",Myself,0,0,0)
		CreateCreatureObject("S!dendr1",Myself,0,0,0)
		SetInterrupt(TRUE)
END

