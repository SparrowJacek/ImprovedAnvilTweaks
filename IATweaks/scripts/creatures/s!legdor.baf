	!CheckStat(ThirdNearest([PC]),1,SCRIPTINGSTATE4)
	!CheckStatGT(ThirdNearest([PC]),0,SCRIPTINGSTATE8)
	!CheckSpellState(ThirdNearest([PC]),SI_ENCHANTMENT)
	!CheckStatGT(ThirdNearest([PC]),0,MINORGLOBE)
    !CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	CheckStatLT(ThirdNearest([PC]),60,RESISTMAGIC)
    CheckStatGT(ThirdNearest([PC]),2,SAVEVSSPELL)
	OR(2)
	    CheckStatGT(ThirdNearest([PC]),6,SAVEVSSPELL)
	    !StateCheck(ThirdNearest([PC]),STATE_IMPROVEDINVISIBILITY)
	See(ThirdNearest([PC]))
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",ONE_MINUTE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(LastSeenBy(Myself),CLERIC_COMMAND)  // SPPR102.SPL (Command)
	RESPONSE #200
	    Continue()
END

