// Stalman from Guarded Compound

COPY_EXISTING ~HLSTAL.cre~ ~override~
  WRITE_LONG 0x14 28000 // Exp
  WRITE_SHORT 0x24 114 // HP
  WRITE_SHORT 0x26 114 // HP
  WRITE_BYTE 0x52 6 // Thac0
  WRITE_BYTE 0x59 50 // Resist Fire
  WRITE_BYTE 0x5d 20 // Resist Magic
  WRITE_BYTE 0x5e 50 // Resist Magic Fire
  WRITE_BYTE 0x60 20 // Resist Slashing
  WRITE_BYTE 0x61 20 // Resist Crushing
  WRITE_BYTE 0x62 20 // Resist Piercing
  WRITE_BYTE 0x63 20 // Resist Missile
  WRITE_BYTE 0x234 30 // Level 1
  WRITE_BYTE 0x23d 17 // Constitution
  WRITE_LONG 0x244 0x40130000 // Kit = Talos

  LPF ~ALTER_EFFECT~ // Casting speed
    INT_VAR
      match_opcode = 189
      parameter1 = 1
  END

  LPF ~ADD_CRE_EFFECT~ // ** in Sword and Shield
    INT_VAR
      target = 1
      opcode = 233
      parameter1 = 2
      parameter2 = 112
      resist_dispel = 0
      timing = 9
  END

  LPF ~ADD_CRE_EFFECT~ // Add ENEMY_GROUP spellstate
    INT_VAR
      target = 1
      opcode = 328
      parameter1 = 0
      parameter2 = enemy_group_state
      resist_dispel = 0
      timing = 9
      special = 1
  END
  
  LPF ~ADD_CRE_EFFECT~ // Set persistent AI
    INT_VAR
      target = 1
      opcode = 293
      parameter2 = 1
      resist_dispel = 0
      timing = 9
  END

  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 146
      target = 1
      parameter2 = 1
      timing = 9
      resist_dispel = 0
      special = 30
    STR_VAR
      resource = ~S!SPLDU2~
      effsource = ~S!SPLDU2~
  END

  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 0 // AC
  END

  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 31 // Magic Damage Resistance
  END

  PATCH_FOR_EACH item_to_remove IN ~S!IMMUNE~ ~PLAT10~ ~SHLD29~ BEGIN
    LPF ~DELETE_CRE_ITEM~
      STR_VAR
        item_to_delete = EVAL ~%item_to_remove%~
    END
  END

