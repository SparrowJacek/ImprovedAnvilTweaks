    !GlobalTimerNotExpired("IaProtRemovalWait","LOCALS")
	See([PC])
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!CheckSpellState(LastSeenBy(Myself),SI_ABJURATION)
	!ImmuneToSpellLevel(LastSeenBy(Myself),4)
	OR(6)
	    CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	    CheckSpellState(LastSeenBy(Myself),SI_DIVINATION)
	    CheckSpellState(LastSeenBy(Myself),SI_ENCHANTMENT)
	    CheckSpellState(LastSeenBy(Myself),SI_EVOCATION)
	    CheckSpellState(LastSeenBy(Myself),SI_NECROMANCY)
	    CheckSpellState(LastSeenBy(Myself),SI_TRANSMUTATION)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(LastSeenBy(Myself),WIZARD_SPELL_THRUST)
		SetGlobalTimer("IaProtRemovalWait","LOCALS",1)
	RESPONSE #150
	    Continue()
END

