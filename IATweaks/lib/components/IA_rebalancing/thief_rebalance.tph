// Main spell with Stealth bonuses

COPY ~IATweaks\resources\spl\s!hisinv.spl~ ~override~
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      projectile = %s!hisinv%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 328
      parameter2 = %hide_in_shadows_success_state%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 142
      parameter2 = %stealth_active_icon_id%
  END

COPY ~IATweaks\resources\spl\s!hisdmg.spl~ ~override~
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 318
      parameter1 = 13
      parameter2 = %stealth_strike_lower_than_row%
  END
  PATCH_FOR_EACH stealth_strike_value IN 25 38 50 63 75 88 100 113 125 138 150 163 175 188 200 208 216 224 232 240 248 256 264 272 280 288 296 304 312 320 328 336 344 352 360 BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 318
        parameter1 = stealth_strike_value
      STR_VAR
        insert = ~last~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 285
      STR_VAR
        insert = ~last~
    END
  END
  LPF ~CLONE_EFFECT~
    INT_VAR
      multi_match = 1
      match_opcode = 318
      parameter1 = 0
      parameter2 = 143
    STR_VAR
      insert = ~first~
  END
  //////////////////////// TO BE REMOVED ////////////////////////////////
  LPF ~CLONE_EFFECT~
    INT_VAR
      match_opcode = 285
      opcode = 139
      parameter1 = 17011
    STR_VAR
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 139
      multi_match = 1
      parameter1 = 17003
    STR_VAR
  END

