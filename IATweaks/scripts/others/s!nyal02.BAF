IF
	True()
THEN
	RESPONSE #100
		CutSceneId("S!NYALEE")  // Nyalee
		SmallWait(12)
		ReallyForceSpellRES("S!CLRFOG",Myself)  // No such index
		MoveViewObject(Myself,INSTANT)
		FadeFromColor([10.0],0)
		Wait(3)
		CreateCreatureEffect("S!YAGAYO","SPPORTAL",[960.1048],N)  // Yaga-Shura
		ActionOverride("s!yagayoung",DisplayStringHead(Myself,@5153))  // (Young Yaga-Shura stands beside Nyalee, slightly trembling)
		Wait(4)
		ActionOverride("s!yagayoung",DisplayStringHead(Myself,@5154))  // Mother... the night was loud again. The shadows called my name. I tried to be brave, but they said you wouldn't come back.
		Wait(8)
		DisplayStringHead(Myself,@5155)  // Hush now, boy. The shadows try to frighten the strong. They lie because they fear you.
		Wait(6)
		ActionOverride("s!yagayoung",DisplayStringHead(Myself,@5156))  // But what if... what if you left? Like the others?
		Wait(5)
		DisplayStringHead(Myself,@5157)  // (Nyalee raises her voice, firm but warm) I am your mother in all but blood. I do not leave my own.
		Wait(8)
		ActionOverride("s!yagayoung",DisplayStringHead(Myself,@5158))  // (Yaga-Shura slowly relaxes, shoulders lowering) ...Thank you, Mother.
		Wait(3)
		FadeToColor([10.0],0)
		SmallWait(8)
		ActionOverride("s!yagayoung",DestroySelf())
		SmallWait(4)
		ReallyForceSpellRES("S!CLRFO2",Myself)  // No such index
		StartCutScene("s!nyal00")
END

