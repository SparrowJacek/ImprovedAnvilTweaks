IF
	See(LastTargetedBy(Myself))
	Global("IaAttacking","LOCALS",1)
	OR(2)
		!WeaponEffectiveVs(LastTargetedBy(Myself),MAINHAND)
		!WeaponCanDamage(LastTargetedBy(Myself),MAINHAND)
THEN
	RESPONSE #100
		SetGlobal("IaAttacking","LOCALS",0)
		ClearActions(Myself)
END

IF
	Allegiance(Myself,ENEMY)
	ActionListEmpty()
	See([PC.0.0.MAGE_ALL])
	HPLT([PC.0.0.MAGE_ALL],30)
	CheckStatGT([PC.0.0.MAGE_ALL],0,ARMORCLASS)
	CheckStatLT([PC.0.0.MAGE_ALL],25,RESISTPIERCING)
    !CheckStatGT([PC.0.0.MAGE_ALL],0,SCRIPTINGSTATE6)
	!CheckStatGT([PC.0.0.MAGE_ALL],0,STONESKINS)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_MIRRORIMAGE)
	Range([PC.0.0.MAGE_ALL],5)
THEN
	RESPONSE #100
		SetGlobal("IaAttacking","LOCALS",1)
		EquipMostDamagingMelee()
		AttackReevaluate([PC.0.0.MAGE_ALL],15)
END

