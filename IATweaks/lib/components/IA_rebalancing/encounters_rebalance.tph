ACTION_FOR_EACH mind_flayer_cre IN ~DAMIND1~ ~DAMIND2~ ~ELEILL01~ ~ELMIND01~ ~MINDFL01~ ~UDILL01~ ~UDMIND10~ BEGIN
  COPY_EXISTING ~%mind_flayer_cre%.cre~ ~override~
    READ_LONG 0x14 exp
    PATCH_IF (exp > 0) BEGIN
      WRITE_LONG 0x14 THIS + 3000 // Exp for creature
    END
    WRITE_SHORT 0x24 THIS + 15 // HP
    WRITE_SHORT 0x26 THIS + 15 // HP
    WRITE_BYTE 0x52 6 // Thac0
    WRITE_BYTE 0x54 6  // Saves
    WRITE_BYTE 0x55 8 // Saves
    WRITE_BYTE 0x56 7  // Saves
    WRITE_BYTE 0x57 8  // Saves
    WRITE_BYTE 0x58 9 // Saves
    WRITE_BYTE 0x59 0 // Resist Fire
    WRITE_BYTE 0x5a 0 // Resist Cold
    WRITE_BYTE 0x5b 0 // Resist Electricity
    WRITE_BYTE 0x5c 0 // Resist Acid
    WRITE_BYTE 0x5d 90 // Resist Magic
    WRITE_BYTE 0x5e 0 // Resist Magic Fire
    WRITE_BYTE 0x5f 0 // Resist Magic Cold
    WRITE_BYTE 0x234 15 // Level 1
    WRITE_BYTE 0x240 2 // Morale Break
    WRITE_BYTE 0x272 124 // Race

    // Cast S!MFPROT each time the damage is dealt
    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 232
        target = 1
        parameter1 = 0
        parameter2 = 11
        timing = 1
        resist_dispel = 0
      STR_VAR
        resource = ~S!MFPROT~
    END
    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 146
        target = 1
        parameter2 = 1
        timing = 9
        resist_dispel = 0
      STR_VAR
        resource = ~S!MFPROT~
    END
    BUT_ONLY
    IF_EXISTS
END

