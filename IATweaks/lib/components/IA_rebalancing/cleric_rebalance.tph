// Tempus Holy Power

COPY_EXISTING ~SPPR412.spl~ ~override/SPPR412D.spl~
  WRITE_LONG  0x08      ~-1~ // spell name
  WRITE_BYTE  0x27      0 // secondary type 

  // Remove spell state BUFF_ENHANCEMENT to avoid AI problems
  LPF ~DELETE_SPELL_EFFECT~
    INT_VAR
      opcode_to_delete = 328
      match_parameter2 = 68
  END

  // Update resource for protection from setting str to 18 if it is higher already
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 318
    STR_VAR
      resource = ~SPPR412D~
  END

  // Add 1/2 APR from lvl 12
  PATCH_FOR_EACH header_num IN 5 6 7 8 9 10 11 12 BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        header = %header_num%
        match_opcode = 18
        opcode = 1
        parameter1 = 6
        parameter2 = 0
    END
  END
  // Add 1 APR from lvl 20
  LPF ~CLONE_EFFECT~
    INT_VAR
      header = 13
      match_opcode = 18
      opcode = 1
      parameter1 = 1
      parameter2 = 0
  END

  // Make undispellable
  LPF ~ALTER_SPELL_EFFECT~
    INT_VAR
      match_opcode = ~-1~
      resist_dispel = 0
  END

  // Extend duration by 50%
  GET_OFFSET_ARRAY ab_array SPL_V10_HEADERS
  PHP_EACH ab_array AS int => ab_off BEGIN
    GET_OFFSET_ARRAY2 fx_array ab_off SPL_V10_HEAD_EFFECTS
    PHP_EACH fx_array AS int => fx_off BEGIN
      READ_LONG (fx_off + 0x0e) duration
      PATCH_IF duration > 0 BEGIN
        WRITE_LONG (fx_off + 0x0e) duration + (duration / 2)
      END
    END
  END

