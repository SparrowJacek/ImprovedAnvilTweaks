IF
    HaveSpell(WIZARD_BREACH)
	Allegiance(Myself,ENEMY)
	OR(2)
        Dead("ABAZIGAL")
        !TriggerOverride("ABAZIGAL", Global("IaBreachPlayer1","LOCALS",1))
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaProtRemovalWait","LOCALS")
	See(Player1)
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	!CheckSpellState(LastSeenBy(Myself),REMOVE_SPECIFIC_PROTS_IMMUNITY)
	OR(2)
        CheckStatGT(LastSeenBy(Myself),10,BREACHABLECOMBATBUFFSPOWER)
        CheckStatGT(LastSeenBy(Myself),10,BREACHABLESPECIFICBUFFSPOWER)
	OR(2)
	    !CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
        TriggerOverride("ABAZIGAL", Global("IaRRRPlayer1","LOCALS",1))
	OR(2)
	    !CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
        !TriggerOverride("ABAZIGAL", GlobalTimerNotExpired("IaRRRPlayer1Delay","LOCALS"))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
	    SetGlobal("IaBreachPlayer1","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaProtRemovalWait","LOCALS",1)
		ForceSpell(LastSeenBy(Myself),WIZARD_BREACH)
		RemoveSpell(WIZARD_BREACH)
	    SetGlobal("IaBreachPlayer1","LOCALS",0)
