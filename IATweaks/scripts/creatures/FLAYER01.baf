		ForceSpell(LastSeenBy(Myself),MIND_FLAYER_PSIONIC_BLAST)  // SPIN974.SPL (Psionic Blast)
	RESPONSE #300
	    Continue()
END

IF
	GlobalLT("IaMind01","LOCALS",7)
	!GlobalTimerNotExpired("IaPsionicAction","LOCALS")
	Allegiance(Myself,ENEMY)
	See(FourthNearestEnemyOf(Myself))
	!HasBounceEffects(LastSeenBy(Myself))
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!CheckSpellState(LastSeenBy(Myself),STUN_IMMUNITY)
    CheckStatGT(LastSeenBy(Myself),2,SAVEVSSPELL)
	OR(2)
	    CheckStatGT(LastSeenBy(Myself),6,SAVEVSSPELL)
	    !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!CheckSpellState(LastSeenBy(Myself),PSIONICS_IMMUNITY)
THEN
	RESPONSE #100
