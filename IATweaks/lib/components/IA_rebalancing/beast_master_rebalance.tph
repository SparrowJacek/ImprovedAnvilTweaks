SILENT

INCLUDE "%MOD_FOLDER%/lib/components/IA_rebalancing/helper_functions.tph"

// Make Beast Masters able to put *** points into all weapons they can use

COPY_EXISTING ~weapprof.2da~  ~override/weapprof.2da~
  COUNT_2DA_COLS ~colcount~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 2 38 ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 3 38 ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 4 38 ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 7 38 ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 17 38 ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 18 38 ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 21 38 ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 22 38 ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 23 38 ~0~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 24 38 ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 25 38 ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 26 38 ~0~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ 27 38 ~3~
  SET_2DA_ENTRIES_NOW ~_#_#_#weapprof~ ~colcount~
  PRETTY_PRINT_2DA

// Make all spears usable by Beast Masters

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
  READ_SHORT 0x1c item_category
  PATCH_IF (item_category = 29)
    THEN BEGIN  
      READ_BYTE 0x2b usability_flags_2
      WRITE_BYTE 0x2b (%usability_flags_2% BAND 0b11111101)
  END
  BUT_ONLY

// Make all crossbows, bolts and darts unusable by Beast Masters

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
  READ_SHORT 0x1c item_category
  PATCH_IF (item_category = 27 OR item_category = 31 OR item_category = 24)
    THEN BEGIN  
      READ_BYTE 0x2b usability_flags_2
      WRITE_BYTE 0x2b (%usability_flags_2% BOR 0b00000010)
  END
  BUT_ONLY

// Animal Rage

COPY ~IATweaks\resources\bam\s!anragb.bam~ ~override~
COPY ~IATweaks\resources\bam\s!anragc.bam~ ~override~
COPY ~IATweaks\resources\spl\s!anrage.spl~ ~override~
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_target = 1
      target = 2
  END
COPY ~IATweaks\resources\spl\s!anirag.spl~ ~override~
  SAY UNIDENTIFIED_DESC @6076

LAF ~S!ADD_CLAB_ROW~
  STR_VAR
    filename = ~CLABRN04.2da~
    row_desc = ~ANIMAL_RAGE~
    level12 = ~GA_S!ANIRAG~
END


// s!hunter.vvc must be duplicated for different enemy height

