// Poison

COPY_EXISTING ~SPPR411.spl~ ~override~
  SAY UNIDENTIFIED_DESC @6142

  // Remove original strength bonus
  PATCH_FOR_EACH no_save_opcode IN 12 61 215 BEGIN
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = %no_save_opcode%
        savingthrow = 0
    END
  END
  BUT_ONLY

COPY_EXISTING ~SPPR412.spl~ ~override/SPPR412.spl~
  SAY UNIDENTIFIED_DESC @6013

  // Remove original strength bonus
  LPF ~DELETE_SPELL_EFFECT~
    INT_VAR
      opcode_to_delete = 44
  END

  // Protect from last effect if str > 18
  LPF ~ADD_SPELL_EFFECT~ 
    INT_VAR
      opcode = 318
      insert_point = ~-1~
      target = 1
      power = 4
      parameter1 = 19
      parameter2 = 124
      duration = 1
      resist_dispel = 0
    STR_VAR
      resource = "SPPR412"
  END

  // Add strength bonus as the last effect
  LPF ~CLONE_EFFECT~
    INT_VAR
      check_globals = 0
      match_opcode = 97
      opcode = 44
      parameter1 = 18
    STR_VAR
      insert = ~last~
  END
  
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_level = 2
      level = 4
  END
  BUT_ONLY

