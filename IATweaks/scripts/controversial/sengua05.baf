IF
	!GlobalTimerNotExpired("DrankPotionTimer","LOCALS")
	!GlobalTimerNotExpired("Iacshot","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	See(NearestEnemyOf(Myself))
	!CheckStatGT(LastSeenBy(Myself),1,SCRIPTINGSTATE6)
	!CheckSpellState(LastSeenBy(Myself),MISSILE_IMMUNITY)
	HaveSpell(ARCHER_CALL_SHOT)  // SPCL121.SPL (Called Shot)
THEN
	RESPONSE #100
		SetGlobalTimer("Iacshot","LOCALS",TWO_ROUNDS)
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		Spell(Myself,ARCHER_CALL_SHOT)  // SPCL121.SPL (Called Shot)
END

