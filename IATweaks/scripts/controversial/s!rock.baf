

IF
    HaveSpell(WARRIOR_GREATER_DEATHBLOW)
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("IaDeathblow","LOCALS",FIVE_ROUNDS)
		ReallyForceSpell(Myself,WARRIOR_GREATER_DEATHBLOW)
		RemoveSpell(WARRIOR_GREATER_DEATHBLOW)
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
END



IF
    ActionListEmpty()
    Global("IaCharge","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("IaCharge","LOCALS",0)
		ReallyForceSpellRES("S!CHARG6",Myself)  // No such index
	    Continue()
END

IF
	!See(NearestEnemyOf(Myself))
	Heard([ANYONE],111)
THEN
	RESPONSE #100
		MoveToObject(LastHeardBy(Myself))
END

IF
	AttackedBy([ANYONE],DEFAULT)
	!See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
	    Shout(111)
		MoveToObject(LastAttackerOf(Myself))
END


IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
		Continue()
END

IF
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		NoAction()
END


IF
	GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaBreakCharge","LOCALS")
THEN
    RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",0)
		Continue()
    RESPONSE #300
		Continue()
END

IF
    Allegiance(Myself,ENEMY)
    OR(2)
        Detect([PC])
        Detect([GOODCUTOFF])
    Global("partyfled","LOCALS",1)
THEN
    RESPONSE #100
        SetGlobal("partyfled","LOCALS",0)
END

