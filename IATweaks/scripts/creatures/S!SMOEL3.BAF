IF
	See([PC])
	Exists("S!aurie3")  // Chief Inspector Auriel
	!Dead("S!aurie3")  // Chief Inspector Auriel
	See("S!aurie3")  // Chief Inspector Auriel
	RandomNumLT(6,2)
THEN
	RESPONSE #100
		AttackOneRound("S!aurie3")  // Chief Inspector Auriel
		AttackOneRound("S!aurie3")  // Chief Inspector Auriel
END

IF
	Allegiance(Myself,ENEMY)
	See(SecondNearestEnemyOf(Myself))
	CheckStatLT(LastSeenBy(Myself),90,RESISTSLASHING)
	!CheckStatGT(LastSeenBy(Myself),2,SCRIPTINGSTATE6)
	RandomNumGT(6,3)
	Range(LastSeenBy(Myself),2)
THEN
	RESPONSE #100
		AttackOneRound(LastSeenBy(Myself))
		AttackOneRound(LastSeenBy(Myself))
END

