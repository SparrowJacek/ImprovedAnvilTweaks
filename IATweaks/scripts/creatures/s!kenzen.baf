IF
	Range(NearestEnemyOf(Myself),5)
	GlobalTimerNotExpired("IaAction","LOCALS")
	!StateCheck(NearestEnemyOf(Myself),STATE_HARMLESS)
	!CheckStatGT(NearestEnemyOf(Myself),0,HELD)
	!GlobalTimerNotExpired("IaRunAway","LOCALS")
	CheckStatLT(Myself,5,STONESKINS)
	!CheckStatGT(Myself,0,SCRIPTINGSTATE6)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRunAway","LOCALS",TWO_ROUNDS)
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),40)
		SetInterrupt(TRUE)
END

IF
	Range(NearestEnemyOf(Myself),5)
	GlobalTimerNotExpired("IaAction","LOCALS")
	!StateCheck(NearestEnemyOf(Myself),STATE_HARMLESS)
	!CheckStatGT(NearestEnemyOf(Myself),0,HELD)
	!GlobalTimerNotExpired("IaRunAway","LOCALS")
	CheckStatLT(Myself,5,STONESKINS)
	HPPercentLT(Myself,80)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRunAway","LOCALS",TWO_ROUNDS)
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),40)
		SetInterrupt(TRUE)
END


IF
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	StateCheck(Myself,STATE_SILENCED)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SpellNoDec(Myself,WIZARD_VOCALIZE)  // SPWI219.SPL (Vocalize)
END
IF
    HaveSpell(WIZARD_ABSOLUTE_IMMUNITY)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	CheckStat(Myself,0,SCRIPTINGSTATE6)
	See(NearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),10)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(Myself,WIZARD_ABSOLUTE_IMMUNITY)
	RESPONSE #25
	    Continue()
END

