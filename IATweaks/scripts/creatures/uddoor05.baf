IF
	!Race(Myself,KUO-TOA)
	See(NearestEnemyOf(Myself))
	Global("Iamirror","LOCALS",1)
THEN
	RESPONSE #100
		EquipMostDamagingMelee()
		AttackOneRound(NearestEnemyOf(Myself))
END

IF
	HasItemEquiped("kuosper",Myself)  // Spear
	See(NearestEnemyOf(Myself))
	!HasItemEquiped("immune2",LastSeenBy(Myself))  // No such index
	!HasItemEquiped("immune1",LastSeenBy(Myself))  // No such index
	OR(2)
		!Class(LastSeenBy(Myself),MONK)
		!LevelGT(LastSeenBy(Myself),19)
	OR(2)
		CheckStat(LastSeenBy(Myself),0,SCRIPTINGSTATE6)
		CheckStat(LastSeenBy(Myself),3,SCRIPTINGSTATE6)
	OR(2)
		Global("Iamirror","LOCALS",1)
		Range(NearestEnemyOf(Myself),4)
THEN
	RESPONSE #100
		AttackOneRound(NearestEnemyOf(Myself))
END

