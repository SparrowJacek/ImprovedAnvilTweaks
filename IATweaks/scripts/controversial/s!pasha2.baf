IF
	Allegiance(Myself,GOODBUTBLUE)
	Global("Iathethree","AR4500",1)  // Pocket Plane
	Dead("S!supgol")  // Supreme Golem
	Dead("S!ultgg1")  // Ultra Golem
	Dead("S!ultgg2")  // Ultra Golem
THEN
	RESPONSE #100
		SetGlobal("Iathethree","AR4500",2)  // Pocket Plane
END

