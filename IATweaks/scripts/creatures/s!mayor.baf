IF
	NumberOfTimesTalkedTo(0)
	Global("Iapcastts","GLOBAL",0)
	Detect([PC])
THEN
	RESPONSE #100
		StartDialogueNoSet([PC])
END

IF
	!Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	OR(5)
		AttackedBy([GOODCUTOFF],DEFAULT)
		AttackedBy([PC],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		SpellCastOnMe([PC],0)
		TookDamage()
THEN
	RESPONSE #100
		Enemy()
		MoveToObject(Player1)
END

IF
	!Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	Detect([GOODCUTOFF])
THEN
	RESPONSE #100
		Enemy()
END

IF
	Allegiance(Myself,ENEMY)
	Detect([PC])
	Global("Ialord","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Ialord","LOCALS",1)
		CreateCreatureObject("S!skelgr",Myself,0,0,0)  // Skeleton Grandlord
END

IF
	Allegiance(Myself,ENEMY)
	See([PC])
	GlobalLT("Iadevil","LOCALS",3)
	!GlobalTimerNotExpired("devilsummon","LOCALS")
THEN
	RESPONSE #100
		IncrementGlobal("Iadevil","LOCALS",1)
		SetGlobalTimer("devilsummon","LOCALS",THREE_ROUNDS)
		ReallyForceSpellRES("SPWII32",Myself)  // Gate to Bone Devil
		CreateCreatureObjectDoor("S!bdevit",LastSeenBy(Myself),0,0,0)  // Bone Devil
END

IF
	Allegiance(Myself,ENEMY)
	Detect([PC])
	Global("Iamayor01","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iamayor01","LOCALS",1)
		SetGlobalTimer("truesight","LOCALS",TEN_ROUNDS)
		ReallyForceSpell(Myself,CLERIC_PHYSICAL_MIRROR)  // SPPR613.SPL (Protection From Missiles)
		ReallyForceSpell(Myself,CLERIC_ANIMATE_DEAD)  // SPPR301.SPL (Animate Dead)
		ReallyForceSpell(Myself,CLERIC_ARMOR_OF_FAITH)  // SPPR111.SPL (Armor of Faith)
		ReallyForceSpell(Myself,CLERIC_DEFENSIVE_HARMONY)  // SPPR406.SPL (Defensive Harmony)
		ReallyForceSpell(Myself,CLERIC_AID)  // SPPR201.SPL (Aid)
		ReallyForceSpell(Myself,CLERIC_CHANT)  // SPPR203.SPL (Chant)
		ReallyForceSpell(Myself,CLERIC_GLOBE_OF_BLADES)  // SPPR725.SPL (Globe of Blades)
		ReallyForceSpell(Myself,CLERIC_TRUE_SIGHT)  // SPPR505.SPL (True Seeing)
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Allegiance(Myself,ENEMY)
	Detect([PC])
	Global("Iatreasure","LOCALS",0)
	Global("Iarynnplace","GLOBAL",2)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Iarynnplace","GLOBAL",5)
		SetGlobal("Iatreasure","LOCALS",1)
		GiveItemCreate("staf20",Myself,0,0,0)  // Staff of Rhynn +4
END

IF
	Allegiance(Myself,ENEMY)
	Detect([PC])
	Global("Iatreasure2","LOCALS",0)
	Global("Iafortitplace","GLOBAL",2)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Iafortitplace","GLOBAL",4)
		SetGlobal("Iatreasure2","LOCALS",1)
		GiveItemCreate("belt09",Myself,0,0,0)  // Girdle of Fortitude
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	See([PC])
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
	Global("Iamayor04","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iamayor04","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDec(LastSeenBy(Myself),CLERIC_STORM_OF_VENGEANCE)  // SPPR722.SPL (Storm of Vengeance)
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!GlobalTimerNotExpired("Iaturntime","LOCALS")
	GlobalLT("Iaturning","LOCALS",2)
	See(Player1)
	LevelLT(Player1,20)
	Class(Player1,PALADIN_ALL)
	Range(Player1,12)
	!StateCheck(Player1,STATE_PANIC)
	!StateCheck(Player1,STATE_CONFUSED)
	!StateCheck(Player1,STATE_HELPLESS)
	!StateCheck(Player1,STATE_STUNNED)
	!StateCheck(Player1,STATE_CHARMED)
	!HasItemEquiped("hamm11",Player1)  // Runehammer +5
	!HasItemEquiped("sw1h32",Player1)  // Peridan +3
	!HasItemEquiped("S!sw04",Player1)  // Judgement Day +5
	!HasItemEquiped("S!sw11",Player1)  // Warlord's blade +5
	!HasItemEquiped("S!halb01",Player1)  // Dragon Lord +5
	!CheckSpellState(LastSeenBy(Myself),IMMUNE_FEAR)
THEN
	RESPONSE #100
		IncrementGlobal("Iaturning","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobalTimer("Isturning","LOCALS",ONE_ROUND)
		ApplySpellRES("SPINI66",Player1)  // No such index
		Turn()
END

