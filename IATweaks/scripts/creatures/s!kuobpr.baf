IF
	HaveSpell(CLERIC_CREEPING_DOOM)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	CheckStatLT(Myself,60,SPELLFAILUREPRIEST)
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_POISONED)
	CheckStatLT([PC.0.0.MAGE_ALL],100,RESISTPIERCING)
	CheckStatLT([PC.0.0.MAGE_ALL],25,RESISTMAGIC)
	!CheckSpellState([PC.0.0.MAGE_ALL],SI_CONJURATION)
	!CheckSpellState([PC.0.0.MAGE_ALL],ACID_SHIELD)
	!CheckSpellState([PC.0.0.MAGE_ALL],RED_FIRESHIELD)
	!CheckSpellState([PC.0.0.MAGE_ALL],BLUE_FIRESHIELD)
	TriggerOverride([PC.0.0.MAGE_ALL], Range(NearestAllyOf(Myself), 15))
	TriggerOverride([PC.0.0.MAGE_ALL], CheckStatLT(NearestAllyOf(Myself),100,RESISTPIERCING))
	TriggerOverride([PC.0.0.MAGE_ALL], CheckStatLT(NearestAllyOf(Myself),75,RESISTMAGIC))
	!TriggerOverride([PC.0.0.MAGE_ALL], CheckSpellState(NearestAllyOf(Myself),SI_CONJURATION))
	See([PC.0.0.MAGE_ALL])
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE) 
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),CLERIC_CREEPING_DOOM)
		ForceSpellRES("S!SEEREM",Myself)
	RESPONSE #0
	    Continue()
END
