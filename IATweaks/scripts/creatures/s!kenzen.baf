	See(SixthNearest([PC]))
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!CheckSpellState(LastSeenBy(Myself),CONFUSION_IMMUNITY)
	CheckStatLT(LastSeenBy(Myself),25,RESISTMAGIC)
	CheckStatGT(LastSeenBy(Myself),4,SAVEVSSPELL)
	OR(2)
	    CheckStatGT(LastSeenBy(Myself),8,SAVEVSSPELL)
	    !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!CheckStat(LastSeenBy(Myself),3,SCRIPTINGSTATE7)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),WIZARD_CHAOS)  // SPWI508.SPL (Chaos)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #50
	    Continue()
END

