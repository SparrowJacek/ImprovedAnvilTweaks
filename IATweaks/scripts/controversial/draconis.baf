	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	CheckStatLT(LastSeenBy(Myself),100,MAGICDAMAGERESISTANCE)
	CheckStatLT(LastSeenBy(Myself),90,RESISTMAGIC)
	!CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	!CheckStat(LastSeenBy(Myself),4,SCRIPTINGSTATE7)
	!HasItemEquiped("morsword",LastSeenBy(Myself))  // Mordenkainen's Sword
	!HPLT(Myself,2)
	!HasItem("blakblad",Myself)  // Black Blade of Disaster
	GlobalLT("Iamissile","LOCALS",5)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		IncrementGlobal("Iamissile","LOCALS",1)
		SpellNoDec(LastSeenBy(Myself),WIZARD_MAGIC_MISSILE)  // SPWI112.SPL (Magic Missile)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	ActionListEmpty()
	See(NearestEnemyOf(Myself))
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	OR(4)
		CheckStatGT(LastSeenBy(Myself),99,MAGICDAMAGERESISTANCE)
		CheckStatGT(LastSeenBy(Myself),89,RESISTMAGIC)
		CheckStat(LastSeenBy(Myself),4,SCRIPTINGSTATE7)
		Global("Iamissile","LOCALS",5)
	!HPLT(Myself,2)
	!HasItem("blakblad",Myself)  // Black Blade of Disaster
THEN
	RESPONSE #100
		RunAwayFrom(NearestEnemyOf(Myself),45)
END
