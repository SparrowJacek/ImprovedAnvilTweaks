    SAY IDENTIFIED_DESC @6119
END

// Mirror Image

COPY_EXISTING ~spwi212.spl~ ~override~
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 119
      opcode = 159
  END
  SET images = 3
  FOR (i=0;i<6;++i) BEGIN
    FOR (j=0;j<3;++j) BEGIN
      LPF ~ALTER_EFFECT~
        INT_VAR
          header = (i*3 + j)
          match_opcode = 159
          parameter1 = images
      END  
    END
    SET images = images + 1
  END

