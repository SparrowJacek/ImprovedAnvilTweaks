THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaProtRemovalWait","LOCALS",1)
		UseItem("SCRL8G",LastSeenBy(Myself))  // SPWI704.SPL (Ruby Ray of Reversal)
	RESPONSE #100
	    Continue()
END

