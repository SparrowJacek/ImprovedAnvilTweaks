    !GlobalTimerNotExpired("IaDeathFogInfinite","LOCALS")
	Allegiance(Myself,ENEMY)
	See(SixthNearest([PC]))
    Range(SixthNearest([PC]), 15)
	CheckStatLT(LastSeenBy(Myself),70,RESISTACID)
	CheckStatLT(LastSeenBy(Myself),35,RESISTMAGIC)
	!CheckStat(LastSeenBy(Myself),4,SCRIPTINGSTATE7)
    Range([PC], 15)
    CheckStatLT([PC],70,RESISTACID)
    CheckStatLT([PC],55,RESISTMAGIC)
    !CheckStat([PC],4,SCRIPTINGSTATE7)
	!HasItemEquiped("S!sper01",LastSeenBy(Myself))  // Corrosive Lance +5
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaDeathFogInfinite","LOCALS",24)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		ForceSpell(Myself,WIZARD_DEATH_FOG)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #250
	    Continue()
END

