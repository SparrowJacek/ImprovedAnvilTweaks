IF
	Global("Iafissureplayer1","LOCALS",6)
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!HPLT(Myself,1)
	See(Player1)
THEN
	RESPONSE #100
	    
		SetGlobalTimer("Iaspell","LOCALS",THREE_ROUNDS)
		ForceSpellRES("S!FISSUR", Player1)
	    
END

