

IF
    ActionListEmpty()
    Global("IaCharge","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("IaCharge","LOCALS",0)
		ReallyForceSpellRES("S!CHARG6",Myself)  // No such index
	    Continue()
END


IF
    HaveSpell(WARRIOR_HARDINESS)
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		ReallyForceSpell(Myself,WARRIOR_HARDINESS)
		RemoveSpell(WARRIOR_HARDINESS)
		Continue()
END

IF
	HaveSpell(WARRIOR_WAR_CRY)
