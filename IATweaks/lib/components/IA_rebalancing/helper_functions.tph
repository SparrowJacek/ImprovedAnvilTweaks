    match_param1   = ~-999~ // param1, use -999 for all
    match_param2   = ~-999~ // param2, use -999 for all
    min_duration   = 0      // duration
    header_length = 0x38    // 0x38 for item, 0x28 for spell
  RET
    is_found
    opcode_resource
    opcode_target
