IF
	!GlobalGT("Iacutscene","AR2400",0)  // Mind Flayers in Underdark
THEN
	RESPONSE #100
		NoAction()
END

IF
	GlobalGT("Iacutscene","AR2400",0)  // Mind Flayers in Underdark
	XPLT(Player1,3400000)
	See([PC])
	Global("IaToneDown","LOCALS",0)
	Global("Iahardmode","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("IaToneDown","LOCALS",1)
		SetGlobalTimer("Iapurge","LOCALS",FOUR_ROUNDS)
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	Detect([PC])
	Global("Iatreasure","LOCALS",0)
	Global("Iarodsmiteplace","GLOBAL",3)
THEN
	RESPONSE #100
		SetGlobal("Iarodsmiteplace","GLOBAL",5)
		SetGlobal("Iatreasure","LOCALS",1)
		GiveItemCreate("rods04",Myself,0,0,0)  // Rod of Smiting
		Continue()
END

