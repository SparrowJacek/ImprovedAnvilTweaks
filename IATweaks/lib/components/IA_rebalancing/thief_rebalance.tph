SILENT

INCLUDE "%MOD_FOLDER%/lib/components/IA_rebalancing/helper_functions.tph"
INCLUDE "%MOD_FOLDER%/lib/components/IA_rebalancing/helper_functions_GUI.tph"

// Required checks for Thieving Ability values

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~PICKPOCKET<n~
    stat                  = ~29~
    value                 = ~-1~
    relation              = ~2~
  RET
    pickpocket_lower_than_row = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~SET_TRAPS<n~
    stat                  = ~137~
    value                 = ~-1~
    relation              = ~2~
  RET
    set_traps_lower_than_row = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~DETECT_ILLUSIONS<n~
    stat                  = ~136~
    value                 = ~-1~
    relation              = ~2~
  RET
    detect_illusions_lower_than_row = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~HIDE_IN_SHADOWS<n~
    stat                  = ~135~
    value                 = ~-1~
    relation              = ~2~
  RET
    hide_in_shadows_lower_than_row = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~FIND_TRAPS<n~
    stat                  = ~28~
    value                 = ~-1~
    relation              = ~2~
  RET
    find_traps_lower_than_row = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~STEALTH_STRIKE<n~
    stat                  = ~27~
    value                 = ~-1~
    relation              = ~2~
  RET
    stealth_strike_lower_than_row = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~HIDE_IN_SHADOWS>n~
    stat                  = ~135~
    value                 = ~-1~
    relation              = ~3~
  RET
    hide_in_shadows_higher_than_row = new_line_number
END

// Required Spellstates
// Add spellstate shield_equipped

LAF resolve_state STR_VAR new_state_id = ~HIDE_IN_SHADOWS_SUCCESS~ RET new_state_index END
OUTER_SET hide_in_shadows_success_state = %new_state_index%
// Add spellstate shield_equipped

LAF resolve_state STR_VAR new_state_id = ~HIDE_IN_SHADOWS_FAIL~ RET new_state_index END
OUTER_SET hide_in_shadows_fail_state = %new_state_index%

// Disable backstab for Staves

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
  READ_SHORT 0x1c item_category
  PATCH_IF (item_category = 26) THEN BEGIN  
    READ_BYTE 0x18 item_flags_1
    PATCH_IF (%item_flags_1% BAND 0b01000000) > 0 BEGIN // If weapon is twohanded
      LPF ~ADD_ITEM_EQEFFECT~
        INT_VAR
          opcode = 263
          target = 1
          timing = 2
          parameter1 = ~-5~
          parameter2 = 0
      END
    END
  END
  BUT_ONLY

// Update Quarterstaff description to inform that they can't backstab

COPY_EXISTING ~weapprof.2da~ ~override~
  SET quarterstaff_weapontype_desc = RESOLVE_STR_REF (@5010)
  REPLACE_TEXTUALLY ~34161~ ~%quarterstaff_weapontype_desc%~
  PRETTY_PRINT_2DA

COPY ~IATweaks\resources\2da\skilldex.2da~ ~override~

// Race thieving bonuses

ACTION_DEFINE_ASSOCIATIVE_ARRAY race_to_thieving_bonuses_mapping BEGIN
  //                       PICK_POCKETS    OPEN_LOCKS      FIND_TRAPS      STEALTH_STRIKE  HIDE_IN_SHADOWS   DETECT_ILLUSION   SET_TRAPS
  ~HUMAN~   =>~HUMAN       15              10              5               5               5                 0                 5~
  ~DWARF~   =>~DWARF       10              10              20              0               0                 5                 10~
  ~ELF~     =>~ELF         20              15              5               5               15                10                0~
  ~GNOME~   =>~GNOME       15              15              15              5               10                20                5~
  ~HALF_ELF~=>~HALF_ELF    25              15              5               10              10                5                 0~
  ~HALFLING~=>~HALFLING    20              20              10              20              20                0                 0~
  ~HALFORC~ =>~HALFORC     10              5               5               5               0                 0                 0~
END

COPY_EXISTING ~skillrac.2da~ ~override~
  PHP_EACH race_to_thieving_bonuses_mapping AS race => race_thieving_bonuses BEGIN
    REPLACE_EVALUATE ~%race%.*~ BEGIN END ~%race_thieving_bonuses%~
  END
  PRETTY_PRINT_2DA

// Lower backstab modifiers to x2

COPY_EXISTING ~backstab.2da~ ~override~
  COUNT_2DA_COLS ~colcount~
  COUNT_2DA_ROWS ~colcount~ ~rowcount~
  FOR (current_column = 2; current_column < %colcount%; ++current_column) BEGIN
    FOR (current_row = 0; current_row < %rowcount%; ++current_row) BEGIN
      READ_2DA_ENTRY %current_row% %current_column% %colcount% current_val
      PATCH_IF %current_val% > 2 BEGIN
        SET_2DA_ENTRY %current_row% %current_column% %colcount% 2
      END
    END
  END
  BUT_ONLY

// Remove starting bonuses from all Thieves, the bonuses will be granted in another form

LAF ~S!MAP_COLUMN_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~clasiskl.2da~
  RET_ARRAY
    clasiskl_columns = 2da_columns_to_ids_mapping
END

COPY_EXISTING ~clasiskl.2da~ ~override~
  COUNT_2DA_COLS ~colcount~
  COUNT_2DA_ROWS ~colcount~ ~rowcount~
  PATCH_FOR_EACH class_kit_name IN ~THIEF~ ~FIGHTER_THIEF~ ~FIGHTER_MAGE_THIEF~ ~MAGE_THIEF~ ~CLERIC_THIEF~ ~ASSASIN~ ~BOUNTY_HUNTER~ ~SWASHBUCKLER~ ~SHADOWDANCER~ BEGIN
    FOR (current_row = 0; current_row < %rowcount%; ++current_row) BEGIN
      SPRINT class_kit_id $clasiskl_columns("%class_kit_name%")
      SET_2DA_ENTRY %current_row% ~%class_kit_id%~ %colcount% 0
    END
  END
  // Increase Dark Moon's Detect Illusions
  SET_2DA_ENTRY 5 $clasiskl_columns("DARK_MOON") %colcount% 20
  PRETTY_PRINT_2DA
  BUT_ONLY

// Rework thieving ability scaling to be either 100 or 0 for all

LAF ~S!MAP_COLUMN_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~thiefscl.2da~
  RET_ARRAY
    thiefscl_columns = 2da_columns_to_ids_mapping
END

COPY_EXISTING ~thiefscl.2da~ ~override~
  COUNT_2DA_COLS ~colcount~
  COUNT_2DA_ROWS ~colcount~ ~rowcount~
  SET pickpocket_row = 0
  SET stealth_strike_row = 3
  SET detect_illusions_row = 5
  SET set_traps_row = 6
  PATCH_FOR_EACH class_kit_name IN ~RANGER~ ~CLERIC_RANGER~ ~FERALAN~ ~BEASTMASTER~ ~SWASHBUCKLER~ ~MONK~ ~DARK_MOON~ ~SUN_SOUL~ ~VAGRANT~ ~PROTECTOR~ BEGIN
    SET_2DA_ENTRY %stealth_strike_row% $thiefscl_columns("%class_kit_name%") %colcount% 0
  END
  PATCH_FOR_EACH class_kit_name IN ~BARD~ ~BLADE~ ~JESTER~ ~SKALD~ BEGIN
    SET_2DA_ENTRY %pickpocket_row% $thiefscl_columns("%class_kit_name%") %colcount% 100
  END
  SET_2DA_ENTRY %set_traps_row% $thiefscl_columns("SWASHBUCKLER") %colcount% 0
  PRETTY_PRINT_2DA
  BUT_ONLY

// Rework starting and per-level thieving ability points

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~thiefskl.2da~
  RET_ARRAY
    thiefskl_rows = 2da_rows_to_ids_mapping
END

COPY_EXISTING ~thiefskl.2da~ ~override~
  COUNT_2DA_COLS ~colcount~
  COUNT_2DA_ROWS ~colcount~ ~rowcount~
  SET starting_points_column = 1
  SET per_level_points_column = 2
  PATCH_FOR_EACH class_kit_name IN ~THIEF~ ~FIGHTER_THIEF~ ~MAGE_THIEF~ ~CLERIC_THIEF~ ~FIGHTER_MAGE_THIEF~ BEGIN
    SET_2DA_ENTRY $thiefskl_rows("%class_kit_name%") %starting_points_column% %colcount% 40
    SET_2DA_ENTRY $thiefskl_rows("%class_kit_name%") %per_level_points_column% %colcount% 10
  END
  PATCH_FOR_EACH class_kit_name IN ~SHADOWDANCER~ ~ASSASIN~ ~BOUNTY_HUNTER~ BEGIN
    SET_2DA_ENTRY $thiefskl_rows("%class_kit_name%") %starting_points_column% %colcount% 10
    SET_2DA_ENTRY $thiefskl_rows("%class_kit_name%") %per_level_points_column% %colcount% 10
  END
  PATCH_FOR_EACH class_kit_name IN ~MONK~ ~DARK_MOON~ ~SUN_SOUL~ BEGIN
    SET_2DA_ENTRY $thiefskl_rows("%class_kit_name%") %starting_points_column% %colcount% 0
    SET_2DA_ENTRY $thiefskl_rows("%class_kit_name%") %per_level_points_column% %colcount% 5
  END
  SET_2DA_ENTRY $thiefskl_rows("SWASHBUCKLER") %starting_points_column% %colcount% 20
  SET_2DA_ENTRY $thiefskl_rows("SWASHBUCKLER") %per_level_points_column% %colcount% 10
  BUT_ONLY

// Per level bonuses for Rangers, Shamans and Bards

COPY ~IATweaks\resources\spl\s!0ss.spl~ ~override~

ACTION_FOR_EACH kit_that_can_hide_but_not_backstab IN ~CLABRN01~ ~CLABRN03~ ~CLABRN04~ ~VAGRAN~ ~PROTEC~ ~CLABMO01~ ~CLABMO02~ ~CLABMO03~ ~CLABTH04~ BEGIN
  // All kits/classes that can't backstab will get -250 to Stealth Strike at lvl1 to prevent them from gaining bonuses from it
  LAF ~S!ADD_CLAB_ROW~
    STR_VAR
      filename = ~%kit_that_can_hide_but_not_backstab%.2da~
      row_desc = ~NO_STEALTH_STRIKE~
      level1 = ~AP_S!0SS~
  END
END

