IF
	OnCreation()
THEN
	RESPONSE #100
		ReallyForceSpellRES("S!MFPROT",Myself)
		Continue()
END

IF
	GlobalGT("IaMind01","LOCALS",0)
	!GlobalTimerNotExpired("IaMindRegen","LOCALS")
	!CheckSpellState(LastSeenBy(Myself),PSIONICS_IMMUNITY)
THEN
	RESPONSE #100
		IncrementGlobal("IaMind01","LOCALS",-1)
		SetGlobalTimerRandom("IaMindRegen","LOCALS",4,7)
END

IF
	Global("IaStartFight","LOCALS",0)
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOfType([PC]))
	!CheckSpellState(LastSeenBy(Myself),PSIONICS_IMMUNITY)
THEN
	RESPONSE #100
		IncrementGlobal("IaStartFight","LOCALS",1)
		SetGlobalTimerRandom("Iaspell","LOCALS",1,3)
END

IF
	GlobalLT("IaMind01","LOCALS",5)
	See(SecondNearest([0.0.MIND_FLAYER.0.0.0.0]))
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOfType([PC]))
	!CheckStatGT(LastSeenBy(Myself),25,MAGICDAMAGERESISTANCE)
	!CheckSpellState(LastSeenBy(Myself),PSIONICS_IMMUNITY)
THEN
	RESPONSE #100
		IncrementGlobal("IaMind01","LOCALS",3)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ForceSpellRES("S!MFBLST",LastSeenBy(Myself))  // Focused Mind Blast
END

