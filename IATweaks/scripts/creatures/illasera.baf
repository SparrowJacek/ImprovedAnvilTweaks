IF
	Allegiance(Myself,ENEMY)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	HPPercentLT(Myself,90)
	OR(2)
		!GlobalTimerNotExpired("absolute","LOCALS")
		CheckStat(Myself,0,SCRIPTINGSTATE6)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	HasItem("scrl9p",Myself)  // Absolute Immunity
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("absolute","LOCALS",FOUR_ROUNDS)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46153)  // *uses a scroll*
		UseItem("scrl9p",Myself)  // Absolute Immunity
		SetInterrupt(TRUE)
END


IF
	HaveSpellRES("S!GGRACE")  // Ghost's Grace
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaGhostGrace","LOCALS")
	CheckStatLT(Myself,1,STONESKINS)
THEN
	RESPONSE #100
		SetGlobalTimer("IaGhostGrace","LOCALS",ONE_TURN)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!GGRACE",Myself)  // Ghost's Grace
		RemoveSpellRES("S!GGRACE")  // Ghost's Grace
END


IF
	HaveSpellRES("SPCL917")  // Avoid Death
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaAvoidDeath","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaAvoidDeath","LOCALS",ONE_TURN)
		ReallyForceSpellRES("SPCL917",Myself)  // Avoid Death
		RemoveSpellRES("SPCL917")  // Avoid Death
END


IF
	HasItem("SCRL7M",Myself)
	Allegiance(Myself,ENEMY)
    !GlobalTimerNotExpired("IaAction","LOCALS")
	!See([PC])
	!See(SecondNearest([PC]))
	!See(ThirdNearest([PC]))
    Range([PC],15)
	!GlobalTimerNotExpired("truesight","LOCALS")
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("truesight","LOCALS",TEN_ROUNDS)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46153)  // *uses a scroll*
		UseItem("SCRL7M",Myself)
		SetInterrupt(TRUE)
	RESPONSE #0
	    Continue()
END


IF
	HaveSpell(ROGUE_GREATER_EVASION)
	Allegiance(Myself,ENEMY)
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_STUNNED)
	!StateCheck(Myself,STATE_PANIC)
	See(NearestEnemyOf(Myself))
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaEvasion","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaEvasion","LOCALS",ONE_TURN)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ForceSpell(Myself,ROGUE_GREATER_EVASION)
		RemoveSpell(ROGUE_EVASION)
	RESPONSE #0
	    Continue()
END



