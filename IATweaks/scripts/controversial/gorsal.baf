IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Iagorsal01","LOCALS",0)
THEN
	RESPONSE #100
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		ReallyForceSpell(Myself,WIZARD_IMPROVED_HASTE)  // SPWI613.SPL (Improved Haste)
		ReallyForceSpellRES("SPWII03",Myself)  // Spell Turning
		ReallyForceSpellRES("jwglobe",Myself)  // Globe of Invulnerability
		SetGlobal("Iagorsal01","LOCALS",1)
		SetGlobal("Iaattack","LOCALS",2)
END

IF
	Allegiance(Myself,ENEMY)
