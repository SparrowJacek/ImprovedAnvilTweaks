IF
	HaveSpell(WIZARD_WISH)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaWishTimer","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	OR(3)
	    See(NearestEnemyOf(Myself))
	    See(SecondNearestEnemyOf(Myself))
	    See(ThirdNearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaWishTimer","LOCALS",TWO_ROUNDS)
		RemoveSpell(WIZARD_WISH)
		SpellNoDecRES("S!WISHEN",Myself)
		SetGlobalRandomPlus("IaWish","LOCALS",1,1,1)
		SmallWait(20)
		SetInterrupt(TRUE)
	RESPONSE #200
	    Continue()
END

