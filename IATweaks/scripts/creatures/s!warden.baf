	See(SixthNearest([PC])) 
	TriggerOverride(SixthNearest([PC]), Range(ThirdNearest([PC]), 15))
	CheckStatLT(SixthNearest([PC]),90,RESISTFIRE)
	CheckStatLT(SixthNearest([PC]),80,RESISTMAGIC)
	CheckStatLT(ThirdNearest([PC]),90,RESISTFIRE)
	CheckStatLT(ThirdNearest([PC]),80,RESISTMAGIC)
THEN
	RESPONSE #250
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaComet","LOCALS",TWO_ROUNDS)
		SpellRES("SPWI925", SixthNearest([PC]))
	RESPONSE #50
	    Continue()
END

