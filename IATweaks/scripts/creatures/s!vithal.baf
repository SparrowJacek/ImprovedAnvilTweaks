
IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Prep","LOCALS",0)
THEN
	RESPONSE #100
	    ReallyForceSpellRES("S!CNT01A",Myself)
	    Continue()
	RESPONSE #25
	    ReallyForceSpellRES("S!CNT03A",Myself)
	    Continue()
	RESPONSE #25
	    ReallyForceSpellRES("S!CNT04A",Myself)
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Prep","LOCALS",0)
THEN
	RESPONSE #100
	    ReallyForceSpellRES("S!CNT02A",Myself)
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Prep","LOCALS",0)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("Prep","LOCALS",1)
		ReallyForceSpellRES("PTN34X",Myself)  // No such index
		ReallyForceSpellRES("PTN33X",Myself)  // No such index
		ReallyForceSpellRES("PTN33X",Myself)  // No such index
		ReallyForceSpellRES("SPWI902",Myself)  // Monster Summoning VII
		RemoveSpellRES("SPWI902")
		ReallyForceSpellRES("SPWI902",Myself)  // Monster Summoning VII
		RemoveSpellRES("SPWI902")
		ReallyForceSpellRES("SPWI902",Myself)  // Monster Summoning VII
		RemoveSpellRES("SPWI902")
		ReallyForceSpellRES("SPWI815",Myself)  // Monster Summoning VI
		RemoveSpellRES("SPWI815")
		ReallyForceSpellRES("SPWI815",Myself)  // Monster Summoning VI
		RemoveSpellRES("SPWI815")
		ReallyForceSpellRES("SPWI815",Myself)  // Monster Summoning VI
		RemoveSpellRES("SPWI815")
		ReallyForceSpell(Myself,WIZARD_ARMOR)  // SPWI102.SPL (Armor)
		RemoveSpell(WIZARD_ARMOR)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_EVIL)  // SPWI113 (Protection From Evil)
		RemoveSpell(WIZARD_ARMOR)
		ReallyForceSpell(Myself,WIZARD_SHIELD)  // SPWI114.SPL (Shield)
		RemoveSpell(WIZARD_SHIELD)
		ReallyForceSpell(Myself,WIZARD_BLUR)  // SPWI201.SPL (Blur)
		RemoveSpell(WIZARD_BLUR)
		ReallyForceSpell(Myself,WIZARD_LUCK)  // SPWI209.SPL (Luck)
		RemoveSpell(WIZARD_LUCK)
		ReallyForceSpell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (Mirror Image)
		RemoveSpell(WIZARD_MIRROR_IMAGE)
		ReallyForceSpell(Myself,WIZARD_MELF_METEOR)  // SPWI325.SPL (Melf's Minute Meteors)
		RemoveSpell(WIZARD_MELF_METEOR)
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		RemoveSpell(WIZARD_STONE_SKIN)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Fire Shield (Red))
		RemoveSpell(WIZARD_FIRE_SHIELD_RED)
		ReallyForceSpell(Myself,WIZARD_IMPROVED_INVISIBILITY)  // SPWI405.SPL (Improved Invisibility)
		RemoveSpell(WIZARD_IMPROVED_INVISIBILITY)
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_DIVINATION)  // SPWI592.SPL (Immunity: Divination)
		RemoveSpell(WIZARD_SPELL_IMMUNITY)
		ReallyForceSpellRES("SPWI522",Myself)  // Soul Armor
		RemoveSpellRES("SPWI522")
		ReallyForceSpell(Myself,WIZARD_GLOBE_OF_INVULNERABILITY)  // SPWI602.SPL (Globe of Invulnerability)
		RemoveSpell(WIZARD_GLOBE_OF_INVULNERABILITY)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_ENERGY)  // SPWI606.SPL (Protection From Magic Energy)
		RemoveSpell(WIZARD_PROTECTION_FROM_MAGIC_ENERGY)
		ReallyForceSpell(Myself,WIZARD_SPELL_TURNING)  // SPWI701.SPL (Spell Turning)
		RemoveSpell(WIZARD_SPELL_TURNING)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_THE_ELEMENTS)  // SPWI702.SPL (Protection From The Elements)
		RemoveSpell(WIZARD_PROTECTION_FROM_THE_ELEMENTS)
		ReallyForceSpellRES("SPWI725",Myself)  // Shield Mind and Body
		RemoveSpellRES("SPWI725")
		ReallyForceSpellRES("SPWI804",Myself)  // Tenser's Partial Transformation
		RemoveSpellRES("SPWI804")
		SmallWait(2)
		ReallyForceSpell(Myself,WIZARD_HASTE)  // SPWI305.SPL (Haste)
		RemoveSpell(WIZARD_HASTE)  // SPWI305.SPL (Haste)
		SetInterrupt(TRUE)
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Iarep","LOCALS",0)
	Global("IaPrep","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iarep","LOCALS",1)
		ReputationInc(-2)
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Iaitem","LOCALS",0)
	Global("IaPrep","LOCALS",1)
	GlobalGT("dwVithal","GLOBAL",17)
	!HasItem("helm17",Myself)  // Skull of Death
THEN
	RESPONSE #100
		SetGlobal("Iaitem","LOCALS",1)
		GiveItemCreate("helm17",Myself,1,1,0)  // Skull of Death
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Iaitem2","LOCALS",0)
	Global("IaPrep","LOCALS",1)
	GlobalGT("dwVithal","GLOBAL",3)
	!HasItem("scrl9e",Myself)  // Incendiary Cloud
	!HasItem("scrl9v",Myself)  // Wail of the Banshee
	!HasItem("scrl9m",Myself)  // Spellstrike
THEN
	RESPONSE #100
		SetGlobal("Iaitem2","LOCALS",1)
		GiveItemCreate("scrl9e",Myself,0,0,0)  // Incendiary Cloud
		GiveItemCreate("scrl9v",Myself,0,0,0)  // Wail of the Banshee
		GiveItemCreate("scrl9m",Myself,0,0,0)  // Spellstrike
END


IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	OR(4)
		CheckStatGT(Myself,0,SCRIPTINGSTATE9)
		StateCheck(Myself,STATE_HELPLESS)
		StateCheck(Myself,STATE_STUNNED)
		Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",2)
END

IF
	Range(NearestEnemyOf(Myself),5)
	GlobalTimerNotExpired("Iaspell","LOCALS")
	!StateCheck(NearestEnemyOf(Myself),STATE_HARMLESS)
	!CheckStatGT(NearestEnemyOf(Myself),0,HELD)
	!GlobalTimerNotExpired("IaRunAway","LOCALS")
	CheckStatLT(Myself,5,STONESKINS)
	!CheckStatGT(Myself,0,SCRIPTINGSTATE6)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRunAway","LOCALS",TWO_ROUNDS)
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),30)
		SetInterrupt(TRUE)
END

IF
	Range(NearestEnemyOf(Myself),5)
	GlobalTimerNotExpired("Iaspell","LOCALS")
	!StateCheck(NearestEnemyOf(Myself),STATE_HARMLESS)
	!CheckStatGT(NearestEnemyOf(Myself),0,HELD)
	!GlobalTimerNotExpired("IaRunAway","LOCALS")
	CheckStatLT(Myself,5,STONESKINS)
	HPPercentLT(Myself,80)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRunAway","LOCALS",TWO_ROUNDS)
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),30)
		SetInterrupt(TRUE)
END


IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
		Continue()
END


IF
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	StateCheck(Myself,STATE_SILENCED)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDec(Myself,WIZARD_VOCALIZE)  // SPWI219.SPL (Vocalize)
END
IF
    HaveSpell(WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	CheckStat(Myself,0,SCRIPTINGSTATE6)
	See(NearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),10)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		Spell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)
	RESPONSE #25
	    Continue()
END
IF
    HaveSpell(WIZARD_STONE_SKIN)
