IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	HaveSpell(CLERIC_POISON)  // SPPR411.SPL (Poison)
	See([PC.0.0.MAGE_ALL])
	!StateCheck(LastSeenBy(Myself),STATE_POISONED)
	CheckStatGT(LastSeenBy(Myself),3,SAVEVSDEATH)
	!CheckSpellState([PC.0.0.MAGE_ALL],POISON_EFFECT_IMMUNITY)
	!CheckStat(LastSeenBy(Myself),5,SCRIPTINGSTATE7)
	!ImmuneToSpellLevel([PC.0.0.MAGE_ALL],4)
	!HasBounceEffects([PC.0.0.MAGE_ALL])
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
	!StateCheck(LastSeenBy(Myself),STATE_HARMLESS)
	CheckStatLT(LastSeenBy(Myself),60,RESISTPOISON)
	CheckStatLT(LastSeenBy(Myself),10,RESISTMAGIC)
THEN
	RESPONSE #75
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		Spell(LastSeenBy(Myself),CLERIC_POISON)  // SPPR411.SPL (Poison)
	RESPONSE #25
	    Continue()
END

