IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!GlobalTimerNotExpired("Iapurge","LOCALS")
	!HPLT(Myself,1)
	See(FifthNearest([PC]))
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	OR(8)
		CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE8)
		CheckStatGT(LastSeenBy(Myself),2,SCRIPTINGSTATE6)
		CheckStatGT(LastSeenBy(Myself),1,STONESKINS)
		StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
		StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
		StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
		CheckStatGT(LastSeenBy(Myself),0,IMPROVEDHASTE)
		CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE3)
THEN
	RESPONSE #100
		SetGlobalTimer("Iapurge","LOCALS",SIX_ROUNDS)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("SPINI29",LastSeenBy(Myself))  // Purge Magic
END

