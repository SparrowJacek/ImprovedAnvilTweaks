IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("guardtimer","LOCALS")
	Exists("S!trollk")  // Troll King
	!Dead("S!trollk")  // Troll King
	OR(2)
		HPPercentLT("S!trollk",100)  // Troll King
		TriggerOverride("S!trollk",Range(ThirdNearestEnemyOf(Myself),4))
	!Range("S!trollk",30)  // Troll King
	CheckStatGT(Myself,0,AURACLEANSING)
	GlobalLT("Guard","LOCALS",2)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		IncrementGlobal("Guard","LOCALS",1)
		ApplySpellRES("s!flee01",Myself)
		SpellNoDecRES("S!LINKUP","S!trollk")  // Troll King
		SetGlobalTimer("guardtimer","LOCALS",TWO_ROUNDS)
		SetInterrupt(TRUE)
END

