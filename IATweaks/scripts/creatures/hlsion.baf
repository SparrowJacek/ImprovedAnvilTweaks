IF
	Allegiance(Myself,ENEMY)
	See([PC])
	HasItem("ENEBLADE",Myself)
    CheckStatGT([PC],20,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
    OR(2)
        CheckStatLT([PC],100,RESISTSLASHING)
        CheckStatLT([PC],100,RESISTELECTRICITY)
    !CheckStatGT([PC],2,SCRIPTINGSTATE6)
	!CheckSpellState([PC],MISSILE_IMMUNITY)
	OR(2)
        !CheckStatGT([PC],1,STONESKINS)
        CheckStatLT([PC],100,RESISTELECTRICITY)
	!StateCheck([PC],STATE_MIRRORIMAGE)
THEN
	RESPONSE #100
		SetGlobal("IaAttacking","LOCALS",1)
		SetGlobal("IaInterrupting","LOCALS",1)
		SetGlobalTimer("IaInterruptingTimer","LOCALS",2)
		AttackReevaluate([PC],30)
END
IF
	Allegiance(Myself,ENEMY)
	See(SecondNearest([PC]))
	HasItem("ENEBLADE",Myself)
    CheckStatGT(SecondNearest([PC]),20,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
    OR(2)
        CheckStatLT(SecondNearest([PC]),100,RESISTSLASHING)
        CheckStatLT(SecondNearest([PC]),100,RESISTELECTRICITY)
    !CheckStatGT(SecondNearest([PC]),2,SCRIPTINGSTATE6)
	!CheckSpellState(SecondNearest([PC]),MISSILE_IMMUNITY)
	OR(2)
        !CheckStatGT(SecondNearest([PC]),1,STONESKINS)
        CheckStatLT(SecondNearest([PC]),100,RESISTELECTRICITY)
	!StateCheck(SecondNearest([PC]),STATE_MIRRORIMAGE)
THEN
	RESPONSE #100
		SetGlobal("IaAttacking","LOCALS",1)
		SetGlobal("IaInterrupting","LOCALS",1)
		SetGlobalTimer("IaInterruptingTimer","LOCALS",2)
		AttackReevaluate(SecondNearest([PC]),30)
END
