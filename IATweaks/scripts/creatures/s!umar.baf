IF
    Global("IaInterrupting","LOCALS",1)
	GlobalTimerExpired("IaInterruptingTimer","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("IaInterrupting","LOCALS",0)
		ClearActions(Myself)
END


IF
	Range(ThirdNearestEnemyOf(Myself),5)
	OR(2)
		StateCheck(Myself,STATE_HASTED)
		!CheckStat(Myself,0,IMPROVEDHASTE)
	!GlobalTimerNotExpired("IaRunAway","LOCALS")
	IsWeaponRanged(Myself)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRunAway","LOCALS",10)
		RunAwayFromNoLeaveArea(NearestEnemyOf(Myself),60)
		SetInterrupt(TRUE)
END

