IF
    HaveSpell(WIZARD_REMOVE_MAGIC)
    OR(2)
	    HaveSpell(WIZARD_POWER_WORD_KILL)
	    HasItem("SCRL9U",Myself)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaRemoveMagicWait","LOCALS")
	Allegiance(Myself,ENEMY)
	See(SixthNearest([PC]))
	CheckStatGT(SixthNearest([PC]),8,DISPELLABLEBUFFSPOWER)
	TriggerOverride(SixthNearest([PC]), Range([PC], 15))
	TriggerOverride(SixthNearest([PC]), CheckStatGT([PC],3,DISPELLABLEBUFFSPOWER))
	!TriggerOverride(SixthNearest([PC]), CheckStat([PC],1,SCRIPTINGSTATE7))
	!CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	CheckStatLT(LastSeenBy(Myself),25,RESISTMAGIC)
	HPLT(LastSeenBy(Myself),60)
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE7)
	CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE2)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRemoveMagicWait","LOCALS",12)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),WIZARD_REMOVE_MAGIC)  // SPWI302.SPL (Remove Magic)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #50
	    Continue()
END
