// Add condition for checking stat range for dex/str bonuses

// dex

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~DEX_LESS_THAN_13~
    stat                  = ~40~
    value                 = ~13~
    relation              = ~2~
  RET
    dex_less_than_13 = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~DEX_GREATER_THAN_15~
    stat                  = ~40~
    value                 = ~16~
    relation              = ~3~
  RET
