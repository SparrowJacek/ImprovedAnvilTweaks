/////////// Rayic (Cowled Wizard that Edwin orders us to kill) ////////////

COPY_EXISTING ~DCOWL1.CRE~ ~override~
  WRITE_SHORT 0x24 43 // HP
  WRITE_SHORT 0x26 43 // HP
  WRITE_BYTE  0x23d 16 // Constitution
  REMOVE_MEMORIZED_SPELL ~spwi609~ ~spwi899~ ~spwi601~
  REMOVE_KNOWN_SPELL ~spwi609~

COPY_EXISTING ~rayic.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    REPLACE_EVALUATE
      ~\([ %TAB%]+\)\(ReallyForceSpellRES("SPWII41",Myself)\)\([ %TAB%%LNL%%MNL%%WNL%]+\)~
    BEGIN
    END
    ~%MATCH1%%MATCH2%%MATCH3%%MATCH1%ReallyForceSpellRES("SPWI618",Myself)%MATCH3%~
  END

