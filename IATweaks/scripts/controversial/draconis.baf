
IF
	OR(2)
		Allegiance(Myself,ENEMY)
		Range([GOODCUTOFF],75)
	Global("Prepare","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Prepare","LOCALS",1)
		SetGlobalTimer("Iadraconisrest","GLOBAL",SEVEN_HOURS)
		SetGlobalTimer("absolute","LOCALS",FOUR_ROUNDS)
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Fire Shield (Red))
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)  // SPWI611.SPL (Protection From Magical Weapons)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_ENERGY)  // SPWI606.SPL (Protection From Magic Energy)
		ReallyForceSpellRES("jwglobe",Myself)  // Globe of Invulnerability
		ReallyForceSpellRES("spwii10",Myself)  // Black Blade of Disaster
		ReallyForceSpellRES("spwii03",Myself)  // Spell Turning
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_ABJURATION)  // SPWI590.SPL (Immunity: Abjuration)
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	GlobalTimerExpired("Iadraconisrest","GLOBAL")
	GlobalGT("Prepare","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("Iadraconisrest","GLOBAL",SEVEN_HOURS)
		SetGlobal("Prepare","LOCALS",0)
		SetGlobal("Prepare2","LOCALS",0)
		SetGlobal("Summon","LOCALS",0)
		SetGlobal("Iadra03","LOCALS",0)
		SetGlobal("Iadra04","LOCALS",0)
		SetGlobal("Irefreshsi","LOCALS",0)
		SetGlobal("Iadra07","LOCALS",0)
		SetGlobal("Iadra08","LOCALS",0)
		SetGlobal("Iadra09","LOCALS",0)
		SetGlobal("Iadra10","LOCALS",0)
		SetGlobal("Iadra11","LOCALS",0)
		SetGlobal("Iadra12","LOCALS",0)
		SetGlobal("Iacastbreach","LOCALS",0)
		SetGlobal("Iareversal","LOCALS",0)
		SetGlobal("Iabbd","LOCALS",0)
		SetGlobal("Iaabs","LOCALS",0)
		SetGlobal("Iawilting","LOCALS",0)
		SetGlobal("Ianoward","LOCALS",0)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
	!HPLT(Myself,2)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	OR(2)
		CheckStatGT(Myself,0,SCRIPTINGSTATE9)
		Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	ActionListEmpty()
	!GlobalTimerNotExpired("Iawishcombo","LOCALS")
	!HPLT(Myself,2)
	GlobalLT("Iadra11","LOCALS",2)
	Allegiance(Myself,ENEMY)
	See(Player1)
	!StateCheck(Player1,STATE_IMPROVEDINVISIBILITY)
	!StateCheck(Player1,STATE_INVISIBLE)
	CheckStatLT(Player1,25,RESISTMAGIC)
	!CheckStat(Player1,2,SCRIPTINGSTATE7)
	!CheckStatGT(Player1,0,SCRIPTINGSTATE2)
	!HasBounceEffects(Player1)
	Global("Iap1nr","GLOBAL",0)
	HPLT(Player1,60)
THEN
	RESPONSE #100
		IncrementGlobal("Iadra11","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDec(Player1,WIZARD_POWER_WORD_KILL)  // SPWI912.SPL (Power Word, Kill)
END

