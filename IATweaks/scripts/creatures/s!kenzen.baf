	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaRemoveMagicWait","LOCALS")
	Allegiance(Myself,ENEMY)
	See([PC])
	CheckSpellState(LastSeenBy(Myself),DISPELLABLE_INCREASED_MAGIC_DAMAGE_RESISTANCE)
	OR(2)
		CheckSpellState(LastSeenBy(Myself),DISPELLABLE_INCREASED_MAGIC_DAMAGE_RESISTANCE)
		CheckStatGT([PC],10,DISPELLABLEBUFFSPOWER)
	TriggerOverride([PC], Range([PC], 15))
	TriggerOverride([PC], CheckStatGT([PC],3,DISPELLABLEBUFFSPOWER))
	!TriggerOverride([PC], CheckStat([PC],1,SCRIPTINGSTATE7))
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
