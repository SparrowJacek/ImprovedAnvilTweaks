THEN
	RESPONSE #100
		SetGlobal("Iaavoidplace","GLOBAL",5)
		SetGlobal("Iatreasure2","LOCALS",1)
		GiveItemCreate("boot04",Myself,0,0,0)  // Senses of the Cat
END

