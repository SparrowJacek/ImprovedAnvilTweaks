// Change APR and dmg for Gem, Coin and Amber Golems

ACTION_FOR_EACH lesser_golem_weapon IN ~S!GEM.itm~ ~S!AMBER.itm~ BEGIN
  COPY_EXISTING ~%lesser_golem_weapon%~ ~override~
    LPF ~ALTER_ITEM_HEADER~
      INT_VAR
        dicesize = 8
        dicenumber = 3
        damage_bonus = 2
    END
    LPF ~DELETE_EFFECT~
      INT_VAR
        match_opcode = 221
        match_parameter2 = 3
    END
    LPF ~ADD_ITEM_EQEFFECT~
      INT_VAR
        target = 1
        timing = 2
        opcode = 1
        parameter1 = 1
        parameter2 = 0
    END 
END 

// Make Gem, Coin and Amber Golems polymorphable

ACTION_FOR_EACH lesser_golem_weapon IN ~S!GEM.itm~ ~S!AMBER.itm~ BEGIN
  COPY_EXISTING ~%lesser_golem_weapon%~ ~override~
    LPF ~DELETE_EFFECT~
      INT_VAR
        match_opcode = 101
        match_parameter2 = 135
    END
    LPF ~DELETE_EFFECT~
      INT_VAR
        match_opcode = 101
        match_parameter2 = 111
    END
    LPF ~ADD_ITEM_EQEFFECT~
      INT_VAR
        target = 1
        timing = 2
        opcode = 325
        parameter1 = 1
        parameter2 = 0
    END 
END

