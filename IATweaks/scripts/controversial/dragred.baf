		SetGlobal("partyfled","LOCALS",0)
		Continue()
END

IF
	!See([PC])
	!See([GOODCUTOFF])
	Global("partyfled","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Global("IaPrep","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobalTimer("IaRestTimer","LOCALS",SEVEN_HOURS)
		SetGlobal("partyfled","LOCALS",1)
END


IF
	Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	See([PC])
	Range(LastSeenBy(Myself),11)
	Global("Iacreature","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iacreature","LOCALS",1)
		SetGlobal("Iamessage","AR1203",1)  // Firkraag's Hideout
		SetInterrupt(FALSE)
		ForceSpell(LastSeenBy(Myself),DRAGON_WING_BUFFET)  // SPIN695.SPL (Wing Buffet)
		Wait(1)
		CreateCreatureObject("S!abishr",Myself,0,0,0)
		CreateCreatureObject("S!abishr",Myself,0,0,0)
		CreateCreatureObject("S!abishr",Myself,0,0,0)
		SetInterrupt(TRUE)
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	See([PC])
	Range(LastSeenBy(Myself),11)
	HPPercentLT(Myself,30)
	Global("Iacreature","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iacreature","LOCALS",2)
		SetGlobal("Iamessage","AR1203",3)  // Firkraag's Hideout
		SetInterrupt(FALSE)
		ForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		ForceSpell(LastSeenBy(Myself),DRAGON_WING_BUFFET)  // SPIN695.SPL (Wing Buffet)
		Wait(1)
		CreateCreatureObject("S!abishr",Myself,0,0,0)
		CreateCreatureObject("S!abishr",Myself,0,0,0)
		CreateCreatureObject("S!abishr",Myself,0,0,0)
		ForceSpellRES("SPPRI10",Myself)  // Heal
		SetInterrupt(TRUE)
END

