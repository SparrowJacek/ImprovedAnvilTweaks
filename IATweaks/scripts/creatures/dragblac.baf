IF
    HaveSpell(WIZARD_REMOVE_MAGIC)
	!GlobalTimerNotExpired("IaRemoveMagicWait","LOCALS")
	Allegiance(Myself,ENEMY)
	See([PC])
	CheckSpellState(LastSeenBy(Myself),DISPELLABLE_INCREASED_ACID_RESISTANCE)
    CheckStatGT([PC],10,DISPELLABLEBUFFSPOWER)
	TriggerOverride([PC], Range([PC], 14))
	OR(2)
	    TriggerOverride([PC], CheckStatGT([PC],3,DISPELLABLEBUFFSPOWER))
	    TriggerOverride([PC], CheckSpellState([PC],DISPELLABLE_INCREASED_ACID_RESISTANCE))
	!TriggerOverride([PC], CheckStat([PC],1,SCRIPTINGSTATE7))
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRemoveMagicWait","LOCALS",24)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		RemoveSpell(WIZARD_REMOVE_MAGIC)
		ForceSpell(LastSeenBy(Myself),WIZARD_REMOVE_MAGIC)  // SPWI302.SPL (Remove Magic)
		SetInterrupt(TRUE)
	RESPONSE #100
	    Continue()
END

