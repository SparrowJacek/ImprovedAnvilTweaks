
IF
	OnCreation()
THEN
	RESPONSE #100
		ReallyForceSpellRES("S!MFPROT",Myself)
		Continue()
END

IF
	GlobalGT("IaMind01","LOCALS",1)
	!GlobalTimerNotExpired("IaMindRegen","LOCALS")
THEN
	RESPONSE #100
		IncrementGlobal("IaMind01","LOCALS",-2)
		SetGlobalTimerRandom("IaMindRegen","LOCALS",3,4)
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
	    ReallyForceSpellRES("S!CNT04A",Myself)
	    Continue()
END

IF
	OR(3)
		See(NearestEnemyOf(Myself))
		AttackedBy([GOODCUTOFF],DEFAULT)
		HPPercentLT(Myself,100)
	Global("IaPrep","LOCALS",0)
	!HPLT(Myself,1)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("IaPrep","LOCALS",1)
		SetGlobalTimer("IaContinThreeRRRTimer","LOCALS",12)
		SetGlobalTimer("pfmw","LOCALS",FOUR_ROUNDS)
		ReallyForceSpell(Myself,WIZARD_ARMOR)  // SPWI102.SPL (Armor)
		ReallyForceSpell(Myself,WIZARD_SHIELD)  // SPWI114.SPL (Shield)
		ReallyForceSpell(Myself,WIZARD_NON_DETECTION)
		ReallyForceSpell(Myself,WIZARD_LUCK)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)  // SPWI611.SPL (Protection From Magical Weapons)
		ReallyForceSpell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (Mirror Image)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_BLUE)  // SPWI403.SPL (Fire Shield (Blue))
		ReallyForceSpell(Myself,WIZARD_IMPROVED_INVISIBILITY)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_RED)
		ReallyForceSpell(Myself,WIZARD_GLOBE_OF_INVULNERABILITY)  // SPWI602.SPL (Globe of Invulnerability)
		ReallyForceSpell(Myself,WIZARD_IMPROVED_HASTE)
		ReallyForceSpellRES("SPWI607",Myself)
		ReallyForceSpell(Myself,WIZARD_SPELL_TURNING)  // SPWI701.SPL (Spell Turning)
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_ABJURATION)  // SPWI590.SPL (Immunity: Abjuration)
		ReallyForceSpell(Myself,WIZARD_BLACK_BLADE_OF_DISASTER)
		EquipItem("blakblad")
		RemoveSpell(WIZARD_NON_DETECTION)
		RemoveSpell(WIZARD_LUCK)
		RemoveSpell(WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)
		RemoveSpell(WIZARD_MIRROR_IMAGE)
		RemoveSpell(WIZARD_FIRE_SHIELD_BLUE)
		RemoveSpell(WIZARD_IMPROVED_INVISIBILITY)
		RemoveSpell(WIZARD_FIRE_SHIELD_RED)
		RemoveSpell(WIZARD_GLOBE_OF_INVULNERABILITY)
		RemoveSpell(WIZARD_IMPROVED_HASTE)
		RemoveSpellRES("SPWI607")
		RemoveSpell(WIZARD_SPELL_TURNING)
		RemoveSpell(WIZARD_SPELL_IMMUNITY_ABJURATION)
		RemoveSpell(WIZARD_BLACK_BLADE_OF_DISASTER)
		SetInterrupt(TRUE)
		Continue()
END

IF
	Global("IaMind01","LOCALS",1)
THEN
	RESPONSE #100
		IncrementGlobal("IaMind01","LOCALS",-1)
		Continue()
END

IF
	See(NearestEnemyOf(Myself))
	Global("EnemySeen","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("EnemySeen","LOCALS",1)
		Shout(89)
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([GOODCUTOFF])
		Detect([PC])
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
		Shout(89)
		Continue()
END


