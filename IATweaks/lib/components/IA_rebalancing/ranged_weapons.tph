PRINT @5207

SILENT

INCLUDE "IATweaks/lib/components/IA_rebalancing/helper_functions.tph"
INCLUDE "IATweaks/lib/components/IA_rebalancing/helper_functions_GUI.tph"

// Merge Shortbows and Longbows into Bows category, update description

COPY_EXISTING ~weapprof.2da~ ~override~
  SET bow_weapontype_desc = RESOLVE_STR_REF (@5204)
  SET ranged_style_name = RESOLVE_STR_REF (@5205)
  SET ranged_style_desc = RESOLVE_STR_REF (@5206)
  REPLACE_TEXTUALLY ~34164~ ~%bow_weapontype_desc%~
  REPLACE_TEXTUALLY ~31129~ ~8733~
  REPLACE_TEXTUALLY ~31128~ ~%ranged_style_name%~
  REPLACE_TEXTUALLY ~34163~ ~%ranged_style_desc%~
  REPLACE_TEXTUALLY ~SHORTBOW~ ~BOW_MERGED~
  REPLACE_TEXTUALLY ~LONGBOW~ ~RANGEDPROF~
  PRETTY_PRINT_2DA

COPY_EXISTING ~weapprof.2da~ ~override~

  // Capture the entire row starting with our known string
  TEXT_SPRINT captured_row ~~
  REPLACE_EVALUATE CASE_INSENSITIVE ~RANGEDPROF[ 0-9A-Za-z_-]*~ BEGIN
      TEXT_SPRINT captured_row ~%MATCH0%~
  END ~~

  // Insert it at the target position
  COUNT_2DA_COLS num_cols
  INSERT_2DA_ROW 27 num_cols ~%captured_row%~
  PRETTY_PRINT_2DA

BUT_ONLY_IF_IT_CHANGES


// Assign values to Ranged Weapons proficiencies per kit

LAF ~S!MAP_COLUMN_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~weapprof.2da~
  RET_ARRAY
    weapprof_cols = 2da_columns_to_ids_mapping
END

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~weapprof.2da~
  RET_ARRAY
    weapprof_rows = 2da_rows_to_ids_mapping
END

COPY_EXISTING ~weapprof.2da~  ~override/weapprof.2da~
