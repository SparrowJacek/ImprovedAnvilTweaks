	Exists("S!aurie3")  // Chief Inspector Auriel
	!Dead("S!aurie3")  // Chief Inspector Auriel
	See(NearestEnemyOf(Myself))
	CheckStatGT(LastSeenBy(Myself),2,SCRIPTINGSTATE6)
THEN
	RESPONSE #100
