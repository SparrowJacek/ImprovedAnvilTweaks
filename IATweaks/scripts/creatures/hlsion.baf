        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
    HPGT(LastSeenBy(Myself),60)
	OR(2)
	    HPGT(LastSeenBy(Myself),30)
	    DifficultyGT(NORMAL)
	OR(2)
	    HPGT(LastSeenBy(Myself),45)
	    Difficulty(HARDEST)
	OR(2)
	    CheckStatLT(LastSeenBy(Myself),80,RESISTFIRE)
	    CheckStatLT(LastSeenBy(Myself),50,RESISTPIERCING)
	OR(2)
	    CheckStatLT(LastSeenBy(Myself),80,RESISTFIRE)
	    CheckStatLT(LastSeenBy(Myself),1,STONESKINS)
	CheckStatLT(LastSeenBy(Myself),50,RESISTMAGIC)
	!CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	!CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE7)
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
	Global("IaSpellSequencer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaSpellSequencer","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayString(Myself,39969)  // Spell Sequencer—Fired
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_FLAME_ARROW)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_FLAME_ARROW)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_FLAME_ARROW)
	RESPONSE #25
	    Continue()
END

