
DEFINE_ACTION_FUNCTION ~S!EXTRACT_LUA_TABLE_FROM_2DA~
  INT_VAR
    first_meaningful_column = 2
  STR_VAR
    filename           = ~~
    var_name           = ~~
  RET
    var_declaration_string
BEGIN
  COPY_EXISTING ~%filename%~ ~override~
    SPRINT var_declaration_string ~%var_name% = {
~
    COUNT_2DA_COLS ~colcount~
    COUNT_2DA_ROWS ~colcount~ ~rowcount~
    SET current_id = 1
    FOR (current_column = %first_meaningful_column%; current_column <= %colcount%; ++current_column) BEGIN
        SET cur_col_id = %current_column% - 1
        SPRINT var_declaration_string ~%var_declaration_string% {~
        FOR (current_row = 1; current_row <= %rowcount%; ++current_row) BEGIN
            SET cur_row_id = %current_row% - 1
            READ_2DA_ENTRY %cur_row_id% %cur_col_id% %colcount% current_val
            SPRINT var_declaration_string ~%var_declaration_string% %current_val%, ~
        END
        SPRINT var_declaration_string ~%var_declaration_string% },
~
    END
    SPRINT var_declaration_string ~%var_declaration_string% }~
    BUT_ONLY
END

DEFINE_ACTION_FUNCTION ~S!CREATE_LUA_KEY_VAL_TABLE_FROM_2DA~
  INT_VAR
    key_column_id = 1
    val_column_id = 2
  STR_VAR
    2da_filename             = ~~
    table_variable_name      = ~~
    change_key_strref_to_str = ~FALSE~
    change_val_strref_to_str = ~FALSE~
    add_quotations_to_key    = ~FALSE~
    add_quotations_to_val    = ~FALSE~
  RET
    var_declaration_string
BEGIN
  COPY_EXISTING ~%2da_filename%~ ~override~
    SPRINT var_declaration_string ~%table_variable_name% = {
~
    COUNT_2DA_COLS ~colcount~
    COUNT_2DA_ROWS ~colcount~ ~rowcount~
    FOR (current_row_id = 0; current_row_id < %rowcount%; ++current_row_id) BEGIN
        READ_2DA_ENTRY %current_row_id% %key_column_id% %colcount% current_key
        READ_2DA_ENTRY %current_row_id% %val_column_id% %colcount% current_val
        PATCH_IF ~%change_key_strref_to_str%~ STR_EQ ~TRUE~ BEGIN
            GET_STRREF %current_key% current_key
        END
        PATCH_IF ~%change_val_strref_to_str%~ STR_EQ ~TRUE~ BEGIN
            GET_STRREF %current_val% current_val
        END
        PATCH_IF ~%add_quotations_to_key%~ STR_EQ ~TRUE~ BEGIN
            SPRINT current_key ~"%current_key%"~
        END
        PATCH_IF ~%add_quotations_to_val%~ STR_EQ ~TRUE~ BEGIN
            SPRINT current_val ~"%current_val%"~
        END
        SPRINT var_declaration_string ~%var_declaration_string%[%current_key%] = %current_val%,
~
    END
    SPRINT var_declaration_string ~%var_declaration_string% }~
    BUT_ONLY
END

DEFINE_ACTION_FUNCTION ~S!CREATE_LUA_KEY_VAL_TABLE_FROM_2DA~
    INT_VAR
        key_column_id = 5
        val_column_id = 2
    STR_VAR
        2da_filename             = ~~
        table_variable_name      = ~~
        change_key_strref_to_str = ~FALSE~
        change_val_strref_to_str = ~FALSE~
        add_quotations_to_key    = ~FALSE~
        add_quotations_to_val    = ~FALSE~
    RET
        var_declaration_string
BEGIN
  COPY_EXISTING ~%2da_filename%~ ~override~
    SPRINT var_declaration_string ~%table_variable_name% = {
~
    COUNT_2DA_COLS ~colcount~
    COUNT_2DA_ROWS ~colcount~ ~rowcount~
    FOR (current_row_id = 0; current_row_id < %rowcount%; ++current_row_id) BEGIN
        READ_2DA_ENTRY %current_row_id% %key_column_id% %colcount% current_key
        READ_2DA_ENTRY %current_row_id% %val_column_id% %colcount% current_val
        PATCH_IF ~%change_key_strref_to_str%~ STR_EQ ~TRUE~ BEGIN
            GET_STRREF %current_key% current_key
        END
        PATCH_IF ~%change_val_strref_to_str%~ STR_EQ ~TRUE~ BEGIN
            GET_STRREF %current_val% current_val
        END
        PATCH_IF ~%add_quotations_to_key%~ STR_EQ ~TRUE~ BEGIN
            SPRINT current_key ~"%current_key%"~
        END
        PATCH_IF ~%add_quotations_to_val%~ STR_EQ ~TRUE~ BEGIN
            SPRINT current_val ~"%current_val%"~
        END
        SPRINT var_declaration_string ~%var_declaration_string%[%current_key%] = %current_val%,
~
    END
    SPRINT var_declaration_string ~%var_declaration_string% }~
    BUT_ONLY
END

DEFINE_PATCH_FUNCTION ~S!READ_AND_PUT_NEEDED_VARIABLES_IN_M_THIEVING_LUA~
BEGIN
    INNER_ACTION BEGIN
        LAF ~S!EXTRACT_LUA_TABLE_FROM_2DA~
        STR_VAR
            filename           = ~skillrac.2da~
            var_name           = ~anvil_race_thief_bonus_table~
        RET
            anvil_race_thief_bonus_table = var_declaration_string
        END

        LAF ~S!EXTRACT_LUA_TABLE_FROM_2DA~
        STR_VAR
            filename           = ~skilldex.2da~
            var_name           = ~anvil_dex_thief_bonus_table~
        RET
            anvil_dex_thief_bonus_table = var_declaration_string
        END

        LAF ~S!CREATE_LUA_KEY_VAL_TABLE_FROM_2DA~
            INT_VAR
                key_column_id = 5
                val_column_id = 2
            STR_VAR
                2da_filename             = ~clastext.2da~
                table_variable_name      = ~anvil_kit_name_to_id_mapping~
                change_key_strref_to_str = ~TRUE~
                add_quotations_to_key    = ~TRUE~
            RET
               anvil_kit_name_to_id_mapping = var_declaration_string
        END

        LAF ~S!CREATE_LUA_KEY_VAL_TABLE_FROM_2DA~
            INT_VAR
                key_column_id = 4
                val_column_id = 1
            STR_VAR
                2da_filename             = ~racetext.2da~
                table_variable_name      = ~anvil_race_name_to_id_mapping~
            RET
               anvil_race_name_to_id_mapping = var_declaration_string
        END
        OUTER_SPRINT all_new_variables ~
%anvil_race_thief_bonus_table%

%anvil_dex_thief_bonus_table%

%anvil_kit_name_to_id_mapping%

%anvil_race_name_to_id_mapping%
~
    APPEND ~M_thief.lua~ ~%all_new_variables%~
    END
END

DEFINE_PATCH_FUNCTION ~S!GENERATE_AND_INSERT_THIEVING_BUTTON_FUNCTIONS~
BEGIN
    TEXT_SPRINT functions_code ~

function _calculateStartingBonus(thief_ability_id)
    if chargen.levelingUp then
        return 0
    end
    local kit = chargen.kit[currentChargenKit]
	local class = chargen.class[currentChargenClass]
    if kit == nil or kit.id == 0 then
        if not class then
            return 0
        end
        if anvil_class_starting_thieving_bonuses[class.id] then
            return anvil_class_starting_thieving_bonuses[class.id][thief_ability_id]
        end
        return 0
    elseif not anvil_kit_starting_thieving_bonuses[kit.id] then
        return 0
    else
        return anvil_kit_starting_thieving_bonuses[kit.id][thief_ability_id]
    end
end

function _calculateMaxValue(thief_ability_id)
	local thief_ability_id = tonumber(chargen.thief_skill[thief_ability_id].id) + 1
    if chargen.levelingUp then
        local kit_id = anvil_kit_name_to_id_mapping[characters[currentID].class]
        if anvil_kit_max_thieving_values[kit_id] == nil then
            return anvil_default_max_thieving_values[thief_ability_id]
        else
            return anvil_kit_max_thieving_values[kit_id][thief_ability_id]
        end
    else
        local kit = chargen.kit[currentChargenKit]
        if not kit then
            return anvil_default_max_thieving_values[thief_ability_id]
        elseif not anvil_kit_max_thieving_values[kit.id] then
            return anvil_default_max_thieving_values[thief_ability_id]
        else
            return anvil_kit_max_thieving_values[kit.id][thief_ability_id]
        end
    end
end

function _calculateRaceBonus(thief_ability_id)
	local race_gui = 0
    if chargen.levelingUp then
        race_gui = anvil_race_name_to_id_mapping[characters[currentID].race]
    else
        race_gui = tonumber(chargen.races[currentChargenRace].id)
    end
    local race_2da = anvil_chargen_gui_to_2da_race_mapping[race_gui]
    local race_bonus = anvil_race_thief_bonus_table[thief_ability_id][race_2da]
    if race_bonus == nil then
        return 0
    end
    return race_bonus
end

function _calculateDexBonus(thief_ability_id)
	local dex
    if chargen.levelingUp then
        dex = characters[currentID].attr.dex.current
    else
        dex = chargen.ability[2].roll or characters[currentID].attr.dex.current
        dex = tonumber(dex)
    end
    local dex_bonus = anvil_dex_thief_bonus_table[thief_ability_id][dex]
    return dex_bonus
end

function calculateRealBonus(thief_ability_row)
    local current_value = chargen.thief_skill[thief_ability_row].value
    local thief_ability_id = tonumber(chargen.thief_skill[thief_ability_row].id) + 1

    local starting_bonus = _calculateStartingBonus(thief_ability_id)
    local race_bonus = _calculateRaceBonus(thief_ability_id)
    local dex_bonus = _calculateDexBonus(thief_ability_id)

    return current_value - race_bonus - dex_bonus + starting_bonus
end

function canInvestInCurrentThievingAbility(thief_ability_id)
    local current_base = calculateRealBonus(thief_ability_id)
    local max_for_kit = _calculateMaxValue(thief_ability_id)
    return current_base < max_for_kit
end

~
    SET ofs = INDEX_BUFFER(~function[ %TAB%]isChargenProficienciesBackButtonClickable()~)
    PATCH_IF %ofs% >= 0 BEGIN
        SET strlen = STRING_LENGTH ~%functions_code%~
        INSERT_BYTES ofs strlen
        WRITE_ASCIIE ofs ~%functions_code%~ (strlen)
    END
    ELSE BEGIN
        PATCH_FAIL ~FAIL: Thieving Ability +/- button functions not installed properly.~
    END
END

DEFINE_PATCH_FUNCTION ~S!APPLY_IA_LOGIC_TO_THIEVING_ABILITIES~
BEGIN
    SET ofs = INDEX_BUFFER(~chargen\.thief_skill\[rowNumber\]\.value~)
    PATCH_IF %ofs% >= 0 BEGIN
        SPRINT base_value ~calculateRealBonus(rowNumber)~
        REPLACE_EVALUATE
        ~chargen\.thief_skill\[rowNumber\]\.value~
        BEGIN
        END
        ~%base_value%~
    END
    ELSE BEGIN
        PATCH_FAIL ~FAIL: Base Thieving Abilities values not showing beside +/- buttons.~
    END
    SET ofs = INDEX_BUFFER(~[ %TAB%]*if[ %TAB%]cellNumber[ %TAB%]==[ %TAB%]3[ %TAB%]then[ %TAB%]*[%WNL%%LNL%%MNL%]+[ %TAB%]*createCharScreen:OnThiefSkillPlusMinusButtonClick~)
    PATCH_IF %ofs% >= 0 BEGIN
        REPLACE_EVALUATE
        ~\([ %TAB%]*if[ %TAB%]cellNumber[ %TAB%]==[ %TAB%]3\)\([ %TAB%]then[ %TAB%]*[%WNL%%LNL%%MNL%]+[ %TAB%]*createCharScreen:OnThiefSkillPlusMinusButtonClick\)~
        BEGIN
          SPRINT val ~%MATCH1% and canInvestInCurrentThievingAbility(currentChargenThiefSkill)%MATCH2%~
        END
        ~%val%~
    END
    ELSE BEGIN
        PATCH_FAIL ~FAIL: Logic for max Thieving Abilities values enforcing not installed.~
    END  
END

DEFINE_PATCH_FUNCTION ~S!5POINTS_PER_CLICK_THIEVING_ABILITIES~
BEGIN
    SET ofs = INDEX_BUFFER(~createCharScreen:OnThiefSkillPlusMinusButtonClick~)
    PATCH_IF %ofs% >= 0 BEGIN
        REPLACE_EVALUATE
        ~\([ %TAB%]*\)\(createCharScreen:OnThiefSkillPlusMinusButtonClick\)\(.*[%WNL%%LNL%%MNL%]+\)~
        BEGIN
          SPRINT val ~%MATCH1%%MATCH2%%MATCH3%%MATCH1%%MATCH2%%MATCH3%%MATCH1%%MATCH2%%MATCH3%%MATCH1%%MATCH2%%MATCH3%%MATCH1%%MATCH2%%MATCH3%~
        END
        ~%val%~
    END 
    ELSE BEGIN
        PATCH_WARN ~WARNING: Changes for +/- buttons for Thieving Skills not installed properly.~
    END 
END

DEFINE_PATCH_FUNCTION ~S!GENERATE_AND_INSERT_STEALTH_BUTTON_FUNCTIONS~
    INT_VAR
        stealth_active_icon_id = 0
        stealth_disabled_icon_id = 0
BEGIN
    TEXT_SPRINT stealth_button_functions_code ~~~~~
	-- Function to split a string into lines
	function splitLines(input)
		local lines = {}
		for line in input:gmatch("[^\r\n]+") do
			table.insert(lines, line)
		end
		return lines
	end
	
	-- Function to check if a character is active based on comparison of characters[id] to character tooltip
	function isCharacterActive(char_id)
		local tooltip_info = Infinity_GetPortraitTooltip(char_id)
		local tooltip_info_lines = splitLines(tooltip_info)
		local lastLine = tooltip_info_lines[#tooltip_info_lines]
		local cur_hp, max_hp = lastLine:match("(%d+)/(%d+)")
		found = string.find(characters[id].name, tooltip_info_lines[1])
		return found and (characters[id].HP.current == tonumber(cur_hp)) and (characters[id].HP.max == tonumber(max_hp)) and tonumber(cur_hp) > 0
	end
	
	-- Function to get the current character portrait ID
	function getCurrentCharPortraitId()
		local idMapping = {}
		Infinity_UpdateLuaStats()
		local curCharId = id
		for i = 0, Infinity_GetNumCharacters() - 1 do
			if isCharacterActive(i) then
				Infinity_OnPortraitLClick(i)
				Infinity_UpdateLuaStats()
				idMapping[id] = i
			end
		end
		Infinity_OnPortraitLClick(idMapping[curCharId])
		return idMapping[curCharId]
	end
	
	-- Function to get the selection sound values
	function getSelectionSoundsValues()
		local panelID = 7
		local soundOptions = {}
		soundOptions[5] = Infinity_GetOption(5, panelID)
		for i = 58, 60 do
			local optionVal = Infinity_GetOption(i, panelID)
			if optionVal == 1 then
				soundOptions[i] = optionVal
			end
		end
		return soundOptions
	end
	
	-- Function to set option values
	function setOptionsValues(valuesTable, panel)
		for k, v in pairs(valuesTable) do
			Infinity_ChangeOption(k, v, panel)
		end
	end
	
	-- Function to silently get the current character portrait ID
	function silentlyGetCurrentCharPortraitId()
		local initialSoundOptions = getSelectionSoundsValues()
		local noSoundOptions = {[5] = 0, [60] = 1}
		setOptionsValues(noSoundOptions, 7)
		local currentCharPortraitId = getCurrentCharPortraitId()
		setOptionsValues(initialSoundOptions, 7)
		return currentCharPortraitId
	end
	
	-- Function to check if a button is stealth
	function isButtonStealth(button_number)
		local button_type = buttonArray:GetButtonType(button_number)
		return button_type == 11
	end
	
	-- Function to check if a portrait icon is present
	function isPortraitIconPresent(icon_id)
		icon_id = tostring(icon_id)
		return characters[id].statusEffects[icon_id] ~= nil
	end
	
	-- Function to check if stealth is active
	function isStealthActive()
		local stealth_active_icon_id = %stealth_active_icon_id%
		return isPortraitIconPresent(stealth_active_icon_id)
	end
	
	-- Function to check if stealth is disabled
	function isStealthDisabled()
		local stealth_disabled_icon_id = %stealth_disabled_icon_id%
		return isPortraitIconPresent(stealth_disabled_icon_id)
	end  
	
	-- Default spell string template
	local spell_default_string = 'ReallyForceSpellRES("RESOURCE", Myself)'
	
	-- Main function for Stealth logic
	function onNewStealthButtonPressed()
		local charPortraitId = silentlyGetCurrentCharPortraitId()
		local party_slot = tostring(charPortraitId + 1)
		for button_index = 1, 10, 1 do
            local button_type = buttonArray:GetButtonType(button_index)
            -- Check if character has Stealth button
            if button_type == 11 then
                break
            end
            -- If not, then do nothing
            if button_index == 10 then
                return
            end
        end
		if isStealthDisabled() then
			-- Do nothing if stealth is disabled
		elseif isStealthActive() then
			local command = spell_default_string:gsub('RESOURCE', 'S!HISRE2')
			local override_command = "'ActionOverride(" .. "PartySlot" .. party_slot .. "," .. command .. ")'"
			C:Eval(override_command)
		else 
			local command = spell_default_string:gsub('RESOURCE', 'S!HISBAS')
			local override_command = "'ActionOverride(" .. "PartySlot" .. party_slot .. "," .. command .. ")'"
			C:Eval(override_command)
		end
	end

~~~~~
    SET ofs = INDEX_BUFFER(~[ %TAB%]*actionBarTooltip[ %TAB%]*=[ %TAB%]*{}~)
    PATCH_IF %ofs% >= 0 BEGIN
        SET strlen = STRING_LENGTH ~%stealth_button_functions_code%~
        INSERT_BYTES ofs strlen
        WRITE_ASCIIE ofs ~%stealth_button_functions_code%~ (strlen)
    END
    ELSE BEGIN
        PATCH_FAIL ~FAIL: Stealth button functions not installed properly.~
    END
END

DEFINE_PATCH_FUNCTION ~S!CREATE_NEW_STEALTH_BUTTONS~
BEGIN
    FOR (current_button_id = 4; current_button_id <= 7; ++current_button_id) BEGIN
        SPRINT EVAL current_button_regex ~\([ %TAB%]*\)\(button[%WNL%%LNL%%MNL%]+[ %TAB%]*{[%WNL%%LNL%%MNL%]+\)\([ %TAB%]*\)\(area[ %TAB%]*[0-9]+[ %TAB%]*[0-9]+[ %TAB%]*[0-9]+[ %TAB%]*[0-9]+\)\([%WNL%%LNL%%MNL%]+[ %TAB%]*actionBar %current_button_id%[%WNL%%LNL%%MNL%]+[ %TAB%]*enabled "buttonArray:GetButtonEnabled(%current_button_id%)"[%WNL%%LNL%%MNL%]+[ %TAB%]*tooltip lua "actionBarTooltip\[%current_button_id%\]"[%WNL%%LNL%%MNL%]+[ %TAB%]*action "buttonArray:OnLButtonPressed(%current_button_id%)"[%WNL%%LNL%%MNL%]+[ %TAB%]*actionAlt "buttonArray:OnRButtonPressed(%current_button_id%)"[%WNL%%LNL%%MNL%]+[ %TAB%]*}\)~
        SET ofs = INDEX_BUFFER(~%current_button_regex%~)
        PATCH_IF %ofs% >= 0 BEGIN
            REPLACE_EVALUATE
            ~%current_button_regex%~
            BEGIN
                SPRINT full_matched_string ~%MATCH1%%MATCH2%%MATCH3%%MATCH4%%MATCH5%~
                SET strlen_original = STRING_LENGTH ~%full_matched_string%~
                SPRINT val ~
%MATCH1%button
%MATCH1%{
%MATCH3%%MATCH4%
%MATCH3%bam "GUIBTACT"
%MATCH3%frame 30
%MATCH3%enabled "isButtonStealth(%current_button_id%)"
%MATCH3%tooltip lua "actionBarTooltip[%current_button_id%]"
%MATCH3%action "onNewStealthButtonPressed()"
%MATCH1%}~

            END
            ~%MATCH1%%MATCH2%%MATCH3%%MATCH4%%MATCH5%~
            SET strlen = STRING_LENGTH ~%val%~
            INSERT_BYTES ofs + strlen_original strlen
            WRITE_ASCIIE ofs + strlen_original ~%val%~ (strlen)
        END
        ELSE BEGIN
            PATCH_FAIL ~FAIL: Stealth buttons not created.~
        END
    END
END

DEFINE_PATCH_FUNCTION ~S!SHOW_BASE_THIEVING_ABILITIES_ON_CHARGEN_SCREEN~
BEGIN
    SET base_prefix_strref = RESOLVE_STR_REF (@5009)
    SET silent_strike_gui_strref = RESOLVE_STR_REF (@5011)
    TEXT_SPRINT chargen_show_base_thieving_skills_function ~~~~~
function getCharInfoChangeThievingSkillsToBase()
	local char_info = chargen.information
	for thieving_ability_strref, thieving_ability_id in pairs{[9463]=1, [9460]=2, [9462]=3, [%silent_strike_gui_strref%]=4, [34120]=5, [34121]=6, [34122]=7} do
		local thieving_ability_name = Infinity_FetchString(thieving_ability_strref)
		local base_prefix = Infinity_FetchString(%base_prefix_strref%)
		if string.find(char_info, thieving_ability_name .. ': (%d+)') then
			local thieving_ability_value = char_info:match(thieving_ability_name .. ': (%d+)')
			local starting_bonus = _calculateStartingBonus(thieving_ability_id)
			local race_bonus = _calculateRaceBonus(thieving_ability_id)
			local dex_bonus = _calculateDexBonus(thieving_ability_id)
			local new_thieving_ability_value = tonumber(thieving_ability_value) - race_bonus - dex_bonus + starting_bonus
			char_info = char_info:gsub(thieving_ability_name .. ': (%d+)', base_prefix .. thieving_ability_name .. ': ' .. new_thieving_ability_value)
		end
	end
	return char_info
end
~~~~~
    SET ofs = INDEX_BUFFER(~[ %TAB%]*function[ %TAB%]*chargenAcceptOrExport()~)
    PATCH_IF %ofs% >= 0 BEGIN
        SET strlen = STRING_LENGTH ~%chargen_show_base_thieving_skills_function%~
        INSERT_BYTES ofs strlen
        WRITE_ASCIIE ofs ~%chargen_show_base_thieving_skills_function%~ (strlen)
        SET ofs2 = INDEX_BUFFER(~[ %TAB%]*text[ %TAB%]*lua[ %TAB%]*"chargen.information"~)
        PATCH_IF %ofs2% >= 0 THEN BEGIN
            REPLACE_EVALUATE
            ~\([ %TAB%]*text[ %TAB%]*lua[ %TAB%]*\)"chargen.information"~
            BEGIN
            SPRINT val ~%MATCH1%"getCharInfoChangeThievingSkillsToBase()"~
            END
            ~%val%~
        END
        ELSE BEGIN
            PATCH_WARN ~WARNING: Chargen thieving skills will not show base values.~
        END
    END
    ELSE BEGIN
        PATCH_WARN ~WARNING: Chargen thieving skills will not show base values.~
    END
END
