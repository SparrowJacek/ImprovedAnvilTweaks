IF
	GlobalLT("IaMind01","LOCALS",6)
	Allegiance(Myself,ENEMY)
	See([PC])
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!CheckSpellState(LastSeenBy(Myself),CHARM_DOMINATION_IMMUNITY)
	!CheckSpellState(LastSeenBy(Myself),SI_ENCHANTMENT)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE3)
	!HasBounceEffects(LastSeenBy(Myself))
    CheckStatGT(LastSeenBy(Myself),3,SAVEVSSPELL)
	OR(2)
	    CheckStatGT(LastSeenBy(Myself),7,SAVEVSSPELL)
	    !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!GlobalTimerNotExpired("IaPsionicAction","LOCALS")
	!CheckSpellState(LastSeenBy(Myself),PSIONICS_IMMUNITY)
THEN
	RESPONSE #100
		IncrementGlobal("IaMind01","LOCALS",2)
		SetGlobalTimer("IaPsionicAction","LOCALS",ONE_ROUND)
		ForceSpell(LastSeenBy(Myself),MIND_FLAYER_DOMINATION)  // SPIN975.SPL (Psionic Domination)
	RESPONSE #200
	    Continue()
END

