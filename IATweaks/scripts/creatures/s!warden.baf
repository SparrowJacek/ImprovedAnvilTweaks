THEN
	RESPONSE #100
		EquipMostDamagingMelee()
		AttackOneRound(NearestEnemyOf(Myself))
END

IF
	See(NearestEnemyOf(Myself))
	ActionListEmpty()
	!Global("ThrallOrb","GLOBAL",2)
THEN
	RESPONSE #100
		EquipMostDamagingMelee()
		AttackOneRound(NearestEnemyOf(Myself))
END

IF
	!Detect([PC])
	!Detect([GOODCUTOFF])
	InMyArea(Player1)
	Global("Iathralldie","AR0516",2)  // Planar Prison
	Global("Iasettimer","LOCALS",2)
	Global("ThrallOrb","GLOBAL",2)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

IF
	!Detect([PC])
	!Detect([GOODCUTOFF])
	InMyArea(Player1)
	Allegiance(Myself,ENEMY)
	!Global("ThrallOrb","GLOBAL",2)
	Global("Iatalked","LOCALS",1)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

IF
	!Detect([PC])
	!Detect([GOODCUTOFF])
	InMyArea(Player1)
	OR(2)
		AttackedBy([GOODCUTOFF],DEFAULT)
		HPPercentLT(Myself,100)
	!Global("ThrallOrb","GLOBAL",2)
	Global("Iatalked","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatalked","LOCALS",1)
END

