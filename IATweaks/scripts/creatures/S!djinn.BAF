IF
	Global("Iamoving","LOCALS",1)
	OR(2)
		Detect(NearestEnemyOf(Myself))
		Detect(NearestEnemyOf(LastSummonerOf(Myself)))
THEN
	RESPONSE #100
		SetGlobal("Iamoving","LOCALS",0)
END

IF
	Global("Iamoving","LOCALS",1)
	CombatCounter(0)
	See([PC])
	Range(LastSeenBy(Myself),6)
THEN
	RESPONSE #100
		SetGlobal("Iamoving","LOCALS",0)
END

IF
	ActionListEmpty()
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	GlobalGT("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Global("Iapcastts","GLOBAL",0)
	OR(2)
		See([EVILCUTOFF])
		See(NearestEnemyOf(Myself))
	Global("Iatrigger","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatrigger","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		DisplayString(Myself,39969)  // Spell Sequencer—Fired
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Fire Shield (Red))
		ReallyForceSpell(Myself,WIZARD_MINOR_GLOBE_OF_INVULNERABILITY)  // SPWI406.SPL (Minor Globe of Invulnerability)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	ActionListEmpty()
	!StateCheck(Myself,STATE_SILENCED)
	!CheckStatGT(Myself,0,SCRIPTINGSTATE9)
	HPPercentLT(Myself,80)
	HaveSpell(WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)  // SPWI611.SPL (Protection From Magical Weapons)
	CheckStatLT(Myself,1,STONESKINS)
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		Spell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)  // SPWI611.SPL (Protection From Magical Weapons)
END

