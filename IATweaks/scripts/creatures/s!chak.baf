	CheckStatLT(Myself,60,SPELLFAILUREPRIEST)
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_POISONED)
	CheckStatLT(SecondNearest([PC.0.0.BARD_ALL]),100,RESISTPIERCING)
	CheckStatLT(SecondNearest([PC.0.0.BARD_ALL]),60,RESISTMAGIC)
	!CheckSpellState(SecondNearest([PC.0.0.BARD_ALL]),SI_CONJURATION)
	See(SecondNearest([PC.0.0.BARD_ALL]))
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE) 
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),CLERIC_CREEPING_DOOM)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #0
	    Continue()
END

