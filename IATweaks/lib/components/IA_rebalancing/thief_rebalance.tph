OUTER_SET trap_script_id = 0

COPY_EXISTING_REGEXP GLOB ~.*\.are$~ ~override~
  // process triggers //

  GET_OFFSET_ARRAY regions ARE_V10_REGIONS

  PHP_EACH regions AS int1 => region_off BEGIN
    READ_SHORT region_off + 0x68 trap_det_diff // trap detection difficulty
    READ_SHORT region_off + 0x6a trap_dis_diff
    READ_SHORT region_off + 0x6c is_trapped
    READ_ASCII region_off + 0x7c script_file
    TO_UPPER script_file

    PATCH_IF ((is_trapped == 1) AND (trap_det_diff < 100) AND (trap_dis_diff > 0)) BEGIN
      SPRINT $trigger_area_trap_scripts("%script_file%") "OK"
    END
    PATCH_IF ((is_trapped == 1) AND (trap_det_diff >= 100)) BEGIN
      INNER_ACTION BEGIN
        COPY_EXISTING ~%script_file%.bcs~ ~override/S!TRP%trap_script_id%.bcs~
      END
      WRITE_ASCIIE region_off + 0x7c ~S!TRP%trap_script_id%~ #8
      trap_script_id = trap_script_id + 1
    END
  END

  // process containers //

  GET_OFFSET_ARRAY containers ARE_V10_CONTAINERS

  PHP_EACH containers AS int2 => cont_off BEGIN
    READ_SHORT cont_off + 0x2c trap_det_diff // trap detection difficulty
    READ_SHORT cont_off + 0x2e trap_dis_diff // trap disarm difficulty
    READ_SHORT cont_off + 0x30 is_trapped
    READ_ASCII cont_off + 0x48 script_file
    TO_UPPER script_file

    PATCH_IF ((is_trapped == 1) AND (trap_det_diff < 100) AND (trap_dis_diff > 0)) BEGIN
      SPRINT $container_trap_scripts("%script_file%") "OK"
    END
    PATCH_IF ((is_trapped == 1) AND (trap_det_diff >= 100)) BEGIN
      INNER_ACTION BEGIN
        COPY_EXISTING ~%script_file%.bcs~ ~override/S!TRP%trap_script_id%.bcs~
      END
      WRITE_ASCIIE cont_off + 0x48  ~S!TRP%trap_script_id%~ #8
      trap_script_id = trap_script_id + 1
    END
  END
  IF_EXISTS

<<<<<<<<.../IATweaks-inlined/trap_immunity_and_removal.baf
IF
  OR(2)
	  Opened([ANYONE])
	  Entered([ANYONE])
  CheckSpellState(LastTrigger,%state%)
THEN
	RESPONSE #100
		DisplayString(LastTrigger,%strref%)
    TriggerActivation(Myself,FALSE)
    RemoveTraps(Myself)
END

>>>>>>>>

ACTION_PHP_EACH container_trap_scripts AS trap_script => _ BEGIN
  EXTEND_TOP "%trap_script%.bcs" ".../IATweaks-inlined/trap_immunity_and_removal.baf"
    SET strref = RESOLVE_STR_REF (@5031)
    SET state = trap_immunity_state
    EVALUATE_BUFFER
END

ACTION_PHP_EACH trigger_area_trap_scripts AS trap_script => _ BEGIN
  EXTEND_TOP "%trap_script%.bcs" ".../IATweaks-inlined/trap_immunity_and_removal.baf"
    SET strref = RESOLVE_STR_REF (@5031)
    SET state = trap_immunity_state
    EVALUATE_BUFFER
END

