PRINT @5107

SILENT

// Improve Keldorn

ACTION_FOR_EACH keldorn_SoA_file IN ~KELDOR8~ ~KELDOR9~ ~KELDOR10~ ~KELDOR12~ BEGIN
  COPY_EXISTING ~%keldorn_SoA_file%.cre~ ~override~  
    WRITE_SHORT 0x24 79 // HP
    WRITE_SHORT 0x26 79 // HP
    WRITE_BYTE  0x23c 17 // dexterity
END

// Enable *** in Sword and Shield for Paladins

LAF ~S!MAP_COLUMN_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~weapprof.2da~
  RET_ARRAY
    weapprof_cols = 2da_columns_to_ids_mapping
END

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~weapprof.2da~
  RET_ARRAY
    weapprof_rows = 2da_rows_to_ids_mapping
END

COPY_EXISTING ~weapprof.2da~  ~override/weapprof.2da~
  COUNT_2DA_COLS ~colcount~
  SET sw_and_sh_row = $weapprof_rows("SWORDANDSHIELD")
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("PALADIN") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("CAVALIER") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("INQUISITOR") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("UNDEAD_HUNTER") ~3~
  SET_2DA_ENTRIES_NOW ~_#_#_#weapprof~ ~colcount~
  PRETTY_PRINT_2DA

// Improve Lay on Hands progression

COPY_EXISTING ~spcl211.spl~ ~override~
  SAY UNIDENTIFIED_DESC @6229
  GET_OFFSET_ARRAY ab_array SPL_V10_HEADERS
  PHP_EACH ab_array AS int => ab_off BEGIN
    GET_OFFSET_ARRAY2 fx_array ab_off SPL_V10_HEAD_EFFECTS
    PHP_EACH fx_array AS int => fx_off BEGIN
      READ_SHORT (fx_off + 0x00) opcode
      PATCH_IF opcode = 17 BEGIN
        WRITE_LONG (fx_off + 0x04) THIS * 5  / 2
      END
    END
  END
BUT_ONLY

COPY ~IATweaks\resources\2da\layhands.2da~ ~override~

// Grant additional uses of Lay on Hands to Paladin

LAF ~S!ADD_CLAB_ROW~
  STR_VAR
    filename = ~CLABPA01.2da~
    row_desc = ~LAY_ON_HANDS~
    level15 = ~GA_SPCL211~
    level30 = ~GA_SPCL211~
END

// Grant +2 to critical hit chance when using large swords

COPY ~IATweaks\resources\eff\s!palcrt.eff~ ~override~
COPY ~IATweaks\resources\spl\s!palcrt.spl~ ~override~

ACTION_FOR_EACH paladin_kit_clab IN ~CLABPA01.2da~ ~CLABPA02.2da~ ~CLABPA04.2da~ BEGIN
  LAF ~S!ADD_CLAB_ROW~
    STR_VAR
      filename = ~%paladin_kit_clab%~
      row_desc = ~BONUS_CRIT_SWORDS~
      level1 = ~AP_S!PALCRT~
  END
END

// Maka an ability version of Heavenly Shield

COPY_EXISTING ~sppr617.spl~ ~override/s!heashl.spl~
  SAY UNIDENTIFIED_DESC @6274
  WRITE_SHORT 0x1c 4
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      location = 4
  END

// Grant that Heavenly Shield to Paladins

ACTION_FOR_EACH paladin_kit_clab IN ~CLABPA01.2da~ ~CLABPA02.2da~ ~CLABPA04.2da~ ~CLABPA06.2da~ BEGIN
  LAF ~S!ADD_CLAB_ROW~
    STR_VAR
      filename = ~%paladin_kit_clab%~
      row_desc = ~HEAVENLY_SHIELD~
      level12 = ~GA_S!HEASHL~
  END
END

// Grant Heavenly Shield as a HLA once

LAF ~S!ADD_HLA_ROW~
  STR_VAR
    filename = ~LUPA0.2DA~
    row_desc = ~HEAVENLY_SHIELD~
    ability = ~GA_S!HEASHL~
    num_allowed = ~1~
END

// Grant Aura of Courage to Paladins and Cavaliers

ADD_PROJECTILE ~IATweaks\resources\pro\s!aocour.pro~
COPY ~IATweaks\resources\eff\s!courag.eff~ ~override~
COPY ~IATweaks\resources\spl\s!nofear.SPL~ ~override~
COPY ~IATweaks\resources\spl\s!courag.SPL~ ~override~
COPY ~IATweaks\resources\spl\s!aocour.SPL~ ~override~
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      projectile = %s!aocour%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 139
      parameter1 = RESOLVE_STR_REF (@6275)
  END

ACTION_FOR_EACH paladin_kit_clab IN ~CLABPA01.2da~ ~CLABPA02.2da~ BEGIN
  LAF ~S!ADD_CLAB_ROW~
    STR_VAR
      filename = ~%paladin_kit_clab%~
      row_desc = ~AURA_OF_COURAGE~
      level1 = ~AP_S!NOFEAR~
  END
END

// Remove casting restrictions from Inquisitor

COPY_EXISTING ~SPCL234.spl~ ~override~
  LPF ~DELETE_EFFECT~ END

COPY_EXISTING ~SPCL234D.spl~ ~override~
  LPF ~DELETE_EFFECT~ END

// Remove 4th level spells from Inquisitor

COPY ~IATweaks\resources\spl\s!-pr4lv.spl~ ~override~

OUTER_FOR (k = 0; k <= 9; ++k) BEGIN
  LAF ~S!ADD_CLAB_ROW~
    STR_VAR
      filename = ~CLABPA03.2da~
      row_desc = ~NO_4TH_LEVEL_SPELLS~
      level15 = ~AP_S!-PR4LV~
  END
END

// Move Inquisitor Usability Flags

LAF ~S!MAP_COLUMN_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~kitlist.2da~
  RET_ARRAY
    kitlist_cols = 2da_columns_to_ids_mapping
END

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~kitlist.2da~
  RET_ARRAY
    kitlist_rows = 2da_rows_to_ids_mapping
END

COPY_EXISTING ~kitlist.2da~ ~override/kitlist.2da~
  COUNT_2DA_COLS ~colcount~
  SET_2DA_ENTRY $kitlist_rows("INQUISITOR") $kitlist_cols("UNUSABLE") ~colcount~ ~0x00000020~ // Lack of spells is hardcoded to usability flags

