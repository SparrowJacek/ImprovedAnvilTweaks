// Randomize Ring of Duplication between Shadow Dragon, Borinall and Damien

COPY_EXISTING ~OHRDALTN.cre~ ~override~
  LPF ~DELETE_CRE_ITEM~
    STR_VAR
      item_to_delete = ~ohrring1~
  END

COPY_EXISTING ~AR0602.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    SET ofs = INDEX_BUFFER(~\(.*\)"Iarandomizer","AR0602",0~)
    PATCH_IF %ofs% >= 0 BEGIN
      // PATCH_PRINT ~%ofs%~
      REPLACE_EVALUATE
      ~\(.*\)"Iarandomizer","AR0602",0~
      BEGIN
        SPRINT val ~	Global("Iadupliringplace","GLOBAL",0)
THEN
	RESPONSE #50
		SetGlobal("Iadupliringplace","GLOBAL",1)
	RESPONSE #50
		SetGlobal("Iadupliringplace","GLOBAL",2)
	RESPONSE #50
		SetGlobal("Iadupliringplace","GLOBAL",3)
END

IF
%MATCH1%"Iarandomizer","AR0602",0~
      END
      ~%val%~
    END
  END
  BUT_ONLY

COPY_EXISTING ~SHADRA01.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    SET ofs = INDEX_BUFFER(~\(.*\)"sw1h40",Myself,0,0,0\(.*\)~)
    PATCH_IF %ofs% >= 0 BEGIN
      REPLACE_EVALUATE
      ~\(.*\)"sw1h40",Myself,0,0,0\(.*\)~
      BEGIN
        SPRINT val ~%MATCH1%"sw1h40",Myself,0,0,0%MATCH2%
END

IF
	Allegiance(Myself,ENEMY)
	Detect([PC])
	Global("Iadupliringplace","GLOBAL",3)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Iadupliringplace","GLOBAL",4)
		GiveItemCreate("ohrring1",Myself,0,0,0)~
      END
      ~%val%~
    END
  END
  BUT_ONLY

