
IF
	!Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	NumberOfTimesTalkedTo(0)
	Detect([PC])
THEN
	RESPONSE #100
		StartDialogueNoSet([PC])
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iacantexit","AR1203",0)  // Firkraag's Hideout
THEN
	RESPONSE #100
		SetGlobal("Iacantexit","AR1203",1)  // Firkraag's Hideout
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
		CreateCreature("s!firag2",[741.1232],SE)  // No such index
		CreateCreature("s!firag1",[1185.914],SE)  // No such index
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		ReallyForceSpellRES("SPWII03",Myself)  // Spell Turning
		ReallyForceSpellRES("jwglobe",Myself)  // Globe of Invulnerability
		ReallyForceSpellRES("SPWII02",Myself)  // Protection From Magic Energy
		ReallyForceSpellRES("SPWII01",Myself)  // Spell Shield
END

IF
	InMyArea(Player1)
	!Allegiance(Myself,ENEMY)
	GlobalGT("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		Enemy()
END


IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
