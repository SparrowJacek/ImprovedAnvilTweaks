IF
	InMyArea(Player1)
	!HPLT(Myself,1)
	XPGT(Player1,1299999)
	Global("Iafirstspawn","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iafirstspawn","LOCALS",1)
		CreateCreatureObject("S!ntroll",Myself,0,0,0)  // Noble Troll
END

IF
	InMyArea(Player1)
	!HPLT(Myself,1)
	XPGT(Player1,1649999)
	Global("Ia2ndspawn","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Ia2ndspawn","LOCALS",1)
		CreateCreatureObject("S!ntroll",Myself,0,0,0)  // Noble Troll
END
