IF
	Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaDominTimer","LOCALS")
	See(SecondNearest([PC]))
	CheckStatLT(LastSeenBy(Myself),50,RESISTMAGIC)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!CheckSpellState(LastSeenBy(Myself),CHARM_DOMINATION_IMMUNITY)
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE4)
	!CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE8)
	!CheckStat(LastSeenBy(Myself),3,SCRIPTINGSTATE7)
	!Class(LastSeenBy(Myself),MONK)
	!Kit(LastSeenBy(Myself),INQUISITOR)
	!Kit(LastSeenBy(Myself),CAVALIER)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE3)
	CheckStatGT(LastSeenBy(Myself),7,SAVEVSSPELL)
	GlobalLT("IaDomination","LOCALS",3)
THEN
	RESPONSE #100
		SetGlobalTimer("IaDominTimer","LOCALS",TWO_ROUNDS)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		IncrementGlobal("IaDomination","LOCALS",1)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_DOMINATION)  // SPWI506.SPL (Domination)
END

