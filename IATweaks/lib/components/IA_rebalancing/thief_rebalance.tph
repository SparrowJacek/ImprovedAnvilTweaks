      match_opcode = 328
      parameter2 = %hide_in_shadows_fail_state%
  END
  PHP_EACH hide_in_shadows_value_to_cooldown_mapping AS his_value=>cooldown_in_ticks BEGIN
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        opcode = 318
        target = 1
        parameter1 = %his_value%
        parameter2 = %hide_in_shadows_higher_than_row%
        duration = 1
        insert_point = 0
      STR_VAR
        resource = ~S!HISREM~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 328
        duration = %cooldown_in_ticks%
        multi_match = 1
      STR_VAR
        insert = ~first~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 142
        duration = %cooldown_in_ticks%
        multi_match = 1
      STR_VAR
        insert = ~first~
    END
  END
  PATCH_FOR_EACH spell_to_remove IN ~S!HISINV~ ~S!HIS101~ ~S!HIS100~ ~S!HISFOE~ ~S!HISTRY~ ~S!HISBAS~ ~S!HISDMG~ BEGIN
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        opcode = 321
        target = 1
        insert_point = 0
      STR_VAR
        resource = EVAL ~%spell_to_remove%~
    END
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      opcode = 206
      target = 1
      duration = 1
      insert_point = 0
    STR_VAR
      resource = ~S!HISINV~
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      opcode = 267
      target = 1
      duration = 1
      parameter1 = 17120 // HiS Failed
      insert_point = 0
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      opcode = 139
      target = 1
      parameter1 = 17120 // HiS Failed
      insert_point = 0
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      opcode = 174
      target = 1
      insert_point = 0
    STR_VAR
      resource = ~ACT_07~
  END

COPY_EXISTING ~s!hisrem.spl~ ~override/s!hisre2.spl~
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 174
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 139
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 206
    STR_VAR
      match_resource = ~S!HISINV~
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 318
    STR_VAR
      match_resource = ~S!HISREM~
      resource = ~S!HISRE2~
  END

// Ensure that Hide in Shadows sound ID is present in .IDS file

LOOKUP_IDS_SYMBOL_OF_INT his_sound_id ~SOUNDOFF~ 70
ACTION_IF ~%his_sound_id%~ STR_EQ ~70~ BEGIN
  APPEND ~SOUNDOFF.ids~ ~70 HIDDEN_IN_SHADOWS~
END

