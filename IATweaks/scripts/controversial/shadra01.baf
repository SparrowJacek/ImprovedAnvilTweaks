
IF
	Detect([PC])
	Global("Ianotalk","AR1402",0)  // Shadow Dragon Hideout
	Global("Iapcastts","GLOBAL",0)
	Allegiance(Myself,NEUTRAL)
	OR(6)
		!PartyHasItem("MISC6P")  // Shadow Dragon Wardstone
		AttackedBy([GOODCUTOFF],DEFAULT)
		AttackedBy([PC],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		SpellCastOnMe([PC],0)
		TookDamage()
	NumberOfTimesTalkedTo(0)
THEN
	RESPONSE #100
		StartDialogueNoSet([PC])
END

IF
	Allegiance(Myself,NEUTRAL)
	Global("Ianotalk","AR1402",0)  // Shadow Dragon Hideout
	InMyArea(Player1)
	OR(7)
		AttackedBy([GOODCUTOFF],DEFAULT)
		AttackedBy([PC],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		SpellCastOnMe([PC],0)
		HPPercentLT(Myself,100)
		TookDamage()
		GlobalGT("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Ianotalk","AR1402",1)  // Shadow Dragon Hideout
		Enemy()
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	!Allegiance(Myself,ENEMY)
	!Detect([PC])
	InMyArea(Player1)
	NumberOfTimesTalkedTo(0)
	!PartyHasItem("MISC6P")  // Shadow Dragon Wardstone
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Iashadra01","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iashadra01","LOCALS",1)
		SetGlobal("Iaattack","LOCALS",2)
		ReallyForceSpellRES("SPWII03",Myself)  // Spell Turning
		ReallyForceSpell(Myself,DRAGON_STONE_SKIN)  // SPIN694.SPL (Stoneskin)
		ReallyForceSpellRES("SPWII01",Myself)  // Spell Shield
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iaexit","AR1402",0)  // Shadow Dragon Hideout
	Global("Iaexitthing","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iaexit","AR1402",1)  // Shadow Dragon Hideout
		SetGlobal("Iaexitthing","LOCALS",1)
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iadoonce","LOCALS",0)
	HPPercentLT(Myself,100)
THEN
	RESPONSE #100
		SetGlobal("Iadoonce","LOCALS",1)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iadoonce","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iadoonce","LOCALS",1)
END

IF
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		NoAction()
END

IF
	Allegiance(Myself,ENEMY)
	!HPLT(Myself,1)
	See(Player1)
	Class(Player1,MAGE_ALL)
	!CheckStat(Player1,5,SCRIPTINGSTATE7)
	!CheckStatGT(Player1,0,SCRIPTINGSTATE2)
	!StateCheck(Player1,STATE_MIRRORIMAGE)
	CheckStatLT(Player1,51,RESISTMAGIC)
	!CheckStat(Player1,2,SCRIPTINGSTATE3)
	!HasBounceEffects(Player1)
	Global("Iap1nr","GLOBAL",0)
	Global("Iashadra08","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iashadra08","LOCALS",1)
		DisplayString(Myself,26328)  // Chain Contingency
		ReallyForceSpell(Player1,WIZARD_FINGER_OF_DEATH)  // SPWI713.SPL (Finger of Death)
		ReallyForceSpell(Player1,WIZARD_FINGER_OF_DEATH)  // SPWI713.SPL (Finger of Death)
		ReallyForceSpell(Player1,WIZARD_FINGER_OF_DEATH)  // SPWI713.SPL (Finger of Death)
END

