IF
	HaveSpell(CLERIC_GREATER_COMMAND)
	Allegiance(Myself,ENEMY)
	!StateCheck(Myself,STATE_SILENCED)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	!GlobalTimerNotExpired("Iagcommand","LOCALS")
	!StateCheck([PC],STATE_STUNNED)
	!StateCheck([PC],STATE_HELPLESS)
	!StateCheck([PC],STATE_CONFUSED)
	!StateCheck([PC],STATE_PANIC)
	CheckStatLT([PC],75,RESISTMAGIC)
	!CheckStat([PC],2,SCRIPTINGSTATE3)
	!CheckStat([PC],1,SCRIPTINGSTATE4)
	CheckStat([PC],0,SCRIPTINGSTATE8)
	!CheckSpellState([PC],SI_ENCHANTMENT)
	!Race([PC],ELF)
	CheckStatGT([PC],2,SAVEVSSPELL)
	TriggerOverride([PC],Range(SecondNearest([PC]),15))
	TriggerOverride([PC],StateCheck(SecondNearest([PC]),STATE_STUNNED))
	TriggerOverride([PC],StateCheck(SecondNearest([PC]),STATE_HELPLESS))
	TriggerOverride([PC],CheckStatLT(SecondNearest([PC]),75,RESISTMAGIC))
	!TriggerOverride([PC],CheckStat(SecondNearest([PC]),2,SCRIPTINGSTATE3))
	!TriggerOverride([PC],CheckStat(SecondNearest([PC]),1,SCRIPTINGSTATE4))
	TriggerOverride([PC],CheckStatLT(SecondNearest([PC]),0,SCRIPTINGSTATE8))
	!TriggerOverride([PC],CheckSpellState(SecondNearest([PC]),SI_ENCHANTMENT))
	!TriggerOverride([PC],Race(SecondNearest([PC]),ELF))
	!TriggerOverride([PC],CheckStatGT(SecondNearest([PC]),2,SAVEVSSPELL))
	See([PC])
THEN
	RESPONSE #75
		SetGlobalTimer("Iagcommand","LOCALS",THREE_ROUNDS)
		SetGlobalTimer("IaFiveSeconds","LOCALS",ONE_MINUTE)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		Spell(LastSeenBy(Myself),CLERIC_GREATER_COMMAND)  // SPPR512.SPL (Greater Command)
	RESPONSE #25
	    Continue()
END

