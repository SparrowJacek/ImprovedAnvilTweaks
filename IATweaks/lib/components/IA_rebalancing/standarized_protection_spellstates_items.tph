SILENT

INCLUDE "%MOD_FOLDER%/lib/components/IA_rebalancing/helper_functions.tph"

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
// Charm and Domination immunity
  LPF ~S!ITEM_USES_OPCODE~
  INT_VAR
    check_globals  = 1
    check_headers  = 1
    match_opcode   = 101
    match_param2   = 5
  RET
    is_found
  END
  PATCH_IF ~%is_found%~ STR_EQ ~TRUE~ BEGIN
    LPF ~S!ITEM_USES_OPCODE~
    INT_VAR
        check_globals  = 1
        check_headers  = 1
        match_opcode   = 328
        match_param2   = charm_domination_immunity
    RET
        is_found
    END
    PATCH_IF ~%is_found%~ STR_EQ ~FALSE~ BEGIN
      LPF ~CLONE_EFFECT~
        INT_VAR
          match_opcode      = 101
          match_parameter2  = 5
          opcode            = 328
          parameter2        = charm_domination_immunity
          special           = 1
      END
    END
  END
