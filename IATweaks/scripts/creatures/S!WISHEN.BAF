IF
	Detect(LastSummonerOf(Myself))
	!Allegiance(LastSummonerOf(Myself),PC)
	TriggerOverride(LastSummonerOf(Myself),Global("IaWish","LOCALS",1))
THEN
	RESPONSE #100
		FaceObject(LastSummonerOf(Myself))
		ActionOverride(LastSummonerOf(Myself),SetGlobal("IaWish","LOCALS",0))
		ActionOverride(LastSummonerOf(Myself),DisplayStringHead(Myself,0))
		Wait(1)
		ForceSpellRES("S!WISHHA",Myself)
		Wait(1)
		DestroySelf()
END

