	!Range(LastSeenBy(Myself),15)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!CheckStat(LastSeenBy(Myself),4,SCRIPTINGSTATE7)
	!CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
	GlobalLT("Iagorsal03","LOCALS",5)
THEN
	RESPONSE #100
		IncrementGlobal("Iagorsal03","LOCALS",1)
		SetGlobalTimer("Iaimpfball","LOCALS",FIVE_ROUNDS)
		FaceObject(LastSeenBy(Myself))
		SetInterrupt(FALSE)
		DisplayString(Myself,4461)  // Stupid cretins. 
		ForceSpell(LastSeenBy(Myself),DRAGON_LOWER_FIRE)  // SPIN682.SPL (Lower Fire Resistance)
		Wait(2)
		ApplySpellRES("SPWII50",LastSeenBy(Myself))  // No such index
		ForceSpellRES("SPWII40",LastSeenBy(Myself))  // Improved FireBall
		SetGlobal("Iaattack","LOCALS",0)
		DisplayString(Myself,19054)  // Your life ends here.
		SetInterrupt(TRUE)
END

