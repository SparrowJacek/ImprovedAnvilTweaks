

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
		Continue()
END

IF
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		NoAction()
END



IF
	Allegiance(Myself,ENEMY)
	GlobalTimerExpired("IaRestTimer","LOCALS")
	Global("partyfled","LOCALS",1)
	Global("IaPrep","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iacontin","LOCALS",0)
		SetGlobal("IaSpellTrigger","LOCALS",0)
		SetGlobal("IaSpellSequencer","LOCALS",0)
		SetGlobal("IaMinorSequencer","LOCALS",0)
		SetGlobal("IaPrep","LOCALS",0)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
		Continue()
END

IF
	!Detect([PC])
	!Detect([GOODCUTOFF])
	Allegiance(Myself,ENEMY)
	GlobalTimerExpired("chase","LOCALS")
	Global("partyfled","LOCALS",1)
	GlobalGT("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iacontin","LOCALS",0)
		SetGlobal("IaSpellTrigger","LOCALS",0)
		SetGlobal("IaSpellSequencer","LOCALS",0)
		SetGlobal("IaMinorSequencer","LOCALS",0)
		SetGlobal("IaPrep","LOCALS",0)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
	    ReallyForceSpellRES("S!CNT03A",Myself)
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
	    ReallyForceSpellRES("S!CNT06A",Myself)
	    Continue()
	RESPONSE #100
	    ReallyForceSpellRES("S!CNT02A",Myself)
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("IaPrep","LOCALS",1)
		ReallyForceSpellRES("S!HOPE",Myself)  // Emotion: Hope
		RemoveSpellRES("S!HOPE")
		ReallyForceSpellRES("PTN34X",Myself)  // No such index
		ReallyForceSpell(Myself,WIZARD_ARMOR)  // SPWI102.SPL (Armor)
		RemoveSpell(WIZARD_ARMOR)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_EVIL)  // SPWI113 (Protection From Evil)
		RemoveSpell(WIZARD_PROTECTION_FROM_EVIL)
		ReallyForceSpell(Myself,WIZARD_LUCK)  // SPWI209.SPL (Luck)
		RemoveSpell(WIZARD_LUCK)
		ReallyForceSpell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (Mirror Image)
		RemoveSpell(WIZARD_MIRROR_IMAGE)
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		RemoveSpell(WIZARD_STONE_SKIN)
		ReallyForceSpell(Myself,WIZARD_TELEPORT_FIELD)
		RemoveSpell(WIZARD_TELEPORT_FIELD)
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_ABJURATION)  // SPWI590.SPL (Immunity: Abjurartion)
		RemoveSpell(WIZARD_SPELL_IMMUNITY)
		ReallyForceSpellRES("SPWI522",Myself)  // Soul Armor
		RemoveSpellRES("SPWI522")
		ReallyForceSpell(Myself,WIZARD_SPELL_TURNING)  // SPWI701.SPL (Spell Turning)
		RemoveSpell(WIZARD_SPELL_TURNING)
		ReallyForceSpellRES("SPWI725",Myself)  // Shield Mind and Body
		RemoveSpellRES("SPWI725")
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_ENERGY)
		RemoveSpell(WIZARD_PROTECTION_FROM_ENERGY)
		ReallyForceSpellRES("SPWI807",Myself)  // Foreknowledge
		RemoveSpellRES("SPWI807")
		ReallyForceSpell(Myself,WIZARD_ABSOLUTE_IMMUNITY)
		RemoveSpell(WIZARD_ABSOLUTE_IMMUNITY)
		SetGlobal("IaWish","LOCALS",1)
		SetGlobalTimer("IaWishTimer","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("S!WISHEN",Myself)  // Wish
		RemoveSpell(WIZARD_WISH)
		SmallWait(5)
		ReallyForceSpell(Myself,WIZARD_GLOBE_OF_INVULNERABILITY)  // SPWI602.SPL (Globe of Invulnerability)
		RemoveSpell(WIZARD_GLOBE_OF_INVULNERABILITY)
		SmallWait(15)
		SetInterrupt(TRUE)
END

IF
	HasItem("MINHP1",Myself)  // No such index
	AreaCheck("AR0907")  // Guarded Compound 2nd Floor
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		DestroyItem("MINHP1")  // No such index
		Continue()
END

IF
	GlobalTimerNotExpired("IaRunAway","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaRunAway","LOCALS",0)
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	OR(4)
		CheckStatGT(Myself,0,SCRIPTINGSTATE9)
		StateCheck(Myself,STATE_HELPLESS)
		StateCheck(Myself,STATE_STUNNED)
		Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",3)
END

