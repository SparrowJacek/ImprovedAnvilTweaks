	!GlobalTimerNotExpired("Iaspell","LOCALS")
	GlobalGT("Iawhirlwind","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",THREE_ROUNDS)
		SetGlobal("Iawhirlwind","LOCALS",0)
		ForceSpellRES("S!WHIRL2",NearestEnemyOf(Myself))
END

IF
	See(Player1)
	!CheckStat(LastSeenBy(Myself),4,SCRIPTINGSTATE7)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",THREE_ROUNDS)
		ForceSpellRES("SPWII13",LastSeenBy(Myself))  // Improved Chain Lightning
END

