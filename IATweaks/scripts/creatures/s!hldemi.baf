	!CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	HPLT(LastSeenBy(Myself),60)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaPwKillInfinite","LOCALS",18)
		ForceSpell(LastSeenBy(Myself),WIZARD_POWER_WORD_KILL)  // SPWI912.SPL (Power Word, Kill)
	RESPONSE #0
	    Continue()
END

