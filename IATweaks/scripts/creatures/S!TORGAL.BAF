IF
	NumberOfTimesTalkedTo(0)
	Global("Iapcastts","GLOBAL",0)
	Detect([PC])
	Global("Iatalk","AR1301",0)  // De'Arnise Cellar
THEN
	RESPONSE #100
		SetGlobal("Iatalk","AR1301",1)  // De'Arnise Cellar
		StartDialogueNoSet([PC])
END

IF
	Detect([PC])
	XPGT(Player1,2349999)
	Global("Iagem","LOCALS",0)
	Global("Iatalk","AR1301",1)  // De'Arnise Cellar
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		CreateCreatureObject("S!gemt",Myself,0,0,0)  // Gem Golem
		CreateCreatureObject("S!ntroll",Myself,0,0,0)  // Noble Troll
		CreateCreatureObject("S!ntroll",Myself,0,0,0)  // Noble Troll
		CreateCreatureObject("S!ntroll",Myself,0,0,0)  // Noble Troll
		CreateCreatureObject("S!ntroll",Myself,0,0,0)  // Noble Troll
		SetGlobal("Iagem","LOCALS",1)
		SetInterrupt(TRUE)
END

