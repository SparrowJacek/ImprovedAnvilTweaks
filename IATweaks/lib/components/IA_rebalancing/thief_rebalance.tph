// Main spell with Stealth bonuses

COPY ~IATweaks\resources\spl\s!hisinv.spl~ ~override~
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      projectile = %s!hisinv%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 328
      parameter2 = %hide_in_shadows_success_state%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 142
      parameter2 = %stealth_active_icon_id%
  END

COPY ~IATweaks\resources\spl\s!hisdmg.spl~ ~override~
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 318
      parameter1 = 13
      parameter2 = %stealth_strike_lower_than_row%
  END
  PATCH_FOR_EACH stealth_strike_value IN 25 38 50 63 75 88 100 110 120 130 140 150 160 170 180 190 200 208 216 224 232 240 248 256 264 272 280 288 296 304 312 320 328 336 344 352 360 BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 318
        parameter1 = stealth_strike_value
      STR_VAR
        insert = ~last~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 285
      STR_VAR
        insert = ~last~
    END
  END
  LPF ~CLONE_EFFECT~
    INT_VAR
      multi_match = 1
      match_opcode = 318
      parameter1 = 0
      parameter2 = 143
    STR_VAR
      insert = ~first~
  END

ACTION_DEFINE_ASSOCIATIVE_ARRAY hide_in_shadows_value_to_cooldown_mapping BEGIN
  110 => 88
  120 => 87
  130 => 85
  140 => 84
  150 => 82
  160 => 81
  170 => 79
  180 => 78
  190 => 76
  200 => 75
  205 => 73
  210 => 72
  215 => 70
  220 => 69
  225 => 67
  230 => 66
  235 => 64
  240 => 63
  245 => 61
  250 => 60
  255 => 58
  260 => 57
  265 => 55
  270 => 54
  275 => 52
  280 => 51
  285 => 49
  290 => 48
  295 => 46
  300 => 45
  305 => 43
  310 => 42
  315 => 40
  320 => 39
  325 => 37
  330 => 36
  335 => 34
  340 => 33
  345 => 31
  350 => 30
  355 => 28
  360 => 27
  365 => 25
  370 => 24
END

COPY ~IATweaks\resources\eff\s!hisrem.eff~ ~override~
COPY ~IATweaks\resources\spl\s!hisrem.spl~ ~override~
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 142
      parameter2 = %stealth_disabled_icon_id%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 328
      parameter2 = %hide_in_shadows_fail_state%
  END
  PHP_EACH hide_in_shadows_value_to_cooldown_mapping AS his_value=>cooldown_in_ticks BEGIN
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        opcode = 318
        target = 1
        parameter1 = %his_value%
        parameter2 = %hide_in_shadows_higher_or_equal_to_row%
        duration = 1
        insert_point = 0
      STR_VAR
        resource = ~S!HISREM~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 328
        duration = %cooldown_in_ticks%
        multi_match = 1
      STR_VAR
        insert = ~first~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 142
        duration = %cooldown_in_ticks%
        multi_match = 1
      STR_VAR
        insert = ~first~
    END
  END
  PATCH_FOR_EACH spell_to_remove IN ~S!HISINV~ ~S!HIS101~ ~S!HIS100~ ~S!HISFOE~ ~S!HISTRY~ ~S!HISBAS~ ~S!HISDMG~ BEGIN
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        opcode = 321
        target = 1
        insert_point = 0
      STR_VAR
        resource = EVAL ~%spell_to_remove%~
    END
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      opcode = 206
      target = 1
      duration = 1
      insert_point = 0
    STR_VAR
      resource = ~S!HISINV~
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      opcode = 267
      target = 1
      duration = 1
      parameter1 = 17120 // HiS Failed
      insert_point = 0
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      opcode = 139
      target = 1
      parameter1 = 17120 // HiS Failed
      insert_point = 0
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      opcode = 174
      target = 1
      insert_point = 0
    STR_VAR
      resource = ~ACT_07~
  END

COPY_EXISTING ~s!hisrem.spl~ ~override/s!hisre2.spl~
  LPF ~DELETE_EFFECT~
