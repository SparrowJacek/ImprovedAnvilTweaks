	ActionListEmpty()
	See(FourthNearestEnemyOf(Myself))
	CheckStatLT(FourthNearestEnemyOf(Myself),80,RESISTPIERCING) // PIERCING/CRUSHING/SLASHING
    !CheckStatGT(FourthNearestEnemyOf(Myself),0,SCRIPTINGSTATE6)
	Range(FourthNearestEnemyOf(Myself),6)
THEN
	RESPONSE #100
		SetGlobal("IaAttacking","LOCALS",1)
		EquipMostDamagingMelee()
		AttackReevaluate(FourthNearestEnemyOf(Myself),45)
END
