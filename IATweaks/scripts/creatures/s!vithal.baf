IF
	HaveSpellRES("SPWI804")
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	See(NearestEnemyOf(Myself))
	!CheckSpellState(Myself,TENSERS_TRANSFORMATION)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellRES("SPWI804",Myself)  // Tenser's Partial Transformation
	RESPONSE #100
	    Continue()
END
IF
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	!HPLT(Myself,1)
	HPPercentLT(Myself,100)
	See([PC])
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	TriggerOverride([PC], Range([PC], 15))
	CheckStatLT(LastSeenBy(Myself),50,RESISTELECTRICITY)
	CheckStatLT(LastSeenBy(Myself),50,RESISTMAGIC)
	TriggerOverride([PC], CheckStatLT([PC],50,RESISTMAGIC))
	TriggerOverride([PC], CheckStatLT([PC],50,RESISTELECTRICITY))
	Global("IaSpellTrigger","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaSpellTrigger","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		DisplayString(Myself,39968)  // Spell Trigger—Fired
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAIN_LIGHTNING)  // SPWI615.SPL (Chain Lightning)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAIN_LIGHTNING)  // SPWI615.SPL (Chain Lightning)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAIN_LIGHTNING)  // SPWI615.SPL (Chain Lightning)
	RESPONSE #10
	    Continue()
END
