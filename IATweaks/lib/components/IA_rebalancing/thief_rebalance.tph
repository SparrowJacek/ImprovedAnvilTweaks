// Make all armors that disable Thieving abilities protect from new stuff

COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
  READ_SHORT 0x1c item_category
  PATCH_IF (item_category = 2) OR (item_category = 60) OR (item_category = 61) OR (item_category = 62) OR (item_category = 63) OR (item_category = 64) OR (item_category = 65) OR (item_category = 66)
    THEN BEGIN
      LPF ~S!ITEM_USES_OPCODE~
        INT_VAR
          check_globals  = 1
          check_headers  = 0
          match_opcode   = 144
          match_param2   = 0
        RET
          is_found
      END
      PATCH_IF ~%is_found%~ STR_EQ ~TRUE~ BEGIN
        LPF ~ADD_ITEM_EQEFFECT~
          INT_VAR
            opcode = 206
            target = 1
            timing = 2
          STR_VAR
            resource = ~S!PPACHE~
        END
        LPF ~ADD_ITEM_EQEFFECT~
          INT_VAR
            opcode = 206
            target = 1
            timing = 2
          STR_VAR
            resource = ~S!HISBAS~
        END
        LPF ~ADD_ITEM_EQEFFECT~
          INT_VAR
            opcode = 142
            target = 1
            timing = 2
            parameter2 = %stealth_disabled_icon_id%
        END
        LPF ~ADD_ITEM_EQEFFECT~
          INT_VAR
            opcode = 328
            target = 1
            timing = 2
            parameter2 = %hide_in_shadows_fail_state%
            special = 1
        END
      END
  END
  BUT_ONLY

/////// AREAS ////////

// Lower lock and trap difficulty in Chateau Irenicus

COPY_EXISTING_REGEXP GLOB ~AR060[1-3]\.are$~ ~override~

  // process triggers //

  GET_OFFSET_ARRAY regions ARE_V10_REGIONS

  PHP_EACH regions AS int1 => region_off BEGIN
    READ_SHORT region_off + 0x68 trap_det_diff // trap detection difficulty
    READ_SHORT region_off + 0x6a trap_rem_diff // trap removal difficulty

    PATCH_IF ((trap_rem_diff > 25) AND (trap_det_diff < 100)) BEGIN
      WRITE_SHORT  region_off + 0x68 20 // trap detection difficulty
      WRITE_SHORT  region_off + 0x6a 25 // trap detection difficulty
    END
  END

  // process containers //

  GET_OFFSET_ARRAY containers ARE_V10_CONTAINERS

  PHP_EACH containers AS int2 => cont_off BEGIN
    READ_ASCII cont_off + 0x78 key // key item
    READ_SHORT cont_off + 0x26 lock_diff // lock difficulty
    READ_SHORT cont_off + 0x2c trap_det_diff // trap detection difficulty
    READ_SHORT cont_off + 0x2e trap_rem_diff // trap removal difficulty

    PATCH_IF (("%key%" STRING_COMPARE_CASE "" = 0) OR ("%key%" STRING_COMPARE_CASE "None" = 0)) BEGIN
      PATCH_IF (lock_diff > 25 AND lock_diff < 100) BEGIN
        WRITE_SHORT cont_off + 0x26 25 // lock difficulty
      END
    END

    PATCH_IF ((trap_det_diff < 100) AND (trap_rem_diff > 25)) BEGIN
      WRITE_SHORT  cont_off + 0x2c 20 // trap detection difficulty
      WRITE_SHORT  cont_off + 0x2e 25 // trap detection difficulty
    END
  END

