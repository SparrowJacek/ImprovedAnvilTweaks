END

IF
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
	!Dead("GPFIGHT1")
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
		ReallyForceSpell("GPFIGHT1",CLERIC_FREE_ACTION)
		RemoveSpell(CLERIC_FREE_ACTION)
		ReallyForceSpell("GPFIGHT1",CLERIC_CHAMPIONS_STRENGTH)
		RemoveSpell(CLERIC_CHAMPIONS_STRENGTH)
		Continue()
END

IF
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
		SetGlobalTimer("IaHolyPowerTimer","LOCALS",TWO_TURNS)
		SetGlobalTimer("IaDefensiveHarmonyTimer","LOCALS",SIX_ROUNDS)
		ReallyForceSpellRES("S!AEGIS",Myself)
		ReallyForceSpell(Myself,CLERIC_BLESS)  // SPPR101.SPL (Bless)
		ReallyForceSpell(Myself,CLERIC_REMOVE_FEAR)  // SPPR108.SPL (Remove Fear)
		ReallyForceSpell(Myself,CLERIC_ARMOR_OF_FAITH)  // SPPR111.SPL (Armor of Faith)
		ReallyForceSpell(Myself,CLERIC_AID)  // SPPR201.SPL (Aid)
		ReallyForceSpell(Myself,CLERIC_CHANT)  // SPPR203.SPL (Chant)
		ReallyForceSpell(Myself,CLERIC_DRAW_UPON_HOLY_MIGHT)  // SPPR214.SPL (Draw Upon Holy Might)
		ReallyForceSpell(Myself,CLERIC_PROTECTION_FROM_FIRE)  // SPPR306.SPL (Protection From Fire)
		ReallyForceSpell(Myself,CLERIC_FREE_ACTION)  // SPPR403.SPL (Free Action)
		ReallyForceSpellRES("SPPR406F",Myself)  // Defensive Harmony
		ReallyForceSpell(Myself,CLERIC_PROTECTION_FROM_LIGHTNING)  // SPPR407.SPL (Protection From Lightning)
		ReallyForceSpell(Myself,CLERIC_DEATH_WARD)  // SPPR409.SPL (Death Ward)
		ReallyForceSpell(Myself,CLERIC_HOLY_POWER)  // SPPR412.SPL (Holy Power)
		ReallyForceSpell(Myself,CLERIC_CHAOTIC_COMMANDS)  // SPPR508.SPL (Chaotic Commands)
		ReallyForceSpell(Myself,CLERIC_MAGIC_RESISTANCE)  // SPPR509.SPL (Magic Resistance)
		ReallyForceSpell(Myself,CLERIC_CAUSE_CRITICAL_WOUNDS)  // SPPR510.SPL (Cause Critical Wounds)
		ReallyForceSpell(Myself,CLERIC_SLAY_LIVING)  // SPPR511.SPL (Slay Living)
		ReallyForceSpell(Myself,CLERIC_PHYSICAL_MIRROR)  // SPPR613.SPL (Protection From Missiles)
		ReallyForceSpell(Myself,CLERIC_CHAMPIONS_STRENGTH)  // sppr618.spl (Champion's Might)
		ReallyForceSpellRES("SPPR617",Myself)  // Heavenly Shield
		ReallyForceSpell(Myself,NPC_BLADE_BARRIER)  // SPPR698.SPL (Blade Barrier)
		ReallyForceSpell(Myself,CLERIC_SHIELD_OF_THE_ARCHONS)  // SPPR701.SPL (Shield of the Archons)
		ReallyForceSpellRES("SPPR729",Myself)  // Foreknowledge
		EquipItem("CRITICAL")  // Cause Critical Wounds
		Continue()
END

IF
	Detect([PC])
	Global("Iatreasure","LOCALS",0)
	Global("Iaarundelplace","GLOBAL",3)
THEN
	RESPONSE #100
		SetGlobal("Iaarundelplace","GLOBAL",5)
		SetGlobal("Iatreasure","LOCALS",1)
		GiveItemCreate("wastaff",Myself,0,0,0)  // Staff of Arundel +3
END

IF
	HaveSpell(CLERIC_SLOW_POISON)
	StateCheck(Myself,STATE_POISONED)
	!CheckSpellState(Myself,DEAFENED)
	!StateCheck(Myself,STATE_DISEASED)
	!StateCheck(Myself,STATE_BLIND)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_STUNNED)
	!StateCheck(Myself,STATE_SILENCED)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",ONE_MINUTE)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ReallyForceSpell(Myself,CLERIC_SLOW_POISON)  // SPPR212.SPL (Slow Poison)
END

IF
	HaveSpell(CLERIC_NEUTRALIZE_POISON)
	OR(4)
		StateCheck(Myself,STATE_POISONED)
		CheckSpellState(Myself,DEAFENED)
		StateCheck(Myself,STATE_DISEASED)
		StateCheck(Myself,STATE_BLIND)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_STUNNED)
	!StateCheck(Myself,STATE_SILENCED)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",ONE_MINUTE)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ReallyForceSpell(Myself,CLERIC_NEUTRALIZE_POISON)  // SPPR404.SPL (Neutralize Poison)
END

IF
	HaveSpellRES("SPCL943")
	HaveSpellRES("S!DIVINT")
	!CheckStatGT(Myself,0,SCRIPTINGSTATE9)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_STUNNED)
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_POISONED)
	GlobalTimerNotExpired("IaFiveSeconds","LOCALS")
	!Dead("gpfight1")
	HPPercentLT(Myself,75)
	HPPercentLT("gpfight1",75)
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("SPCL943",Myself)  // Purify Aura
		RemoveSpellRES("SPCL943")
		SpellRES("S!DIVINT",Myself)  // Divine Intervention
END

