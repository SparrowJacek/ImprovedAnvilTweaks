// Remove holy symbols from pure Clerics

COPY_EXISTING ~CLABPR01.2da~ ~override~
  REPLACE_EVALUATE
    ~AP_CDHLYSYM~
    BEGIN
    END
    ~****~
  PRETTY_PRINT_2DA

// Allow Cleric kits to get their Holy Symbols at level 20

ACTION_FOR_EACH cleric_kit_clab IN ~CLABPR02.2da~ ~CLABPR03.2da~ ~CLABPR04.2da~ ~OHTYR.2da~ ~OHTEMPUS.2da~ ~SHAR.2da~ BEGIN
  COPY_EXISTING ~%cleric_kit_clab%~ ~override~
    REPLACE_EVALUATE
      ~AP_CDHLYSYM~
      BEGIN
      END
      ~****~
    PRETTY_PRINT_2DA
END

ACTION_FOR_EACH cleric_kit_clab IN ~CLABPR02.2da~ ~CLABPR03.2da~ ~CLABPR04.2da~ ~OHTYR.2da~ ~OHTEMPUS.2da~ ~SHAR.2da~ BEGIN
  LAF ~S!ADD_CLAB_ROW~
    STR_VAR
      filename = ~%cleric_kit_clab%~
      row_desc = ~HOLY_SYMBOL~
      level20 = ~AP_CDHLYSYM~
  END
END

// Make all Cleric kits use unique files for their HLAs

ACTION_DEFINE_ASSOCIATIVE_ARRAY hla_row_to_abbrev_mapping BEGIN
  45=>"Cl1"
  46=>"Cl2"
  47=>"Cl3"
  60=>"Cl4"
  61=>"Cl5"
END

COPY_EXISTING ~luabbr.2da~ ~override~
  COUNT_2DA_COLS ~colcount~
  PHP_EACH hla_row_to_abbrev_mapping AS row => abbreviation BEGIN
    SET_2DA_ENTRY_LATER ~_#_#_#luabbr~ row 1 ~%abbreviation%~
  END
  SET_2DA_ENTRIES_NOW ~_#_#_#luabbr~ ~colcount~
  PRETTY_PRINT_2DA

// Make copies of the original Cleric HLA table

ACTION_PHP_EACH hla_row_to_abbrev_mapping AS _ => abbreviation BEGIN
  COPY_EXISTING ~lucl0.2da~ ~override/lu%abbreviation%.2da~
END

LAF ~S!MAP_COLUMN_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~weapprof.2da~
  RET_ARRAY
    weapprof_cols = 2da_columns_to_ids_mapping
END

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~weapprof.2da~
  RET_ARRAY
    weapprof_rows = 2da_rows_to_ids_mapping
END

COPY_EXISTING ~weapprof.2da~  ~override/weapprof.2da~
  COUNT_2DA_COLS ~colcount~
  SET dagger_row = $weapprof_rows("DAGGER")
  SET sw_and_sh_row = $weapprof_rows("SWORDANDSHIELD")
// Enable ** in Sword and Shield for Cleric and all kits and *** for Tyr
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("CLERIC") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("FIGHTER_CLERIC") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("CLERIC_MAGE") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("CLERIC_THIEF") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("FIGHTER_MAGE_CLERIC") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("CLERIC_RANGER") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("TALOS") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("HELM") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("LATHANDER") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("OHTYR") ~3~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("OHTEMPUS") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ sw_and_sh_row $weapprof_cols("SHAR") ~2~
// Enable Clerics to put points into daggers
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("CLERIC") ~1~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("FIGHTER_CLERIC") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("CLERIC_MAGE") ~1~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("CLERIC_THIEF") ~1~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("FIGHTER_MAGE_CLERIC") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("CLERIC_RANGER") ~2~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("TALOS") ~1~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("HELM") ~1~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("LATHANDER") ~1~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("OHTYR") ~1~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("OHTEMPUS") ~1~
  SET_2DA_ENTRY_LATER ~_#_#_#weapprof~ dagger_row $weapprof_cols("SHAR") ~1~
  SET_2DA_ENTRIES_NOW ~_#_#_#weapprof~ ~colcount~
  PRETTY_PRINT_2DA

// Make all daggers usable by Clerics
COPY_EXISTING_REGEXP GLOB ~.+\.itm~ ~override~
  READ_SHORT 0x1c item_category
  PATCH_IF (item_category = 16)
    THEN BEGIN  
      READ_BYTE 0x1e usability_flags_1
      READ_BYTE 0x1f usability_flags_2
      WRITE_BYTE 0x1e (%usability_flags_1% BAND 0b01111111) // enable daggers for Clerics
      WRITE_BYTE 0x1f (%usability_flags_2% BAND 0b00111000) // enable daggers for Cleric multi combinations
  END
  BUT_ONLY

// add bonuses for *** in Sword and Shield
COPY_EXISTING ~stylbonu.2da~  ~override/stylbonu.2da~
  COUNT_2DA_COLS ~colcount~
  COUNT_2DA_ROWS ~colcount~ ~rowcount~
  INSERT_2DA_ROW ~rowcount~ ~colcount~ ~SWORDANDSHIELD-3 0                0                0                0                -3               -3               0                0~
  PRETTY_PRINT_2DA

