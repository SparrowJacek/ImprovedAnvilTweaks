IF
	Allegiance("pbhunt01",ENEMY)  // Aawill
	!Allegiance(Myself,ENEMY)
THEN
	RESPONSE #100
		Enemy()
END

IF
	AttackedBy([GOODCUTOFF],DEFAULT)
	Allegiance(Myself,NEUTRAL)
THEN
	RESPONSE #100
		Enemy()
		Shout(89)
END

IF
	Allegiance(Myself,ENEMY)
	Detect([PC])
	Global("Iahound","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iahound","LOCALS",1)
		CreateCreatureObject("S!phound",Myself,0,0,0)  // Planar Hound
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iamorehound","LOCALS")
	See([PC])
	!Range(LastSeenBy(Myself),4)
	Global("Iahound","LOCALS",1)
	Global("Prep","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobalTimer("Iamorehound","LOCALS",FOUR_ROUNDS)
		SetGlobal("Iahound","LOCALS",0)
END

IF
	Allegiance(Myself,ENEMY)
	Detect([PC])
	Global("Iadoonce","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iadoonce","LOCALS",1)
		SetGlobalTimer("Iamorehound","LOCALS",FOUR_ROUNDS)
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
