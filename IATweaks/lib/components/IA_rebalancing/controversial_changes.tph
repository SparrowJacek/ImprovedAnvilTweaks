// Add condition for checking if magic damage resistance is less than n

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~MAGIC_DAMAGE_RES>=n~
    stat                  = ~73~
    value                 = ~-1~
    relation              = ~4~
  RET
    magic_damage_res_greater_equal_than_row = new_line_number
END

