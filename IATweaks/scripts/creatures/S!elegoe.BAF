IF
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("Iatimer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("golemcall","LOCALS",THREE_ROUNDS)
		SetGlobal("Iatimer","LOCALS",1)
END

IF
	Detect([PC])
	Global("Iatreasure","LOCALS",0)
	Global("Iakundaneplace","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("Iakundaneplace","GLOBAL",4)
		SetGlobal("Iatreasure","LOCALS",1)
		GiveItemCreate("sw1h25",Myself,0,0,0)  // Kundane +2
END

