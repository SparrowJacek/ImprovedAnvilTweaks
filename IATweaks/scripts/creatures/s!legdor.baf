IF
	!See([PC])
	!See([GOODCUTOFF])
	Global("partyfled","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Global("IaPrep","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobalTimer("IaRestTimer","LOCALS",SEVEN_HOURS)
		SetGlobal("partyfled","LOCALS",1)
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	Global("IaPrep","LOCALS",1)
	HasItem("BHAALHP1",Myself)  // No such index
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
		DestroyItem("BHAALHP1")  // No such index
		SetInterrupt(TRUE)
END

IF
	Allegiance(Myself,ENEMY)
	AreaCheck("AR1202")  // Firkraag's Maze
	Detect([PC])
	Global("Iatreasure","LOCALS",0)
	Global("Iabeltplace","GLOBAL",2)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Iabeltplace","GLOBAL",5)
		SetGlobal("Iatreasure","LOCALS",1)
		GiveItemCreate("belt10",Myself,0,0,0)  // Belt of Inertial Barrier
		XEquipItem("belt10",Myself,SLOT_BELT,EQUIP)
		Continue()
END

IF
	Global("Iasentinelplace","GLOBAL",2)
	Global("Iatreasure2","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iasentinelplace","GLOBAL",5)
		SetGlobal("Iatreasure2","LOCALS",1)
		GiveItemCreate("shld22",Myself,0,0,0)  // Sentinel +4
		XEquipItem("shld22",Myself,SLOT_SHIELD,EQUIP)
		Continue()
END

IF
	!Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	Global("Iasamiadamaged","AR1202",0)  // Firkraag's Maze
	OR(5)
		AttackedBy([GOODCUTOFF],DEFAULT)
		AttackedBy([PC],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		SpellCastOnMe([PC],0)
		TookDamage()
THEN
	RESPONSE #100
		Enemy()
		SetGlobal("Iasamiadamaged","AR1202",1)  // Firkraag's Maze
		MoveToObject(Player1)
END

