
IF
	See(NearestEnemyOf(Myself))
	Global("Prep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Prep","LOCALS",1)
		SetGlobal("Iaonce","LOCALS",0)
		SetGlobal("Iatrigger","LOCALS",0)
		SetGlobal("Iapfmw","LOCALS",0)
		SetGlobal("Iacontingency","LOCALS",0)
		SetGlobal("Iastoneskin","LOCALS",0)
		SetGlobal("Iaimage","LOCALS",0)
		SetGlobal("Iacastbreach","LOCALS",0)
		SetGlobal("Iadragbreath","LOCALS",0)
		SetGlobal("Iaseq","LOCALS",0)
		SetGlobal("Iabclenched","LOCALS",0)
		SetGlobal("Iahardiness","LOCALS",0)
		SetGlobal("Iasidiv","LOCALS",0)
		SetGlobal("Iaassassination","LOCALS",0)
		SetGlobal("Iacrit","LOCALS",0)
		SetGlobal("Iainv","LOCALS",0)
		SetGlobalTimer("pfmw","LOCALS",FOUR_ROUNDS)
		SetGlobalTimer("Iasiduration","LOCALS",123)
		ReallyForceSpell(Myself,WIZARD_SHIELD)  // SPWI114.SPL (Shield)
		ReallyForceSpell(Myself,WIZARD_ARMOR)  // SPWI102.SPL (Armor)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)  // SPWI611.SPL (Protection From Magical Weapons)
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_BLUE)  // SPWI403.SPL (Fire Shield (Blue))
		ReallyForceSpell(Myself,WIZARD_BLUR)  // SPWI201.SPL (Blur)
		ReallyForceSpell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (Mirror Image)
		ReallyForceSpellRES("SPWII41",Myself)  // Improved Invisibility
		ReallyForceSpellRES("SPWI807",Myself)  // Foreknowledge
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_DIVINATION)  // SPWI592.SPL (Immunity: Divination)
		ForceSpell(Myself,WARRIOR_HARDINESS)  // SPCL907.SPL (Hardiness)
END

IF
	See(NearestEnemyOf(Myself))
	Allegiance(Myself,ENEMY)
	GlobalTimerExpired("Iademorest","GLOBAL")
	Global("Prep","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Prep","LOCALS",0)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	Global("Ialongfforged","GLOBAL",1)
	Global("IaLoot1","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaLoot1","LOCALS",1)
		DestroyItem("S!sw17")  // Long Sword +4
END

IF
	Global("Prep","LOCALS",1)
	Global("Iadifficulty","LOCALS",0)
	GlobalGT("Chapter","GLOBAL",7)
THEN
	RESPONSE #100
		SetGlobal("Iadifficulty","LOCALS",1)
		SetGlobal("IaAssassinAmount","LOCALS",5)
		SetGlobal("IaPfMWAmount","LOCALS",2)
		SetGlobal("IaHardinessAmount","LOCALS",2)
		SetGlobal("IaBigbyAmount","LOCALS",8)
END

IF
	Global("Prep","LOCALS",1)
	Global("Iadifficulty","LOCALS",0)
	GlobalLT("Chapter","GLOBAL",8)
THEN
	RESPONSE #100
		SetGlobal("Iadifficulty","LOCALS",1)
		SetGlobal("IaAssassinAmount","LOCALS",3)
		SetGlobal("IaPfMWAmount","LOCALS",1)
		SetGlobal("IaHardinessAmount","LOCALS",1)
		SetGlobal("IaBigbyAmount","LOCALS",4)
END

IF
	See(NearestEnemyOf(Myself))
	Global("Prep","LOCALS",1)
	Global("IaCastSpell","LOCALS",0)
	!GlobalTimerNotExpired("IaActionTypeCheck","LOCALS")
	RandomNumGT(6,4)
THEN
	RESPONSE #100
		SetGlobal("IaCastSpell","LOCALS",1)
		SetGlobalTimer("IaActionTypeCheck","LOCALS",ONE_ROUND)
END

IF
	See(NearestEnemyOf(Myself))
	Global("Prep","LOCALS",1)
	Global("IaCastSpell","LOCALS",0)
	GlobalsEqual("Iaassassination","IaAssassinAmount")
	Global("Iacrit","LOCALS",3)
	Global("Iainv","LOCALS",3)
THEN
	RESPONSE #100
		SetGlobal("IaCastSpell","LOCALS",1)
END

IF
	Allegiance(Myself,ENEMY)
	See(Player1)
	OR(2)
		Kit(Player1,MAGESCHOOL_NECROMANCER)
		Kit(Player1,AURAMASTER)
	!GlobalTimerNotExpired("Iacreature","LOCALS")
	!HPLT(Myself,1)
	Global("Iaonce","LOCALS",0)
	GlobalGT("Chapter","GLOBAL",7)
THEN
	RESPONSE #100
		SetGlobal("Iaonce","LOCALS",1)
		SetGlobal("IaCastSpell","LOCALS",0)
		SetGlobalTimer("Iacreature","LOCALS",FIVE_ROUNDS)
		DisplayStringHead(Myself,70998)  // Come, my minions!
		CreateCreatureObjectDoor("S!varg",LastSeenBy(Myself),0,0,0)  // Vargouille
		CreateCreatureObjectDoor("S!varg",LastSeenBy(Myself),0,0,0)  // Vargouille
		CreateCreatureObjectDoor("S!varg",LastSeenBy(Myself),0,0,0)  // Vargouille
END

