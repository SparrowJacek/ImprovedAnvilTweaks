	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!HPLT(Myself,1)
	HPPercentLT(Myself,100)
	See(SixthNearest([PC]))
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	TriggerOverride(SixthNearest([PC]), Range([PC], 15))
	CheckStatLT(LastSeenBy(Myself),50,RESISTELECTRICITY)
	CheckStatLT(LastSeenBy(Myself),50,RESISTMAGIC)
	TriggerOverride(SixthNearest([PC]), CheckStatLT([PC],50,RESISTMAGIC))
	TriggerOverride(SixthNearest([PC]), CheckStatLT([PC],50,RESISTELECTRICITY))
	Global("IaSpellTrigger","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaSpellTrigger","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayString(Myself,39968)  // Spell Trigger—Fired
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAIN_LIGHTNING)  // SPWI615.SPL (Chain Lightning)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAIN_LIGHTNING)  // SPWI615.SPL (Chain Lightning)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_CHAIN_LIGHTNING)  // SPWI615.SPL (Chain Lightning)
	RESPONSE #10
	    Continue()
END

