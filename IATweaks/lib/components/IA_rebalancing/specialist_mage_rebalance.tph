    row_desc = ~ABJUR_MASTERY~
    level12 = ~GA_S!ABJMAS~
    level18 = ~GA_S!ABJMAS~
    level24 = ~GA_S!ABJMAS~
    level30 = ~GA_S!ABJMAS~
    level36 = ~GA_S!ABJMAS~
END

///////////////// Creatures ////////////////////

// Sorcerous Amon
COPY_EXISTING ~SEVPAT02.cre~ ~override~
  WRITE_SHORT 0x24 47 // HP
  WRITE_SHORT 0x26 47 // HP
  WRITE_SHORT 0x46 10 // AC
  WRITE_SHORT 0x48 10 // AC
  WRITE_BYTE 0x60 0 // Resist Slashing
  WRITE_BYTE 0x61 0 // Resist Crushing
  WRITE_BYTE 0x62 0 // Resist Piercing
  WRITE_BYTE 0x63 0 // Resist Missile
  WRITE_LONG 0x244 0x00000800 // Kit = Invoker

  LPF ~ADD_CRE_EFFECT~ // Sequencer with Flame Arrow
    INT_VAR
      opcode = 256
      target = 1
      resist_dispel = 0
      timing = 9
      parameter3 = 0
    STR_VAR
      effsource = ~SPWIJ01~
      resource = ~SPWI303~
  END

  LPF ~DELETE_CRE_ITEM~
    STR_VAR
      item_to_delete = ~S!IMMUNE~
  END
// Gaius

COPY_EXISTING ~GAIUS.cre~ ~override~
  WRITE_SHORT 0x24 84 // HP
  WRITE_SHORT 0x26 84 // HP
  WRITE_SHORT 0x46 10 // AC
  WRITE_SHORT 0x48 10 // AC
  WRITE_BYTE 0x59 0 // Resist Fire
  WRITE_BYTE 0x5a 0 // Resist Cold
  WRITE_BYTE 0x5b 0 // Resist Electricity
  WRITE_BYTE 0x5c 0 // Resist Acid
  WRITE_BYTE 0x5d 0 // Resist Magic
  WRITE_BYTE 0x5e 0 // Resist Magic Fire
  WRITE_BYTE 0x5e 0 // Resist Magic Cold
  WRITE_BYTE 0x60 0 // Resist Slashing
  WRITE_BYTE 0x61 0 // Resist Crushing
  WRITE_BYTE 0x62 0 // Resist Piercing
  WRITE_BYTE 0x63 0 // Resist Missile

  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 0
  END

  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 31
  END

  LPF ~DELETE_CRE_ITEM~
    STR_VAR
      item_to_delete = ~S!IMMUNE~
  END

  ADD_CRE_ITEM ~POTN33~ #0 #0 #0 ~~ ~INV15~

COMPILE ~IATweaks\scripts\creatures\S!GAIUS.BAF~
  PATCH_IF(FILE_EXISTS_IN_GAME ~POTN33.spl~) BEGIN
    ADD_CRE_ITEM ~POTN33~ #0 #0 #0 ~UNSTEALABLE&UNDROPPABLE~ ~INV14~
  END

// Random Encounter Bandit Mage
COPY_EXISTING ~REBAND04.cre~ ~override~
  LPF ~DELETE_CRE_ITEM~
    STR_VAR
      item_to_delete = ~S!IMMUNE~
  END
