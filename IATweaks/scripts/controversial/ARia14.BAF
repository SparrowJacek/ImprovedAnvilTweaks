IF
	Global("IaUndeadWaves","GLOBAL",4)
	!Dead("S!DRACOL")
	TriggerOverride("S!DRACOL",GlobalLT("IaToneDown","LOCALS",2))
	!GlobalTimerNotExpired("IaCreature1Timer","ARIA14")
THEN
	RESPONSE #100
		CreateCreatureEffect("s!zmbdra","SPRAISED",[789.1148],14) 
		SetGlobalTimer("IaCreature1Timer","ARIA14",5)
		Continue()
	RESPONSE #100
		CreateCreatureEffect("s!zmbrun","SPRAISED",[789.1148],14) 
		SetGlobalTimer("IaCreature1Timer","ARIA14",5)
		Continue()
	RESPONSE #300
		SetGlobalTimer("IaCreature1Timer","ARIA14",3)
		Continue()
END

