ACTION_DEFINE_ASSOCIATIVE_ARRAY old_to_new_animal_summ_mapping BEGIN
  "SPPR402"=>"S!BMSUMA"
  "SPPR501"=>"S!BMSUMB"
  "SPPR602"=>"S!BMSUMC"
  "SPPR703"=>"S!BMSUMD"
END

ACTION_PHP_EACH old_to_new_animal_summ_mapping AS old_spell => new_spell BEGIN
  COPY_EXISTING ~%old_spell%.spl~ ~override/%new_spell%.spl~
    WRITE_LONG 0x08 ~-1~ // Remove name
    WRITE_SHORT 0x22 0 // Remove casting animation
    WRITE_LONG 0x50 ~-1~ // Remove description
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 177
        duration = 90
    END
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = ~-1~
      STR_VAR
        match_resource = EVAL ~%old_spell%~
        resource = EVAL ~%new_spell%~
    END
END

LAF ~S!ADD_CLAB_ROW~
  STR_VAR
    filename = ~CLABRN04.2da~
    row_desc = ~ANIMAL_SUMMONING~
    level1 = ~GA_S!BMSUM1~
    level10 = ~GA_S!BMSUM2~
    level12 = ~GA_S!BMSUM3~
    level14 = ~GA_S!BMSUM4~
END

// Hunter's Mark

ADD_PROJECTILE ~IATweaks\resources\pro\s!hunfri.pro~

COPY ~IATweaks\resources\vvc\s!hunte1.VVC~ ~override~
COPY ~IATweaks\resources\vvc\s!hunte2.VVC~ ~override~
COPY ~IATweaks\resources\vvc\s!hunte3.VVC~ ~override~
COPY ~IATweaks\resources\bam\s!hunter.bam~ ~override~
COPY ~IATweaks\resources\bam\s!hunmab.bam~ ~override~
COPY ~IATweaks\resources\bam\s!hunmad.bam~ ~override~
COPY ~IATweaks\resources\spl\s!hmani2.spl~ ~override~
COPY ~IATweaks\resources\spl\s!hmani3.spl~ ~override~
COPY ~IATweaks\resources\spl\s!hunmar.spl~ ~override~
  SAY NAME1 @6097
  SAY UNIDENTIFIED_DESC @6098
COPY ~IATweaks\resources\spl\s!hunfoe.spl~ ~override~
  FOR (i = 0; i <= 13; ++i) BEGIN
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        insert_point = ~-1~
        opcode = 146
        parameter2 = 1
        target = 2
        duration = 4 + (i * 6)
        timing = 3
      STR_VAR
        resource = EVAL ~S!HUNPRT~
    END
  END
  PATCH_FOR_EACH header_num IN 1 2 3 4 5 6 7 8 BEGIN
    SET min_level = %header_num% * 5
    SET new_val = 0 - 2 - %header_num%
    LPF ~S!CLONE_SPELL_HEADER~
      INT_VAR
        level_req = %min_level%
    END
    LPF ~S!ALTER_EFFECT~
      INT_VAR
        header = %header_num%
        match_opcode = 178
        special = %new_val%
    END
    LPF ~S!ALTER_EFFECT~
      INT_VAR
        header = %header_num%
        match_opcode = 179
        special = %new_val%
    END
  END

COPY ~IATweaks\resources\eff\s!hunfoe.eff~ ~override~
COPY ~IATweaks\resources\spl\s!hunvis.spl~ ~override~
COPY ~IATweaks\resources\spl\s!hunprt.spl~ ~override~

OUTER_SET hunters_mark_desc_str_ref = RESOLVE_STR_REF (@6097)
LAF ~S!ADD_PORTRAIT_ICON~
  INT_VAR
    description_str_ref = %hunters_mark_desc_str_ref%
  STR_VAR
    bam_file = ~S!HUNMAD~
  RET
    hunters_mark_icon_id = portrait_icon_id
END
COPY ~IATweaks\resources\spl\s!hunfri.spl~ ~override~
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      projectile = %s!hunfri%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 142
      parameter2 = %hunters_mark_icon_id%
  END
  FOR (i = 1; i <= 14; ++i) BEGIN
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        insert_point = ~-1~
        opcode = 146
        parameter2 = 1
        target = 1
        duration = 6 * i
        timing = 3
      STR_VAR
        resource = EVAL ~S!HUNREM~
    END
  END
  PATCH_FOR_EACH header_num IN 1 2 3 4 5 6 7 8 BEGIN
    SET min_level = %header_num% * 5
    SET new_val = 2 + %header_num%
    LPF ~S!CLONE_SPELL_HEADER~
      INT_VAR
        level_req = %min_level%
    END
    LPF ~S!ALTER_EFFECT~
      INT_VAR
        header = %header_num%
        match_opcode = 178
        special = %new_val%
    END
    LPF ~S!ALTER_EFFECT~
      INT_VAR
        header = %header_num%
        match_opcode = 179
        special = %new_val%
    END
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = ~-1~
      match_dicesize = ~-1~
      dicesize = 0
  END

COPY ~IATweaks\resources\eff\s!hunfri.eff~ ~override~
COPY ~IATweaks\resources\spl\s!hmkill.spl~ ~override~
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 139
      parameter1 = RESOLVE_STR_REF (@6120)
  END
COPY ~IATweaks\resources\eff\s!hmkill.eff~ ~override~
COPY_EXISTING ~s!hmkill.spl~ ~override/s!hunrem.spl~
COPY ~IATweaks\resources\spl\s!hmbase.spl~ ~override~ 

LAF ~S!ADD_CLAB_ROW~
  STR_VAR
    filename = ~CLABRN04.2da~
    row_desc = ~HUNTER'S_MARK~
    level1 = ~AP_S!HMBASE~
END

