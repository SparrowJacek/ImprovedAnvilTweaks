// Dispellable protection from magic
  LPF ~S!ITEM_USES_OPCODE~
  INT_VAR
    check_globals  = 1
    check_headers  = 1
    match_dispel   = 3
    match_opcode   = 166
    min_duration   = 12
  RET
    is_found
    opcode_param1
  END
  PATCH_IF (~%is_found%~ STR_EQ ~TRUE~) AND (opcode_param1 > 0) AND (opcode_param1 < 127) BEGIN
    LPF ~S!ITEM_USES_OPCODE~
    INT_VAR
      check_globals  = 1
      check_headers  = 1
      match_opcode   = 328
      match_param2   = dispellable_increased_magic_resistance
