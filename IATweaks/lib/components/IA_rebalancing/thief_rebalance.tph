COPY ~IATweaks\resources\spl\s!hissnd.spl~ ~override~
// TODO: consider changing lower probability to higher probability +1 from s!hisen1 to avoid overlapping

// Main spell with Stealth bonuses
ADD_PROJECTILE ~IATweaks\resources\pro\s!hisinv.pro~
COPY ~IATweaks\resources\spl\s!hisinv.spl~ ~override~
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      projectile = %s!hisinv%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 318
      parameter2 = %stealth_strike_lower_than_row%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 328
      parameter2 = %hide_in_shadows_success_state%
  END
  LPF ~CLONE_EFFECT~
    INT_VAR
      match_opcode = 146
      opcode = 272
      parameter1 = 1
      parameter2 = 0
      timing = 1
      duration = 119
      multi_match = 1
    STR_VAR
      insert = ~above~
      resource = ~S!HISREM~
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 142
      parameter2 = %stealth_active_icon_id%
  END

ACTION_DEFINE_ASSOCIATIVE_ARRAY hide_in_shadows_value_to_cooldown_mapping BEGIN
  120 => 87
  140 => 84
  160 => 81
  180 => 78
  200 => 75
  210 => 72
  220 => 69
  230 => 66
  240 => 63
  250 => 60
  260 => 57
  270 => 54
  280 => 51
  290 => 48
  300 => 45
  310 => 42
  320 => 39
  330 => 36
  340 => 33
  350 => 30
END

COPY ~IATweaks\resources\eff\s!hisrem.eff~ ~override~
COPY ~IATweaks\resources\spl\s!hisrem.spl~ ~override~
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 142
      parameter2 = %stealth_disabled_icon_id%
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 328
      parameter2 = %hide_in_shadows_fail_state%
  END
  PHP_EACH hide_in_shadows_value_to_cooldown_mapping AS his_value=>cooldown_in_ticks BEGIN
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        opcode = 318
        target = 1
        parameter1 = %his_value%
        parameter2 = %hide_in_shadows_higher_than_row%
        insert_point = 0
      STR_VAR
        resource = ~S!HISREM~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 328
        duration = %cooldown_in_ticks%
        multi_match = 1
      STR_VAR
        insert = ~first~
    END
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 142
        duration = %cooldown_in_ticks%
        multi_match = 1
      STR_VAR
        insert = ~first~
    END
  END
  PATCH_FOR_EACH spell_to_remove IN ~S!HISINV~ ~S!HIS101~ ~S!HIS100~ ~S!HISFOE~ ~S!HISTRY~ ~S!HISBAS~ BEGIN
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        opcode = 321
        target = 1
        insert_point = 0
      STR_VAR
        resource = EVAL ~%spell_to_remove%~
    END
  END

// Ensure that Hide in Shadows sound ID is present in .IDS file

LOOKUP_IDS_SYMBOL_OF_INT test ~SOUNDOFF~ 70
ACTION_IF ~%test%~ STR_EQ ~70~ BEGIN
  APPEND ~SOUNDOFF.ids~ ~70 HIDDEN_IN_SHADOWS~
END

// Ensure that Hide in Shadows character sound is said only once

