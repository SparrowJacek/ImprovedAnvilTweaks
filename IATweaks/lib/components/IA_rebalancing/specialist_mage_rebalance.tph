  READ_BYTE 0x1f spell_flags
  WRITE_BYTE 0x1f (%spell_flags% BAND 0b00000000) // enable the spell for Conjurers
  WRITE_BYTE 0x1f (%spell_flags% BOR 0b00000001) // disable the spell for Diviners
