IF
	AreaCheck("AR4500")  // Pocket Plane
	GlobalGT("Iaepicbattle","AR4500",2)  // Pocket Plane
	Global("Iasuicide","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iasuicide","LOCALS",1)
		DestroySelf()
END

IF
	See(NearestEnemyOf(Myself))
	Global("EnemySeen","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("EnemySeen","LOCALS",1)
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	AreaCheck("AR4500")  // Pocket Plane
	GlobalGT("Iapasha","AR4500",0)  // Pocket Plane
	Exists("S!pasha2")  // Pasha Mahmoud
	!Dead("S!pasha2")  // Pasha Mahmoud
	OR(2)
		See("S!pasha2")  // Pasha Mahmoud
		See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Detect([PC])
	Global("Iatimer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobal("Iatimer","LOCALS",1)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("Iaicespikesplayer1","LOCALS",0)
		SetGlobal("Iaicespikesplayer2","LOCALS",0)
		SetGlobal("Iaicespikesplayer3","LOCALS",0)
		SetGlobal("Iaicespikesplayer4","LOCALS",0)
		SetGlobal("Iaicespikesplayer5","LOCALS",0)
		SetGlobal("Iaicespikesplayer6","LOCALS",0)
		SetGlobal("Iaicespikesplayer_1_2","LOCALS",0)
		SetGlobal("Iaicespikesplayer_1_3","LOCALS",0)
		SetGlobal("Iaicespikesplayer_1_4","LOCALS",0)
		SetGlobal("Iaicespikesplayer_1_5","LOCALS",0)
		SetGlobal("Iaicespikesplayer_1_6","LOCALS",0)
		SetGlobal("Iaicespikesplayer_2_1","LOCALS",0)
		SetGlobal("Iaicespikesplayer_2_3","LOCALS",0)
		SetGlobal("Iaicespikesplayer_2_4","LOCALS",0)
		SetGlobal("Iaicespikesplayer_2_5","LOCALS",0)
		SetGlobal("Iaicespikesplayer_2_6","LOCALS",0)
		SetGlobal("Iaicespikesplayer_3_1","LOCALS",0)
		SetGlobal("Iaicespikesplayer_3_2","LOCALS",0)
		SetGlobal("Iaicespikesplayer_3_4","LOCALS",0)
		SetGlobal("Iaicespikesplayer_3_5","LOCALS",0)
		SetGlobal("Iaicespikesplayer_3_6","LOCALS",0)
		SetGlobal("Iaicespikesplayer_4_1","LOCALS",0)
		SetGlobal("Iaicespikesplayer_4_2","LOCALS",0)
		SetGlobal("Iaicespikesplayer_4_3","LOCALS",0)
		SetGlobal("Iaicespikesplayer_4_5","LOCALS",0)
		SetGlobal("Iaicespikesplayer_4_6","LOCALS",0)
		SetGlobal("Iaicespikesplayer_5_1","LOCALS",0)
		SetGlobal("Iaicespikesplayer_5_2","LOCALS",0)
		SetGlobal("Iaicespikesplayer_5_3","LOCALS",0)
		SetGlobal("Iaicespikesplayer_5_4","LOCALS",0)
		SetGlobal("Iaicespikesplayer_5_6","LOCALS",0)
		SetGlobal("Iaicespikesplayer_6_1","LOCALS",0)
		SetGlobal("Iaicespikesplayer_6_2","LOCALS",0)
		SetGlobal("Iaicespikesplayer_6_3","LOCALS",0)
		SetGlobal("Iaicespikesplayer_6_4","LOCALS",0)
		SetGlobal("Iaicespikesplayer_6_5","LOCALS",0)
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!HPLT(Myself,1)
	See(Player1)
	OR(2)
		CheckStatLT(Player1,90,RESISTCOLD)
		CheckStatLT(Player1,90,RESISTPIERCING)
	OR(2)
		CheckStatLT(Player2,90,RESISTCOLD)
		CheckStatLT(Player2,90,RESISTPIERCING)
	Range(Player2,18)
	Range(Player1,18)
	!Range(Player2,15)
	TriggerOverride(Player1,Range(Player2,11))
THEN
	RESPONSE #100
		IncrementGlobal("Iaicespikesplayer1","LOCALS",1)
		SetGlobal("Iaicespikesplayer_1_2","LOCALS",1)
		Continue()
END

