
IF
	NumberOfTimesTalkedTo(0)
	Detect([PC])
	Global("Iapcastts","GLOBAL",0)
	ActionListEmpty()
THEN
	RESPONSE #100
        DestroyItem("S!UMAR")
		SetGlobal("IalordSpawn","AR1401",1)
		StartDialogueNoSet([PC])
END

IF
	!Allegiance(Myself,ENEMY)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
THEN
	RESPONSE #100
		Enemy()
		SetGlobal("IalordSpawn","AR1401",1)
        DestroyItem("S!UMAR")
END

IF
	Heard([ANYONE],89)
	!Allegiance(Myself,ENEMY)
THEN
	RESPONSE #100
		Enemy()
		SetGlobal("IalordSpawn","AR1401",1)
        DestroyItem("S!UMAR")
END

IF
	InMyArea(Player1)
	OR(7)
		AttackedBy([GOODCUTOFF],DEFAULT)
		AttackedBy([PC],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		SpellCastOnMe([PC],0)
		HitBy([PC],CRUSHING)
		HitBy([GOODCUTOFF],CRUSHING)
		TookDamage()
	!Allegiance(Myself,ENEMY)
THEN
	RESPONSE #100
		Enemy()
		Shout(89)
		SetGlobal("IalordSpawn","AR1401",1)
        DestroyItem("S!UMAR")
		MoveToObject(Player1)
END

IF
	Allegiance("rumar03",ENEMY)  // Wondrous Imp
	!Allegiance(Myself,ENEMY)
THEN
	RESPONSE #100
		Enemy()
		SetGlobal("IalordSpawn","AR1401",1)
        DestroyItem("S!UMAR")
END


IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
		Continue()
END

IF
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		NoAction()
END


IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
	    ReallyForceSpellRES("S!CNT03A",Myself)
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
	    ReallyForceSpellRES("S!CNT02A",Myself)
	    Continue()
END


IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("IaPrep","LOCALS",1)
		ReallyForceSpellRES("PTN34X",Myself)  // No such index
		ReallyForceSpellRES("PTN34X",Myself)  // No such index
		ReallyForceSpell(Myself,WIZARD_ARMOR)  // SPWI102.SPL (Armor)
		RemoveSpell(WIZARD_ARMOR)
		ReallyForceSpell(Myself,WIZARD_SHIELD)
		RemoveSpell(WIZARD_SHIELD)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_EVIL)  // SPWI113 (Protection From Evil)
		RemoveSpell(WIZARD_PROTECTION_FROM_EVIL)
		ReallyForceSpell(Myself,WIZARD_LUCK)  // SPWI209.SPL (Luck)
		RemoveSpell(WIZARD_LUCK)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_BLUE)  // SPWI403.SPL (Fire Shield (Blue))
		RemoveSpell(WIZARD_FIRE_SHIELD_BLUE)
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		RemoveSpell(WIZARD_STONE_SKIN)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Fire Shield (Red))
		RemoveSpell(WIZARD_FIRE_SHIELD_RED)
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_ABJURATION)  // SPWI590.SPL (Immunity: Abjurartion)
		RemoveSpell(WIZARD_SPELL_IMMUNITY)
		ReallyForceSpellRES("SPWI522",Myself)  // Soul Armor
		RemoveSpellRES("SPWI522")
		ReallyForceSpell(Myself,WIZARD_SPELL_TURNING)  // SPWI701.SPL (Spell Turning)
		RemoveSpell(WIZARD_SPELL_TURNING)
		ReallyForceSpellRES("SPWI725",Myself)  // Shield Mind and Body
		RemoveSpellRES("SPWI725")
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_ENERGY)
		RemoveSpell(WIZARD_PROTECTION_FROM_ENERGY)
		ReallyForceSpellRES("SPWI804",Myself)  // Tenser's Partial Transformation
		RemoveSpellRES("SPWI804")
		ReallyForceSpellRES("SPWI807",Myself)  // Foreknowledge
		RemoveSpellRES("SPWI807")
		ReallyForceSpell(Myself,WIZARD_HASTE)  // SPWI305.SPL (Haste)
		RemoveSpell(WIZARD_HASTE)  // SPWI305.SPL (Haste)
		ReallyForceSpellRES("SPWI920",Myself) //  Energy Blades
		RemoveSpellRES("SPWI920")
		EquipItem("ENEBLADE")  // Energy Blade
		SmallWait(5)
		ReallyForceSpell(Myself,WIZARD_GLOBE_OF_INVULNERABILITY)  // SPWI602.SPL (Globe of Invulnerability)
		RemoveSpell(WIZARD_GLOBE_OF_INVULNERABILITY)
		SetInterrupt(TRUE)
END


