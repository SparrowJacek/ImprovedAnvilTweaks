// Rune Assassin
COPY_EXISTING ~TANTHF01.cre~ ~override~
  WRITE_BYTE 0x10 64 // Original class = Thief
  WRITE_SHORT 0x24 73 // HP
  WRITE_SHORT 0x26 73 // HP
  WRITE_BYTE 0x45 150 // Hide in Shadows
  WRITE_BYTE 0x52 5 // Thac0
  WRITE_BYTE 0x54 4 // Saves
  WRITE_BYTE 0x55 6 // Saves
  WRITE_BYTE 0x56 5 // Saves
  WRITE_BYTE 0x57 4 // Saves
  WRITE_BYTE 0x58 7 // Saves
  WRITE_BYTE 0x64 0 // Detect Illusions
  WRITE_BYTE 0x65 0 // Set Traps
  WRITE_BYTE 0x67 0 // Pick Locks
  WRITE_BYTE 0x68 0 // Stealth Strike
  WRITE_BYTE 0x69 0 // Find Traps
  WRITE_BYTE 0x6a 0 // Pick Pockets
  WRITE_BYTE 0x234 15 // 1st Class Level
  WRITE_BYTE 0x235 16 // 2nd Class Level
  WRITE_LONG 0x244 0x400a0000 // Kit = Assassin

  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 233
      match_parameter2 = 91
      parameter1 = 5
  END

  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 73
      target = 1
      parameter1 = 1
      parameter2 = 0
      timing = 9
    STR_VAR
      effsource = ~SPCL421~
  END

  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 278
      target = 1
      parameter1 = 1
      parameter2 = 0
      timing = 9
    STR_VAR
      effsource = ~SPCL421~
  END

  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 59
      target = 1
      parameter1 = 40
      parameter2 = 0
      timing = 9
    STR_VAR
      effsource = ~S!40SS~
  END

  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 275
      target = 1
      parameter1 = 40
      parameter2 = 0
      timing = 9
    STR_VAR
      effsource = ~S!40HIS~
  END

  LPF ~ADD_CRE_EFFECT~
    INT_VAR
      opcode = 144
      target = 1
      timing = 9
    STR_VAR
      effsource = ~S!DISSTE~
  END

COMPILE ~IATweaks\scripts\creatures\S!RUNEAS.baf~

// Thieves right before the exit from Chateau Irenicus
ACTION_FOR_EACH low_level_thief_cre IN ~ISHADTH1.cre~ ~ISHADMT1.cre~ ~ISHADFT1.cre~ BEGIN 
  COPY_EXISTING ~%low_level_thief_cre%~ ~override~
    WRITE_BYTE 0x52 17 // Thac0
    WRITE_BYTE 0x64 0 // Detect Illusions
    WRITE_BYTE 0x65 0 // Set Traps
    WRITE_BYTE 0x67 0 // Pick Locks
    WRITE_BYTE 0x68 0 // Stealth Strike
    WRITE_BYTE 0x69 0 // Find Traps
    WRITE_BYTE 0x6a 80 // Pick Pockets
    WRITE_BYTE 0x23c 17 // Dexterity
    WRITE_BYTE 0x272 3 // Half Elf because they're multi-class

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 90
        target = 1
        parameter1 = 40
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~S!40OL~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 91
        target = 1
        parameter1 = 40
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~S!40FT~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 92
        target = 1
        parameter1 = 40
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~S!40PP~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 144
        target = 1
        timing = 9
      STR_VAR
        effsource = ~S!DISSTE~
    END
END

COPY_EXISTING ~ISHADFT1.cre~ ~override~
  WRITE_BYTE 0x52 16 // Thac0
  WRITE_BYTE 0x238 17 // Strength

