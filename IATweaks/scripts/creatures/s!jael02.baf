	!TriggerOverride([PC],Race(SecondNearest([PC]),HALF_ELF))
	!TriggerOverride([PC],CheckStatGT(SecondNearest([PC]),5,SAVEVSSPELL))
	See([PC])
THEN
	RESPONSE #90
