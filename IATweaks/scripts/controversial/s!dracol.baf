IF
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	See([PC])
	OR(3)
		CheckStatLT(LastSeenBy(Myself),8,SAVEVSBREATH)
		CheckStatLT(LastSeenBy(Myself),8,SAVEVSSPELL)
		CheckStatLT(LastSeenBy(Myself),-8,THAC0)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE3)
	!GlobalTimerNotExpired("Iagdoom","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("Iagdoom","LOCALS",15)
		ForceSpellRES("SPINI68",LastSeenBy(Myself))  // Greater Doom
END

