
IF
	GlobalGT("YagaShuraHeart","GLOBAL",0)
	Global("Iapcastts","GLOBAL",0)
	HasItem("invulner",Myself)  // Ring
THEN
	RESPONSE #100
		DestroyItem("invulner")  // Ring
		Continue()
END

IF
	NumberOfTimesTalkedTo(0)
	Global("Iapcastts","GLOBAL",0)
	See([PC])
THEN
	RESPONSE #100
		StartDialogueNoSet([PC])
END

IF
	Global("YagaShuraSpawn","AR5203",1)  // Yaga-Shura's Camp
	Global("Iacreature","AR5203",2)  // Yaga-Shura's Camp
	Global("Iapcastts","GLOBAL",0)
	HasItem("sureHP1",Myself)  // Ring
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
		DestroyItem("sureHP1")  // Ring
		SetInterrupt(TRUE)
END

IF
	GlobalGT("YagaShuraHeart","GLOBAL",0)
	GlobalLT("YagaShuraHeart","GLOBAL",3)
	HPPercentLT(Myself,100)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		StartDialogueNoSet(Player1)
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Iayaga01","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iayaga01","LOCALS",1)
END

IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	GlobalGT("YagaShuraSpawn","AR5203",0)  // Yaga-Shura's Camp
	GlobalLT("Iacreature","AR5203",2)  // Yaga-Shura's Camp
	HasItem("sureHP1",Myself)  // Ring
	HPPercentLT(Myself,75)
THEN
	RESPONSE #100
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	Detect([PC])
	Global("Iaitem","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iaitem","LOCALS",1)
		GiveItemCreate("s!misc67",Myself,0,0,0)  // Blood of a Greater Bhaalspawn
		Continue()
END


IF
	Allegiance(Myself,ENEMY)
    !GlobalTimerNotExpired("IaAction","LOCALS")
    !GlobalTimerNotExpired("IaFissureTimer","LOCALS")
	See(Player1) 
	TriggerOverride(Player1, Range(NearestAllyOf(Myself), 10))
	CheckStatLT(Player1,70,RESISTFIRE)
	CheckStatLT(NearestAllyOf(Myself),100,RESISTFIRE)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaFissureTimer","LOCALS",15)
		ForceSpellRES("S!FISSUR", Player1)
	RESPONSE #100
	    Continue()
END
