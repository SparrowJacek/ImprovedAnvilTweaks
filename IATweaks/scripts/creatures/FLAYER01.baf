IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Allegiance(Myself,ENEMY)
	See(FifthNearestAllyOf(Myself))
	TriggerOverride(FifthNearestAllyOf(Myself),Race(Myself,MIND_FLAYER))
THEN
	RESPONSE #100
		IncrementGlobal("IaMindAlliesNearby","LOCALS",1)
		Continue()
END

IF
	GlobalLT("IaMind01","LOCALS",5)
	GlobalGT("IaMindAlliesNearby","LOCALS",1)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOfType([PC]))
	!CheckStatGT(LastSeenBy(Myself),25,MAGICDAMAGERESISTANCE)
THEN
	RESPONSE #100
		IncrementGlobal("IaMind01","LOCALS",3)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		ForceSpellRES("S!MFBLST",LastSeenBy(Myself))  // Focused Mind Blast
END

