IF
	!GlobalTimerNotExpired("IaSwapPlaces","LOCALS")
	Range(SecondNearestEnemyOf(Myself),4)
	!Dead("GAROCK")
	!Range("GAROCK",4)
	!TriggerOverride("GAROCK",Range(SecondNearestEnemyOf(Myself),5))
	TriggerOverride("GAROCK",Global("IaWhrwnd","LOCALS",1))
	See("GAROCK")
THEN
	RESPONSE #100
		SetGlobalTimer("IaSwapPlaces","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("S!SWAPMI",LastSeenBy(Myself))
	RESPONSE #50
	    Continue()
END

