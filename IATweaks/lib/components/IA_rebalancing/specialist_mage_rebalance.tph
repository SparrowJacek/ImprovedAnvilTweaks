// update class description for Specialist Mages
COPY_EXISTING ~clastext.2da~ ~override/clastext.2da~
  COUNT_2DA_COLS ~colcount~
  SET description_col = $clastext_cols("DESCSTR")
  SET_2DA_ENTRY_LATER ~s!specialist_mage_desc~ $clastext_rows("ABJURER") description_col RESOLVE_STR_REF (@5073)
  SET_2DA_ENTRY_LATER ~s!specialist_mage_desc~ $clastext_rows("CONJURER") description_col RESOLVE_STR_REF (@5074)
  SET_2DA_ENTRY_LATER ~s!specialist_mage_desc~ $clastext_rows("DIVINER") description_col RESOLVE_STR_REF (@5075)
  SET_2DA_ENTRY_LATER ~s!specialist_mage_desc~ $clastext_rows("ENCHANTER") description_col RESOLVE_STR_REF (@5076)
  SET_2DA_ENTRY_LATER ~s!specialist_mage_desc~ $clastext_rows("ILLUSIONIST") description_col RESOLVE_STR_REF (@5072)
  SET_2DA_ENTRY_LATER ~s!specialist_mage_desc~ $clastext_rows("INVOKER") description_col RESOLVE_STR_REF (@5077)
  SET_2DA_ENTRY_LATER ~s!specialist_mage_desc~ $clastext_rows("TRANSMUTER") description_col RESOLVE_STR_REF (@5078)
  SET_2DA_ENTRIES_NOW ~s!specialist_mage_desc~ ~colcount~
  PRETTY_PRINT_2DA

