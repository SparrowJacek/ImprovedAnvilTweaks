THEN
	RESPONSE #100
		SetGlobal("Iahlcler04","LOCALS",2)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SpellNoDec(LastSeenBy(Myself),CLERIC_IMPLOSION)  // SPPR728.SPL (Implosion)
END

