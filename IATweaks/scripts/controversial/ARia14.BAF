		CreateVisualEffect("SPRAISED",[1312.1443])
		CreateVisualEffect("SPRAISED",[1390.1389])
		CreateVisualEffect("SPRAISED",[1468.1334])
		Wait(3)
		CreateCreature("S!SKELLD",[1127.1513],SE)  // Skeleton Lord
		CreateCreature("S!SKELLD",[1204.1480],SE)  // Skeleton Lord
		CreateCreature("S!SHADO3",[1252.1404],SE)  // Deep Shadow
		CreateCreature("S!SHADO3",[1408.1295],SE)  // Deep Shadow
		CreateCreature("S!SKELLD",[1516.1261],SE)  // Skeleton Lord
