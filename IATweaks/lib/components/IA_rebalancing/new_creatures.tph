PRINT @5091

SILENT

  /////////////////////// Paraelementals //////////////////////////////

// Ice Elemental
COPY ~IATweaks\resources\cre\s!iceel1.cre~ ~override~
  SAY NAME1 @5040
  SAY NAME2 @5040
  WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~ANVIL_ICE_ELEMENTAL~))

COPY ~IATweaks\resources\itm\s!iceele.itm~ ~override~

COMPILE ~IATweaks\scripts\creatures\S!ICEELE.BAF~

// Magma Elemental
COPY ~IATweaks\resources\cre\s!magel1.cre~ ~override~
  SAY NAME1 @5041
  SAY NAME2 @5041
  WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~ANVIL_MAGMA_ELEMENTAL~))

COPY ~IATweaks\resources\itm\s!magele.itm~ ~override~

COMPILE ~IATweaks\scripts\creatures\S!MAGELE.BAF~

// Ooze Elemental
COPY ~IATweaks\resources\cre\s!oozel1.cre~ ~override~
  SAY NAME1 @5042
  SAY NAME2 @5042
  WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~ANVIL_OOZE_ELEMENTAL~))

COPY ~IATweaks\resources\itm\s!oozele.itm~ ~override~

COMPILE ~IATweaks\scripts\creatures\S!OOZELE.BAF~

// Smoke Elemental
COPY ~IATweaks\resources\cre\s!smoel1.cre~ ~override~
  SAY NAME1 @5043
  SAY NAME2 @5043
  WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~ANVIL_SMOKE_ELEMENTAL~))

COPY ~IATweaks\resources\itm\s!smoele.itm~ ~override~

COMPILE ~IATweaks\scripts\creatures\S!SMOELE.BAF~

// Truly Horrid Umber Hulk
COPY ~IATweaks\resources\cre\s!umbth1.cre~ ~override~
  SAY NAME1 @5069
  SAY NAME2 @5069
  WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~ANVIL_UMBER_HULK_HORRID~))

COPY ~IATweaks\resources\itm\s!umbth1.itm~ ~override~
COPY ~IATweaks\resources\itm\s!umbth2.itm~ ~override~

COMPILE ~IATweaks\scripts\creatures\S!UMBTH1.BAF~

// Charge ability

ADD_PROJECTILE ~IATweaks\resources\pro\s!charge.pro~

COPY ~IATweaks\resources\spl\s!charg1.spl~ ~override~
  LPF ~ALTER_SPELL_HEADER~ 
    INT_VAR 
      projectile = ~%s!invbas%~
  END
COPY ~IATweaks\resources\spl\s!charg2.spl~ ~override~
  LPF ~ALTER_SPELL_HEADER~ 
    INT_VAR 
      projectile = ~%s!charge%~
  END
COPY ~IATweaks\resources\spl\s!charg3.spl~ ~override~
COPY ~IATweaks\resources\spl\s!charg4.spl~ ~override~
  SAY NAME1 @6210
COPY ~IATweaks\resources\spl\s!charg5.spl~ ~override~
COPY ~IATweaks\resources\spl\s!charg6.spl~ ~override~

// Red Abishai
COPY ~IATweaks\resources\itm\s!abishr.itm~ ~override~
COPY ~IATweaks\resources\cre\s!abishr.cre~ ~override~
  SAY NAME1 @5122
  SAY NAME2 @5122

  REMOVE_MEMORIZED_SPELLS

  ADD_MEMORIZED_SPELL "SPWI303" #2 "wizard" ( 2 ) // Flame Arrow
  ADD_MEMORIZED_SPELL "SPWI304" #2 "wizard" ( 2 ) // Fireball

COMPILE ~IATweaks\scripts\creatures\S!ABISHR.BAF~

// Corrupted Tree of Life Branch

COPY ~IATweaks\resources\itm\s!dendr1.itm~ ~override~
COPY ~IATweaks\resources\itm\s!dendr2.itm~ ~override~
COPY ~IATweaks\resources\cre\s!dendr1.cre~ ~override~
  SAY NAME1 @5138
  SAY NAME2 @5138

COMPILE ~IATweaks\scripts\creatures\S!DENDR1.BAF~
