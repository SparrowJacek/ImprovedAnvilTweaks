IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Detect([PC])
	Global("Iatimer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobal("Iatimer","LOCALS",1)
		SetGlobal("Iawhirlwind","LOCALS",0)
END

IF
	GlobalGT("Iawhirlwind","LOCALS",0)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("Iawhirlwind","LOCALS",0)
		Continue()
END
IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Range(Player1, 7)
	OR(2)
	    CheckStatLT(Player1,100,RESISTELECTRICITY)
	    CheckStatLT(Player1,100,RESISTSLASHING)
THEN
	RESPONSE #100
		IncrementGlobal("Iawhirlwind","LOCALS",1)
		Continue()
END

