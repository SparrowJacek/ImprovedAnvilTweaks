// Rework Deathblow and Greater Deathblow

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~SLASHING_RES<100~
    stat                  = ~21~
    value                 = ~100~
    relation              = ~2~
  RET
    slashing_less_than_100 = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~CRUSHING_RES<100~
    stat                  = ~22~
    value                 = ~100~
    relation              = ~2~
  RET
    crushing_less_than_100 = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~PIERCING_RES<100~
    stat                  = ~23~
    value                 = ~100~
    relation              = ~2~
  RET
    piercing_less_than_100 = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~MISSILE_RES>=100~
    stat                  = ~24~
    value                 = ~100~
    relation              = ~4~
  RET
    missile_equal_or_greater_than_100 = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~SLASHING_OR_CRUSHING<100~
    stat                  = ~0x103~
    value                 = EVAL ~%slashing_less_than_100%~
    relation              = EVAL ~%crushing_less_than_100%~
  RET
    slashing_or_crushing_less_than_100 = new_line_number
END

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~SLASHING_AND_CRUSHING_AND_PIERCING>=100~
    stat                  = ~0x104~
    value                 = EVAL ~%piercing_less_than_100%~
    relation              = EVAL ~%slashing_or_crushing_less_than_100%~
  RET
    slashing_and_crushing_and_piercing_equal_or_greater_than_100 = new_line_number
END

