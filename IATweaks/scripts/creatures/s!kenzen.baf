	HaveSpell(WIZARD_RUBY_RAY_OF_REVERSAL)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
    !GlobalTimerNotExpired("IaProtRemovalWait","LOCALS")
	See(Player1)
	OR(2)
        Dead("hlsion")
        !TriggerOverride("hlsion", Global("IaRRRPlayer1","LOCALS",1))
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!CheckSpellState(LastSeenBy(Myself),SI_TRANSMUTATION)
	OR(3)
	    CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	    CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	    CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE7)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
	    SetGlobal("IaRRRPlayer1","LOCALS",1)
		SetGlobalTimer("IaRRRPlayer1Delay","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaProtRemovalWait","LOCALS",1)
