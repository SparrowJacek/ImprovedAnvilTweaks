///////////////////////// Mind Flayers ///////////////////////////////

// Add spell which has a chance to grant protection from opcode 12 when hit

COPY ~IATweaks\resources\spl\s!mfprot.spl~ ~override~

ACTION_FOR_EACH spellstate_for_damage_reduction IN 1 2 3 4 BEGIN
  LAF ~S!ADD_7EYES_ROW~
    INT_VAR
      strref        = RESOLVE_STR_REF (@5049)
    STR_VAR
      row_desc      = EVAL ~DMG_PROT_%spellstate_for_damage_reduction%~
      spellstate    = EVAL ~%spellstate_for_damage_reduction%~
      eff1          = ~12~ // Damage
    RET new_row_id 
  END
  COPY_EXISTING ~s!mfprot.spl~ ~override~
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_parameter1 = spellstate_for_damage_reduction
        parameter2 = new_row_id
    END
END

COPY_EXISTING ~MINDFLAY.itm~ ~override~
  // Lower int drain to 3
  LPF ~S!ALTER_EFFECT~
    INT_VAR
      match_opcode = 19
      parameter1 = ~-3~
  END
  // Cast S!MFPROT each time the creature is hit
  LPF ~ADD_ITEM_EQEFFECT~
    INT_VAR
      opcode = 232
      target = 1
      parameter1 = 0
      parameter2 = 0
      timing = 9
      resist_dispel = 0
    STR_VAR
      resource = ~S!MFPROT~
  END
  // Grant +5 saving throws against Enchantment spells
  LPF ~ADD_ITEM_EQEFFECT~
    INT_VAR
      opcode = 346
      target = 1
      parameter1 = 5
      parameter2 = 0
      timing = 9
      resist_dispel = 0
      special = 4
  END

// Mind Flayer Focused Mind Blast

COPY_EXISTING ~BIGNAREA.pro~ ~override/S!MFAREA.pro~
  WRITE_SHORT 0x200 192 // Affect only allies

ADD_PROJECTILE ~override/S!MFAREA.pro~
COPY ~IATweaks\resources\spl\s!mfblst.spl~ ~override~
  SAY NAME1 @6158
  LPF ~ALTER_SPELL_HEADER~ 
    INT_VAR 
      projectile = ~S!MFAREA~
  END
  PATCH_FOR_EACH header_num IN 1 2 3 BEGIN
    SET min_level = (header_num + 3) * 5
    LPF ~S!CLONE_SPELL_HEADER~
      INT_VAR
        level_req = min_level
    END
    LPF ~S!ALTER_EFFECT~
      INT_VAR
        header = header_num
        match_opcode = 148
        parameter1 = min_level
    END
  END

COPY_EXISTING ~s!mindbl.pro~ ~override/s!mfblst.pro~
  WRITE_SHORT 0x200 64 // Affect only enemies

ADD_PROJECTILE ~override/s!mfblst.pro~
COPY ~IATweaks\resources\spl\s!mfbls1.spl~ ~override~
  LPF ~ALTER_SPELL_HEADER~ 
    INT_VAR 
      projectile = ~s!mfblst~
  END
  PATCH_FOR_EACH header_num IN 1 2 3 BEGIN
    SET min_level = (header_num + 3) * 5
    SET dice_thrown = (header_num * 2) + 6
    LPF ~S!CLONE_SPELL_HEADER~
      INT_VAR
        level_req = min_level
    END
    LPF ~S!ALTER_EFFECT~
      INT_VAR
        header = header_num
        match_opcode = 12
        dicenumber = dice_thrown
    END
  END

COPY ~IATweaks\resources\spl\s!mfbls2.spl~ ~override~
  SAY NAME1 @6160
  LPF ~ALTER_SPELL_HEADER~ 
    INT_VAR 
      projectile = ~s!mfblst~
  END
  PATCH_FOR_EACH header_num IN 1 2 3 BEGIN
    SET min_level = (header_num + 3) * 5
    SET dice_thrown = header_num + 3
    LPF ~S!CLONE_SPELL_HEADER~
      INT_VAR
        level_req = min_level
    END
    LPF ~S!ALTER_EFFECT~
      INT_VAR
        header = header_num
        match_opcode = 12
        dicenumber = dice_thrown
    END
  END

