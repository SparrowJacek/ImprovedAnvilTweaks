IF
	HaveSpell(CLERIC_GREATER_COMMAND)
	Allegiance(Myself,ENEMY)
	!StateCheck(Myself,STATE_SILENCED)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("Iagcommand","LOCALS")
	!StateCheck([PC],STATE_INVISIBLE)
	!StateCheck([PC],STATE_STUNNED)
	!StateCheck([PC],STATE_HELPLESS)
	!StateCheck([PC],STATE_CONFUSED)
	!StateCheck([PC],STATE_PANIC)
	CheckStatLT([PC],30,RESISTMAGIC)
	!CheckStat([PC],2,SCRIPTINGSTATE3)
	!CheckStat([PC],1,SCRIPTINGSTATE4)
	CheckStat([PC],0,SCRIPTINGSTATE8)
	!CheckSpellState([PC],SI_ENCHANTMENT)
	!Race([PC],ELF)
	!Race([PC],HALF_ELF)
    CheckStatGT([PC],5,SAVEVSSPELL)
	OR(2)
	    CheckStatGT([PC],9,SAVEVSSPELL)
	    !StateCheck([PC],STATE_IMPROVEDINVISIBILITY)
	TriggerOverride([PC],Range([PC],15))
	TriggerOverride([PC],StateCheck([PC],STATE_STUNNED))
	TriggerOverride([PC],StateCheck([PC],STATE_HELPLESS))
	TriggerOverride([PC],CheckStatLT([PC],60,RESISTMAGIC))
	!TriggerOverride([PC],CheckStat([PC],2,SCRIPTINGSTATE3))
	!TriggerOverride([PC],CheckStat([PC],1,SCRIPTINGSTATE4))
	TriggerOverride([PC],CheckStatLT([PC],0,SCRIPTINGSTATE8))
	!TriggerOverride([PC],CheckSpellState([PC],SI_ENCHANTMENT))
	!TriggerOverride([PC],Race([PC],ELF))
	!TriggerOverride([PC],Race([PC],HALF_ELF))
	!TriggerOverride([PC],CheckStatGT([PC],5,SAVEVSSPELL))
	See([PC])
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("Iagcommand","LOCALS",THREE_ROUNDS)
		SetGlobalTimer("IaFiveSeconds","LOCALS",ONE_MINUTE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),CLERIC_GREATER_COMMAND)  // SPPR512.SPL (Greater Command)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #50
	    Continue()
END

