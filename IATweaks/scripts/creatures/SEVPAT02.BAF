END

IF
	Global("Iachainsequencer","LOCALS",0)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("Iaspell","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	See([PC])
	TriggerOverride([PC], Range(SecondNearest([PC]), 15))
	CheckStatLT([PC],50,RESISTFIRE)
	CheckStatLT([PC],50,RESISTMAGIC)
	CheckStatLT(SecondNearest([PC]),50,RESISTFIRE)
	CheckStatLT(SecondNearest([PC]),50,RESISTMAGIC)
	!StateCheck([PC],STATE_NOT_TARGETABLE)
	!StateCheck(SecondNearest([PC]),STATE_NOT_TARGETABLE)
	!CheckStatGT([PC],0,MINORGLOBE)
	!CheckStatGT(SecondNearest([PC]),0,MINORGLOBE)
	!CheckSpellState([PC],WIZARD_SPELL_TURNING)
	!CheckSpellState(SecondNearest([PC]),WIZARD_SPELL_TURNING)
	!CheckSpellState([PC],SI_CONJURATION)
	!CheckSpellState(SecondNearest([PC]),SI_CONJURATION)
THEN
	RESPONSE #250
		IncrementGlobal("Iachainsequencer[PC]","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDecRES("SPWIJ01D", [PC])
	RESPONSE #50
	    Continue()
END

