// Add immunity to this spell to some items and creatures

COPY_EXISTING_REGEXP GLOB ~.*\.itm~ ~override~
  PATCH_FOR_EACH deathblow_spell IN ~S!DBLOW1~ ~S!DBLOW2~ ~S!DBLOW3~ ~S!DBLOW4~ BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        silent = 1
        multi_match = 1
        match_opcode = 208
        opcode = 206
        parameter1 = 0
        parameter2 = 0
      STR_VAR
        resource = EVAL ~%deathblow_spell%~
    END
  END

  BUT_ONLY

ACTION_FOR_EACH protective_spell IN ~spcl917~ ~spcl941~ BEGIN
  COPY_EXISTING ~%protective_spell%.spl~ ~override~
    PATCH_FOR_EACH deathblow_spell IN ~S!DBLOW1~ ~S!DBLOW2~ ~S!DBLOW3~ ~S!DBLOW4~ BEGIN
      LPF ~CLONE_EFFECT~
        INT_VAR
          silent = 1
          multi_match = 1
          match_opcode = 208
          opcode = 206
          parameter1 = 0
          parameter2 = 0
        STR_VAR
          resource = EVAL ~%deathblow_spell%~
      END
    END
END

