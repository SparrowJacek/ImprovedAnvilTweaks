
IF
	OR(2)
		Allegiance(Myself,ENEMY)
		Global("Iareaction","AR3018",1)  // Watcher's Keep -- Saladrex (Dragon)
	Global("Iaexit","AR3018",0)  // Watcher's Keep -- Saladrex (Dragon)
THEN
	RESPONSE #100
		SetGlobal("Iaexit","AR3018",1)  // Watcher's Keep -- Saladrex (Dragon)
END

IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	!Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	InMyArea(Player1)
	Global("Iapccloud","AR3018",1)  // Watcher's Keep -- Saladrex (Dragon)
THEN
	RESPONSE #100
		Enemy()
		SetGlobal("Iapccloud","AR3018",0)  // Watcher's Keep -- Saladrex (Dragon)
		ForceSpell(Myself,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
		MoveToObject(Player1)
END

IF
	!Allegiance(Myself,ENEMY)
	InMyArea(Player1)
THEN
	RESPONSE #100
		Enemy()
		MoveToObject(Player1)
END

IF
	!Allegiance(Myself,ENEMY)
	See([GOODCUTOFF])
	!InParty(LastSeenBy(Myself))
THEN
	RESPONSE #100
		Enemy()
END

IF
	!Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	Global("Iareaction","AR3018",1)  // Watcher's Keep -- Saladrex (Dragon)
THEN
	RESPONSE #100
