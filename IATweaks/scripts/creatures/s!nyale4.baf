	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
    CheckStatLT(SecondNearestEnemyOf(Myself),100,RESISTPIERCING)
	!CheckSpellState(SecondNearestEnemyOf(Myself),WIZARD_SPELL_TURNING)
	!CheckStat(SecondNearestEnemyOf(Myself),4,SCRIPTINGSTATE7)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ForceSpell(SecondNearestEnemyOf(Myself),CLERIC_BOLT_OF_GLORY)
	RESPONSE #200
	    Continue()
END

