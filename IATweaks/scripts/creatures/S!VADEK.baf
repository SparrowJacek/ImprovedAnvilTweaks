IF
	!Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	!HPLT(Myself,1)
	OR(6)
		AttackedBy([GOODCUTOFF],DEFAULT)
		AttackedBy([PC],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		Allegiance("pirmur01",ENEMY)  // Galvena
		HPPercentLT("pirmur01",100)  // Galvena
		HPPercentLT(Myself,100)
THEN
	RESPONSE #100
		Enemy()
		MoveToObject(Player1)
END

IF
	Global("Iavadek01","LOCALS",0)
	Allegiance(Myself,ENEMY)
	HasItem("POTN34",Myself)
THEN
	RESPONSE #100
		ReallyForceSpellRES("PTN34X",Myself)
		DestroyItem("POTN34")
		Continue()
END

IF
	Global("Iavadek01","LOCALS",0)
	Allegiance(Myself,ENEMY)
	HasItem("POTN33",Myself)  // Barbarian Essence
THEN
	RESPONSE #100
		ReallyForceSpellRES("PTN33X",Myself)  // No such index
		DestroyItem("POTN33")  // Barbarian Essence
		Continue()
END

IF
	Global("Iavadek01","LOCALS",0)
	Allegiance(Myself,ENEMY)
	HasItem("POTN33",Myself)  // Barbarian Essence
THEN
	RESPONSE #100
		ReallyForceSpellRES("PTN33X",Myself)  // No such index
		DestroyItem("POTN33")  // Barbarian Essence
		Continue()
END

IF
	Global("Iavadek01","LOCALS",0)
	Allegiance(Myself,ENEMY)
	Exists("pirmur01")
	!Dead("pirmur01")
THEN
	RESPONSE #100
		ReallyForceSpell("pirmur01",WIZARD_IMPROVED_HASTE)
		ReallyForceSpell("pirmur01",WIZARD_PROTECTION_FROM_ENERGY)  // SPWI803.SPL (Protection From Energy)
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("Iavadek01","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iavadek01","LOCALS",1)
		SetGlobalTimer("Iatpt","LOCALS",66)
		ReallyForceSpell(Myself,WIZARD_MELF_METEOR)  // SPWI325.SPL (Melf's Minute Meteors)
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Fire Shield (Red))
		ReallyForceSpellRES("SPWI522",Myself)  // Soul Armor
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_ABJURATION)  // SPWI590.SPL (Immunity: Abjuration)
		ReallyForceSpell(Myself,WIZARD_GLOBE_OF_INVULNERABILITY)  // SPWI602.SPL (Globe of Invulnerability)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_ENERGY)  // SPWI606.SPL (Protection From Magic Energy)
		ReallyForceSpell(Myself,WIZARD_SPELL_TURNING)  // SPWI701.SPL (Spell Turning)
		ReallyForceSpellRES("SPWI725",Myself)  // Shield Mind and Body
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_ENERGY)  // SPWI803.SPL (Protection From Energy)
		ReallyForceSpellRES("SPWI804",Myself)  // Tenser's Partial Transformation
END

