IF
	Clicked([ANYONE])
	Global("toggle","AR1513",1)  // Bodhi's Hunt Level 2
	Global("page","AR1513",11)  // Bodhi's Hunt Level 2
	Global("Iarested","AR1513",0)  // Bodhi's Hunt Level 2
THEN
	RESPONSE #100
		DisplayString(Myself,50658)  // The enchanted book creates several magical items for you.
		IncrementGlobal("page","AR1513",1)  // Bodhi's Hunt Level 2
		GiveItemCreate("S!misc01",LastTrigger,0,0,0)  // Scroll of Memory Boosting
		GiveItemCreate("S!scrl07",LastTrigger,0,0,0)  // Giant Strength
		GiveItemCreate("scrla7",LastTrigger,0,0,0)  // Remove Magic
		GiveItemCreate("shld31",LastTrigger,0,0,0)  // Darksteel Shield +4
		GiveItemCreate("scrl8g",LastTrigger,0,0,0)  // Ruby Ray of Reversal
		GiveItemCreate("potn43",LastTrigger,0,0,0)  // Potion of Vitality
		GiveItemCreate("potn33",LastTrigger,0,0,0)  // Barbarian Essence
		AddXPObject(Player1,8000)
		AddXPObject(Player2,8000)
		AddXPObject(Player3,8000)
		AddXPObject(Player4,8000)
		AddXPObject(Player5,8000)
		AddXPObject(Player6,8000)
END

