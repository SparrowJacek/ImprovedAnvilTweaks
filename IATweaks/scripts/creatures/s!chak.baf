	    !GlobalTimerNotExpired("IaAction","LOCALS")
	See([PC.0.0.MAGE_ALL])
	!StateCheck(LastSeenBy(Myself),STATE_POISONED)
    CheckStatGT([PC.0.0.MAGE_ALL],5,SAVEVSDEATH)
	OR(2)
	    CheckStatGT([PC.0.0.MAGE_ALL],9,SAVEVSDEATH)
	    !StateCheck([PC.0.0.MAGE_ALL],STATE_IMPROVEDINVISIBILITY)
	!CheckSpellState([PC.0.0.MAGE_ALL],POISON_EFFECT_IMMUNITY)
