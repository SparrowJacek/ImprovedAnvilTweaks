// Sorcerous Amon
COPY_EXISTING ~SEVPAT02.cre~ ~override~
  WRITE_SHORT 0x24 47 // HP
  WRITE_SHORT 0x26 47 // HP
  WRITE_SHORT 0x46 10 // AC
  WRITE_SHORT 0x48 10 // AC
  WRITE_BYTE 0x60 0 // Resist Slashing
  WRITE_BYTE 0x61 0 // Resist Crushing
  WRITE_BYTE 0x62 0 // Resist Piercing
  WRITE_BYTE 0x63 0 // Resist Missile
  WRITE_LONG 0x244 0x08000000 // Kit = Invoker

  FOR (i = 0; i <= 1; ++i) BEGIN
    PATCH_FOR_EACH element_id IN 1 2 3 4 BEGIN
      LPF ~ADD_CRE_EFFECT~ // Bonus elemental damage
        INT_VAR
          opcode = 332
          target = 1
          parameter1 = 5
          parameter2 = element_id
          resist_dispel = 0
          timing = 9
        STR_VAR
          effsource = ~S!+5ELED~
      END
    END
  END

  LPF ~ADD_CRE_EFFECT~ // Sequencer with Flame Arrow
    INT_VAR
      opcode = 256
      target = 1
      resist_dispel = 0
      timing = 9
      parameter3 = 0
    STR_VAR
      effsource = ~SPWIJ01~
      resource = ~SPWI303~
  END

  LPF ~DELETE_CRE_ITEM~
    STR_VAR
      item_to_delete = ~S!IMMUNE~
  END

  ADD_CRE_ITEM ~POTN33~ #0 #0 #0 ~UNSTEALABLE&UNDROPPABLE~ ~INV14~

