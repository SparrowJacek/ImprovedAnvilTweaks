	OR(4)
		HaveSpell(WIZARD_DRAGONS_BREATH)
		HaveSpell(WIZARD_COMET)
		HaveSpell(WIZARD_SUN_FIRE)
		HaveSpell(WIZARD_FLAME_ARROW)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaRemoveMagicWait","LOCALS")
	Allegiance(Myself,ENEMY)
	See([PC])
	CheckSpellState(LastSeenBy(Myself),DISPELLABLE_INCREASED_FIRE_RESISTANCE)
	OR(2)
		CheckSpellState(LastSeenBy(Myself),DISPELLABLE_INCREASED_MAGIC_RESISTANCE)
		CheckStatGT([PC],10,DISPELLABLEBUFFSPOWER)
	TriggerOverride([PC], Range([PC], 15))
	TriggerOverride([PC], CheckStatGT([PC],3,DISPELLABLEBUFFSPOWER))
	!TriggerOverride([PC], CheckStat([PC],1,SCRIPTINGSTATE7))
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!StateCheck(LastSeenBy(Myself),STATE_CONFUSED)
	!StateCheck(LastSeenBy(Myself),STATE_PANIC)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaRemoveMagicWait","LOCALS",12)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),WIZARD_REMOVE_MAGIC)  // SPWI302.SPL (Remove Magic)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #25
	    Continue()
END
