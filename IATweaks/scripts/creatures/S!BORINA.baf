IF
	InMyArea(Player1)
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
END

IF
	Allegiance(Myself,ENEMY)
	Global("Iaexit","AR0417",0)  // Living Room
THEN
	RESPONSE #100
		SetGlobal("Iaexit","AR0417",1)  // Living Room
		CreateCreatureObjectDoor("S!amber4",Player1,0,0,0)  // Amber Golem
		ApplySpellRES("S!TALBLS",Myself)  // No such index	
END

IF
	Allegiance(Myself,ENEMY)
	See([PC])
	GlobalLT("Iacreature","LOCALS",3)
	!GlobalTimerNotExpired("Iasummon","LOCALS")
	!HPLT(Myself,1)
THEN
	RESPONSE #100
		IncrementGlobal("Iacreature","LOCALS",1)
		SetGlobalTimer("Iasummon","LOCALS",FOUR_ROUNDS)
		CreateCreatureObject("tanthf01",Myself,0,0,0)  // Rune Assassin
		CreateCreatureObject("tanthf01",LastSeenBy(Myself),0,0,0)  // Rune Assassin
END

IF
	!Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	OR(3)
		AttackedBy([GOODCUTOFF],DEFAULT)
		SpellCastOnMe([GOODCUTOFF],0)
		HPPercentLT(Myself,100)
THEN
	RESPONSE #100
		Enemy()
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([GOODCUTOFF])
		Detect([PC])
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iainnate","LOCALS")
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobalTimer("Iainnate","LOCALS",ONE_ROUND)
END

IF
	!CheckSpellState(Myself,HIDE_IN_SHADOWS_SUCCESS)
	!CheckSpellState(Myself,HIDE_IN_SHADOWS_FAIL)
	!StateCheck(Myself,STATE_INVISIBLE)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	See(NearestEnemyOf(Myself))
	OR(2)
		ObjectActionListEmpty(Myself)
		Global("s!interruptibleaction","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("s!interruptibleaction","LOCALS",0)
		ActionOverride(Myself,ForceSpellRES("S!HISBAS",Myself))  // No such index
END

IF
	ObjectActionListEmpty(Myself)
	Global("s!interruptibleaction","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("s!interruptibleaction","LOCALS",0)
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("Iaborina01","LOCALS",0)
	!GlobalTimerNotExpired("Iainnate","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("Iaborina01","LOCALS",1)
		SetGlobalTimer("Iainnate","LOCALS",ONE_ROUND)
		ForceSpell(Myself,ROGUE_GREATER_EVASION)  // SPCL914.SPL (Greater Evasion)
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	GlobalLT("Iaborina06","LOCALS",4)
	CheckStatLT(Myself,70,RESISTSLASHING)
	!GlobalTimerNotExpired("Iainnate","LOCALS")
THEN
	RESPONSE #100
		IncrementGlobal("Iaborina06","LOCALS",1)
		SetGlobalTimer("Iainnate","LOCALS",ONE_ROUND)
		ForceSpell(Myself,WARRIOR_HARDINESS)  // SPCL907.SPL (Hardiness)
END

IF
	HPPercentLT(Myself,50)
	!GlobalTimerNotExpired("Iainnate","LOCALS")
	HasItem("POTN55",Myself)  // Potion of Superior Healing
THEN
	RESPONSE #100
		SetGlobalTimer("Iainnate","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46150)  // *quaffs a potion*
		UseItem("POTN55",Myself)  // Potion of Superior Healing
END

IF
	Allegiance(Myself,ENEMY)
	AreaCheck("AR0417")  // Living Room
	Detect([PC])
	Global("Iatreasure","LOCALS",0)
	Global("Iaring35place","GLOBAL",2)
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Iaring35place","GLOBAL",5)
		SetGlobal("Iatreasure","LOCALS",1)
		GiveItemCreate("ring35",Myself,0,0,0)  // Ring of Lock Picks
END

