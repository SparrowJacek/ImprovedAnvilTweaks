IF
	!GlobalTimerNotExpired("IaNextCharge","LOCALS")
	!GlobalTimerNotExpired("IaRunToCharge","LOCALS")
	See(FarthestEnemyOf(Myself))
	Range(LastSeenBy(Myself),10)
	!Range(LastSeenBy(Myself),7)
	!Range(ThirdNearest([ANYONE]),4)
THEN
	RESPONSE #100
		SetGlobalTimer("IaRunToCharge","LOCALS",10)
	    RunAwayFromNoInterrupt(LastSeenBy(Myself),20)
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("IaBreakCharge","LOCALS")
	ActionListEmpty()
	See([PC])
    CheckStatLT([PC],75,RESISTSLASHING)
	!CheckStatGT([PC],2,SCRIPTINGSTATE6)
	!CheckStatGT([PC],0,STONESKINS)
	!StateCheck([PC],STATE_MIRRORIMAGE)
	Range([PC],3)
THEN
	RESPONSE #100
		ReallyForceSpellRES("S!CHARG6",Myself)
		AttackOneRound([PC])
	RESPONSE #100
	    Continue()
END

