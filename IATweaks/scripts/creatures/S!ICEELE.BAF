IF
	See(NearestEnemyOf(Myself))
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
END

IF
	See(NearestEnemyOf(Myself))
	Global("Interruptible","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Interruptible","LOCALS",1)
		SetInterrupt(FALSE)
		Continue()
END

IF
	Detect([PC])
	Global("Iatimer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobal("Iatimer","LOCALS",1)
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	See([PC])
	OR(2)
		CheckStatLT([PC],50,RESISTCOLD)
		CheckStatLT([PC],50,RESISTPIERCING)
	OR(2)
		CheckStatLT(SecondNearest([PC]),75,RESISTCOLD)
		CheckStatLT(SecondNearest([PC]),75,RESISTPIERCING)
	Range(SecondNearest([PC]),18)
	Range([PC],18)
	!Range(SecondNearest([PC]),15)
	TriggerOverride([PC],Range(SecondNearest([PC]),11))
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",THREE_ROUNDS)
		ForceSpellRES("S!SPIKE", [PC])
END

