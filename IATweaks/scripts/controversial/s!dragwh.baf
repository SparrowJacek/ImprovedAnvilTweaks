IF
    HaveSpell(WIZARD_DEATH_SPELL)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
    !GlobalTimerNotExpired("IaDeathSpellWait","LOCALS")
	See(NearestEnemyOfType([GOODCUTOFF.0.0.0.0.SUMMONED]))
	OR(3)
		CheckStat(LastSeenBy(Myself),20,RESISTSLASHING)
		CheckStat(LastSeenBy(Myself),95,RESISTPIERCING)
		CheckStat(LastSeenBy(Myself),89,RESISTMAGIC)
	TriggerOverride(LastSeenBy(Myself), Range([GOODCUTOFF.0.0.0.0.SUMMONED], 15))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		SetGlobalTimer("IaDeathSpellWait","LOCALS",1)
		RemoveSpell(WIZARD_DEATH_SPELL)
		ForceSpell(LastSeenBy(Myself),WIZARD_DEATH_SPELL)  // SPWI605.SPL (Death Spell)
