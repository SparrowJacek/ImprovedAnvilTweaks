	!GlobalTimerNotExpired("Iaspell","LOCALS")
	See(FourthNearest([PC]))
	OR(2)
		CheckStatLT(FourthNearest([PC]),50,RESISTCOLD)
		CheckStatLT(FourthNearest([PC]),50,RESISTPIERCING)
	OR(2)
		CheckStatLT(FifthNearest([PC]),75,RESISTCOLD)
		CheckStatLT(FifthNearest([PC]),75,RESISTPIERCING)
	Range(FifthNearest([PC]),18)
	Range(FourthNearest([PC]),3)
	TriggerOverride(FourthNearest([PC]),Range(FifthNearest([PC]),2))
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",THREE_ROUNDS)
		ForceSpellRES("S!SPIKE", FourthNearest([PC]))
END

