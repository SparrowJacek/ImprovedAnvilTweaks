IF
	HaveSpellRES("SPCL423")
	!GlobalTimerNotExpired("PoisonWeapon","LOCALS")
	!GlobalTimerNotExpired("DrankPotionTimer","LOCALS")
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	See(NearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),5)
	CheckStatLT(LastSeenBy(Myself),100,RESISTPOISON)
	!CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE6)
THEN
	RESPONSE #100
		SetGlobalTimer("PoisonWeapon","LOCALS",THREE_ROUNDS)
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		ForceSpellRES("SPCL423",Myself)  // Poison Weapon
		RemoveSpellRES("SPCL423")
END

IF
	Allegiance(Myself,ENEMY)
	StateCheck(Myself,STATE_INVISIBLE)
	OR(5)
		See([GOODCUTOFF.0.0.BARD_ALL])
		See([GOODCUTOFF.0.0.DRUID_ALL])
		See([GOODCUTOFF.0.0.SHAMAN])
		See([GOODCUTOFF.0.0.CLERIC_ALL])
		See([GOODCUTOFF.0.0.MAGE_ALL])
	!Range(LastSeenBy(Myself), 20)
THEN
	RESPONSE #100
		MoveToObject(LastSeenBy(Myself))
END

IF
	Allegiance(Myself,ENEMY)
	StateCheck(Myself,STATE_INVISIBLE)
	See([PC])
	!Range(LastSeenBy(Myself), 20)
THEN
	RESPONSE #100
		MoveToObject(LastSeenBy(Myself))
END

IF
	Allegiance(Myself,ENEMY)
	GlobalTimerNotExpired("PoisonWeapon","LOCALS")
	OR(2)
        StateCheck(Myself,STATE_INVISIBLE)
        CheckStatGT(Myself,0,ASSASSINATE)
	See([PC.0.0.MAGE_ALL])
	HPLT([PC.0.0.MAGE_ALL],100)
	OR(2)
	    CheckStatGT([PC.0.0.MAGE_ALL],-15,ARMORCLASS)
	    CheckStatGT(Myself,5,CRITICALHITBONUS)
	CheckStatLT([PC.0.0.MAGE_ALL],50,RESISTPIERCING) // PIERCING/CRUSHING/SLASHING
    !CheckStatGT([PC.0.0.MAGE_ALL],0,SCRIPTINGSTATE6)
	!CheckStatGT([PC.0.0.MAGE_ALL],0,STONESKINS)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_MIRRORIMAGE)
	!StateCheck(LastSeenBy(Myself),STATE_POISONED)
	!CheckSpellState([PC.0.0.MAGE_ALL],POISON_EFFECT_IMMUNITY)
	CheckStatLT(LastSeenBy(Myself),60,RESISTPOISON)
	!CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE20)
	Range([PC.0.0.MAGE_ALL],5)
THEN
	RESPONSE #100
		EquipMostDamagingMelee()
		AttackOneRound(LastSeenBy(Myself))
END

