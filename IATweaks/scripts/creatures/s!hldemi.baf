
IF
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
		CreateCreatureEffect("s!demipr","S!REDDHM",[297.653],14) 
		CreateCreatureEffect("s!demimg","S!REDDHM",[764.325],14) 
		CreateCreatureEffect("s!demipr","S!REDDHM",[1030.507],14) 
		CreateCreatureEffect("s!demimg","S!REDDHM",[544.842],14) 
		Continue()
END


IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
		Continue()
END

IF
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		NoAction()
END


IF
	Allegiance(Myself,ENEMY)
    !GlobalTimerNotExpired("IaKangaxxCurse","LOCALS")
THEN
	RESPONSE #100
		ReallyForceSpellRES("S!GAXCUR",Myself)
		SetGlobalTimer("IaKangaxxCurse","LOCALS",FIVE_TURNS)
END


IF
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	OR(2)
	    HPPercentLT(Myself,75)
	    !GlobalTimerNotExpired("IaEnergyDrainHpBoost","LOCALS")
    !GlobalTimerNotExpired("IaEnergyDrainTimer","LOCALS")
	See(SixthNearest([PC]))
	Range(SixthNearest([PC]),15)
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
    CheckStatLT(LastSeenBy(Myself),30,MAGICDAMAGERESISTANCE)
	!CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	!CheckSpellState(LastSeenBy(Myself),SI_NECROMANCY)
	!CheckSpellState(LastSeenBy(Myself),DISPELLABLE_PROT_FROM_LEVEL_DRAIN)
	!CheckSpellState(LastSeenBy(Myself),UNDISPELLABLE_PROT_FROM_LEVEL_DRAIN)
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaEnergyDrainHpBoost","LOCALS",THREE_TURNS)
		SetGlobalTimer("IaEnergyDrainTimer","LOCALS",30)
		ForceSpell(LastSeenBy(Myself),WIZARD_ENERGY_DRAIN)
	RESPONSE #250
	    Continue()
END

