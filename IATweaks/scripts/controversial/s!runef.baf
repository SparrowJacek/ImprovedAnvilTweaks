IF
	Allegiance(Myself,ENEMY)
	Detect([PC])
	Class(Player1,RANGER_ALL)
	Global("Iatreasure","LOCALS",0)
	GlobalLT("Iamaskplace","GLOBAL",3)
THEN
	RESPONSE #100
		SetGlobal("Iamaskplace","GLOBAL",3)
