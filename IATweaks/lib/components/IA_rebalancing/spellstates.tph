///////////////// Add existing Spellstates to existing spells

OUTER_SET SI_spellstate = 56 // Spell Immunities
ACTION_FOR_EACH spell_immunity_subspell IN ~SPWI590~ ~SPWI591~ ~SPWI592~ ~SPWI593~ ~SPWI594~ ~SPWI595~ ~SPWI596~ ~SPWI597~ BEGIN
  COPY_EXISTING ~%spell_immunity_subspell%.spl~ ~override~
    LPF ~ADD_SPELL_EFFECT~
      INT_VAR
        opcode = 328
        target = 1
        power = 5
        parameter2 = SI_spellstate
        resist_dispel = 0
        duration = 120
        special = 1
        insert_point = 1
    END
  OUTER_SET SI_spellstate = SI_spellstate + 1
END

COPY_EXISTING ~SPPR109.spl~ ~override~
  LPF ~CLONE_EFFECT~
    INT_VAR
      match_opcode = 153
      opcode = 328
      parameter1 = 0
      parameter2 = 20 // Sanctuary
      special = 1
  END

