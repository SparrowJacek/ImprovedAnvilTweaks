// Block spawning points for 0-exp Golems in 2nd level of WK

<<<<<<<< .../inlined/ar3016-no-0-exp-golems.baf
IF
		Global("Iaenablespawns","AR3016",0)
		Global("SetDifficulty","AR3016",0)
THEN
	RESPONSE #100
		SetGlobal("Iaenablespawns","AR3016",1)
		SetGlobal("SetDifficulty","AR3016",1)
END

>>>>>>>>
EXTEND_TOP ~ar3016.bcs~ ~.../inlined/ar3016-no-0-exp-golems.baf~
  EVALUATE_BUFFER

// Add info about Orcus when you pick up Daystar

OUTER_SET orcus_info_str_ref = RESOLVE_STR_REF(@5121)
<<<<<<<< .../inlined/ar0082-orcus-info.baf
IF
		Global("IaOrcusInfo","AR0082",0)
		PartyHasItem("SW1H31")
THEN
	RESPONSE #100
		SetGlobal("IaOrcusInfo","AR0082",1)
		DisplayStringHead(Player1,%orcus_info_str_ref%)
END

>>>>>>>>
EXTEND_TOP ~ar0082.bcs~ ~.../inlined/ar0082-orcus-info.baf~
  EVALUATE_BUFFER

// Prevent Dispel/Remove Magic from 100% removing magical weapons

ACTION_FOR_EACH dispel_magic_spl_file IN ~SPCL231~ ~SPPR303~ ~SPPRI02~ ~SPWI302~ ~SPWI326~ BEGIN
  COPY_EXISTING ~%dispel_magic_spl_file%.spl~ ~override~
    GET_OFFSET_ARRAY ab_array SPL_V10_HEADERS
    PHP_EACH ab_array AS int => ab_off BEGIN
      GET_OFFSET_ARRAY2 fx_array ab_off SPL_V10_HEAD_EFFECTS
      PHP_EACH fx_array AS int => fx_off BEGIN
        READ_SHORT (fx_off) opcode
        PATCH_IF opcode = 58 BEGIN
          WRITE_SHORT (fx_off + 0xa) 2
        END
      END
    END
END


// // Make some spells properly hostile

// ACTION_FOR_EACH hostile_spell IN ~SPPR106~ ~SPPR208~ ~SPPR211~ ~SPPR302~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ ~~ BEGIN
//   COPY_EXISTING ~%hostile_spell%.spl~ ~override~
//     WRITE_BYTE 0x18 (THIS BOR 0b00000100) // Add Hostile flag
// END

// Remove immunity to opcode "create item" from some items and swap it with immunity to Polymorph spell

OUTER_SET wizard_polymorph_other_spell_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_POLYMORPH_OTHER~)
LAF RES_NAME_OF_SPELL_NUM INT_VAR spell_num = wizard_polymorph_other_spell_id RET wizard_polymorph_other_spell_res = spell_res END

ACTION_FOR_EACH item_to_patch IN ~DRAGRING~ ~S!DRGRNG~ BEGIN
  COPY_EXISTING ~%item_to_patch%.itm~ ~override~
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 101
        match_parameter2 = 111
        opcode = 206
        parameter1 = 0
        parameter2 = 0
      STR_VAR
        resource = EVAL ~%wizard_polymorph_other_spell_res%~
    END
END

