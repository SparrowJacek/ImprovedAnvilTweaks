	Allegiance(Myself,ENEMY)
	ActionListEmpty()
	See([PC.0.0.MAGE_ALL])
	CheckStatLT([PC.0.0.MAGE_ALL],100,RESISTCRUSHING) // PIERCING/CRUSHING/SLASHING
