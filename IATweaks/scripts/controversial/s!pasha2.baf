
IF
	!StateCheck(Myself,STATE_HELPLESS)
	Global("Iapcastts","GLOBAL",0)
	HPPercentLT(Myself,60)
	!GlobalTimerNotExpired("DrankPotionTimer","LOCALS")
	HasItem("POTN55",Myself)  // Potion of Superior Healing
THEN
	RESPONSE #100
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46150)  // *quaffs a potion*
		UseItem("POTN55",Myself)  // Potion of Superior Healing
END

IF
	Allegiance(Myself,GOODBUTBLUE)
	!GlobalTimerNotExpired("DrankPotionTimer","LOCALS")
	!GlobalTimerNotExpired("gww","LOCALS")
	!StateCheck(Myself,STATE_HELPLESS)
	Global("Iapcastts","GLOBAL",0)
	See(NearestEnemyOf(Player1))
	Range(LastSeenBy(Myself),5)
	!CheckStatGT(LastSeenBy(Myself),2,SCRIPTINGSTATE6)
	OR(2)
		Global("Iathethree","AR4500",2)  // Pocket Plane
		!HasItem("S!rakp",LastSeenBy(Myself))  // Skull
	GlobalLT("Iapasha01","LOCALS",8)
THEN
	RESPONSE #100
		IncrementGlobal("Iapasha01","LOCALS",1)
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		SetGlobalTimer("gww","LOCALS",THREE_ROUNDS)
		ForceSpell(Myself,WARRIOR_GREATER_WHIRLWIND)  // SPCL901.SPL (Greater Whirlwind Attack)
END

IF
	Allegiance(Myself,GOODBUTBLUE)
	!GlobalTimerNotExpired("DrankPotionTimer","LOCALS")
	!GlobalTimerNotExpired("cstrike","LOCALS")
	!StateCheck(Myself,STATE_HELPLESS)
	Global("Iapcastts","GLOBAL",0)
	See(NearestEnemyOf(Player1))
	Range(LastSeenBy(Myself),5)
	!CheckStatGT(LastSeenBy(Myself),2,SCRIPTINGSTATE6)
	OR(2)
		Global("Iathethree","AR4500",2)  // Pocket Plane
		!HasItem("S!rakp",LastSeenBy(Myself))  // Skull
    CheckStatLT(Myself,8,CRITICALHITBONUS)
	GlobalLT("Iapasha02","LOCALS",4)
THEN
	RESPONSE #100
		IncrementGlobal("Iapasha02","LOCALS",1)
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		SetGlobalTimer("cstrike","LOCALS",THREE_ROUNDS)
		ForceSpell(Myself,WARRIOR_CRITICAL_STRIKE)  // SPCL905.SPL (Critical Strike)
END

