IF
	HaveSpellRES("SPCL943")  // Purify Aura
	GlobalLT("s!purifyaura","LOCALS",1)
THEN
	RESPONSE #100
		ForceSpellRES("SPCL943",Myself)  // Purify Aura
		IncrementGlobal("s!purifyaura","LOCALS",1)
END

IF
	Global("partyfled","LOCALS",0)
	!See([GOODCUTOFF])
	!See([PC])
	Global("prep","LOCALS",1)
	Allegiance(Myself,ENEMY)
THEN
	RESPONSE #100
		SetGlobalTimer("chase","LOCALS",TEN_ROUNDS)
		SetGlobal("partyfled","LOCALS",1)
END

IF
	!See([PC])
	!See([GOODCUTOFF])
	GlobalTimerNotExpired("chase","LOCALS")
	InMyArea(Player1)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_STUNNED)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_CHARMED)
	Allegiance(Myself,ENEMY)
	Global("prep","LOCALS",1)
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

IF
	!See([PC])
	!See([GOODCUTOFF])
	GlobalTimerExpired("chase","LOCALS")
	Global("partyfled","LOCALS",1)
	Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	Global("prep","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("prep","LOCALS",0)
		SetGlobal("Iagreater","LOCALS",0)
		SetGlobal("Iatruesight","LOCALS",0)
		SetGlobal("Iacommand","LOCALS",0)
		SetGlobal("Iahold","LOCALS",0)
		SetGlobal("Iarigid","LOCALS",0)
		SetGlobal("Iacure","LOCALS",0)
		SetGlobal("Iadoom","LOCALS",0)
		SetGlobal("s!purifyaura","LOCALS",0)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
END

IF
	See(NearestEnemyOf(Myself))
	Allegiance(Myself,ENEMY)
	!CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE6)
THEN
	RESPONSE #100
		AttackOneRound(LastSeenBy(Myself))
END

IF
	See(SecondNearestEnemyOf(Myself))
	Allegiance(Myself,ENEMY)
	!CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE6)
THEN
	RESPONSE #100
		AttackOneRound(LastSeenBy(Myself))
END

IF
	See(NearestEnemyOf(Myself))
	Allegiance(Myself,ENEMY)
THEN
	RESPONSE #100
		AttackOneRound(LastSeenBy(Myself))
END

IF
	!See([GOODCUTOFF])
	InMyArea(Player1)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

