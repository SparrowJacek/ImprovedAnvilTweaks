	See(ThirdNearestEnemyOfType([GOODCUTOFF.0.0.0.0.SUMMONED]))
	Range(ThirdNearestEnemyOfType([GOODCUTOFF.0.0.0.0.SUMMONED]), 15)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
