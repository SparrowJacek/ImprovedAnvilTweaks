	Allegiance(Myself,ENEMY)
    ActionListEmpty()
	Global("IaChar2Seen","LOCALS",1)
	!See(Player2)
	!HPLT(Player2,0)
	InMyArea(Player2)
THEN
	RESPONSE #100
		MoveToObject(Player2)
END

