	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	Allegiance(Myself,ENEMY)
	See(ThirdNearest([PC]))
	CheckStatLT(LastSeenBy(Myself),50,MAGICDAMAGERESISTANCE)
	CheckStatLT(LastSeenBy(Myself),50,RESISTMAGIC)
	!CheckStat(LastSeenBy(Myself),5,SCRIPTINGSTATE7)
	!HasItemEquiped("S!halb02",LastSeenBy(Myself))  // Poseidon's Wrath +5
	TriggerOverride(LastSeenBy(Myself), Range(ThirdNearest([PC]), 15))
	TriggerOverride(LastSeenBy(Myself), CheckStatLT(ThirdNearest([PC]),90,MAGICDAMAGERESISTANCE))
	TriggerOverride(LastSeenBy(Myself), CheckStatLT(ThirdNearest([PC]),75,RESISTMAGIC))
	!TriggerOverride(LastSeenBy(Myself), CheckStat(ThirdNearest([PC]),5,SCRIPTINGSTATE7))
	!TriggerOverride(LastSeenBy(Myself), HasItemEquiped("S!halb02",ThirdNearest([PC])))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),WIZARD_ABI_DALZIMS_HORRID_WILTING)  // SPWI812.SPL (Abi-Dalzim's Horrid Wilting)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #50
	    Continue()
END

