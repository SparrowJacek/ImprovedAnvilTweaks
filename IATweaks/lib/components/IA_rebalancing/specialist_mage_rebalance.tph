  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 133
      opcode = 22
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = ~-1~
      match_duration = 18
      duration = 120
  END

ACTION_FOR_EACH luck_scroll IN ~s!scrl18.itm~ ~scrl93.itm~ BEGIN
