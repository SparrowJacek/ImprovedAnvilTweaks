END

IF
	Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	!CheckStatGT(Myself,0,AURACLEANSING)
	Global("MyAura","LOCALS",1)
	GlobalLT("alacritymax","LOCALS",2)
THEN
	RESPONSE #100
		IncrementGlobal("alacritymax","LOCALS",1)
		SetGlobal("MyAura","LOCALS",0)
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		CheckStatGT(Myself,0,AURACLEANSING)
		!GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaNatureBeauty","LOCALS")
	CheckStat(Myself,0,SCRIPTINGSTATE6)
	See(ThirdNearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),7)
	GlobalLT("naturebeauty","LOCALS",2)
THEN
	RESPONSE #100
		IncrementGlobal("naturebeauty","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaNatureBeauty","LOCALS",THREE_ROUNDS)
		SpellNoDec(Myself,CLERIC_NATURE_BEAUTY)  // SPPR704.SPL (Nature's Beauty)
END


IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("restoretimer","LOCALS")
	OR(2)
		CheckStatGT(Myself,0,AURACLEANSING)
		!GlobalTimerNotExpired("IaAction","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	GlobalLT("naturalrestore","LOCALS",3)
	!Dead("S!trollk")  // Troll King
	HPPercentLT("S!trollk",60)  // Troll King
THEN
	RESPONSE #100
		IncrementGlobal("naturalrestore","LOCALS",1)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("restoretimer","LOCALS",2)
		SpellNoDecRES("SPCLI15","S!trollk")  // Natural Restoral
END

