	HaveSpell(TALOS_LIGHTNING_BOLT)
	Allegiance(Myself,ENEMY)
    !GlobalTimerNotExpired("IaTalosBoltPurify","LOCALS")
	GlobalTimerNotExpired("IaFiveSeconds","LOCALS")
	See(SixthNearest([PC]))
	!CheckSpellState(LastSeenBy(Myself),SI_EVOCATION)
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	CheckStatLT(LastSeenBy(Myself),50,RESISTELECTRICITY)
	CheckStatLT(LastSeenBy(Myself),25,RESISTMAGIC)
THEN
	RESPONSE #100
	    SetInterrupt(FALSE)
		SetGlobalTimer("IaTalosBoltPurify","LOCALS",THREE_ROUNDS)
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("SPCL943",Myself)  // Purify Aura
		RemoveSpellRES("SPCL943")
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),TALOS_LIGHTNING_BOLT)
		ReallyForceSpellRES("S!SEEREM",Myself)
	    SetInterrupt(TRUE)
	RESPONSE #50
	    Continue()
END

