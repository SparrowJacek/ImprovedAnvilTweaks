IF
	NumberOfTimesTalkedTo(0)
	Detect([PC])
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Iatalked","LOCALS",1)
		StartDialogueNoSet([PC])
END

IF
	NumberOfTimesTalkedTo(0)
	Detect([PC])
	GlobalGT("Iapcastts","GLOBAL",0)
	Global("Iatalked","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatalked","LOCALS",1)
		SetGlobal("Iatreasure","LOCALS",1)
END

IF
	Global("ThrallOrb","GLOBAL",2)
	Global("Iathralldie","AR0516",2)  // Planar Prison
	Global("Iasettimer","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iasettimer","LOCALS",1)
		SetGlobalTimer("Iatheygone","LOCALS",3)
END

IF
	Global("ThrallOrb","GLOBAL",2)
	Global("Iathralldie","AR0516",2)  // Planar Prison
	Global("Iasettimer","LOCALS",1)
	GlobalTimerExpired("Iatheygone","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("Iasettimer","LOCALS",2)
END

IF
	GlobalLT("ThrallOrb","GLOBAL",2)
	!Global("Iasettimer","LOCALS",2)
	See([PC])
THEN
	RESPONSE #100
		SetGlobal("Iasettimer","LOCALS",2)
END

IF
	Global("Iakillthrall","AR0516",1)  // Planar Prison
	Global("Iathralldie","AR0516",0)  // Planar Prison
THEN
	RESPONSE #100
		SetGlobal("Iathralldie","AR0516",1)  // Planar Prison
		SetGlobalTimer("Iasunfire","LOCALS",3)
END

IF
	GlobalTimerExpired("Iasunfire","LOCALS")
	Global("ThrallOrb","GLOBAL",2)
	GlobalLT("asunfire","LOCALS",1)
	Global("Iathralldie","AR0516",1)  // Planar Prison
THEN
	RESPONSE #100
		SetGlobal("Iathralldie","AR0516",2)  // Planar Prison
		IncrementGlobal("asunfire","LOCALS",1)
		ReallyForceSpell(Myself,WIZARD_SUN_FIRE)  // SPWI523.SPL (Sunfire)
		ReallyForceSpellRES("SPWII07",Myself)  // No such index
		Kill("pthral07")  // Warden's Thrall
		Kill("pthral08")  // Thrall
		Kill("pthral09")  // Thrall
END

IF
	InMyArea(Player1)
	XPLT(Player1,2350000)
	Global("IaToneDown","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaToneDown","LOCALS",1)
		SetGlobal("Iarefreshsi","LOCALS",1)
		SetGlobal("Iawarden06","LOCALS",2)
		SetGlobal("Iawarden10","LOCALS",3)
		SetGlobal("Iawarden03","LOCALS",1)
		SetGlobal("Iawarden04","LOCALS",1)
		SetGlobal("Iawarden14","LOCALS",4)
		RemoveSpellRES("SPWI925")
		RemoveSpellRES("SPWI925")
END

IF
	Allegiance(Myself,ENEMY)
	OR(4)
		Detect([PC])
		Detect([GOODCUTOFF])
		Global("Iathralldie","AR0516",2)  // Planar Prison
		Global("Iatalked","LOCALS",1)
	Global("Prep","AR0516",0)  // Planar Prison
THEN
	RESPONSE #100
		SetGlobal("Prep","AR0516",1)  // Planar Prison
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		ReallyForceSpell(Myself,WIZARD_SPELL_TURNING)  // SPWI701.SPL (Spell Turning)
		ReallyForceSpell(Myself,WIZARD_MIRROR_IMAGE)  // SPWI212.SPL (Mirror Image)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Fire Shield (Red))
		ReallyForceSpell(Myself,WIZARD_MINOR_GLOBE_OF_INVULNERABILITY)  // SPWI406.SPL (Minor Globe of Invulnerability)
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_ABJURATION)  // SPWI590.SPL (Immunity: Abjuration)
END

