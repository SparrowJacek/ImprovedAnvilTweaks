IF
	!See(NearestEnemyOf(Myself))
	Heard([EVILCUTOFF],151)
	InMyArea(Player1)
THEN
	RESPONSE #100
		SetGlobal("Iashoutonce","LOCALS",1)
		MoveToObject(LastHeardBy(Myself))
END

IF
	Global("Iashoutonce","LOCALS",0)
	Global("Iapcastts","GLOBAL",0)
	See([GOODCUTOFF])
	Allegiance(Myself,ENEMY)
	ActionListEmpty()
THEN
	RESPONSE #100
		SetGlobal("Iashoutonce","LOCALS",1)
		GlobalShout(151)
END


IF
	HaveSpellRES("SPCL922")
	See(NearestEnemyOf(Myself))
	HPPercentLT(Myself,80)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaContactWithNature","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaContactWithNature","LOCALS",ONE_TURN)
