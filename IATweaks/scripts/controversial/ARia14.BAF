IF
	Global("IaUndeadWaves","GLOBAL",1)
	!GlobalTimerNotExpired("IaNextUndeadWave","GLOBAL")
THEN
	RESPONSE #100
		IncrementGlobal("IaUndeadWaves","GLOBAL",1)
		SetGlobalTimer("IaNextUndeadWave","GLOBAL",TWO_ROUNDS)
		CreateVisualEffect("SPRAISED",[970.1427])
		CreateVisualEffect("SPRAISED",[1031.1356])
		CreateVisualEffect("SPRAISED",[1109.1302])
		CreateVisualEffect("SPRAISED",[1265.1193])
		CreateVisualEffect("SPRAISED",[1343.1139])
		CreateVisualEffect("SPRAISED",[1437.1100])
		CreateVisualEffect("SPRAISED",[1063.1387])
		CreateVisualEffect("SPRAISED",[1141.1333])
		CreateVisualEffect("SPRAISED",[1297.1224])
		CreateVisualEffect("SPRAISED",[1375.1170])
		Wait(3)
		CreateCreature("S!SKELLD",[970.1427],SE)  // Skeleton Lord
		CreateCreature("S!SHADO3",[1031.1356],SE)  // Deep Shadow
		CreateCreature("S!SHADO3",[1109.1302],SE)  // Deep Shadow
		CreateCreature("S!SHADO3",[1265.1193],SE)  // Deep Shadow
		CreateCreature("S!SHADO3",[1343.1139],SE)  // Deep Shadow
		CreateCreature("S!SKELLD",[1437.1100],SE)  // Skeleton Lord
		CreateCreature("S!SHADO3",[1063.1387],SE)  // Deep Shadow
		CreateCreature("S!SHADO3",[1141.1333],SE)  // Deep Shadow
		CreateCreature("S!SHADO3",[1297.1224],SE)  // Deep Shadow
		CreateCreature("S!SHADO3",[1375.1170],SE)  // Deep Shadow
END

