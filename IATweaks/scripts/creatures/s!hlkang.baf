IF
	Allegiance(Myself,ENEMY)
	HaveSpell(WIZARD_GREATER_MALISON)
	CheckStatGT(Myself,0,AURACLEANSING)
    !GlobalTimerNotExpired("IaGreaterMalisonWait","LOCALS")
	See(SixthNearest([PC]))
	TriggerOverride(SixthNearest([PC]), Range([PC], 15))
	CheckStatLT(LastSeenBy(Myself),30,RESISTMAGIC)
    !CheckSpellState(LastSeenBy(Myself),SI_ENCHANTMENT)
    !CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE3)
	!ImmuneToSpellLevel(LastSeenBy(Myself),4)
	TriggerOverride(SixthNearest([PC]), CheckStatLT([PC],50,RESISTMAGIC))
	TriggerOverride(SixthNearest([PC]), CheckSpellState([PC],SI_ENCHANTMENT))
	!TriggerOverride(SixthNearest([PC]), CheckStat([PC],1,SCRIPTINGSTATE3))
	!TriggerOverride(SixthNearest([PC]), ImmuneToSpellLevel([PC],4))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaGreaterMalisonWait","LOCALS",3)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),WIZARD_GREATER_MALISON)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #300
	    Continue()
END

