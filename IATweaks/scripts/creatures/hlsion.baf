	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaProtRemovalWait","LOCALS")
	See([PC])
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!CheckSpellState(LastSeenBy(Myself),REMOVE_SPECIFIC_PROTS_IMMUNITY)
	OR(2)
        CheckStatGT(LastSeenBy(Myself),5,BREACHABLECOMBATBUFFSPOWER)
        CheckStatGT(LastSeenBy(Myself),8,BREACHABLESPECIFICBUFFSPOWER)
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(LastSeenBy(Myself),WIZARD_BREACH)
		SetGlobalTimer("IaProtRemovalWait","LOCALS",1)
	RESPONSE #50
	    Continue()
END

