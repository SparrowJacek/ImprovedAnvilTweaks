	InMyArea(Player1)
	Global("Iaitem3","AR2811",0)  // House in Suldanessellar
	Global("Iapcastts","GLOBAL",0)
THEN
	RESPONSE #100
		SetGlobal("Iaitem3","AR2811",1)  // House in Suldanessellar
		ActionOverride("Drawer 1",CreateItem("scrl7q",0,0,0))  // Improved Haste
END

IF
	InMyArea(Player1)
	Global("Iaitem4","AR2811",0)  // House in Suldanessellar
	Global("Iapcastts","GLOBAL",0)
	Global("Iawoodlandsplace","GLOBAL",3)
THEN
	RESPONSE #100
		SetGlobal("Iaitem4","AR2811",1)  // House in Suldanessellar
		SetGlobal("Iawoodlandsplace","GLOBAL",4)
		ActionOverride("Table 1",CreateItem("staf14",20,20,20))  // Staff of the Woodlands +4
END

