IF
    Global("IaInterrupting","LOCALS",1)
	GlobalTimerExpired("IaInterruptingTimer","LOCALS")
THEN
	RESPONSE #100
		SetGlobal("IaInterrupting","LOCALS",0)
		ClearActions(Myself)
END


IF
	Allegiance(Myself,ENEMY)
	HaveSpell(TALOS_LIGHTNING_BOLT)
	See([PC])
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	OR(2)
        CheckStatGT(LastSeenBy(Myself),33,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
        CheckStatGT(LastSeenBy(Myself),24,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
	OR(2)
        CheckStatGT(LastSeenBy(Myself),33,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
        CheckStatGT(Myself,1,MENTALSPEED)
	!StateCheck(LastSeenBy(Myself),STATE_INVISIBLE)
	!StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	CheckStatLT(LastSeenBy(Myself),100,RESISTELECTRICITY)
	CheckStatLT(LastSeenBy(Myself),20,RESISTMAGIC)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaFiveSeconds","LOCALS",5)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),TALOS_LIGHTNING_BOLT)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #200
	    Continue()
END

