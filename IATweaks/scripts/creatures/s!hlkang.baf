IF
	Allegiance(Myself,ENEMY)
	HaveSpell(WIZARD_ICE_STORM)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!See(NearestAllyOf(Myself))
	See(SixthNearest([PC]))
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	TriggerOverride(SixthNearest([PC]), Range([PC], 15))
	CheckStatLT(LastSeenBy(Myself),70,RESISTCOLD)
	CheckStatLT(LastSeenBy(Myself),35,RESISTMAGIC)
    !CheckSpellState(LastSeenBy(Myself),SI_EVOCATION)
	!ImmuneToSpellLevel(LastSeenBy(Myself),4)
	TriggerOverride(SixthNearest([PC]), CheckStatLT([PC],55,RESISTMAGIC))
	TriggerOverride(SixthNearest([PC]), CheckStatLT([PC],70,RESISTCOLD))
	TriggerOverride(SixthNearest([PC]), CheckSpellState([PC],SI_EVOCATION))
	!TriggerOverride(SixthNearest([PC]), ImmuneToSpellLevel([PC],4))
	OR(3)
        CheckSpellState(Myself,SI_EVOCATION)
	    ImmuneToSpellLevel(Myself,4)
	    !Range(SixthNearest([PC]), 18)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		Spell(LastSeenBy(Myself),WIZARD_ICE_STORM)
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #250
	    Continue()
END

