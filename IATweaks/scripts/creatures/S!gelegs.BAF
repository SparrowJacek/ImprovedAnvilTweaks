IF
	Global("Iapcastts","GLOBAL",0)
	See([PC])
	!GlobalTimerNotExpired("Iapurge","LOCALS")
	!HPLT(Myself,1)
THEN
	RESPONSE #100
		SetGlobalTimer("Iapurge","LOCALS",FOUR_ROUNDS)
		ReallyForceSpellRES("SPINI29",LastSeenBy(Myself))  // Purge Magic
END

IF
	!GlobalTimerNotExpired("Iareconstruct","LOCALS")
	Global("Iapcastts","GLOBAL",1)
	!HPLT(Myself,1)
	HPPercentLT(Myself,75)
THEN
	RESPONSE #100
		SetGlobalTimer("Iareconstruct","LOCALS",THREE_ROUNDS)
		ReallyForceSpellRES("SPWII45",Myself)  // No such index
END

IF
	!GlobalTimerNotExpired("Iareconstruct","LOCALS")
	!Detect([PC])
	!Detect([GOODCUTOFF])
	!HPLT(Myself,1)
	HPPercentLT(Myself,75)
THEN
	RESPONSE #100
		SetGlobalTimer("Iareconstruct","LOCALS",TEN_ROUNDS)
		ReallyForceSpellRES("SPWII45",Myself)  // No such index
END


IF
	Detect([PC])
	Global("IaAmbers","LOCALS",0)
THEN
	RESPONSE #100
		CreateCreatureObject("S!ambere",Myself,0,0,0)  // Amber Golem
		CreateCreatureObject("S!ambere",Myself,0,0,0)  // Amber Golem
		SetGlobal("IaAmbers","LOCALS",1)
END

IF
	Global("IaSpawnElementals1","LOCALS",0)
	HPPercentLT(Myself,83)
THEN
	RESPONSE #25
		ReallyForceSpellRES("S!ELEINF",Myself)
		CreateCreatureObject("S!ICEEL1",Myself,0,0,0)
		SetGlobal("IaSpawnElementals1","LOCALS",1)
		ReallyForceSpellRES("S!COLD-5",Myself)
		ReallyForceSpellRES("S!ELEC-5",Myself)
	RESPONSE #25
		ReallyForceSpellRES("S!ELEINF",Myself)
		CreateCreatureObject("S!MAGEL1",Myself,0,0,0)
		SetGlobal("IaSpawnElementals1","LOCALS",1)
		ReallyForceSpellRES("S!FIRE-5",Myself)
		ReallyForceSpellRES("S!ACID-5",Myself)
	RESPONSE #25
		ReallyForceSpellRES("S!ELEINF",Myself)
		CreateCreatureObject("S!OOZEL1",Myself,0,0,0)
		SetGlobal("IaSpawnElementals1","LOCALS",1)
		ReallyForceSpellRES("S!COLD-5",Myself)
		ReallyForceSpellRES("S!ACID-5",Myself)
	RESPONSE #25
		ReallyForceSpellRES("S!ELEINF",Myself)
		CreateCreatureObject("S!SMOEL1",Myself,0,0,0)
		SetGlobal("IaSpawnElementals1","LOCALS",1)
		ReallyForceSpellRES("S!ELEC-5",Myself)
		ReallyForceSpellRES("S!FIRE-5",Myself)
END

