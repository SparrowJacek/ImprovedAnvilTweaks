// Remove Spare the Dying from resurrected characters

ACTION_IF (NOT FILE_EXISTS_IN_GAME ~#RDREMOV.spl~) BEGIN
  ACTION_FOR_EACH resurrection_spell IN ~spja01.spl~ ~sppr504.spl~ ~sppr550.spl~ ~sppr712.spl~ BEGIN
    COPY_EXISTING ~%resurrection_spell%~ ~override~
      LPF ~CLONE_EFFECT~
        INT_VAR
          match_opcode = 172
          multi_match = 1
        STR_VAR
          insert = ~last~
          resource = ~sppr735~
      END
  END
END
ACTION_IF (FILE_EXISTS_IN_GAME ~#RDREMOV.spl~) BEGIN
  COPY_EXISTING ~#RDREMOV.spl~ ~override~
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 172
        multi_match = 1
      STR_VAR
        insert = ~last~
        resource = ~sppr735~
    END
END

