IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!CheckStatGT(Myself,0,SCRIPTINGSTATE9)
	Global("Iapcastts","GLOBAL",0)
	InMyArea(Player1)
	Global("Iapccloud","AR1301",1)  // De'Arnise Cellar
	GlobalLT("Iatorgal02","LOCALS",2)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("Iapccloud","AR1301",0)  // De'Arnise Cellar
		Wait(2)
		IncrementGlobal("Iatorgal02","LOCALS",1)
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SpellNoDec(Myself,CLERIC_ZONE_OF_SWEET_AIR)  // SPPR318.SPL (Zone of Sweet Air)
		SetInterrupt(TRUE)
		MoveToObject(Player1)
END

