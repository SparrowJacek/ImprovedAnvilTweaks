IF
	Global("Iaexit","AR0412",1)  // Sphere: Ice and Fire Room
	OR(2)
		Dead("tolger2")  // Tolgerias
		Dead("TOLGER")  // Tolgerias
	CombatCounter(0)
	InMyArea(Player1)
THEN
	RESPONSE #100
		SetGlobal("Iaexit","AR0412",2)  // Sphere: Ice and Fire Room
		TriggerActivation("Tran0411",TRUE)
END

IF
	Global("Ianticheat","AR0412",0)  // Sphere: Ice and Fire Room
	Exists("tolger2")  // Tolgerias
	!Dead("tolger2")  // Tolgerias
	!Allegiance("tolger2",ENEMY)  // Tolgerias
	HPPercentLT("tolger2",100)  // Tolgerias
THEN
	RESPONSE #100
		SetGlobal("Ianticheat","AR0412",1)  // Sphere: Ice and Fire Room
		ChangeEnemyAlly("tolger2",ENEMY)  // Tolgerias
		ApplySpellRES("SPWII07","tolger2")  // No such index
END

IF
	Global("Ianticheat","AR0412",0)  // Sphere: Ice and Fire Room
	Exists("TOLGER")  // Tolgerias
	!Dead("TOLGER")  // Tolgerias
	!Allegiance("TOLGER",ENEMY)  // Tolgerias
	HPPercentLT("TOLGER",100)  // Tolgerias
THEN
	RESPONSE #100
		SetGlobal("Ianticheat","AR0412",1)  // Sphere: Ice and Fire Room
		ChangeEnemyAlly("TOLGER",ENEMY)  // Tolgerias
		ApplySpellRES("SPWII07","TOLGER")  // No such index
END

