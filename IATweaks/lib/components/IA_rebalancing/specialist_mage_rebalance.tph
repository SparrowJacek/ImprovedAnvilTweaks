// Improve Chain Lightning

COPY_EXISTING ~spwi615.spl~ ~override~
              ~sppri13.spl~ ~override~
              ~spdr601.spl~ ~override~
  SAY UNIDENTIFIED_DESC @6240
  GET_OFFSET_ARRAY ab_array SPL_V10_HEADERS
  PHP_EACH ab_array AS int => ab_off BEGIN
    GET_OFFSET_ARRAY2 fx_array ab_off SPL_V10_HEAD_EFFECTS
    PHP_EACH fx_array AS int => fx_off BEGIN
      READ_SHORT fx_off current_opcode
      PATCH_IF (current_opcode = 12) BEGIN
        WRITE_LONG (fx_off + 0x1c) THIS + 2
        WRITE_BYTE (fx_off + 0x24) 2
      END
    END
  END
BUT_ONLY

COPY_EXISTING ~SCRL7k.itm~ ~override~
              ~SCRL7s.itm~ ~override~
  SAY IDENTIFIED_DESC @6240

// Change Prismatic Spray

COPY_EXISTING ~S!PSSHAR.spl~ ~override~
              ~SPWI714.spl~ ~override~
  SAY UNIDENTIFIED_DESC @6233
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 12
      match_parameter1 = 10
      match_savingthrow = 1
      savingthrow = 0
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 12
      match_parameter1 = 20
      match_savingthrow = 1
      savingthrow = 2
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 134
      opcode = 12
      parameter1 = 70
      parameter2 = 64
      savingthrow = 1
      special = 256
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 76
      opcode = 12
      parameter1 = 50
      parameter2 = 64
      savingthrow = 2
      special = 256
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 238
      opcode = 12
      parameter1 = 30
      parameter2 = 64
      savingthrow = 0
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 142
      match_parameter2 = 48
  END

