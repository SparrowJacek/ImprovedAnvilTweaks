SILENT

INCLUDE "%MOD_FOLDER%/lib/components/IA_rebalancing/helper_functions.tph"
INCLUDE "%MOD_FOLDER%/lib/components/IA_rebalancing/helper_functions_GUI.tph"

COPY ~IATweaks\resources\bam\GUILS10.bam~ ~override~

COPY_EXISTING ~UI.MENU~ ~override~
  LPF ~S!ADD_BUTTON_FOR_SHOWING_NUMBER_OF_STONESKINS~
  END

// Changes for button showing number of stoneskins

LAF ~S!ADD_SPLPROT_2DA_ENTRY~
  STR_VAR
    condition_description = ~STONESKINS_NUM~
    stat                  = ~88~
    value                 = ~-1~
    relation              = ~1~
  RET
    stoneskins_num = new_line_number
END

COPY ~IATweaks\resources\spl\s!skin00.spl~ ~override~
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 326
      parameter1 = 1
      parameter2 = stoneskins_num
    STR_VAR
      resource = ~S!SKIN1~
  END
  FOR (i=2;i<=10;++i) BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        multi_match = 1
        match_opcode = 326
        parameter1 = i
      STR_VAR
        resource = EVAL ~S!SKIN%i%~
    END
  END

COPY ~IATweaks\resources\spl\s!skin1.spl~ ~override\s!skin1.spl~
  SAY NAME1 @5066

COPY ~IATweaks\resources\spl\s!skin1.spl~ ~override\s!skin2.spl~
  SAY NAME1 @5065

COPY ~IATweaks\resources\spl\s!skin1.spl~ ~override\s!skin3.spl~
  SAY NAME1 @5064

COPY ~IATweaks\resources\spl\s!skin1.spl~ ~override\s!skin4.spl~
  SAY NAME1 @5063

COPY ~IATweaks\resources\spl\s!skin1.spl~ ~override\s!skin5.spl~
  SAY NAME1 @5062

COPY ~IATweaks\resources\spl\s!skin1.spl~ ~override\s!skin6.spl~
  SAY NAME1 @5061

COPY ~IATweaks\resources\spl\s!skin1.spl~ ~override\s!skin7.spl~
  SAY NAME1 @5060

COPY ~IATweaks\resources\spl\s!skin1.spl~ ~override\s!skin8.spl~
  SAY NAME1 @5059

COPY ~IATweaks\resources\spl\s!skin1.spl~ ~override\s!skin9.spl~
  SAY NAME1 @5058

COPY ~IATweaks\resources\spl\s!skin1.spl~ ~override\s!skin10.spl~
  SAY NAME1 @5057
