IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOfType([GOODCUTOFF.0.0.SKELETON_WARRIOR.0.SUMMONED]))
	!Allegiance(LastSeenBy(Myself),ENEMY)
THEN
	RESPONSE #100
		ActionOverride(LastSeenBy(Myself),Enemy())
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOfType([GOODCUTOFF.0.SKELETON.SKELETON.0.SUMMONED]))
	!Allegiance(LastSeenBy(Myself),ENEMY)
THEN
	RESPONSE #100
		ActionOverride(LastSeenBy(Myself),Enemy())
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	!HPLT(Myself,1)
	HPLT(Myself,250)
	Global("IaStage","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaStage","LOCALS",1)
		Continue()
END

