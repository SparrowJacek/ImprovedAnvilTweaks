// Remove Greater Whirlwind and War Cry from Monks

ACTION_FOR_EACH hla_table IN ~LUMO0~ ~LUMO1~ ~LUMO2~ BEGIN
  COPY_EXISTING ~%hla_table%.2da~ ~override~
    COUNT_2DA_COLS ~colcount~
    COUNT_2DA_ROWS ~colcount~ ~rowcount~
    SET gww_row = (0 - 1)
    FOR (i = 0; i < ~rowcount~; ++i) BEGIN
      READ_2DA_ENTRY i 1 %colcount% current_val
      PATCH_IF (~%current_val%~ STR_EQ ~GA_SPCL901~) BEGIN
        SET gww_row = i
      END
    END
    PATCH_IF (gww_row != (0 - 1)) BEGIN
      REMOVE_2DA_ROW gww_row ~colcount~
    END
    BUT_ONLY
END

ACTION_FOR_EACH hla_table IN ~LUMO0~ ~LUMO1~ ~LUMO2~ BEGIN
  COPY_EXISTING ~%hla_table%.2da~ ~override~
    COUNT_2DA_COLS ~colcount~
    COUNT_2DA_ROWS ~colcount~ ~rowcount~
    SET warcry_row = (0 - 1)
    FOR (i = 0; i < ~rowcount~; ++i) BEGIN
      READ_2DA_ENTRY i 1 %colcount% current_val
      PATCH_IF (~%current_val%~ STR_EQ ~GA_SPCL908~) BEGIN
        SET warcry_row = i
      END
    END
    PATCH_IF (warcry_row != (0 - 1)) BEGIN
      REMOVE_2DA_ROW warcry_row ~colcount~
    END
    PRETTY_PRINT_2DA
    BUT_ONLY
END

// Remove War Cry from Wizard Slayers

COPY_EXISTING ~LUFI3.2da~ ~override~
  COUNT_2DA_COLS ~colcount~
  COUNT_2DA_ROWS ~colcount~ ~rowcount~
  SET war_cry_row = (0 - 1)
  FOR (i = 0; i < ~rowcount~; ++i) BEGIN
    READ_2DA_ENTRY i 1 %colcount% current_val
    PATCH_IF (~%current_val%~ STR_EQ ~GA_SPCL908~) BEGIN
      SET war_cry_row = i
    END
  END
  PATCH_IF (war_cry_row != (0 - 1)) BEGIN
    REMOVE_2DA_ROW war_cry_row ~colcount~
  END
  BUT_ONLY

// Lower number of Acrobatic Combat picks for Swashbuckler to 4

COPY_EXISTING ~LUTH1.2da~ ~override~
  COUNT_2DA_COLS ~colcount~
  COUNT_2DA_ROWS ~colcount~ ~rowcount~
  FOR (i = 0; i < ~rowcount~; ++i) BEGIN
    READ_2DA_ENTRY i 1 %colcount% current_val
    PATCH_IF (~%current_val%~ STR_EQ ~GA_SPCLI13~) BEGIN
      SET_2DA_ENTRY i 6 ~colcount~ 4
    END
  END
  BUT_ONLY

// Remove Whirlwind Attack and prerequisite for GWW for Riskbreakers

LAF ~S!MAP_ROW_NAMES_TO_IDS_IN_2DA_FILE~
  STR_VAR
    2da_table_name = ~luabbr.2da~
  RET_ARRAY
    luabbr_rows = 2da_rows_to_ids_mapping
END

COPY_EXISTING ~luabbr.2da~  ~override~
  COUNT_2DA_COLS ~colcount~
  READ_2DA_ENTRY $luabbr_rows("RISKBREAKER") 1 ~colcount~ rb_hlas_suffix
  PATCH_IF (~%rb_hlas_suffix%~ STR_EQ ~Fi0~) BEGIN
    SET_2DA_ENTRY $luabbr_rows("RISKBREAKER") 1 ~colcount~ ~S!RB~
    PRETTY_PRINT_2DA
  END
  BUT_ONLY

ACTION_IF (~%rb_hlas_suffix%~ STR_EQ ~Fi0~) BEGIN
  COPY_EXISTING ~LUFi0.2da~ ~override/LUS!RB.2da~
  SPRINT rb_hlas_suffix ~S!RB~
END

COPY_EXISTING ~LU%rb_hlas_suffix%.2da~ ~override~
  COUNT_2DA_COLS ~colcount~
  COUNT_2DA_ROWS ~colcount~ ~rowcount~
  SET ww_row = (0 - 1)
  FOR (i = 0; i < ~rowcount~; ++i) BEGIN
    READ_2DA_ENTRY i 1 %colcount% current_val
    PATCH_IF (~%current_val%~ STR_EQ ~GA_SPCL900~) BEGIN
      SET ww_row = i
    END
    PATCH_IF (~%current_val%~ STR_EQ ~GA_SPCL901~) BEGIN
      SET_2DA_ENTRY i 7 ~colcount~ ~*~
    END
  END
  PATCH_IF (ww_row != (0 - 1)) BEGIN
    REMOVE_2DA_ROW ww_row ~colcount~
  END
  PRETTY_PRINT_2DA
  BUT_ONLY
  
