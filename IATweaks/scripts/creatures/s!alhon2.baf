IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
		Continue()
END

IF
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		NoAction()
END



IF
	Allegiance(Myself,ENEMY)
	!HPLT(Myself,1)
    Global("Iacontin","LOCALS",0)
	See([PC])
	!CheckSpellState(LastSeenBy(Myself),SI_TRANSMUTATION)
	OR(2)
	    CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
        CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	OR(2)
	    CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE7) 
        CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	OR(2)
	    CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	    CheckStatGT(LastSeenBy(Myself),0,SCRIPTINGSTATE7) 
THEN
	RESPONSE #100
		SetGlobal("Iacontin","LOCALS",1)
		SetGlobalTimer("IaProtRemovalWait","LOCALS",1)
		DisplayString(Myself,26328)  // Chain Contingency
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_RUBY_RAY_OF_REVERSAL)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_RUBY_RAY_OF_REVERSAL)
		ReallyForceSpell(LastSeenBy(Myself),WIZARD_RUBY_RAY_OF_REVERSAL)
	RESPONSE #25
	    Continue()
END

