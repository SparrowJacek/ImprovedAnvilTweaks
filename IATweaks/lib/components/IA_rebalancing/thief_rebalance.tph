// Block real Stealth for every character, so that they can't access vanilla Stealth through some quick button

COPY ~IATweaks\resources\spl\s!disste.spl~ ~override~

ACTION_FOR_EACH kit_that_can_hide IN ~CLABRN01~ ~CLABRN02~ ~CLABRN03~ ~CLABRN04~ ~VAGRAN~ ~PROTEC~ ~CLABMO01~ ~CLABMO02~ ~CLABMO03~ ~CLABTH01~ ~CLABTH02~ ~CLABTH03~ ~CLABTH04~ ~CLABTH05~ BEGIN
  LAF ~S!ADD_CLAB_ROW~
    STR_VAR
      filename = ~%kit_that_can_hide%.2da~
      row_desc = ~NO_REAL_STEALTH_BUTTON~
      level1 = ~AP_S!DISSTE~
  END
END

