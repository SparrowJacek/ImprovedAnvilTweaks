	!StateCheck(LastSeenBy(Myself),STATE_HELPLESS)
	!GlobalTimerNotExpired("IaSpellTurn","LOCALS")
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaSpellTurn","LOCALS",TEN_ROUNDS)
		ForceSpellRES("SPWII03",Myself)  // Spell Turning
	RESPONSE #100
	    Continue()
END

