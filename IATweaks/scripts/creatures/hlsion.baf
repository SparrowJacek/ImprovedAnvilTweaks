IF
	HaveSpellRES("SPWI922")
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!GlobalTimerNotExpired("IaDragonBreath","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	CheckStatLT(SixthNearest([PC]),95,RESISTFIRE)
	See(SixthNearest([PC]))
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaDragonBreath","LOCALS",TWO_ROUNDS)
		ReallyForceSpellRES("S!SEEAOE",Myself)
		SpellRES("SPWI922", LastSeenBy(Myself))
		ReallyForceSpellRES("S!SEEREM",Myself)
		SetInterrupt(TRUE)
	RESPONSE #100
	    Continue()
END

