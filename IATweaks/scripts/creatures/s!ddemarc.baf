IF
	Allegiance(Myself,ENEMY)
	ActionListEmpty()
	See(NearestEnemyOf(Myself))
	HPLT(NearestEnemyOf(Myself),40)
	CheckStatLT(NearestEnemyOf(Myself),80,RESISTCRUSHING) // PIERCING/CRUSHING/SLASHING
    !CheckStatGT(NearestEnemyOf(Myself),0,SCRIPTINGSTATE6)
	!CheckStatGT(NearestEnemyOf(Myself),0,STONESKINS)
	!StateCheck(NearestEnemyOf(Myself),STATE_MIRRORIMAGE)
	Range(NearestEnemyOf(Myself),3)
THEN
	RESPONSE #100
		SetGlobal("IaAttacking","LOCALS",1)
		EquipMostDamagingMelee()
		AttackReevaluate(NearestEnemyOf(Myself),45)
END
