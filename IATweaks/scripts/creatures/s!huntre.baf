IF
	See(LastTargetedBy(Myself))
	Global("IaAttacking","LOCALS",1)
	OR(2)
		!WeaponEffectiveVs(LastTargetedBy(Myself),MAINHAND)
		!WeaponCanDamage(LastTargetedBy(Myself),MAINHAND)
THEN
	RESPONSE #100
		SetGlobal("IaAttacking","LOCALS",0)
		ClearActions(Myself)
END


IF
	Allegiance(Myself,ENEMY)
    ActionListEmpty()
	Global("IaChar1Seen","LOCALS",1)
	!See(Player1)
	!HPLT(Player1,0)
	InMyArea(Player1)
THEN
	RESPONSE #100
		MoveToObject(Player1)
END

