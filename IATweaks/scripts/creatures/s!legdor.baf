IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("IaPrep","LOCALS",1)
		ReallyForceSpellRES("PTN33X",Myself)  // No such index
		ReallyForceSpellRES("PTN33X",Myself)  // No such index
		ReallyForceSpellRES("SPPR101",Myself) //  Bless
		ReallyForceSpellRES("SPPR108",Myself) //  Remove Fear
		ReallyForceSpellRES("SPPR111",Myself) //  Armor of Faith
		ReallyForceSpellRES("SPPR201",Myself) //  Aid
		ReallyForceSpellRES("SPPR203",Myself) //  Chant
		ReallyForceSpellRES("SPPR206",Myself) //  Flame Blade
		ReallyForceSpellRES("SPPR412",Myself) //  Holy Power
		ReallyForceSpellRES("SPPR214",Myself) //  Draw Upon Holy Might
		ReallyForceSpellRES("SPPR403",Myself) //  Free Action
		ReallyForceSpellRES("SPPR406F",Myself) //  Defensive Harmony
		ReallyForceSpellRES("SPPR407",Myself) //  Protection From Lightning
		ReallyForceSpellRES("SPPR408",Myself) //  Protection From Evil, 10' Radius
		ReallyForceSpellRES("SPPR409",Myself) //  Death Ward
		ReallyForceSpellRES("SPPR508",Myself) //  Chaotic Commands
		ReallyForceSpellRES("SPPR509",Myself) //  Magic Resistance
		ReallyForceSpellRES("SPPR511",Myself) //  Slay Living
		ReallyForceSpellRES("SPPR513",Myself) //  Righteous Magic
		ReallyForceSpellRES("SPPR613",Myself) //  Protection From Missiles
		ReallyForceSpellRES("SPPR617",Myself) //  Heavenly Shield
		ReallyForceSpellRES("SPPR618",Myself) //  Champion's Might
		ReallyForceSpellRES("SPPR701",Myself) //  Shield of the Archons
		SetGlobalTimer("IaDefensiveHarmonyTimer","LOCALS",SIX_ROUNDS)
		RemoveSpellRES("SPPR101")
		RemoveSpellRES("SPPR108")
		RemoveSpellRES("SPPR111")
		RemoveSpellRES("SPPR201")
		RemoveSpellRES("SPPR203")
		RemoveSpellRES("SPPR206")
		RemoveSpellRES("SPPR214")
		RemoveSpellRES("SPPR403")
		RemoveSpellRES("SPPR406F")
		RemoveSpellRES("SPPR407")
		RemoveSpellRES("SPPR408")
		RemoveSpellRES("SPPR409")
		RemoveSpellRES("SPPR412")
		RemoveSpellRES("SPPR508")
		RemoveSpellRES("SPPR509")
		RemoveSpellRES("SPPR511")
		RemoveSpellRES("SPPR513")
		RemoveSpellRES("SPPR613")
		RemoveSpellRES("SPPR617")
		RemoveSpellRES("SPPR618")
		RemoveSpellRES("SPPR701")
		SetInterrupt(TRUE)
END


