	CheckStatLT(LastSeenBy(Myself),80,RESISTELECTRICITY)
	TriggerOverride(FifthNearest([PC]), CheckStatLT(NearestAllyOf(Myself),100,RESISTELECTRICITY))
	!GlobalTimerNotExpired("IaDragonBreath","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaDragonBreath","LOCALS",36)
		ForceSpell(LastSeenBy(Myself),BLUE_DRAGON_BREATH)
	RESPONSE #100
	    Continue()
END

