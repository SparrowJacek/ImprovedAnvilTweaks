IF
	ActionListEmpty()
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	!GlobalTimerNotExpired("Iadoracle","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	!CheckStatGT(Myself,0,SCRIPTINGSTATE9)
	OR(2)
		Detect(NearestEnemyOf(Myself))
		Detect([EVILCUTOFF])
	!See([EVILCUTOFF])
	!See(NearestEnemyOf(Myself))
	HaveSpell(WIZARD_ORACLE)  // SPWI515.SPL (Oracle)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		SetGlobalTimer("Iadoracle","LOCALS",THREE_ROUNDS)
		Spell(Myself,WIZARD_ORACLE)  // SPWI515.SPL (Oracle)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	ActionListEmpty()
	!StateCheck(Myself,STATE_SILENCED)
	!CheckStatGT(Myself,0,SCRIPTINGSTATE9)
	!CheckStatGT(Myself,0,MINORGLOBE)
	OR(2)
		!StateCheck(Myself,STATE_HASTED)
		StateCheck(Myself,STATE_SLOWED)
	HaveSpell(WIZARD_HASTE)  // SPWI305.SPL (Haste)
	See(NearestEnemyOf(Myself))
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		Spell(Myself,WIZARD_HASTE)  // SPWI305.SPL (Haste)
