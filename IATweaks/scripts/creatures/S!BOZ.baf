IF
	Allegiance(Myself,ENEMY)
	Global("Iapcastts","GLOBAL",0)
	See(NearestEnemyOf(Myself))
	HPPercentGT(Myself,75)
	HasItem("potn09",Myself)
	!GlobalTimerNotExpired("DrankPotionTimer","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46150)  // *quaffs a potion*
		UseItem("potn09",Myself)  // Potion of Superior Healing
	RESPONSE #100
		Continue()
END

IF
	HasItem("POTN14",Myself)
	Detect(NearestEnemyOf(Myself))
	!StateCheck(Myself,STATE_HASTED)
	CheckStat(Myself,0,IMPROVEDHASTE)
	!GlobalTimerNotExpired("DrankPotionTimer","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		UseItem("POTN14",Myself)
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("DrankPotionTimer","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_CONFUSED)
	Global("Iapcastts","GLOBAL",0)
	See([PC])
	Range(LastSeenBy(Myself),5)
	GlobalLT("Iaboz02","LOCALS",2)
	!GlobalTimerNotExpired("Iahla","LOCALS")
	!GlobalTimerNotExpired("Iagww","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("Iagww","LOCALS",FOUR_ROUNDS)
		SetGlobalTimer("Iahla","LOCALS",TWO_ROUNDS)
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		IncrementGlobal("Iaboz02","LOCALS",1)
		ForceSpell(Myself,WARRIOR_GREATER_WHIRLWIND)  // SPCL901.SPL (Greater Whirlwind Attack)
END

IF
	Allegiance(Myself,ENEMY)
	!GlobalTimerNotExpired("Iahla","LOCALS")
	!GlobalTimerNotExpired("Iacstrike","LOCALS")
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_CONFUSED)
	Global("Iapcastts","GLOBAL",0)
	See([PC])
	!CheckStatGT(LastSeenBy(Myself),2,SCRIPTINGSTATE6)
	CheckStatLT(LastSeenBy(Myself),1,STONESKINS)
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
	Range(LastSeenBy(Myself),5)
	GlobalLT("Iaboz03","LOCALS",2)
	!GlobalTimerNotExpired("DrankPotionTimer","LOCALS")
THEN
	RESPONSE #100
		SetGlobalTimer("Iacstrike","LOCALS",THREE_ROUNDS)
		SetGlobalTimer("Iahla","LOCALS",TWO_ROUNDS)
		SetGlobalTimer("DrankPotionTimer","LOCALS",ONE_ROUND)
		IncrementGlobal("Iaboz03","LOCALS",1)
		ForceSpell(Myself,WARRIOR_CRITICAL_STRIKE)  // SPCL905.SPL (Critical Strike)
END

