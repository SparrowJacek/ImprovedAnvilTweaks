IF
	HaveSpell(ROGUE_ASSASINATION)  // SPCL916.SPL (Assassination)
	Allegiance(Myself,ENEMY)
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_STUNNED)
	!StateCheck(Myself,STATE_PANIC)
	See(NearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),5)
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!CheckStatGT(Myself,0,ASSASSINATE)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ForceSpell(Myself,ROGUE_ASSASINATION)  // SPCL916.SPL (Assassination)
		RemoveSpell(ROGUE_ASSASINATION)  // SPCL916.SPL (Assassination)
END


IF
	!CheckSpellState(Myself,HIDE_IN_SHADOWS_SUCCESS)
	!CheckSpellState(Myself,HIDE_IN_SHADOWS_FAIL)
	!StateCheck(Myself,STATE_INVISIBLE)
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	OR(3)
	    See(NearestEnemyOf(Myself))
	    See(SecondNearestEnemyOf(Myself))
	    See(ThirdNearestEnemyOf(Myself))
THEN
	RESPONSE #100
		ForceSpellRES("S!HISBAS",Myself)  // No such index
END


IF
	HaveSpellRES("SPCL423")
	!GlobalTimerNotExpired("PoisonWeapon","LOCALS")
	!GlobalTimerNotExpired("IaAction","LOCALS")
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_SILENCED)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	See([PC])
	Range(LastSeenBy(Myself),7)
	CheckStatLT(LastSeenBy(Myself),100,RESISTPOISON)
THEN
	RESPONSE #100
		SetGlobalTimer("PoisonWeapon","LOCALS",THREE_ROUNDS)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		ForceSpellRES("SPCL423",Myself)  // Poison Weapon
		RemoveSpellRES("SPCL423")
END

