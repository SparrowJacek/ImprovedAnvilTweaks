// Archers can pick any alignment and won't fall:

COPY_EXISTING ~ALIGNMNT.2da~ ~override~
  REPLACE_EVALUATE
    ~FERALAN.*~
    BEGIN
    END
    ~FERALAN 1 1 1 1 1 1 1 1 1~
  PRETTY_PRINT_2DA

APPEND ~FALLEN.2da~ ~FERALAN 0~

// Cloak of Atonement

COPY ~IATweaks\resources\bam\s!atone1.bam~ ~override~
COPY ~IATweaks\resources\bam\s!atone2.bam~ ~override~
COPY ~IATweaks\resources\bam\s!atone3.bam~ ~override~
COPY ~IATweaks\resources\itm\ohrclck3.itm~ ~override~
  SAY IDENTIFIED_DESC @7063

COPY_EXISTING ~oh4101.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    SET ofs = INDEX_BUFFER(~"OHRCLCK3",Player1,[0-9]+,[0-9]+,[0-9]+~)
    PATCH_IF %ofs% >= 0 BEGIN
      REPLACE_EVALUATE
      ~"OHRCLCK3",Player1,[0-9]+,[0-9]+,[0-9]+~
      BEGIN
        SPRINT val ~"OHRCLCK3",Player1,4,3,2~
      END
      ~%val%~
    END
  END
  BUT_ONLY

