IF
	OnCreation()
THEN
	RESPONSE #100
		ReallyForceSpellRES("S!MFPROT",Myself)
		Continue()
END

IF
	GlobalGT("IaMind01","LOCALS",0)
	!GlobalTimerNotExpired("IaMindRegen","LOCALS")
THEN
	RESPONSE #100
		IncrementGlobal("IaMind01","LOCALS",-1)
		SetGlobalTimerRandom("IaMindRegen","LOCALS",3,5)
END

IF
	Global("IaStartFight","LOCALS",0)
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOfType([PC]))
THEN
	RESPONSE #100
		IncrementGlobal("IaStartFight","LOCALS",1)
		SetGlobalTimerRandom("IaPsionicAction","LOCALS",1,4)
END

IF
	See(NearestEnemyOf(Myself))
	Global("EnemySeen","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("EnemySeen","LOCALS",1)
		Shout(89)
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([GOODCUTOFF])
		Detect([PC])
	Global("partyfled","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("partyfled","LOCALS",0)
		Shout(89)
END


IF
	GlobalLT("IaMind01","LOCALS",7)
	!GlobalTimerNotExpired("IaBatheInBloodTimer","AR3021")
	HPPercentLT(Myself,60)
THEN
	RESPONSE #100
		IncrementGlobal("IaMind01","LOCALS",2)
		SetGlobalTimer("IaPsionicAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaBatheInBloodTimer","AR3021",ONE_ROUND)
		ForceSpellPointRES("S!BLOODB",[488.1027])  // Bathe in Blood
	RESPONSE #100
	    Continue()
END

IF
	GlobalLT("IaMind01","LOCALS",6)
	!GlobalTimerNotExpired("IaPsionicAction","LOCALS")
    Global("IaBloodFog","AR3021",0)
THEN
	RESPONSE #100
		IncrementGlobal("IaMind01","LOCALS",3)
        SetGlobal("IaBloodFog","AR3021",1)
		SetGlobalTimer("IaPsionicAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaBloodFogTimerTimer","AR3021",ONE_ROUND)
		ForceSpellPointRES("S!BLDFOG",[488.1027])
	RESPONSE #50
	    Continue()
END

IF
	GlobalLT("IaMind01","LOCALS",5)
	See(SecondNearest([0.0.MIND_FLAYER.0.0.0.0]))
	!GlobalTimerNotExpired("IaPsionicAction","LOCALS")
	Allegiance(Myself,ENEMY)
	See(SixthNearest([PC]))
    HPLT(LastSeenBy(Myself),70)
	!StateCheck(LastSeenBy(Myself),STATE_STUNNED)
	!StateCheck(LastSeenBy(Myself),STATE_CHARMED)
	!CheckStatGT(LastSeenBy(Myself),50,MAGICDAMAGERESISTANCE)
	TriggerOverride(SixthNearest([PC]),Range(NearestAllyOf(Myself),4))
	!TriggerOverride(SixthNearest([PC]), CheckStatGT(NearestAllyOf(Myself),50,MAGICDAMAGERESISTANCE))
THEN
	RESPONSE #100
		IncrementGlobal("IaMind1","LOCALS",3)
		SetGlobalTimer("IaPsionicAction","LOCALS",ONE_ROUND)
		ForceSpellRES("S!MFBLST",LastSeenBy(Myself))
END
