// Thieves right before the exit from Chateau Irenicus
ACTION_FOR_EACH low_level_thief_cre IN ~ISHADTH1.cre~ ~ISHADMT1.cre~ ~ISHADFT1.cre~ BEGIN 
  COPY_EXISTING ~%low_level_thief_cre%~ ~override~
    WRITE_BYTE 0x52 17 // Thac0
    WRITE_BYTE 0x64 0 // Detect Illusions
    WRITE_BYTE 0x65 0 // Set Traps
    WRITE_BYTE 0x67 0 // Pick Locks
    WRITE_BYTE 0x68 0 // Stealth Strike
    WRITE_BYTE 0x69 0 // Find Traps
    WRITE_BYTE 0x6a 80 // Pick Pockets
    WRITE_BYTE 0x23c 17 // Dexterity
    WRITE_BYTE 0x272 3 // Half Elf because they're multi-class
  
  LPF ~ADD_CRE_EFFECT~ // Set persistent AI
    INT_VAR
      target = 1
      opcode = 293
      parameter2 = 1
      resist_dispel = 0
      timing = 9
  END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 90
        target = 1
        parameter1 = 40
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~S!40OL~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 91
        target = 1
        parameter1 = 40
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~S!40FT~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 92
        target = 1
        parameter1 = 40
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~S!40PP~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 144
        target = 1
        timing = 9
      STR_VAR
        effsource = ~S!DISSTE~
    END
END

COPY_EXISTING ~ISHADFT1.cre~ ~override~
  WRITE_BYTE 0x52 16 // Thac0
  WRITE_BYTE 0x238 17 // Strength

// Suna Seni Assassin
ACTION_FOR_EACH thief_thug_cre IN ~RETHIE01.cre~ ~RETHUG04.cre~ BEGIN
  COPY_EXISTING ~%thief_thug_cre%~ ~override~
    WRITE_SHORT 0x24 66 // HP
    WRITE_SHORT 0x26 66 // HP
    WRITE_BYTE 0x45 130 // Hide in Shadows
    WRITE_BYTE 0x52 12 // Thac0
    WRITE_BYTE 0x64 0 // Detect Illusions
    WRITE_BYTE 0x65 0 // Set Traps
    WRITE_BYTE 0x67 0 // Pick Locks
    WRITE_BYTE 0x68 0 // Stealth Strike
    WRITE_BYTE 0x69 0 // Find Traps
    WRITE_BYTE 0x6a 0 // Pick Pockets
    WRITE_LONG 0x244 0x400a0000 // Kit = Assassin
  
  LPF ~ADD_CRE_EFFECT~ // Set persistent AI
    INT_VAR
      target = 1
      opcode = 293
      parameter2 = 1
      resist_dispel = 0
      timing = 9
  END

    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 233
        match_parameter2 = 91
        parameter1 = 2
    END

    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = 233
        match_parameter2 = 113
        parameter1 = 2
    END

    LPF ~ADD_CRE_EFFECT~ // For some reason damage bonus is already applied
      INT_VAR
        opcode = 278
        target = 1
        parameter1 = 1
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~SPCL421~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 59
        target = 1
        parameter1 = 40
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~S!40SS~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 275
        target = 1
        parameter1 = 40
        parameter2 = 0
        timing = 9
      STR_VAR
        effsource = ~S!40HIS~
    END

    LPF ~ADD_CRE_EFFECT~
      INT_VAR
        opcode = 144
        target = 1
        timing = 9
      STR_VAR
        effsource = ~S!DISSTE~
    END
END

