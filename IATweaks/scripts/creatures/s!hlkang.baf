
IF
	Allegiance(Myself,ENEMY)
	InMyArea(Player1)
	Global("Iaexit","AR0331",0)  // House Cellar (Kangaxx)
THEN
	RESPONSE #100
		SetGlobal("Iaexit","AR0331",1)  // House Cellar (Kangaxx)
		Continue()
END


IF
	Global("Iapcastts","GLOBAL",1)
	Global("Iatsinvulner","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",1)
		ApplySpellRES("SPINI70",Myself)  // No such index
END

IF
	Global("Iapcastts","GLOBAL",0)
	Global("Iatsinvulner","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("Iatsinvulner","LOCALS",0)
		ApplySpellRES("SPINI71",Myself)  // No such index
		Continue()
END

IF
	Global("Iapcastts","GLOBAL",1)
THEN
	RESPONSE #100
		NoAction()
END


IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
	    ReallyForceSpellRES("S!CNT03A",Myself)
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
	    ReallyForceSpellRES("S!CNT02A",Myself)
	    Continue()
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("IaPrep","LOCALS",0)
THEN
	RESPONSE #100
		SetInterrupt(FALSE)
		SetGlobal("IaPrep","LOCALS",1)
		ReallyForceSpellRES("S!GAXCUR",Myself)
		ReallyForceSpell(Myself,WIZARD_ARMOR)  // SPWI102.SPL (Armor)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_EVIL)  // SPWI113 (Protection From Evil)
		ReallyForceSpell(Myself,WIZARD_LUCK)  // SPWI209.SPL (Luck)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_BLUE)  // SPWI403.SPL (Fire Shield (Blue))
		ReallyForceSpell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
		ReallyForceSpell(Myself,WIZARD_FIRE_SHIELD_RED)  // SPWI418.SPL (Fire Shield (Red))
		ReallyForceSpell(Myself,WIZARD_TELEPORT_FIELD)
		ReallyForceSpell(Myself,WIZARD_SPELL_IMMUNITY_NECROMANCY)
		ReallyForceSpellRES("SPWI522",Myself)  // Soul Armor
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_MAGIC_WEAPONS)
		ReallyForceSpell(Myself,WIZARD_SPELL_TURNING)  // SPWI701.SPL (Spell Turning)
		ReallyForceSpell(Myself,WIZARD_PROTECTION_FROM_ENERGY)
		ReallyForceSpellRES("SPWI804",Myself)  // Tenser's Partial Transformation
		ReallyForceSpellRES("SPWI807",Myself)  // Foreknowledge
		ReallyForceSpell(Myself,WIZARD_GLOBE_OF_INVULNERABILITY)  // SPWI602.SPL (Globe of Invulnerability)
		SetGlobalTimer("IaAlacrity","LOCALS",11)
		ReallyForceSpell(Myself,WIZARD_IMPROVED_ALACRITY)
		RemoveSpell(WIZARD_ARMOR)
		RemoveSpell(WIZARD_SHIELD)
		RemoveSpell(WIZARD_PROTECTION_FROM_EVIL)
		RemoveSpell(WIZARD_LUCK)
		RemoveSpell(WIZARD_FIRE_SHIELD_BLUE)
		RemoveSpell(WIZARD_GLOBE_OF_INVULNERABILITY)
		RemoveSpell(WIZARD_STONE_SKIN)
		RemoveSpell(WIZARD_FIRE_SHIELD_RED)
		RemoveSpell(WIZARD_SPELL_IMMUNITY)
		RemoveSpellRES("SPWI522")
		RemoveSpell(WIZARD_SPELL_TURNING)
		RemoveSpellRES("SPWI725")
		RemoveSpell(WIZARD_PROTECTION_FROM_ENERGY)
		RemoveSpellRES("SPWI804")
		RemoveSpellRES("SPWI807")
		RemoveSpell(WIZARD_IMPROVED_ALACRITY)
		SetInterrupt(TRUE)
END


IF
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	StateCheck(Myself,STATE_SILENCED)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SpellNoDec(Myself,WIZARD_VOCALIZE)  // SPWI219.SPL (Vocalize)
END
IF
    HaveSpell(WIZARD_IMPROVED_ALACRITY)
	Allegiance(Myself,ENEMY)
	OR(2)
        !CheckStatGT(Myself,0,AURACLEANSING)
        !GlobalTimerNotExpired("IaAlacrity","LOCALS")
    !GlobalTimerNotExpired("IaAction","LOCALS")
	See([PC])
	OR(2)
	    See(SecondNearestEnemyOf(Myself))
	    NumInParty(1)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaAlacrity","LOCALS",11)
		RemoveSpell(WIZARD_IMPROVED_ALACRITY)
		ForceSpell(Myself,WIZARD_IMPROVED_ALACRITY)
	RESPONSE #0
	    Continue()
END
IF
    HaveSpell(WIZARD_STONE_SKIN)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	See(NearestEnemyOf(Myself))
	CheckStatLT(Myself,1,STONESKINS)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(Myself,WIZARD_STONE_SKIN)  // SPWI408.SPL (Stoneskin)
	RESPONSE #10
	    Continue()
END
IF
    HaveSpell(WIZARD_IMPROVED_MANTLE)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	CheckStat(Myself,0,SCRIPTINGSTATE6)
	See(NearestEnemyOf(Myself))
	Range(LastSeenBy(Myself),10)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(Myself,WIZARD_IMPROVED_MANTLE)
	RESPONSE #10
	    Continue()
END

IF
    HaveSpell(WIZARD_LARLOCH_MINOR_DRAIN)
	Allegiance(Myself,ENEMY)
	CheckStatGT(Myself,0,AURACLEANSING)
	See([PC])
	OR(2)
        CheckStatGT(LastSeenBy(Myself),24,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
        CheckStatGT(LastSeenBy(Myself),15,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
	OR(2)
        CheckStatGT(LastSeenBy(Myself),24,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
        CheckStatGT(Myself,0,MENTALSPEED)
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
    CheckStatLT(LastSeenBy(Myself),100,MAGICDAMAGERESISTANCE)
	!CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	!CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	!CheckSpellState(LastSeenBy(Myself),SI_NECROMANCY)
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(LastSeenBy(Myself),WIZARD_LARLOCH_MINOR_DRAIN)
	RESPONSE #300
	    Continue()
END

