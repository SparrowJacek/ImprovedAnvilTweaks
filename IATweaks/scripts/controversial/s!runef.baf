
IF
	InMyArea(Player1)
	Global("Iauseanyitem","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("Iauseanyitem","LOCALS",1)
		ApplySpellRES("SPCL915",Myself)  // Use Any Item
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		See([PC])
		Global("RuneFinalBattle","GLOBAL",1)
	Global("Iacreature","LOCALS",0)
	!HPLT(Myself,1)
THEN
	RESPONSE #100
		SetGlobal("Iacreature","LOCALS",1)
		SetGlobalTimer("Ianextrunef3","LOCALS",ONE_ROUND)
		CreateCreature("S!runef2",[1572.2202],SEE)  // Master Assassin
		CreateCreature("S!runef2",[1526.2259],SEE)  // Master Assassin
		CreateCreature("S!runef3",[1483.2180],SEE)  // Assassin Coordinator
		CreateCreature("S!runef2",[1496.2116],NNE)  // Master Assassin
		CreateCreature("S!runef2",[1534.2133],NNE)  // Master Assassin
		Continue()
END

IF
	Allegiance(Myself,ENEMY)
	OR(2)
		See([PC])
		Global("RuneFinalBattle","GLOBAL",1)
	Global("Iacreature","LOCALS",1)
	GlobalTimerExpired("Ianextrunef3","LOCALS")
	!HPLT(Myself,1)
THEN
	RESPONSE #100
		SetGlobal("Iacreature","LOCALS",2)
		CreateCreatureObject("S!runef3",Myself,0,0,0)  // Assassin Coordinator
		Continue()
END

