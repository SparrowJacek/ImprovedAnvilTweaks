	!StateCheck([PC],STATE_MIRRORIMAGE)
	Range([PC],5)
    HasItem("SW1H04",Myself)
THEN
	RESPONSE #100
	    
		XEquipItem("SW1H04",Myself,SLOT_WEAPON3,EQUIP)
		AttackOneRound(LastSeenBy(Myself))
END

