    CheckStatGT(FourthNearest([PC]),2,SAVEVSSPELL)
	OR(2)
	    CheckStatGT(FourthNearest([PC]),6,SAVEVSSPELL)
	    !StateCheck(FourthNearest([PC]),STATE_IMPROVEDINVISIBILITY)
	See(FourthNearest([PC]))
THEN
	RESPONSE #100
		SetGlobalTimer("IaFiveSeconds","LOCALS",ONE_MINUTE)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(LastSeenBy(Myself),CLERIC_COMMAND)  // SPPR102.SPL (Command)
	RESPONSE #200
	    Continue()
END

