IF
    HaveSpell(WIZARD_LOWER_RESISTANCE)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
    !GlobalTimerNotExpired("IaLowerResWait","LOCALS")
	See([PC])
	CheckStatLT(LastSeenBy(Myself),60,RESISTMAGIC)
	CheckStatGT(LastSeenBy(Myself),30,RESISTMAGIC)
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	!CheckStat(LastSeenBy(Myself),1,SCRIPTINGSTATE7)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		SetGlobalTimer("IaLowerResWait","LOCALS",2)
		RemoveSpell(WIZARD_LOWER_RESISTANCE)
		ForceSpell(LastSeenBy(Myself),WIZARD_LOWER_RESISTANCE)
	RESPONSE #100
	    Continue()
END

