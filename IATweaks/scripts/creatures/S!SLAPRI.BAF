IF
	Detect([PC])
	Global("Iatreasure","LOCALS",0)
	Global("Iablackbloodplace","GLOBAL",3)
THEN
	RESPONSE #100
		SetGlobal("Iablackbloodplace","GLOBAL",5)
		SetGlobal("Iatreasure","LOCALS",1)
		GiveItemCreate("blun22",Myself,0,0,0)  // Club +2, Blackblood
END

IF
	!StateCheck(Myself,STATE_CONFUSED)
	!StateCheck(Myself,STATE_HELPLESS)
	!StateCheck(Myself,STATE_PANIC)
	!StateCheck(Myself,STATE_STUNNED)
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	HasItem("POTN34",Myself)
THEN
	RESPONSE #100
		SetGlobalTimer("Iaspell","LOCALS",ONE_ROUND)
		DisplayStringHead(Myself,46150)  // *quaffs a potion*
		UseItem("POTN34",Myself)  // Potion of Superior Healing
END

IF
	OR(2)
		Detect([PC])
		Detect([GOODCUTOFF])
	Global("EnemySeen","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("EnemySeen","LOCALS",1)
