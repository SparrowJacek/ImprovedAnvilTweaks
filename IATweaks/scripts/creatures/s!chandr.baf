IF
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
	!Dead("GPSIMB")  // Simbja
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
		ReallyForceSpell("GPSIMB",CLERIC_FREE_ACTION)  // Simbja
		RemoveSpell(CLERIC_FREE_ACTION)
		ReallyForceSpell("GPSIMB",CLERIC_CHAOTIC_COMMANDS)  // Simbja
		RemoveSpell(CLERIC_CHAOTIC_COMMANDS)
		Continue()
END

IF
	See(NearestEnemyOf(Myself))
	Global("IaPrep","LOCALS",0)
	!Dead("GPTHIEF1")  // Thief
THEN
	RESPONSE #100
		SetGlobal("IaPrep","LOCALS",1)
		ReallyForceSpell("GPTHIEF1",CLERIC_FREE_ACTION)  // Thief
		RemoveSpell(CLERIC_FREE_ACTION)
		ReallyForceSpell("GPTHIEF1",CLERIC_CHAOTIC_COMMANDS)  // Thief
		RemoveSpell(CLERIC_CHAOTIC_COMMANDS)
