	Allegiance(Myself,ENEMY)
	Detect([PC])
	Global("Iatreasure3","LOCALS",0)
	Global("Iaring35place","GLOBAL",4)
	GlobalGT("golems","LOCALS",0)
	Global("Iapcastts","GLOBAL",0)
THEN
