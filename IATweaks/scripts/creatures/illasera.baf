	CheckStatLT([PC.0.0.MAGE_ALL],75,RESISTSLASHING) // PIERCING/CRUSHING/SLASHING
    CheckStat([PC.0.0.MAGE_ALL],3,SCRIPTINGSTATE6)
	!CheckSpellState([PC.0.0.MAGE_ALL],PROTECTION_FROM_NORMAL_WEAPONS)
	!CheckStatGT([PC.0.0.MAGE_ALL],0,STONESKINS)
	!StateCheck([PC.0.0.MAGE_ALL],STATE_MIRRORIMAGE)
	Range([PC.0.0.MAGE_ALL],10)
    HasItem("SW1H43",Myself)
THEN
	RESPONSE #100
		XEquipItem("SW1H43",Myself,SLOT_WEAPON3,EQUIP)
		AttackReevaluate(LastSeenBy(Myself),30)
END

