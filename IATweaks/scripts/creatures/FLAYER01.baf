IF
	OnCreation()
THEN
	RESPONSE #100
		ReallyForceSpellRES("S!MFPROT",Myself)
		Continue()
END

IF
	GlobalGT("IaMind01","LOCALS",0)
	!GlobalTimerNotExpired("IaMindRegen","LOCALS")
THEN
	RESPONSE #100
		IncrementGlobal("IaMind01","LOCALS",-1)
		SetGlobalTimerRandom("IaMindRegen","LOCALS",4,7)
END

IF
	Global("IaStartFight","LOCALS",0)
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOfType([PC]))
THEN
	RESPONSE #100
		IncrementGlobal("IaStartFight","LOCALS",1)
		SetGlobalTimerRandom("Iaspell","LOCALS",1,3)
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Allegiance(Myself,ENEMY)
	See(NearestEnemyOfType([PC]))
THEN
	RESPONSE #100
		SetGlobal("IaMindAlliesNearby","LOCALS",0)
		Continue()
END

IF
	!GlobalTimerNotExpired("IaSoftenMind","LOCALS")
	GlobalGT("IaMind02","LOCALS",0)
	Allegiance(Myself,ENEMY)
THEN
	RESPONSE #100
		IncrementGlobal("IaMind02","LOCALS",-1)
		SetGlobalTimerRandom("IaSoftenMind","LOCALS",5,11)
		Continue()
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Allegiance(Myself,ENEMY)
	See(NearestAllyOf(Myself))
	TriggerOverride(NearestAllyOf(Myself),Race(Myself,MIND_FLAYER))
THEN
	RESPONSE #100
		IncrementGlobal("IaMindAlliesNearby","LOCALS",1)
		Continue()
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Allegiance(Myself,ENEMY)
	See(SecondNearestAllyOf(Myself))
	TriggerOverride(SecondNearestAllyOf(Myself),Race(Myself,MIND_FLAYER))
THEN
	RESPONSE #100
		IncrementGlobal("IaMindAlliesNearby","LOCALS",1)
		Continue()
END

IF
	!GlobalTimerNotExpired("Iaspell","LOCALS")
	Allegiance(Myself,ENEMY)
	See(ThirdNearestAllyOf(Myself))
	TriggerOverride(ThirdNearestAllyOf(Myself),Race(Myself,MIND_FLAYER))
THEN
