  LPF ~ADD_CRE_EFFECT~ // * in Single Weapon
    INT_VAR
      target = 1
      opcode = 233
      parameter1 = 1
      parameter2 = 113
      resist_dispel = 0
      timing = 9
  END

  LPF ~ADD_CRE_EFFECT~ // * in Short Sword
    INT_VAR
      target = 1
      opcode = 233
      parameter1 = 1
      parameter2 = 91
      resist_dispel = 0
      timing = 9
  END

  LPF ~ADD_CRE_EFFECT~ // * in Crossbow
    INT_VAR
      target = 1
      opcode = 233
      parameter1 = 1
      parameter2 = 103
      resist_dispel = 0
      timing = 9
  END
    
  LPF ~DELETE_CRE_EFFECT~ // Unknown AC bonus
    INT_VAR
      opcode_to_delete = 0
  END
    
  LPF ~DELETE_CRE_EFFECT~ // Unknown thac0 bonus
    INT_VAR
      opcode_to_delete = 54
  END

