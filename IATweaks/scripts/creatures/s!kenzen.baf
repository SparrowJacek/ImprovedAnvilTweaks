IF
    HaveSpell(WIZARD_FLAME_ARROW)
	Allegiance(Myself,ENEMY)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	See([PC])
	OR(2)
        CheckStatGT(LastSeenBy(Myself),42,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
        CheckStatGT(LastSeenBy(Myself),33,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
	OR(2)
        CheckStatGT(LastSeenBy(Myself),42,TICKSTOFINISHCASTINGHIGHPRIORITYSPELL)
        CheckStatGT(Myself,0,MENTALSPEED)
	OR(2)
        CheckStatGT(Myself,0,SEEINVISIBLE)
        !StateCheck(LastSeenBy(Myself),STATE_IMPROVEDINVISIBILITY)
	OR(2)
	    CheckStatLT(LastSeenBy(Myself),100,RESISTFIRE)
	    CheckStatLT(LastSeenBy(Myself),100,RESISTPIERCING)
	OR(2)
	    CheckStatLT(LastSeenBy(Myself),100,RESISTFIRE)
	    CheckStatLT(LastSeenBy(Myself),1,STONESKINS)
	CheckStatLT(LastSeenBy(Myself),20,RESISTMAGIC)
	!CheckStatGT(LastSeenBy(Myself),0,MINORGLOBE)
	!CheckSpellState(LastSeenBy(Myself),WIZARD_SPELL_TURNING)
	!CheckStat(LastSeenBy(Myself),2,SCRIPTINGSTATE7)
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
THEN
	RESPONSE #100
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		Spell(LastSeenBy(Myself),WIZARD_FLAME_ARROW)
	RESPONSE #100
	    Continue()
END

