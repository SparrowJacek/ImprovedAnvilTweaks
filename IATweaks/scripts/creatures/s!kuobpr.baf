IF
	Allegiance(Myself,ENEMY)
	OR(3)
		HasItem("S!HARM",Myself)  // Harm
		HasItem("SERIOUS",Myself)  // Cause Serious Wounds
		HasItem("CRITICAL",Myself)  // Cause Critical Wounds
	See([PC])
	Range(LastSeenBy(Myself),10)
	!StateCheck(LastSeenBy(Myself),STATE_MIRRORIMAGE)
	CheckStatLT(LastSeenBy(Myself),3,SCRIPTINGSTATE6)
	CheckStatLT(LastSeenBy(Myself),50,MAGICDAMAGERESISTANCE)
THEN
	RESPONSE #100
		AttackOneRound(LastSeenBy(Myself))
END

