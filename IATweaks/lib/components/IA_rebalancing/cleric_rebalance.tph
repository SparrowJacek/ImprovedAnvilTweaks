// Improved Armor of Faith for kits from level 20

// Original Armor of Faith make it remove itself instead of protecting from itself
COPY_EXISTING ~SPPR111.spl~ ~override/SPPR111.spl~
  LPF ~CLONE_EFFECT~
    INT_VAR
      match_opcode = 206
      opcode = 321
      duration = 0
    STR_VAR
      insert = ~first~
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 206
    STR_VAR
      resource = ~SPPR111~
  END

// New version for kits
COPY_EXISTING ~SPPR111.spl~ ~override/SPPR111D.spl~
  WRITE_LONG  0x08      ~-1~ // spell name
  WRITE_BYTE  0x27      0 // secondary type 

  // Increase duration to 90s
  LPF ~ALTER_SPELL_EFFECT~
    INT_VAR
      match_opcode = ~-1~
      duration_high = 135
  END

  PATCH_FOR_EACH res_opcode IN 31 86 87 88 89 BEGIN
    LPF ~ALTER_EFFECT~
      INT_VAR
        match_opcode = res_opcode
        parameter1 = 15

    END
  END
  // Remove self for stacking reasons
  LPF ~CLONE_EFFECT~
    INT_VAR
      match_opcode = 321
      multi_match = 1
    STR_VAR
      resource = ~SPPR111D~
  END

  // Make undispellable
  LPF ~ALTER_SPELL_EFFECT~
    INT_VAR
      match_opcode = ~-1~
      resist_dispel = 0
  END

// Original Armor of Faith
COPY_EXISTING ~SPPR111.spl~ ~override/SPPR111.spl~
  LPF ~S!CLONE_SPELL_HEADER~
    INT_VAR
      level_req = 20
  END
  SET shar_kit = ~%SHAR%~ + 0x4000
  PATCH_FOR_EACH cleric_kit IN 16425 16424 16404 16405 16403 ~%shar_kit%~ BEGIN
  // Protect from original spell if caster is Cleric kit
    LAUNCH_PATCH_FUNCTION ~ADD_SPELL_EFFECT~ 
      INT_VAR
        header = 2
        opcode = 318
        insert_point = ~1~
        target = 1
        power = 1
        parameter1 = cleric_kit
        parameter2 = %kit_equals_row%
        duration = 0
        resist_dispel = 0
      STR_VAR
        resource = "SPPR111"
    END
    // Cast improved version if caster is Cleric kit
    LAUNCH_PATCH_FUNCTION ~ADD_SPELL_EFFECT~ 
      INT_VAR
        header = 2
        opcode = 326
        insert_point = ~1~
        target = 1
        power = 1
        parameter1 = cleric_kit
        parameter2 = %kit_equals_row%
        duration = 0
        resist_dispel = 0
      STR_VAR
        resource = "SPPR111D"
    END
  END

// Rework Defensive Harmony

COPY_EXISTING ~sppr406.spl~ ~override/sppr406d.spl~
  SAY UNIDENTIFIED_DESC @6002
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      projectile = %s!defha1% // New projectile with smaller area of effect
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 321 // Shaman aura cleanse
    STR_VAR
      match_resource = ~SPPRI25~
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 215 // Play visual effect
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 233 // Modify Proficiencies
  END
  LPF ~DELETE_EFFECT~
    INT_VAR
      match_opcode = 174 // Play sound
  END
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 321
    STR_VAR
      match_resource = ~sppr406~
      resource = ~sppr406d~
  END
  LPF ~ALTER_SPELL_EFFECT~
    INT_VAR
      duration_high = 6
  END
  LPF ~ADD_SPELL_EFFECT~
    INT_VAR
      opcode = 50
      target = 2
      power = 4
      parameter1 = ~-675892480~
      parameter2 = 1310720
      resist_dispel = 3
  END

COPY ~IATweaks\resources\spl\sppr406e.spl~ ~override\sppr406e.spl~ // Cleric kit only bonus spell
  LPF ~ALTER_SPELL_HEADER~
    INT_VAR
      projectile = %s!defha2% // New projectile with smaller area of effect
  END

COPY ~IATweaks\resources\spl\s!defhar.spl~ ~override\sppr406.spl~ // New Defensive Harmony spell
  SAY UNIDENTIFIED_DESC @6002
  LPF ~ALTER_EFFECT~
    INT_VAR
      match_opcode = 146
    STR_VAR
      resource = ~sppr406d~
  END
  PATCH_FOR_EACH kit_name IN ~OHTYR~ ~GODTALOS~ ~GODHELM~ ~GODLATHANDER~ ~OHTEMPUS~ ~SHAR~ BEGIN
    LPF ~CLONE_EFFECT~
      INT_VAR
        match_opcode = 146
        opcode = 326
        parameter1 = IDS_OF_SYMBOL (kit ~%kit_name%~)
        parameter2 = kit_equals_row
      STR_VAR
        resource = ~sppr406e~
        insert = ~below~
    END
  END

