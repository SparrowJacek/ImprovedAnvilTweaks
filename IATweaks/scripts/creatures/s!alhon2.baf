IF
	Allegiance(Myself,ENEMY)
	OR(4)
	    !Range(NearestAllyOf(Myself), 15)
	    ImmuneToSpellLevel(NearestAllyOf(Myself),5)
	    CheckSpellState(NearestAllyOf(Myself),SI_EVOCATION)
	    CheckStatGT(NearestAllyOf(Myself),99,RESISTFIRE)
	OR(2)
	    CheckStatGT(Myself,0,AURACLEANSING)
	    !GlobalTimerNotExpired("IaAction","LOCALS")
	!HPLT(Myself,1)
	HPPercentLT(Myself,100)
	See(SixthNearest([PC]))
	Range(SixthNearest([PC]), 15)
	Range([PC], 15)
	CheckStatLT(LastSeenBy(Myself),50,RESISTFIRE)
    !CheckSpellState(LastSeenBy(Myself),SI_EVOCATION)
	TriggerOverride(SixthNearest([PC]), CheckStatLT([PC],50,RESISTFIRE))
	TriggerOverride(SixthNearest([PC]), CheckSpellState([PC],SI_EVOCATION))
	Global("IaSpellTrigger","LOCALS",0)
THEN
	RESPONSE #100
		SetGlobal("IaSpellTrigger","LOCALS",1)
		SetGlobalTimer("IaFourSeconds","LOCALS",4)
		SetGlobalTimer("IaAction","LOCALS",ONE_ROUND)
		DisplayString(Myself,39968)  // Spell Trigger—Fired
		ReallyForceSpell(Myself,WIZARD_SUN_FIRE)
		ReallyForceSpell(Myself,WIZARD_SUN_FIRE)
		ReallyForceSpell(Myself,WIZARD_SUN_FIRE)
	RESPONSE #200
	    Continue()
END

