// Make Improved Chain Lightning an Evocation spell and increase its casting time

COPY_EXISTING ~SPWII13.spl~ ~override~
  WRITE_SHORT 0x22 15 // casting animation
  WRITE_BYTE 0x25 6 // Spell School
  
  // Update casting speed
  LPF ~ALTER_SPELL_HEADER~ INT_VAR speed = 4 END

  
